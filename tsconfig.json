{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "types": ["node"]
  },
  "exclude": [
    "dist",
    "dist-new",
    "dist-test",
    "dist-vercel-test",
    ".astro",
    ".wrangler",
    "node_modules",
    "functions/keystatic",
    "xiaominart-test-site",
    "keystatic.config.ts",
    ".workspace-trash"
  ]
}
