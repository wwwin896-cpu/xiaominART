{
  "framework": "astro",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/custom", "destination": "/custom-commission/", "statusCode": 301 },
    { "source": "/custom/", "destination": "/custom-commission/", "statusCode": 301 },
    { "source": "/commission", "destination": "/custom-commission/", "statusCode": 301 },
    { "source": "/commission/", "destination": "/custom-commission/", "statusCode": 301 },
    { "source": "/en/custom", "destination": "/custom-commission/", "statusCode": 301 },
    { "source": "/en/custom/", "destination": "/custom-commission/", "statusCode": 301 },
    { "source": "/en", "destination": "/", "statusCode": 301 },
    { "source": "/en/", "destination": "/", "statusCode": 301 },
    { "source": "/faq", "destination": "/help/", "statusCode": 301 },
    { "source": "/faq/", "destination": "/help/", "statusCode": 301 },
    { "source": "/art-gift", "destination": "/gift-guide/", "statusCode": 301 },
    { "source": "/art-gift/", "destination": "/gift-guide/", "statusCode": 301 },
    { "source": "/blog", "destination": "/journal/", "statusCode": 301 },
    { "source": "/blog/", "destination": "/journal/", "statusCode": 301 },
    { "source": "/blog/:slug", "destination": "/journal/", "statusCode": 301 },
    { "source": "/blog/:slug/", "destination": "/journal/", "statusCode": 301 },
    { "source": "/business", "destination": "/business-gifts/", "statusCode": 301 },
    { "source": "/business/", "destination": "/business-gifts/", "statusCode": 301 },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "xiaominart.com" }],
      "destination": "https://www.xiaominart.com/$1",
      "permanent": true
    }
  ]
}
