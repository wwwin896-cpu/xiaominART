# Cloudflare Pages 响应头规则
# 文档：https://developers.cloudflare.com/pages/configuration/headers/

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=1209600, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ── 安全基线（2026-10-06）──
# 防止页面被第三方 iframe 嵌套（点击劫持）；CSP 先以 Report-Only 观察后再启用，见 docs 运营方案
/*
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
