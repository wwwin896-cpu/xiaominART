# ═════════════════════════════════════════════════════════════
# 阿里云服务器环境变量（复制到服务器 /var/www/xiaominart/.env，权限 600）
#
#   cp server/.env.example /var/www/xiaominart/.env
#   chmod 600 /var/www/xiaominart/.env
#   nano /var/www/xiaominart/.env
#   systemctl restart xiaominart-api
#
# ⚠️ 这个文件**不要提交真实值**。仓库是公开的。
# ⚠️ 6 个值只在 Cloudflare 后台存着，本地 .env 里是空的 ——
#    迁移前必须从 Cloudflare Dashboard 抄过来，否则表单会 503。
# ═════════════════════════════════════════════════════════════

# ── 服务 ──
PORT=8787
HOST=127.0.0.1

# ── 表单与埋点（缺 FORMS_ACCESS_KEY = /api/lead 直接 503，询盘全丢）──
FORMS_ACCESS_KEY=

# ── 定制进度管理接口（/api/admin/progress 的 x-admin-key）──
ADMIN_ACCESS_KEY=

# ── 新线索通知：飞书群机器人 ──
# 若飞书机器人开了「自定义关键词」安全设置，消息必须含该词，
# 否则返回 19024 且静默丢消息（本项目已踩过）。
FEISHU_WEBHOOK_URL=
FEISHU_KEYWORD=

# ── 新线索通知：邮件（Resend）──
# 未验证自有域名时，RESEND_TO_EMAIL 必须填 Resend 注册邮箱，否则 403。
# 想在官网域名下发信，先在 resend.com/domains 完成验证。
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# ── 在线后台 /keystatic（GitHub App）──
# 这 4 个值本地 .env 已有，直接抄过来即可。
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
