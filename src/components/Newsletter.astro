<section class="newsletter" aria-labelledby="newsletter-title">
  <span class="eyebrow">Journal / 创作笔记</span>
  <h2 id="newsletter-title" class="serif">订阅和关注</h2>
  <p>订阅创作笔记，获取最新案例与艺术灵感。邮件服务配置由运营后台统一管理。</p>
  <p lang="en">Subscribe and follow studio notes, new references and quiet inspiration.</p>
  <form class="newsletter-form" data-newsletter-form>
    <label class="sr-only" for="newsletter-email">邮箱 / Email</label>
    <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="你的邮箱 / Your email" required />
    <button class="btn btn-secondary" type="submit">订阅 / Subscribe</button>
  </form>
  <p class="newsletter-status" data-newsletter-status aria-live="polite" role="status"></p>
</section>
<script>
  const newsletterForm = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const newsletterStatus = document.querySelector<HTMLElement>('[data-newsletter-status]');
  newsletterForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (newsletterStatus) newsletterStatus.textContent = '订阅意向已记录，我们会在邮件服务启用后发送内容。 / Your interest has been noted; updates will be sent through the studio mailing channel.';
    newsletterForm.reset();
  });
</script>
<style>
  .newsletter { border-top: 1px solid var(--line); margin-top: 64px; padding-top: 36px; max-width: 760px; }
  .newsletter h2 { font-size: 34px; font-weight: 500; line-height: 1.25; margin: 12px 0 10px; }
  .newsletter p { color: var(--ink-soft); max-width: 650px; margin: 6px 0; }
  .newsletter p[lang='en'] { font: 17px/1.5 var(--font-display-en), Georgia, serif; color: var(--ink); }
  .newsletter-form { display: flex; gap: 10px; align-items: stretch; margin-top: 20px; max-width: 620px; }
  .newsletter-form input { flex: 1; min-width: 0; min-height: 48px; border: 1px solid var(--line); border-radius: 0; background: var(--paper-light); color: var(--ink); padding: 12px 13px; }
  .newsletter-form input:focus { border-color: var(--cinnabar); }
  .newsletter-form .btn { min-width: 132px; }
  .newsletter-status { min-height: 1.8em; color: var(--cinnabar-deep) !important; font-size: 13px; margin-top: 12px !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 767px) {
    .newsletter { margin-top: 44px; padding-top: 28px; }
    .newsletter h2 { font-size: 28px; }
    .newsletter-form { display: grid; grid-template-columns: 1fr; }
    .newsletter-form input, .newsletter-form .btn { width: 100%; }
  }
</style>
