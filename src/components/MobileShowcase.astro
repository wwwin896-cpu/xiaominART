    .mshow-sheet-item .serif { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: var(--cinnabar); font-size: 17px; line-height: 1.1; background: rgba(192, 57, 43, .08); }
    .mshow-sheet-item small { color: var(--muted); font-size: 10.5px; }
  }

  /* 弹层 / 分类面板展开时锁住页面滚动 */
  :global(body.mshow-open) { overflow: hidden; }
</style>
