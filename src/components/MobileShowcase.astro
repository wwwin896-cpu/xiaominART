    .mshow-sheet-item { display: grid; justify-items: center; gap: 5px; padding: 12px 2px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--card, #fffdf7); color: var(--ink); font: inherit; font-size: 12px; text-align: center; transition: transform .15s ease; }
