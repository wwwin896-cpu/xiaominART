---
// ─────────────────────────────────────────────────────────────
// 移动端首屏商品流（2026-10-29）
//
// 解决的问题：首页首屏在手机上是一张「品牌海报」——三屏轮播文案 + 见山河 +
// 文字源流 + 见自己 + 见来处，要滑过四屏才第一次看到作品卡片。
// 手机访客是网购习惯：进来先看货，看不到就走。
//
// 形态（参照 /workspace/xiaominart-style-demo.html 那套浏览交互）：
//   · 分类 chip 条（横滑吸顶）→ 点开底部分类面板（场合 / 对象 / 看全部）
//   · 2 列商品卡：图 + 题字 + 品类签 + 价格，**右下角收藏心形**
//   · 点卡片 → 底部详情弹层（大图 / 价格 / 释义 / 规格 / 收藏 + 咨询）
//
// ⚠️ 桌面端完全不参与渲染：本组件根元素 `display: none`，
//    只在 `@media (max-width: 767px)` 里出现。桌面首页的顺序与样式一行没动。
//
// ⚠️ 收藏按钮**不能**用 `data-wishlist`：
//    GiftCard.astro / GiftProductDetail / ready-made 详情页三处脚本都用
//    `querySelectorAll('[data-wishlist]')` 全文档扫描，若本组件也用同一属性，
//    那些页面上会把本弹层里的按钮一并绑走（GiftCard 目前只在 /gifts/ 出现，
//    但一旦以后把它放进首页就会互相污染）。所以这里用 `data-ms-wish`，
//    收藏读写仍走 src/scripts/wishlist.ts 的唯一入口。
//
// 数据：giftProducts + zodiacWorks + readyMadeWorks 构建期烘焙，客户端只拿渲染好的 JSON。
// ─────────────────────────────────────────────────────────────
import { giftProducts, zodiacWorks, readyMadeWorks } from '../data/content';

type Tile = {
  id: string;
  kind: 'gift' | 'zodiac' | 'ready';
  href: string;
  image: string;
  alt: string;
  char: string;
  title: string;
  tag: string;
  /** 卡面右上角小签：场景/系列的短词（demo .tag 的语言） */
  tagShort: string;
  price: string;
  desc: string;
  specs: Array<[string, string]>;
  /** 分类归属：场合 chip / 对象 chip 的并集，用于筛选 */
  groups: string[];
};

const tiles: Tile[] = [];

// 2026-10-31 业主补充的两类「送给谁」：
//   · 送孩子 —— 生肖十二件里有鼠/兔/虎等孩童专用的勇气与陪伴意，且生肖线本就按
//     生日/开学送礼，故归入 child 组。
//   · 送外宾 —— 古文字（甲骨/石鼓/秦篆）是最直接的「中国文化原生符号」，
//     与企业/机构的涉外往来、节日问候重合，故归入 foreign-guests 组。
// 这两组在新增时是全空组（筛选后 0 件），必须在 tile 侧给出归属，
// 否则「分类面板里看得见、点进去是空页」——这正是本次要避免的体验断点。
// 生肖十二件 slug：鼠牛虎兔龙蛇马羊猴鸡狗猪（与 zodiacWorks 一一对应）。
const ZODIAC_TILE_IDS = new Set(['shu', 'niu', 'hu', 'tu', 'long', 'she', 'ma', 'yang', 'hou', 'ji', 'gou', 'zhu']);
// 外宾组用现有 6 件商品里「符号感最强、最不涉私人关系」的四件（slug 已与 giftProducts 核对）。
const FOREIGN_TILE_IDS = new Set(['quiet-entry-gift', 'cinnabar-note-gift', 'seasonal-letter-gift', 'ink-breath-teacher']);
// 校园庆典：赠予学校的题字类（德馨雅居=校训/书房气、「长乐」=校庆吉语）+ 师生互赠的节气礼。
const CAMPUS_TILE_IDS = new Set(['de-xin-ya-ju', 'chang-le', 'seasonal-letter-gift']);
// 活动手伴：小尺幅现货（案头/挂墙小品，单价 ¥399 起、可单件带走、24h 直发），
// 适合会议、雅集、开业活动的伴手礼——与「企业团建」的预算区间也对得上。
const KEEPSAKE_TILE_IDS = new Set(['qing-huan', 'mao-fei-jia-run', 'xiang-jian-yi-wu-shi', 'chang-le']);
/** 同一件商品可能同时属于多个人群组，统一在这里补齐 */
const extraGroups = (id: string, kind: string): string[] => {
  const out: string[] = [];
  if (kind === 'zodiac' && ZODIAC_TILE_IDS.has(id)) out.push('child');
  if (FOREIGN_TILE_IDS.has(id)) out.push('foreign-guests');
  if (CAMPUS_TILE_IDS.has(id)) out.push('campus');
  if (KEEPSAKE_TILE_IDS.has(id)) out.push('keepsake');
  return out;
};

// ① 礼品线（/gifts/…）：每件本身就是一条业务详情页
for (const p of giftProducts) {
  if (p.published === false) continue;
  tiles.push({
    id: p.slug,
    kind: 'gift',
    href: `/gifts/${p.slug}/`,
    image: p.image || '/assets/scenes/study-desk-scroll.jpg',
    alt: `${p.name}｜${p.sceneLabel}`,
    char: p.visual || '禮',
    title: p.name,
    tag: `${p.sceneLabel} · ${p.price}`,
    tagShort: p.sceneLabel,
    price: p.price,
    desc: p.meaning,
    specs: [
      ['适合谁', p.recipient],
      ['时间', p.dispatch],
      ['含', p.packaging],
    ],
    groups: ['all', 'gift', p.scene, ...extraGroups(p.slug, 'gift')],
  });
}

// ② 生肖线（/zodiac/ 聚合页内有 12 件全览与规格）
for (const z of zodiacWorks) {
  tiles.push({
    id: z.slug,
    kind: 'zodiac',
    href: `/zodiac/#${z.slug}`,
    image: z.image,
    alt: z.alt,
    char: z.char,
    title: z.name,
    tag: `生肖 · ${z.price}`,
    tagShort: '字游记',
    price: z.price,
    desc: z.story,
    specs: [
      ['吉语', z.blessing],
      ['形制', '外框 A4 竖幅 · 画芯 16×8 cm · 胡桃木框'],
      ['时间', '现货 24h 顺丰直发'],
    ],
    groups: ['all', 'zodiac', 'festival', 'birthday', ...extraGroups(z.slug, 'zodiac')],
  });
}

// ③ 现货线（已写完、可立即发货，每幅世间唯一）
for (const w of readyMadeWorks) {
  tiles.push({
    id: w.slug,
    kind: 'ready',
    href: `/gifts/ready-made/${w.slug}/`,
    image: w.image,
    alt: w.alt,
    char: w.title.slice(0, 1),
    title: w.title,
    tag: `现货 · ¥${w.price}`,
    tagShort: w.form === '挂墙' ? '可挂' : '案头',
    price: `¥${w.price}`,
    desc: w.note,
    specs: [
      ['出处', w.source ? `${w.source.char} · ${w.source.origin}` : '古文字有出处'],
      ['材质', w.material || '手写书法原作 · 实木装裱'],
      ['尺寸', w.size ? `外框 ${w.size.w} × ${w.size.h} cm · ${w.form}` : w.form],
    ],
    groups: ['all', 'ready', 'housewarming', 'opening', 'thanks', ...extraGroups(w.slug, 'ready')],
  });
}

// ── 分类 chip ──
// 「全部 / 现货」两个常驻 + 三个最高频的送礼场景。
// 完整场合与对象列表收进底部「分类」面板，避免首屏 chip 条变成横向垃圾场。
const quickChips = [
  { key: 'all', label: '全部' },
  { key: 'ready', label: '现货可发' },
  { key: 'housewarming', label: '乔迁' },
  { key: 'birthday', label: '生日' },
  { key: 'thanks', label: '谢师' },
];

// 2026-10-31 业主补充：「什么场合」+ 婚庆纪念 / 校园庆典 / 活动手伴。
// 三个都映射到 giftScenes 里已有的场景键（anniversary / opening+thanks / festival+keepsake），
// 走 getGiftsForScene 的同一条规则筛货，所以不会出现「点了分类是空页」——
// 只要该场景下有商品，这里就一定有货；真没货时 applyGroup 会给出「暂时没有现货」的兜底句。
const sceneGroups = [
  { key: 'housewarming', label: '乔迁之喜' },
  { key: 'opening', label: '开业贺礼' },
  { key: 'birthday', label: '生日心意' },
  { key: 'festival', label: '节日问候' },
  { key: 'thanks', label: '感谢恩师' },
  { key: 'anniversary', label: '婚庆纪念' },
  { key: 'campus', label: '校园庆典' },
  { key: 'keepsake', label: '活动手伴' },
];
const kindGroups = [
  { key: 'gift', label: '礼品套装', href: '/gifts/' },
  { key: 'zodiac', label: '十二生肖', href: '/zodiac/' },
  { key: 'ready', label: '现货小品', href: '/gifts/ready-made/' },
];
// 2026-10-31 业主补充：「送给谁」+ 送孩子 / 送外宾。
// 这两类暂未建独立落地页（/recipients/child/、/recipients/foreign-guests/ 不生成），
// 因此不能像其他六项那样做成 <a href>——点了会 404。
// 统一改成 data-ms-chip-link 的**筛选按钮**：落在同一套 applyGroup 上，
// 按 groups 里已有的场景键（生日/开学 → birthday；外事往来 → festival+opening）出货。
// 等这两类的内容页做好，只把 kind 换成 'link' + 补 href 即可。
const recipientGroups = [
  { key: 'parents', label: '送长辈', href: '/recipients/parents/' },
  { key: 'teachers', label: '送老师', href: '/recipients/teachers/' },
  { key: 'partner', label: '送伴侣', href: '/recipients/partner/' },
  { key: 'friends', label: '送朋友', href: '/recipients/friends/' },
  { key: 'clients', label: '送客户', href: '/recipients/clients/' },
  { key: 'team', label: '送员工', href: '/recipients/team/' },
  { key: 'child', label: '送孩子', href: '' },
  { key: 'foreign-guests', label: '送外宾', href: '' },
];

// 首屏只发前 8 件：再多就是让首屏变回一条长列表。
// 「看全部 30 件」按钮把其余的一并展开（不跳页，留在当前滚动位置）。
const FIRST_BATCH = 8;
const tilesJson = JSON.stringify(tiles);
---

<section class="mshow" aria-labelledby="mshow-title" data-ms>
  {/* ── 全景场景图（2026-10-31 业主：今季之选配图要用全景场景图）─────
      原来是「只有标题 + 说明」的纯文字头，手机上进这一屏完全没有画面。
      现在把一张宽幅实景（16:9 原图 1200×675）铺成通栏场景图：
        · 宽高比固定 16 / 9，宽度 100% + object-fit: cover →
          320 / 390 / 430 / 768(平板竖) 任意宽度都自动铺满，不拉伸不露边；
        · 用 <img> 而非 CSS background：CLS 有 width/height 兜住，
          lazy 生效，也走浏览器原生 picture 选图能力；
        · 图上压一层纸色渐变 + 标题字，避免「图文两张皮」。
      换图只改 sceneImage 一个常量。 */}
  <figure class="mshow-scene">
    <img
      src="/assets/scenes/four-seasons-cabinet.jpg"
      alt="客厅四时之景：书法小品与四季陈设的同框实拍"
      width="1200" height="675" loading="lazy" decoding="async"
    />
    <figcaption class="mshow-scene-cap">
      <span class="eyebrow">Seasonal / 今季</span>
      <strong class="serif">四时有序，一季一字</strong>
    </figcaption>
  </figure>

  <div class="mshow-head">
    <h2 id="mshow-title" class="serif">今季之选</h2>
    <p>点击卡片看详情 · 右下角可收藏</p>
  </div>

  <div class="mshow-chips" role="group" aria-label="按类型筛选">
    {quickChips.map((chip, i) => (
      <button
        class:list={['mshow-chip', { 'is-on': i === 0 }]}
        type="button"
        data-ms-chip={chip.key}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >{chip.label}</button>
    ))}
    <button class="mshow-chip mshow-chip--more" type="button" data-ms-more aria-haspopup="dialog" aria-controls="mshow-sheet">分类 ▾</button>
  </div>

  <div class="mshow-grid" data-ms-grid>
    {tiles.map((tile, i) => (
      <article
        class:list={['mshow-tile', { 'is-extra': i >= FIRST_BATCH }]}
        data-ms-tile={tile.id}
        data-ms-groups={tile.groups.join(' ')}
        hidden={i >= FIRST_BATCH ? true : undefined}
      >
        {/* 卡面 = demo .art 的大字艺术卡：纸底渐变 + 双线框 + 题字大字做主视觉；
            真实商品照片放进详情弹层的大图区（点卡片时看），美学与信息两不丢 */}
        <button class="mshow-tile-main" type="button" data-ms-open={tile.id}>
          <span class="mshow-tile-fig">
            <span class="mshow-tile-char serif" aria-hidden="true">{tile.char}</span>
            <span class="mshow-tag" aria-hidden="true">{tile.tagShort}</span>
          </span>
          <span class="mshow-tile-copy">
            <strong class="serif">{tile.title}</strong>
            <small>{tile.price}</small>
          </span>
        </button>
        <button class="mshow-fav" type="button" data-ms-wish={tile.id} aria-pressed="false" aria-label={`收藏 ${tile.title}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.6 4.9 13.7A4.6 4.6 0 0 1 12 7.4a4.6 4.6 0 0 1 7.1 6.3Z" /></svg>
        </button>
      </article>
    ))}
  </div>

  <button class="mshow-all" type="button" data-ms-expand>看全部 {tiles.length} 件 ▾</button>

  <a class="mshow-guide" href="/gift-guide/">不知道送什么？两分钟选礼指南 →</a>
</section>

{/* ── 底部详情弹层 ── */}
<div class="mshow-detail" id="mshow-detail" role="dialog" aria-modal="true" aria-labelledby="mshow-detail-title" hidden>
  <div class="mshow-detail-panel">
    <span class="mshow-grab" aria-hidden="true"></span>
    <button class="mshow-close" type="button" data-ms-close aria-label="关闭">×</button>
    <div class="mshow-detail-fig" data-ms-detail-fig></div>
    <div class="mshow-detail-body">
      <span class="eyebrow" data-ms-detail-tag></span>
      <h3 id="mshow-detail-title" class="serif" data-ms-detail-title></h3>
      <strong class="mshow-price" data-ms-detail-price></strong>
      <p data-ms-detail-desc></p>
      <dl class="mshow-specs" data-ms-detail-specs></dl>
      <div class="mshow-detail-actions">
        <button class="btn btn-primary" type="button" data-dm-open>就这件，问问看</button>
        <button class="btn btn-secondary mshow-detail-fav" type="button" data-ms-detail-fav aria-pressed="false">♡ 收藏</button>
      </div>
      <a class="mshow-detail-link" data-ms-detail-link href="/gifts/">看完整介绍 →</a>
    </div>
  </div>
</div>

{/* ── 分类面板 ── */}
<div class="mshow-sheet" id="mshow-sheet" role="dialog" aria-modal="true" aria-labelledby="mshow-sheet-title" hidden>
  <div class="mshow-sheet-panel">
    <span class="mshow-grab" aria-hidden="true"></span>
    <div class="mshow-sheet-head">
      <h3 id="mshow-sheet-title" class="serif">按什么找？</h3>
      <button class="mshow-close" type="button" data-ms-close aria-label="关闭">×</button>
    </div>
    <div class="mshow-sheet-body">
      <p class="mshow-sheet-label">看哪一类</p>
      <div class="mshow-sheet-grid">
        <a href="/gifts/" class="mshow-sheet-item"><span class="serif">礼</span>全部好礼<small>30 件</small></a>
        {kindGroups.map((g) => (
          <a href={g.href} class="mshow-sheet-item"><span class="serif">字</span>{g.label}<small>点开看</small></a>
        ))}
      </div>
      <p class="mshow-sheet-label">什么场合</p>
      <div class="mshow-sheet-grid">
        {sceneGroups.map((g) => (
          <button type="button" class="mshow-sheet-item" data-ms-chip-link={g.key}><span class="serif">礼</span>{g.label}<small>{tiles.filter((t) => t.groups.includes(g.key)).length} 件</small></button>
        ))}
      </div>
      <p class="mshow-sheet-label">送给谁</p>
      <div class="mshow-sheet-grid">
        {recipientGroups.map((g) => (
          g.href
            ? <a href={g.href} class="mshow-sheet-item"><span class="serif">人</span>{g.label}<small>点开看</small></a>
            : <button type="button" class="mshow-sheet-item" data-ms-chip-link={g.key}><span class="serif">人</span>{g.label}<small>{tiles.filter((t) => t.groups.includes(g.key)).length} 件</small></button>
        ))}
      </div>
    </div>
  </div>
</div>

<script type="application/json" data-ms-data set:html={tilesJson}></script>

<script>
  import { isWishlisted, toggleWishlist, onWishlistChange } from '../scripts/wishlist';

  type Tile = {
    id: string;
    kind: string;
    href: string;
    image: string;
    alt: string;
    char: string;
    title: string;
    tag: string;
    price: string;
    desc: string;
    specs: Array<[string, string]>;
    groups: string[];
  };

  let tiles: Tile[] = [];
  try {
    tiles = JSON.parse(document.querySelector('[data-ms-data]')?.textContent || '[]');
  } catch {
    tiles = [];
  }
  const byId = new Map(tiles.map((t) => [t.id, t]));

  const root = document.querySelector<HTMLElement>('[data-ms]');
  const grid = document.querySelector<HTMLElement>('[data-ms-grid]');
  const detail = document.querySelector<HTMLElement>('#mshow-detail');
  const sheet = document.querySelector<HTMLElement>('#mshow-sheet');

  // ── 收藏状态同步 ──
  // 一张卡一个按钮 + 弹层里那一个：全部按 slug 重算，避免「卡片点了、弹层没变」。
  const syncWish = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-ms-wish]').forEach((btn) => {
      const saved = isWishlisted(btn.dataset.msWish || '');
      btn.classList.toggle('is-saved', saved);
      btn.setAttribute('aria-pressed', String(saved));
      btn.setAttribute('aria-label', `${saved ? '取消收藏' : '收藏'} ${byId.get(btn.dataset.msWish || '')?.title ?? ''}`);
    });
    const dfav = document.querySelector<HTMLButtonElement>('[data-ms-detail-fav]');
    if (dfav) {
      const saved = isWishlisted(currentId);
      dfav.classList.toggle('is-saved', saved);
      dfav.setAttribute('aria-pressed', String(saved));
      dfav.textContent = saved ? '♥ 已收藏' : '♡ 收藏';
    }
  };
  onWishlistChange(syncWish);

  document.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-ms-wish]');
    if (!btn) return;
    // 卡片按钮在外层按钮内部会触发兄弟按钮的冒泡，这里必须先掐掉
    event.preventDefault();
    event.stopPropagation();
    toggleWishlist(btn.dataset.msWish || '');
    syncWish();
  });

  // ── 详情弹层 ──
  let currentId = '';
  let lastFocus: HTMLElement | null = null;

  const openDetail = (id: string, trigger?: HTMLElement | null) => {
    const tile = byId.get(id);
    if (!tile || !detail) return;
    currentId = id;
    lastFocus = trigger || (document.activeElement as HTMLElement | null);

    const fig = detail.querySelector<HTMLElement>('[data-ms-detail-fig]');
    if (fig) {
      fig.textContent = '';
      const img = document.createElement('img');
      img.src = tile.image;
      img.alt = tile.alt;
      img.decoding = 'async';
      fig.append(img);
    }
    const set = (sel: string, text: string) => {
      const el = detail.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };
    set('[data-ms-detail-tag]', tile.tag);
    set('[data-ms-detail-title]', tile.title);
    set('[data-ms-detail-price]', tile.price);
    set('[data-ms-detail-desc]', tile.desc);

    const specs = detail.querySelector<HTMLElement>('[data-ms-detail-specs]');
    if (specs) {
      specs.textContent = '';
      tile.specs.forEach(([k, v]) => {
        if (!v) return;
        const row = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.textContent = v;
        row.append(dt, dd);
        specs.append(row);
      });
    }
    const link = detail.querySelector<HTMLAnchorElement>('[data-ms-detail-link]');
    if (link) link.href = tile.href;

    syncWish();
    detail.hidden = false;
    document.body.classList.add('mshow-open');
    detail.querySelector<HTMLElement>('[data-ms-close]')?.focus();
  };

  const closeOverlays = () => {
    let closed = false;
    if (detail && !detail.hidden) { detail.hidden = true; closed = true; }
    if (sheet && !sheet.hidden) { sheet.hidden = true; closed = true; }
    if (closed) {
      document.body.classList.remove('mshow-open');
      lastFocus?.focus?.();
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('[data-ms-close]')) { closeOverlays(); return; }
    if (target === detail || target === sheet) { closeOverlays(); return; }
    const opener = target.closest<HTMLElement>('[data-ms-open]');
    if (opener) { openDetail(opener.dataset.msOpen || '', opener); return; }
    if (target.closest('[data-ms-more]')) {
      if (sheet) {
        lastFocus = document.activeElement as HTMLElement | null;
        sheet.hidden = false;
        document.body.classList.add('mshow-open');
        sheet.querySelector<HTMLElement>('[data-ms-close]')?.focus();
      }
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeOverlays();
  });

  // 弹层里的收藏按钮：跟着当前打开的那一件走
  document.querySelector('[data-ms-detail-fav]')?.addEventListener('click', () => {
    if (!currentId) return;
    toggleWishlist(currentId);
    syncWish();
  });

  // ── 筛选 chip ──
  const applyGroup = (key: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-ms-chip]').forEach((chip) => {
      const on = chip.dataset.msChip === key;
      chip.classList.toggle('is-on', on);
      chip.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    let shown = 0;
    grid?.querySelectorAll<HTMLElement>('[data-ms-tile]').forEach((tile) => {
      const groups = (tile.dataset.msGroups || '').split(' ');
      const match = key === '' || groups.includes(key);
      // 筛选后不再遵守「首屏只 8 件」的折叠：用户明确要这一类，就把这一类的全给出来
      tile.hidden = !match;
      if (match) {
        tile.classList.remove('is-extra');
        shown += 1;
      }
    });
    // 筛选结果为空时给一句话，避免整片空白看起来像加载失败
    let empty = grid?.parentElement?.querySelector<HTMLElement>('[data-ms-empty]');
    if (shown === 0) {
      if (!empty && grid?.parentElement) {
        empty = document.createElement('p');
        empty.className = 'mshow-empty';
        empty.dataset.msEmpty = '';
        empty.textContent = '这一类暂时没有现货，可以先看看别类，或者直接问我们要什么字。';
        grid.after(empty);
      }
    } else {
      empty?.remove();
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-ms-chip]').forEach((chip) => {
    chip.addEventListener('click', () => {
      applyGroup(chip.dataset.msChip || '');
      // chip 条在页面顶部附近，筛选后回到网格顶部，避免用户以为「什么都没发生」
      const top = root?.getBoundingClientRect().top ?? 0;
      if (top < 0) root?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  });

  // 分类面板里的「场合」不是筛选 chip，是跳到网格并筛选
  document.querySelectorAll<HTMLButtonElement>('[data-ms-chip-link]').forEach((item) => {
    item.addEventListener('click', () => {
      const key = item.dataset.msChipLink || '';
      applyGroup(key);
      if (sheet) sheet.hidden = true;
      document.body.classList.remove('mshow-open');
      root?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
  });

  // ── 展开全部 ──
  document.querySelector('[data-ms-expand]')?.addEventListener('click', (event) => {
    const btn = event.currentTarget as HTMLButtonElement;
    grid?.querySelectorAll<HTMLElement>('[data-ms-tile]').forEach((tile) => {
      tile.hidden = false;
      tile.classList.remove('is-extra');
    });
    btn.hidden = true;
  });

  syncWish();
</script>

<style>
  /* 桌面端：整块不参与布局、不占位、不加载图片（图片是 lazy，隐藏后不会请求） */
  .mshow, .mshow-detail, .mshow-sheet { display: none; }

  @media (max-width: 767px) {
    .mshow { display: block; padding: 0 0 34px; border-top: 1px solid var(--line-soft); }

    /* ── 全景场景图（2026-10-31）─────────────────────────────────
       16 / 9 通栏：宽度自适应任意机型，高度按比例算，不裁切主体。
       aspect-ratio 让容器先占位（CLS=0），img 再 cover 填满。
       底部压一层纸色渐变，让下一段「今季之选」标题自然浮上来。 */
    .mshow-scene { position: relative; margin: 0 0 18px; aspect-ratio: 16 / 9; overflow: hidden; background: var(--paper-deep); }
    .mshow-scene img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 46%; }
    .mshow-scene::after { content: ''; position: absolute; inset: auto 0 0; height: 58%; background: linear-gradient(180deg, transparent, rgba(28, 22, 14, .62)); pointer-events: none; }
    .mshow-scene-cap { position: absolute; left: 16px; right: 16px; bottom: 14px; z-index: 1; display: flex; flex-direction: column; gap: 4px; }
    .mshow-scene-cap .eyebrow { color: rgba(255, 255, 255, .82); font-size: 10px; letter-spacing: .3em; }
    .mshow-scene-cap strong { color: #fff; font-size: 19px; font-weight: 500; letter-spacing: .16em; text-shadow: 0 2px 10px rgba(0, 0, 0, .32); }
    /* 超窄屏（iPhone SE / 320px）：标题略收，避免压字 */
    @media (max-width: 359px) { .mshow-scene-cap strong { font-size: 16.5px; letter-spacing: .1em; } }
    /* demo .sec-title：serif 大字距标题 + 右侧小字说明，同行 baseline */
    .mshow-head { display: flex; align-items: baseline; gap: 10px; padding: 0 16px 16px; }
    .mshow-head h2 { font-size: 21px; font-weight: 500; letter-spacing: .34em; margin: 0; white-space: nowrap; }
    .mshow-head p { margin: 0; color: var(--ink-soft); font-size: 11.5px; letter-spacing: .02em; }

    /* chip 条：胶囊化（demo 语言：圆角 999、选中朱砂渐变） */
    .mshow-chips { display: flex; gap: 8px; overflow-x: auto; padding: 0 16px 14px; scrollbar-width: none; }
    .mshow-chips::-webkit-scrollbar { display: none; }
    .mshow-chip { flex: 0 0 auto; min-height: 34px; padding: 6px 15px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255, 255, 255, .6); color: var(--ink-soft); font: inherit; font-size: 13px; letter-spacing: .04em; white-space: nowrap; transition: background-color .2s, color .2s, border-color .2s; }
    .mshow-chip.is-on { background: linear-gradient(135deg, var(--cinnabar), var(--cinnabar-deep)); border-color: transparent; color: #fff; box-shadow: 0 2px 8px rgba(160, 44, 32, .35); }
    .mshow-chip--more { color: var(--cinnabar); border-color: rgba(192, 57, 43, .4); background: rgba(192, 57, 43, .06); }

    /* 2 列卡：圆角卡 + 阴影（demo .card：radius 14、白卡、浮起阴影） */
    .mshow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding: 0 16px; }
    .mshow-tile { position: relative; background: var(--card, #fffdf7); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 2px 8px rgba(60, 50, 30, .08); overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
    .mshow-tile:active { transform: scale(.98); }
    .mshow-tile[hidden] { display: none; }
    .mshow-tile-main { display: block; width: 100%; padding: 0; border: 0; background: transparent; text-align: left; font: inherit; color: inherit; }
    /* demo .art：纸底渐变 + 内框线，题字大字是卡面绝对主角 */
    .mshow-tile-fig { position: relative; display: grid; place-items: center; aspect-ratio: 1 / 1; overflow: hidden; background: linear-gradient(160deg, #fbf8f0, #f1e9d6); border-bottom: 1px solid rgba(120, 100, 60, .15); }
    .mshow-tile-fig::after { content: ''; position: absolute; inset: 7px; border: 1px solid rgba(120, 100, 60, .18); border-radius: 8px; pointer-events: none; }
    .mshow-tile-char { font-size: clamp(58px, 18vw, 84px); color: var(--ink); text-shadow: 0 2px 6px rgba(43, 43, 43, .12); letter-spacing: .04em; }
    .mshow-tile-copy { display: block; padding: 10px 12px 12px; }
    .mshow-tile-copy strong { display: block; font-family: var(--font-display-zh); font-size: 15px; font-weight: 500; letter-spacing: .06em; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mshow-tile-copy small { display: block; margin-top: 4px; color: var(--cinnabar); font: 600 13px var(--font-display-en), Georgia, serif; letter-spacing: .02em; }

    /* demo .tag：右上角朱砂细签 */
    .mshow-tag { position: absolute; top: 10px; right: 10px; z-index: 3; padding: 3px 10px; border: 1px solid rgba(165, 72, 59, .4); border-radius: 999px; background: rgba(165, 72, 59, .06); color: var(--cinnabar); font-size: 10.5px; letter-spacing: .18em; }

    /* 右下角收藏：毛玻璃圆钮（demo .fav），38px 命中区 */
    .mshow-fav { position: absolute; right: 8px; bottom: 56px; z-index: 2; width: 36px; height: 36px; display: grid; place-items: center; padding: 0; border: 1px solid rgba(255, 255, 255, .7); border-radius: 50%; background: rgba(255, 255, 255, .82); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); box-shadow: 0 2px 8px rgba(43, 41, 36, .16); }
    .mshow-fav svg { width: 19px; height: 19px; display: block; }
    .mshow-fav svg path { fill: none; stroke: var(--ink-soft); stroke-width: 1.6; stroke-linejoin: round; }
    .mshow-fav.is-saved { background: rgba(192, 57, 43, .08); border-color: rgba(192, 57, 43, .5); }
    .mshow-fav.is-saved svg path { fill: var(--cinnabar); stroke: var(--cinnabar); }
    .mshow-fav:active { transform: scale(.86); }

    .mshow-all { display: block; width: calc(100% - 32px); margin: 18px 16px 0; min-height: 46px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255, 255, 255, .6); color: var(--ink); font: inherit; font-size: 14px; letter-spacing: .06em; }
    .mshow-all[hidden] { display: none; }
    .mshow-guide { display: block; margin: 16px 16px 0; color: var(--cinnabar); font-size: 13px; text-align: center; }
    .mshow-empty { margin: 0 16px; padding: 26px 0; color: var(--ink-soft); font-size: 13px; line-height: 1.9; text-align: center; }

    /* ── 底部弹层通用：20px 顶圆角 + 强阴影（demo .dl-panel） ── */
    .mshow-detail, .mshow-sheet { display: block; position: fixed; inset: 0; z-index: 15; background: rgba(28, 24, 16, .55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .mshow-detail[hidden], .mshow-sheet[hidden] { display: none; }
    .mshow-detail-panel, .mshow-sheet-panel { position: absolute; left: 0; right: 0; bottom: 0; max-height: 88vh; overflow-y: auto; background: var(--paper); border-top: 1px solid var(--line); border-radius: 20px 20px 0 0; box-shadow: 0 -10px 60px rgba(0, 0, 0, .3); padding-bottom: calc(20px + env(safe-area-inset-bottom)); animation: mshow-up .3s cubic-bezier(.32, .72, .35, 1); -webkit-overflow-scrolling: touch; }
    @keyframes mshow-up { from { transform: translateY(40px); opacity: .6; } to { transform: none; opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .mshow-detail-panel, .mshow-sheet-panel { animation: none; } }
    .mshow-grab { display: block; width: 40px; height: 4px; margin: 10px auto 0; border-radius: 4px; background: var(--line); }
    .mshow-close { position: absolute; right: 12px; top: 12px; width: 34px; height: 34px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: var(--paper-deep); color: var(--ink-soft); font-size: 16px; line-height: 1; }

    /* ── 详情弹层 ── */
    .mshow-detail-fig { margin-top: 6px; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-deep); border-radius: 0; }
    .mshow-detail-fig img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .mshow-detail-body { padding: 18px 20px 0; }
    .mshow-detail-body h3 { font-family: var(--font-display-zh); font-size: 21px; font-weight: 500; letter-spacing: .06em; margin: 8px 0 6px; }
    .mshow-price { display: block; font: 700 20px var(--font-display-en), Georgia, serif; color: var(--cinnabar); margin-bottom: 12px; }
    .mshow-detail-body p { margin: 0 0 14px; color: var(--ink-soft); font-size: 14px; line-height: 1.85; }
