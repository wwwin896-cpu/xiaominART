    .mshow-detail-actions .btn { min-height: 48px; font-size: 14px; letter-spacing: .06em; padding: 10px 12px; }
    .mshow-detail-fav.is-saved { border-color: rgba(192, 57, 43, .5); color: var(--cinnabar); background: rgba(192, 57, 43, .06); }
