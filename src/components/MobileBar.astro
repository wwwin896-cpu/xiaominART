---
// ─────────────────────────────────────────────────────────────
// 移动端底部导航（2026-10-30 v5.0）：四 Tab + 悬浮咨询钮
//
// 底栏 4 Tab（v5.0 规范定版）：首页 / 书法 / 非遗 / 我的 —— 两大业务直接升为 Tab。
// 原「收藏」入口移入「我的」页；「咨询」从底栏格改为右下角悬浮圆钮
// （.mobile-ask-fab，转化入口不让位），复用原有 openDm 三路分流逻辑不动。
//
// 咨询 = **实时对话入口**（2026-10-18 二次改造）。访客不填表、不加好友，点开即可说话：
//   · 微信内 → 跳「微信客服」会话（企业微信，业主回复后访客微信有消息提醒）
//   · 其他浏览器 → 拉起 Knocket 网页聊天面板（不离开站点）
//   · 两者未配置 → 回退留言弹层（/api/lead quick_message → 云数据库 + 推飞书群）
// 通道凭据在 src/data/site.ts 的 chatConfig，填值即生效，无需改此处代码。
//
// ⚠️ 飞书机器人 webhook 只能被程序 POST，**不能**做成访客可点的链接
//    （浏览器打开只会看到错误页），所以通知侧始终走服务端转发。
//
// 微信直联弹层保留：页内 [data-wechat-open] 触发点仍唤起它。
// 桌面端用 SiteHeader 的 .header-tools（心愿单 + 搜索），与移动底栏不可互换。
//
// 相关样式在 Layout.astro 的 <style> 中（.mobile-tabbar / .mobile-ask-fab / .dm-sheet / .wechat-sheet）。
// ─────────────────────────────────────────────────────────────
import { siteContact } from '../data/site';
---

<nav class="mobile-tabbar" aria-label="移动端主导航">
  <a href="/" aria-label="首页"><span class="tab-ico" aria-hidden="true">⌂</span><span class="tab-zh">首页</span></a>
  <a href="/gifts/" aria-label="书法小品与礼品"><span class="tab-ico serif" aria-hidden="true">墨</span><span class="tab-zh">书法</span></a>
  <a href="/intangible/" aria-label="南京面塑非遗"><span class="tab-ico serif" aria-hidden="true">承</span><span class="tab-zh">非遗</span></a>
  <a href="/me/" aria-label="我的收藏与服务"><span class="tab-ico" aria-hidden="true">♡</span><span class="tab-zh">我的</span></a>
</nav>

{/* 悬浮咨询钮：右下角常驻（v5.0：咨询从底栏格让位给四 Tab，但不消失） */}
<button class="mobile-ask-fab" type="button" data-dm-open aria-controls="dm-sheet" aria-expanded="false" aria-label="咨询工作室"><span aria-hidden="true">✉</span></button>

<div class="dm-sheet" id="dm-sheet" role="dialog" aria-modal="true" aria-labelledby="dm-sheet-title" hidden>
  <div class="dm-sheet-card">
    <button class="dm-sheet-close" type="button" aria-label="关闭">×</button>
    <span class="eyebrow">Ask / 咨询</span>
    <h2 id="dm-sheet-title" class="serif">想说什么，写在这里。</h2>
    <p class="dm-sheet-hint">留言会直接进我们的飞书，看到就回。</p>
    <form class="dm-form" data-dm-form novalidate>
      <label class="sr-only" for="dm-contact">微信或手机号</label>
      <input id="dm-contact" name="contact" type="text" inputmode="text" autocomplete="off" placeholder="微信 / 手机号（方便回复你）" required />
      <label class="sr-only" for="dm-message">留言内容</label>
      <textarea id="dm-message" name="message" rows="3" placeholder="想问什么，或想写什么字"></textarea>
      <input class="dm-hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-primary" type="submit">发送给工作室</button>
      <p class="dm-status" data-dm-status aria-live="polite" role="status"></p>
    </form>
  </div>
</div>

<div class="wechat-sheet" id="wechat-sheet" role="dialog" aria-modal="true" aria-labelledby="wechat-sheet-title" hidden>
  <div class="wechat-sheet-card">
    <button class="wechat-sheet-close" type="button" aria-label="关闭">×</button>
    <span class="eyebrow">WeChat / 微信直联</span>
    <h2 id="wechat-sheet-title" class="serif">想快点聊上，加微信最快。</h2>
    <a class="wechat-sheet-qr" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img src={siteContact.wechatQr} width="176" height="176" alt="小民艺术微信二维码" loading="lazy" /></a>
    <p class="wechat-sheet-hint">长按上方二维码识别添加，备注一句来意即可。</p>
    {siteContact.wechatId ? <div class="wechat-sheet-id"><code data-wechat-id>{siteContact.wechatId}</code><button class="btn btn-secondary btn-sm" type="button" data-copy-wechat>复制微信号</button></div> : null}
    <p class="wechat-sheet-note">不方便加微信也可以<a href="/custom-commission/">提交定制咨询</a>，留下联系方式，我们主动找你。</p>
  </div>
</div>

<script>
  import { submitLead, isHoneypotFilled, trackEvent } from '../scripts/cloud-forms';
  import { chatConfig } from '../data/site';

  // ─────────────────────────────────────────────────────────────
  // 「咨询」三路分流（2026-10-18 业主选定「两个都要」）
  //
  //   ① 微信内 + 配了微信客服链接 → 原生跳转进客服会话（无需加好友）
  //   ② 配了 Knocket → 拉起网页聊天面板（不离开站点）
  //   ③ 都没配 / 拉不起来 → 回退留言弹层（写库 + 推飞书群）
  //
  // 分流的唯一目的是「让访客少走一步」：能直接说话就绝不让他填表。
  // 留言弹层保留为最后兜底，任何时候都不留死入口。
  // ─────────────────────────────────────────────────────────────

  // 微信内置浏览器（含企业微信）。桌面版微信同样命中，跳客服链接也可用。
  const isWeChat = () => /MicroMessenger/i.test(navigator.userAgent);

  const sheet = () => document.querySelector<HTMLElement>('#dm-sheet');
  const trigger = () => document.querySelector<HTMLButtonElement>('.mobile-ask-fab');

  /**
   * 点击反馈。底栏「咨询」原来的问题是：SDK 没加载出来时，
   * 要等 1.8 秒轮询超时才回退，用户感受是「点了没反应」。
   * 所以点击瞬间就把文字换成「连接中」，让动作立刻有回执。
   */
  function setBarLabel(text: string) {
    // v5.0 后咨询钮是圆形 FAB，无文字位：连接中给旋转/降透明反馈
    const fab = document.querySelector<HTMLElement>('.mobile-ask-fab');
    if (!fab) return;
    fab.classList.toggle('connecting', text !== '咨询');
  }

  /**
   * 拉起 Knocket 聊天面板。
   *
   * ⚠️ Knocket SDK 是 async 加载，且 `contactWidget.showChat` 在初始化完成前
   *    是**空函数占位**（调用无报错、也无反应）—— 典型的静默失效。
   *    因此这里做两件事：先等对象出现（最多 ~1.8s），出现后再补两次调用
   *    （showChat 幂等，重复调用只是把面板置为打开态，无副作用）。
   */
  function openWebChat(path: string): boolean {
    const widget = () => (window as unknown as { contactWidget?: { showChat?: () => void } }).contactWidget;

    const fire = () => {
      try { widget()?.showChat?.(); } catch { /* 未就绪：忽略，等下一次补调 */ }
    };

    setBarLabel('连接中');

    if (widget()) {
      trackEvent('dm_open', { path, channel: 'web_chat' });
      fire();
      window.setTimeout(fire, 500);
      window.setTimeout(fire, 1400);
      window.setTimeout(() => setBarLabel('咨询'), 1600);
      return true;
    }

    // SDK 还在下载：轮询等待，超时则回退留言弹层（不留空点击）
    let tries = 0;
    trackEvent('dm_open', { path, channel: 'web_chat_loading' });
    const wait = () => {
      tries += 1;
      if (widget()) {
        fire();
        window.setTimeout(fire, 500);
        window.setTimeout(() => setBarLabel('咨询'), 1600);
        return;
      }
      if (tries < 12) { window.setTimeout(wait, 150); return; }
      setBarLabel('咨询');
      openFallback(path, 'web_chat_timeout');
    };
    wait();
    return true;
  }

  /** 兜底：留言弹层（原行为） */
  function openFallback(path: string, channel = 'form') {
    const el = sheet();
    if (!el) return;
    el.hidden = false;
    trigger()?.setAttribute('aria-expanded', 'true');
    trackEvent('dm_open', { path, channel });
    el.querySelector<HTMLInputElement>('#dm-contact')?.focus();
  }

  function openDm() {
    const path = window.location.pathname;

    // ① 微信内 → 微信客服会话页（业主回复后访客微信有消息提醒）
    if (chatConfig.wechatKfUrl && isWeChat()) {
      trackEvent('dm_open', { path, channel: 'wechat_kf' });
      window.location.href = chatConfig.wechatKfUrl;
      return;
    }

    // ② 网页聊天
    if (chatConfig.knocketIdentifier && openWebChat(path)) return;

    // ③ 兜底
    openFallback(path);
  }

  function closeDm() {
    const el = sheet();
    if (!el) return;
    el.hidden = true;
    trigger()?.setAttribute('aria-expanded', 'false');
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('[data-dm-open]')) { event.preventDefault(); openDm(); return; }
    if (target.closest('.dm-sheet-close')) { closeDm(); return; }
    if (target === sheet()) { closeDm(); }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDm();
  });

  document.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement | null;
    if (!form || !form.matches('[data-dm-form]')) return;
    event.preventDefault();
    if (isHoneypotFilled(form)) return; // 机器人静默丢弃

    const status = form.querySelector<HTMLElement>('[data-dm-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const contact = String(new FormData(form).get('contact') || '').trim();
    const message = String(new FormData(form).get('message') || '').trim();

    if (!contact) {
      if (status) status.textContent = '留个微信或手机号，我们才好回你。';
      form.querySelector<HTMLInputElement>('#dm-contact')?.focus();
      return;
    }
    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '正在发送…';

    const result = await submitLead('quick_message', '移动端咨询', contact, {
      message: message || '（未填写内容，仅留了联系方式）',
      source: `mobile_bar:${window.location.pathname}`,
    });

    if (submitBtn) submitBtn.disabled = false;
    if (result.ok) {
      if (status) status.textContent = '已发出，我们会尽快回你。';
      trackEvent('dm_submit', { status: 'success', path: window.location.pathname });
      form.reset();
      window.setTimeout(closeDm, 1400);
    } else {
      if (status) status.textContent = '没发出去，稍后重试；也可以直接加微信。';
      trackEvent('dm_submit', { status: 'error', path: window.location.pathname });
    }
  });
</script>
