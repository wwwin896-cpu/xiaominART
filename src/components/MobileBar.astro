---
// ─────────────────────────────────────────────────────────────
// 移动端底部导航栏 + 私信弹层 + 微信直联弹层
// （2026-10-12 从 Layout.astro 抽出；2026-10-18 加私信弹层、底栏精简为 3 格）
//
// 底栏 3 格（2026-10-18 业主指示）：收藏（心愿单）/ 私信 / 分享。
//
// 私信 = 弹层留言，提交后经 /api/lead（formType: quick_message）落到云数据库，
// 并由服务端推送到飞书群 —— 业主在飞书直接看到，访客不需要跳转到任何技术页面。
// ⚠️ 飞书机器人 webhook 只能被程序 POST，**不能**做成访客可点的链接
//    （浏览器打开只会看到错误页），所以这里用弹层 + 服务端转发，而不是外链。
//
// 微信直联弹层保留：页内 [data-wechat-open] 触发点仍唤起它，只是底栏不再有入口。
// 注意：这一组按钮是移动端唯一的工具入口 —— 桌面端用的是
// SiteHeader 的 .header-tools（心愿单 + 搜索），两者不可互换。
//
// 相关样式在 Layout.astro 的 <style> 中（.mobile-shopping-bar / .wechat-sheet / .dm-sheet），
// 因底栏需与页脚 padding、Cookie 横幅高度在同一媒体查询里协同。
// ─────────────────────────────────────────────────────────────
import { siteContact } from '../data/site';
---

<nav class="mobile-shopping-bar" aria-label="移动端底部导航"><button class="wishlist-bar" type="button" data-wishlist-open aria-label="打开收藏夹"><span class="bar-zh">收藏</span><small lang="en">Saved <span data-wishlist-count></span></small></button><button class="dm-bar" type="button" data-dm-open aria-controls="dm-sheet" aria-expanded="false" aria-label="私信留言"><span class="bar-zh">私信</span><small lang="en">Message</small></button><button class="bar-share" type="button" data-share-button data-event="share_click" aria-label="分享本页给微信好友或朋友圈"><span class="bar-zh">分享</span><small lang="en">Share</small></button></nav>

<div class="dm-sheet" id="dm-sheet" role="dialog" aria-modal="true" aria-labelledby="dm-sheet-title" hidden>
  <div class="dm-sheet-card">
    <button class="dm-sheet-close" type="button" aria-label="关闭">×</button>
    <span class="eyebrow">Message / 私信</span>
    <h2 id="dm-sheet-title" class="serif">想说什么，写在这里。</h2>
    <p class="dm-sheet-hint">留言会直接进我们的飞书，看到就回。</p>
    <form class="dm-form" data-dm-form novalidate>
      <label class="sr-only" for="dm-contact">微信或手机号</label>
      <input id="dm-contact" name="contact" type="text" inputmode="text" autocomplete="off" placeholder="微信 / 手机号（方便回复你）" required />
      <label class="sr-only" for="dm-message">留言内容</label>
      <textarea id="dm-message" name="message" rows="3" placeholder="想问什么，或想写什么字"></textarea>
      <input class="dm-hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="btn btn-primary" type="submit">发送给工作室</button>
      <p class="dm-status" data-dm-status aria-live="polite" role="status"></p>
    </form>
  </div>
</div>

<div class="wechat-sheet" id="wechat-sheet" role="dialog" aria-modal="true" aria-labelledby="wechat-sheet-title" hidden>
  <div class="wechat-sheet-card">
    <button class="wechat-sheet-close" type="button" aria-label="关闭">×</button>
    <span class="eyebrow">WeChat / 微信直联</span>
    <h2 id="wechat-sheet-title" class="serif">想快点聊上，加微信最快。</h2>
    <a class="wechat-sheet-qr" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img src={siteContact.wechatQr} width="176" height="176" alt="小民艺术微信二维码" loading="lazy" /></a>
    <p class="wechat-sheet-hint">长按上方二维码识别添加，备注一句来意即可。</p>
    {siteContact.wechatId ? <div class="wechat-sheet-id"><code data-wechat-id>{siteContact.wechatId}</code><button class="btn btn-secondary btn-sm" type="button" data-copy-wechat>复制微信号</button></div> : null}
    <p class="wechat-sheet-note">不方便加微信也可以<a href="/custom-commission/">提交定制咨询</a>，留下联系方式，我们主动找你。</p>
  </div>
</div>

<script>
  import { submitLead, isHoneypotFilled, trackEvent } from '../scripts/cloud-forms';

  // 事件委托到 document：底栏与弹层由组件运行时插入，直接绑定会静默失效
  const sheet = () => document.querySelector<HTMLElement>('#dm-sheet');
  const trigger = () => document.querySelector<HTMLButtonElement>('.dm-bar');

  function openDm() {
    const el = sheet();
    if (!el) return;
    el.hidden = false;
    trigger()?.setAttribute('aria-expanded', 'true');
    trackEvent('dm_open', { path: window.location.pathname });
    el.querySelector<HTMLInputElement>('#dm-contact')?.focus();
  }

  function closeDm() {
    const el = sheet();
    if (!el) return;
    el.hidden = true;
    trigger()?.setAttribute('aria-expanded', 'false');
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('[data-dm-open]')) { event.preventDefault(); openDm(); return; }
    if (target.closest('.dm-sheet-close')) { closeDm(); return; }
    if (target === sheet()) { closeDm(); }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDm();
  });

  document.addEventListener('submit', async (event) => {
    const form = event.target as HTMLFormElement | null;
    if (!form || !form.matches('[data-dm-form]')) return;
    event.preventDefault();
    if (isHoneypotFilled(form)) return; // 机器人静默丢弃

    const status = form.querySelector<HTMLElement>('[data-dm-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const contact = String(new FormData(form).get('contact') || '').trim();
    const message = String(new FormData(form).get('message') || '').trim();

    if (!contact) {
      if (status) status.textContent = '留个微信或手机号，我们才好回你。';
      form.querySelector<HTMLInputElement>('#dm-contact')?.focus();
      return;
    }
    if (submitBtn) submitBtn.disabled = true;
    if (status) status.textContent = '正在发送…';

    const result = await submitLead('quick_message', '移动端私信', contact, {
      message: message || '（未填写内容，仅留了联系方式）',
      source: `mobile_bar:${window.location.pathname}`,
    });

    if (submitBtn) submitBtn.disabled = false;
    if (result.ok) {
      if (status) status.textContent = '已发出，我们会尽快回你。';
      trackEvent('dm_submit', { status: 'success', path: window.location.pathname });
      form.reset();
      window.setTimeout(closeDm, 1400);
    } else {
      if (status) status.textContent = '没发出去，稍后重试；也可以直接加微信。';
      trackEvent('dm_submit', { status: 'error', path: window.location.pathname });
    }
  });
</script>
