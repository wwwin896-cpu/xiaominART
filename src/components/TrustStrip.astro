---
// 信任标签（WO-P1-04，2026-10-09）。
// 四项均为「已承诺事实」，不是愿景占位：
//   · 专属编号 / 原创书写 —— 既有能力（企业礼赠页 02 条目早已声明唯一编号与藏品证书）
//   · 物流破损 / 质量问题 —— 业主 2026-10-09 定稿的售后条款，见 /help/#after-sales
// ⚠ 原占位文案「视频为证 / 能力确认后开放」已移除：承诺未兑现前不上墙。
const items: Array<[string, string]> = [
  ['专属编号', '每幅作品唯一编号，凭号受理售后'],
  ['原创书写', '亲笔原作，不是印刷品'],
  ['物流破损 · 修复重发', '运输损坏退回，修复后重新发出'],
  ['质量问题 · 直接退货', '装裱或材质与确认要求不符可退'],
];
---
<div class="trust" data-component="trust-strip">
  {items.map(([label, note]) => <span><b>—</b> {label}<small>{note}</small></span>)}
</div>
<style>
  .trust { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--border); padding: 18px 0; gap: 16px; }
  .trust span { font-size: 13px; color: var(--muted); }
  .trust b { color: var(--accent); font-weight: 400; }
  .trust small { display: block; color: var(--meta); font-size: 10px; margin: 4px 0 0 18px; line-height: 1.6; }
  @media (max-width: 767px) { .trust { grid-template-columns: repeat(2, 1fr); gap: 18px 8px; } }
</style>
