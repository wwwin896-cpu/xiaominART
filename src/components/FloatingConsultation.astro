<button class="floating-consultation" type="button" aria-controls="quick-message" aria-expanded="false"><span>马上咨询</span><small>微信 / 留言均可</small></button>
<div class="quick-message" id="quick-message" role="dialog" aria-modal="true" aria-labelledby="quick-message-title" hidden>
  <div class="quick-message-card"><button class="quick-message-close" type="button" aria-label="关闭快速留言 / Close quick message">×</button><span class="eyebrow">Quick message / 快速留言</span><h2 id="quick-message-title" class="serif">先问一个具体问题。</h2><p>留下称呼、联系方式和问题即可。工作日我们会尽快回复；急事建议直接加页脚微信。</p><form class="quick-message-form" data-quick-form><label for="quick-name">怎么称呼你？<input id="quick-name" name="name" autocomplete="name" required /></label><label for="quick-contact">联系方式<input id="quick-contact" name="contact" autocomplete="email" placeholder="微信或邮箱" required /></label><label for="quick-question">你的问题<textarea id="quick-question" name="question" rows="4" required></textarea></label><input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" /><button class="btn btn-primary" type="submit">发送快速留言 / Send message</button><p class="quick-message-note" aria-live="polite">提交后我们会尽快回复你。</p></form></div>
</div>
<script>
  import { submitLead, isHoneypotFilled, CONTACT_FALLBACK } from '../scripts/cloud-forms';
  const quickTrigger = document.querySelector<HTMLButtonElement>('.floating-consultation');
  const quickDialog = document.querySelector<HTMLElement>('#quick-message');
  const quickClose = document.querySelector<HTMLButtonElement>('.quick-message-close');
  const closeQuick = () => { if (!quickDialog || !quickTrigger) return; quickDialog.hidden = true; quickTrigger.setAttribute('aria-expanded','false'); };
  quickTrigger?.addEventListener('click', () => { if (!quickDialog) return; quickDialog.hidden = false; quickTrigger.setAttribute('aria-expanded','true'); quickDialog.querySelector<HTMLInputElement>('input')?.focus(); });
  quickClose?.addEventListener('click', closeQuick);
  quickDialog?.addEventListener('click', (event) => { if (event.target === quickDialog) closeQuick(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeQuick(); });
  const quickForm = document.querySelector<HTMLFormElement>('[data-quick-form]');
  const quickNote = document.querySelector<HTMLElement>('.quick-message-note');
  const quickSubmit = quickForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  quickForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!quickForm || !quickSubmit || !quickNote) return;
    if (isHoneypotFilled(quickForm)) { quickDialog && (quickDialog.hidden = true); return; }
    const data = new FormData(quickForm);
    const name = String(data.get('name') || '').trim();
    const contact = String(data.get('contact') || '').trim();
    const question = String(data.get('question') || '').trim();
    if (!name || !contact || !question) { quickNote.textContent = '请补全称呼、联系方式和问题后再提交。'; return; }
    quickSubmit.disabled = true;
    quickNote.textContent = '正在发送…';
    const result = await submitLead('quick_message', name, contact, { question, page: window.location.pathname });
    quickSubmit.disabled = false;
    if (result.ok) {
      quickNote.textContent = '已收到你的留言，我们会尽快回复你。';
      quickForm.reset();
    } else {
      quickNote.textContent = `发送失败，请稍后重试；${CONTACT_FALLBACK}`;
    }
  });
</script>
<style>
  .floating-consultation{position:fixed;right:22px;bottom:22px;z-index:12;display:flex;flex-direction:column;align-items:flex-start;gap:3px;padding:12px 16px;min-height:56px;border:1px solid var(--cinnabar);background:var(--cinnabar);color:#fff;box-shadow:0 8px 24px rgba(115,53,46,.18);cursor:pointer}.floating-consultation span{font-size:13px}.floating-consultation small{font-size:10px;opacity:.82}.quick-message{position:fixed;inset:0;z-index:15;display:grid;place-items:center;padding:18px;background:rgba(24,22,19,.5)}.quick-message[hidden]{display:none}.quick-message-card{position:relative;width:min(520px,100%);max-height:calc(100vh - 36px);overflow:auto;padding:30px;background:var(--paper-light);border:1px solid var(--line);box-shadow:var(--shadow)}.quick-message-close{position:absolute;right:14px;top:10px;border:0;background:transparent;font-size:26px;color:var(--ink);cursor:pointer}.quick-message-card h2{font-size:26px;font-weight:500;margin:14px 0 8px}.quick-message-card>p{color:var(--ink-soft);font-size:14px;line-height:1.7}.quick-message-card label{display:block;margin:14px 0;color:var(--ink-soft);font-size:12px}.quick-message-card input,.quick-message-card textarea{display:block;width:100%;margin-top:6px;padding:11px;border:1px solid var(--line);background:var(--paper);color:var(--ink);min-height:44px;font-size:16px}  .quick-message-card .btn{margin-top:6px;width:100%}.quick-message-note{margin:12px 0 0;color:var(--meta);font-size:12px;line-height:1.6}.honeypot{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;opacity:0!important;pointer-events:none!important}@media(max-width:767px){.floating-consultation{right:14px;bottom:calc(78px + env(safe-area-inset-bottom))}.quick-message-card{padding:24px 18px}.quick-message-card h2{font-size:23px}}
</style>
