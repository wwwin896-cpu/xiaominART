<button class="floating-consultation" type="button" aria-controls="quick-message" aria-expanded="false"><span>发起定制咨询</span><small>1–2 个工作日回复</small></button>
<div class="quick-message" id="quick-message" role="dialog" aria-modal="true" aria-labelledby="quick-message-title" hidden>
  <div class="quick-message-card"><button class="quick-message-close" type="button" aria-label="关闭快速留言 / Close quick message">×</button><span class="eyebrow">Quick message / 快速留言</span><h2 id="quick-message-title" class="serif">先问一个具体问题。</h2><p>无需填写完整表单，留下称呼、联系方式和问题即可。我们会在 1–2 个工作日内回复。</p><form class="quick-message-form" action="mailto:hello@xiaominart.com" method="post" enctype="text/plain"><label for="quick-name">怎么称呼你？<input id="quick-name" name="name" autocomplete="name" required /></label><label for="quick-contact">联系方式<input id="quick-contact" name="contact" autocomplete="email" placeholder="微信或邮箱" required /></label><label for="quick-question">你的问题<textarea id="quick-question" name="question" rows="4" required></textarea></label><button class="btn btn-primary" type="submit">发送快速留言 / Send message</button><p class="quick-message-note" aria-live="polite">发送后会打开默认邮件客户端；我们会在 1–2 个工作日内回复。</p></form></div>
</div>
<script>
  const quickTrigger = document.querySelector<HTMLButtonElement>('.floating-consultation');
  const quickDialog = document.querySelector<HTMLElement>('#quick-message');
  const quickClose = document.querySelector<HTMLButtonElement>('.quick-message-close');
  const closeQuick = () => { if (!quickDialog || !quickTrigger) return; quickDialog.hidden = true; quickTrigger.setAttribute('aria-expanded','false'); };
  quickTrigger?.addEventListener('click', () => { if (!quickDialog) return; quickDialog.hidden = false; quickTrigger.setAttribute('aria-expanded','true'); quickDialog.querySelector<HTMLInputElement>('input')?.focus(); });
  quickClose?.addEventListener('click', closeQuick);
  quickDialog?.addEventListener('click', (event) => { if (event.target === quickDialog) closeQuick(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeQuick(); });
</script>
<style>
  .floating-consultation{position:fixed;right:22px;bottom:22px;z-index:12;display:flex;flex-direction:column;align-items:flex-start;gap:3px;padding:12px 16px;min-height:56px;border:1px solid #2A5A6B;background:#2A5A6B;color:#fff;box-shadow:0 8px 24px rgba(24,50,61,.18);cursor:pointer}.floating-consultation span{font-size:13px}.floating-consultation small{font-size:10px;opacity:.82}.quick-message{position:fixed;inset:0;z-index:15;display:grid;place-items:center;padding:18px;background:rgba(24,22,19,.5)}.quick-message[hidden]{display:none}.quick-message-card{position:relative;width:min(520px,100%);max-height:calc(100vh - 36px);overflow:auto;padding:30px;background:var(--paper-light);border:1px solid var(--line);box-shadow:var(--shadow)}.quick-message-close{position:absolute;right:14px;top:10px;border:0;background:transparent;font-size:26px;color:var(--ink);cursor:pointer}.quick-message-card h2{font-size:36px;font-weight:500;margin:14px 0 8px}.quick-message-card>p{color:var(--ink-soft);font-size:14px;line-height:1.7}.quick-message-card label{display:block;margin:14px 0;color:var(--ink-soft);font-size:12px}.quick-message-card input,.quick-message-card textarea{display:block;width:100%;margin-top:6px;padding:11px;border:1px solid var(--line);background:var(--paper);color:var(--ink);min-height:44px}  .quick-message-card .btn{margin-top:6px;width:100%}.quick-message-note{margin:12px 0 0;color:var(--meta);font-size:11px;line-height:1.6}@media(max-width:767px){.floating-consultation{right:14px;bottom:14px}.quick-message-card{padding:24px 18px}.quick-message-card h2{font-size:30px}}
</style>
