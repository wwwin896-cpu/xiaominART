---
// 右下角「寻墨」印章按钮：安静的客服/留言入口（印章形态，非营销按钮）。
// 点击展开快速留言弹层；移动端位于底栏上方右侧，分享按钮叠放其上。
---
<button class="ink-seek" type="button" aria-controls="quick-message" aria-expanded="false" aria-label="寻墨 · 与我们留言"><span class="seal-text">寻墨</span></button>
<div class="quick-message" id="quick-message" role="dialog" aria-modal="true" aria-labelledby="quick-message-title" hidden>
  <div class="quick-message-card"><button class="quick-message-close" type="button" aria-label="关闭留言 / Close">×</button><span class="eyebrow">Say hello / 与我们聊聊</span><h2 id="quick-message-title" class="serif">先说一句想说的话。</h2><p>留下称呼、联系方式和想表达的心意即可。工作日我们会尽快回复；急事也可以扫描页脚微信。</p><form class="quick-message-form" data-quick-form><label for="quick-name">怎么称呼你？<input id="quick-name" name="name" autocomplete="name" required /></label><label for="quick-contact">联系方式<input id="quick-contact" name="contact" autocomplete="email" placeholder="微信或邮箱" required /></label><label for="quick-question">你想说的话<textarea id="quick-question" name="question" rows="4" required></textarea></label><input type="text" name="website" value="" tabindex="-1" autocomplete="off" aria-hidden="true" class="honeypot" /><button class="btn btn-primary" type="submit">发送 / Send</button><p class="quick-message-note" aria-live="polite">提交后我们会尽快回复你。</p></form></div>
</div>
<script>
  import { submitLead, isHoneypotFilled, CONTACT_FALLBACK } from '../scripts/cloud-forms';
  const quickTrigger = document.querySelector<HTMLButtonElement>('.ink-seek');
  const quickDialog = document.querySelector<HTMLElement>('#quick-message');
  const quickClose = document.querySelector<HTMLButtonElement>('.quick-message-close');
  const closeQuick = () => { if (!quickDialog || !quickTrigger) return; quickDialog.hidden = true; quickTrigger.setAttribute('aria-expanded','false'); };
  quickTrigger?.addEventListener('click', () => { if (!quickDialog) return; quickDialog.hidden = false; quickTrigger.setAttribute('aria-expanded','true'); quickDialog.querySelector<HTMLInputElement>('input')?.focus(); });
  quickClose?.addEventListener('click', closeQuick);
  quickDialog?.addEventListener('click', (event) => { if (event.target === quickDialog) closeQuick(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeQuick(); });
  const quickForm = document.querySelector<HTMLFormElement>('[data-quick-form]');
  const quickNote = document.querySelector<HTMLElement>('.quick-message-note');
  const quickSubmit = quickForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  quickForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!quickForm || !quickSubmit || !quickNote) return;
    if (isHoneypotFilled(quickForm)) { quickDialog && (quickDialog.hidden = true); return; }
    const data = new FormData(quickForm);
    const name = String(data.get('name') || '').trim();
    const contact = String(data.get('contact') || '').trim();
    const question = String(data.get('question') || '').trim();
    if (!name || !contact || !question) { quickNote.textContent = '请补全称呼、联系方式和想说的话。'; return; }
    quickSubmit.disabled = true;
    quickNote.textContent = '正在发送…';
    const result = await submitLead('quick_message', name, contact, { question, page: window.location.pathname });
    quickSubmit.disabled = false;
    if (result.ok) {
      quickNote.textContent = '已收到，我们会尽快回复你。';
      quickForm.reset();
    } else {
      quickNote.textContent = `发送失败，请稍后重试；${CONTACT_FALLBACK}`;
    }
  });
</script>
<style>
  .ink-seek{position:fixed;right:20px;bottom:22px;z-index:12;width:52px;height:52px;border:0;border-radius:10px;background:var(--cinnabar);color:#fffaf1;box-shadow:0 6px 20px rgba(116,53,46,.28);cursor:pointer;transition:transform .2s ease, box-shadow .2s ease}
  .ink-seek:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(116,53,46,.34)}
  .ink-seek:active{transform:scale(.94)}
  .seal-text{display:block;writing-mode:vertical-rl;font-family:var(--font-display-zh),serif;font-size:15px;letter-spacing:.28em;margin:0 auto;line-height:1;transform:translateX(.14em)}
  .quick-message{position:fixed;inset:0;z-index:15;display:grid;place-items:center;padding:18px;background:rgba(24,22,19,.5)}
  .quick-message[hidden]{display:none}
  .quick-message-card{position:relative;width:min(520px,100%);max-height:calc(100vh - 36px);overflow:auto;padding:30px;background:var(--paper-light);border:1px solid var(--line);box-shadow:var(--shadow)}
  .quick-message-close{position:absolute;right:14px;top:10px;border:0;background:transparent;font-size:26px;color:var(--ink);cursor:pointer}
  .quick-message-card h2{font-size:26px;font-weight:500;margin:14px 0 8px}
  .quick-message-card>p{color:var(--ink-soft);font-size:14px;line-height:1.7}
  .quick-message-card label{display:block;margin:14px 0;color:var(--ink-soft);font-size:12px}
  .quick-message-card input,.quick-message-card textarea{display:block;width:100%;margin-top:6px;padding:11px;border:1px solid var(--line);background:var(--paper);color:var(--ink);min-height:44px;font-size:16px}  .quick-message-card .btn{margin-top:6px;width:100%}
  .quick-message-note{margin:12px 0 0;color:var(--meta);font-size:12px;line-height:1.6}
  .honeypot{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;opacity:0!important;pointer-events:none!important}
  @media(max-width:767px){
    .ink-seek{right:14px;bottom:calc(86px + env(safe-area-inset-bottom));width:50px;height:50px;border-radius:12px}
    .quick-message-card{padding:24px 18px}
    .quick-message-card h2{font-size:23px}
  }
</style>
