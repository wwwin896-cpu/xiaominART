---
// ─────────────────────────────────────────────────────────────
// 站点页脚（2026-10-12 从 Layout.astro 抽出）
//
// 2026-10-14 业主反馈后重做：**只有首页保留完整页脚，其余页面收成一行。**
//   业主原话：「现在每个网页的最后都是『愿你在这方寸之间…』以及后面的
//   联系方式，我认为除了主页面可以保留，其他页面都不需要反复出现，
//   让人看了不舒服。」
//
// 这种做法在内容站上是标准解法：首页承担「品牌自我介绍」的职责，
// 内页则应把访客留在内容里，而不是每条路都撞见同一块推销。
//
// 内页保留的那一行仍含三个必要入口（编码查询 / 售后 / 隐私）——
// 前两个是功能，第三个是合规要求，不能省。
//
// 联系信息全部来自 `src/data/site.ts` 的 siteContact，
// 改微信号 / 换二维码只需改数据文件，不需要动本文件。
//
// 相关样式仍在 Layout.astro 的 <style> 中
// （.site-footer / .footer-grid / .trust-signals 等），
// 因其与移动端断点、移动底栏共用媒体查询。
// ─────────────────────────────────────────────────────────────
import { siteContact } from '../data/site';
import Newsletter from './Newsletter.astro';
import FilingLine from './FilingLine.astro';

/** 是否为首页。路由由 Layout 传入（`Astro.url.pathname` 在本组件里不可靠）。 */
const { isHome = false } = Astro.props;
---

{isHome ? (
  <footer class="site-footer" data-component="site-footer">
    <div class="container footer-grid">
      <div><p class="eyebrow">XIAOMINART / 用心好礼</p><p class="footer-claim serif">愿你在这方寸之间，<br />找到属于自己的定制心意。</p></div>
      {/* 2026-10-16 业主反馈：联系区排版优化 —— 邮箱提级、二维码与微信文字并排、
          指引与政策链接分组；删除「或先说一句想说的话」入口（主页已有「与我们聊聊」按钮） */}
      <div class="footer-contact">
        <p class="eyebrow">Contact / 联系</p>
        <a class="footer-email" href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
        <div class="footer-wechat">
          {siteContact.wechatQr ? <a class="wechat-qr-link" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img class="wechat-qr" src={siteContact.wechatQr} width="112" height="112" alt="小民艺术微信二维码" loading="lazy" /></a> : null}
          <p>{siteContact.wechatId ? <>微信 / 企业微信：<strong>{siteContact.wechatId}</strong></> : siteContact.wechatQr ? <>微信 / 企业微信：扫码添加</> : <>微信 / 企业微信：提交<a href="/custom-commission/">定制咨询表单</a>并留下你的微信号，我们会主动添加你。</>}<br />（备注来意，尽快回复）</p>
        </div>
        {/* 2026-11-01 业主：微信区下方的功能链接统一做成胶囊按钮（送礼指南 /
            提交咨询 / 作品编码查询 / 帮助中心 / 售后 / 隐私），并新增「我的收藏」
            ——data-wishlist-open 由 WishlistDrawer 脚本全局绑定，点击直接开心愿单抽屉。 */}
        <div class="footer-pills" role="group" aria-label="常用功能">
          <a class="footer-pill" href="/gift-guide/">送礼指南</a>
          <a class="footer-pill" href="/custom-commission/">提交咨询</a>
          <button class="footer-pill" type="button" data-wishlist-open>♡ 我的收藏</button>
          <a class="footer-pill" href="/verify/">作品编码查询</a>
          <a class="footer-pill" href="/help/">帮助中心</a>
          <a class="footer-pill" href="/help/#after-sales">售后保障与退换须知</a>
          <a class="footer-pill" href="/privacy/">隐私政策</a>
        </div>
        {/* 2026-10-28 审计修复：/scenes/ /seasons/ /works/ 三个页面在 sitemap 与 llms.txt 里
            都收录了，但站内没有任何链接指向它们（旧的导航入口在 10-19 改版时移除，
            页面本身没下）。首页页脚是它们唯一合理的位置 —— 认知路径上也对：
            先看挂在哪，再看哪个节气，最后看作品档案。 */}
        <p class="footer-explore"><span class="eyebrow">Explore / 继续看</span><a href="/scenes/">书法挂在哪：书房·客厅·茶室·玄关</a><a href="/seasons/">四季节气与应时祝愿</a><a href="/works/">作品档案与字形考据</a></p>
        {/* 2026-11-01：原 footer-policy 四链接已并入上方 footer-pills（含「我的收藏」） */}
      </div>
    </div>
    <div class="container trust-signals" aria-label="信息边界 / Information boundaries"><div><span class="eyebrow">Artist / 艺术家</span><strong>由具体创作方向与沟通内容开始</strong></div><div><span class="eyebrow">Projects / 项目</span><strong>已确认内容才会公开呈现</strong></div><div class="trust-privacy"><span class="eyebrow">Privacy / 隐私</span><strong>客户故事与图像获得授权后发布</strong></div><p>我们不使用未经核验的客户数量、媒体曝光或合作机构作为背书。</p></div>
    <div class="container footer-newsletter"><Newsletter /></div>
    <div class="container footer-bottom"><span>© {new Date().getFullYear()} XIAOMINART | 守艺 · 传情</span><FilingLine /><span>世间无双，只此一幅 | Every piece is one of a kind.</span></div>
  </footer>
) : (
  <footer class="site-footer is-slim" data-component="site-footer">
    <div class="container footer-slim">
      <span class="footer-slim-copy">© {new Date().getFullYear()} XIAOMINART | 守艺 · 传情</span>
      <nav class="footer-slim-nav" aria-label="页脚导航">
        <a href="/verify/">作品编码查询</a>
        {/* 2026-10-28 审计修复：此前只链 /help/#after-sales（带 fragment），
            搜索引擎把 fragment 视为同页，等于 /help/ 本身零入链。补一条无锚点的。 */}
        <a href="/help/">帮助中心</a>
        <a href="/help/#after-sales">售后与退换</a>
        <a href="/privacy/">隐私政策</a>
      </nav>
      <FilingLine />
    </div>
  </footer>
)}
