---
// ─────────────────────────────────────────────────────────────
// 站点页脚（2026-10-12 从 Layout.astro 抽出）
//
// 含：品牌主张、联系信息（邮箱 / 微信 + 二维码）、政策链接、
// 「先说一句」入口、信任信号区（信息边界）、Newsletter、版权行。
//
// 联系信息全部来自 `src/data/site.ts` 的 siteContact，
// 改微信号 / 换二维码只需改数据文件，不需要动本文件。
//
// 相关样式仍在 Layout.astro 的 <style> 中
// （.site-footer / .footer-grid / .trust-signals 等），
// 因其与移动端断点、移动底栏共用媒体查询。
// ─────────────────────────────────────────────────────────────
import { siteContact } from '../data/site';
import Newsletter from './Newsletter.astro';
---

<footer class="site-footer" data-component="site-footer">
  <div class="container footer-grid">
    <div><p class="eyebrow">XIAOMINART / 用心好礼</p><p class="footer-claim serif">愿你在这方寸之间，<br />找到属于自己的定制心意。</p></div>
    <div class="footer-contact"><p class="eyebrow">Contact / 联系</p><a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>{siteContact.wechatId ? <p>微信 / 企业微信：<strong>{siteContact.wechatId}</strong>（备注来意，尽快回复）</p> : siteContact.wechatQr ? <p>微信 / 企业微信：扫码添加（备注来意，尽快回复）</p> : <p>微信 / 企业微信：提交<a href="/custom-commission/">定制咨询表单</a>并留下你的微信号，我们会主动添加你。</p>}{siteContact.wechatQr ? <a class="wechat-qr-link" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img class="wechat-qr" src={siteContact.wechatQr} width="112" height="112" alt="小民艺术微信二维码" loading="lazy" /></a> : null}<p>送礼问题可先从送礼指南开始；需要个性化建议，可提交咨询。</p><p class="footer-policy"><a href="/verify/">作品编码查询 →</a><a href="/help/#after-sales">售后保障与退换须知 →</a><a href="/privacy/">隐私政策 →</a></p><button class="ink-seek footer-seek" type="button" aria-controls="quick-message" aria-expanded="false">或先说一句想说的话 →</button></div>
  </div>
  <div class="container trust-signals" aria-label="信息边界 / Information boundaries"><div><span class="eyebrow">Artist / 艺术家</span><strong>由具体创作方向与沟通内容开始</strong></div><div><span class="eyebrow">Projects / 项目</span><strong>已确认内容才会公开呈现</strong></div><div class="trust-privacy"><span class="eyebrow">Privacy / 隐私</span><strong>客户故事与图像获得授权后发布</strong></div><p>我们不使用未经核验的客户数量、媒体曝光或合作机构作为背书。</p></div>
  <div class="container footer-newsletter"><Newsletter /></div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} XIAOMINART | 守艺 · 传情</span><span>世间无双，只此一幅 | Every piece is one of a kind.</span></div>
</footer>
