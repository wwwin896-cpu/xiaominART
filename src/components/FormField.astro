---
const { label, name, type = 'text', placeholder = '', required = false, rows = 0 } = Astro.props;
---
<label class="form-field">{label}{required && <span aria-hidden="true"> *</span>}{rows ? <textarea name={name} rows={rows} placeholder={placeholder} required={required}></textarea> : <input name={name} type={type} placeholder={placeholder} required={required} />}</label>
<style>
  .form-field { display: block; color: var(--ink-soft); font-size: 13px; margin-bottom: 18px; }
  .form-field > span { color: var(--cinnabar); }
  input, textarea { display: block; width: 100%; margin-top: 7px; border: 1px solid var(--line); border-radius: 0; background: var(--paper-light); color: var(--ink); padding: 12px 13px; }
  textarea { resize: vertical; }
  input:focus, textarea:focus { outline: none; border-color: var(--cinnabar); box-shadow: var(--focus); }
</style>
