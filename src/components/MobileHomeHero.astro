---
// ─────────────────────────────────────────────────────────────
// 移动端首屏（2026-10-29 v2，按 xiaominart-style-demo.html 视觉重做）
//
// v1 的问题：结构对了（价签+事实），但排版还是「正式站旧语言」——
// 左对齐、照片主图、观感与 demo 脱节。业主明确要 demo 效果。
//
// v2 = demo .hero 的本体：
//   · 居中大标题「一字一礼，把心意写成看得见的样子」
//   · 副题一行硬承诺
//   · 双 CTA：挑选礼品（朱砂渐变胶囊）/ 了解定制（幽灵胶囊）
//   · 两团墨晕（demo .ink-blot）缓慢漂移
//   · 三张事实瓷片 + 搜索胶囊（保留 v1 的转化件，套新皮肤）
//   · 照片主图删除——真实照片移到商品卡详情弹层的大图区
//
// ⚠️ 桌面端不渲染：根元素 display:none，只在 767px 以下出现。
// ─────────────────────────────────────────────────────────────
interface Props {
  /** 最低价，由 index.astro 从现货数据里算出 */
  priceFrom: number;
  /** 在册件数（礼品 + 生肖 + 现货） */
  itemCount: number;
}

const { priceFrom, itemCount } = Astro.props;
---

<section class="mhero" aria-labelledby="mhero-title">
  <span class="mhero-blot mhero-blot1" aria-hidden="true"></span>
  <span class="mhero-blot mhero-blot2" aria-hidden="true"></span>

  <div class="mhero-inner">
    <span class="mhero-eyebrow">小民艺术 ｜ 手写书法礼品与非遗手作定制</span>
    <h1 id="mhero-title" class="serif">一字一礼<br />看得到的心意</h1>
    <p class="mhero-sub">每一件都由小民亲笔书写 · 宣纸装裱 · 附赠手写贺语</p>

    <div class="mhero-cta">
      <a class="btn btn-primary mhero-cta-main" href="/gifts/" data-event="hero_cta_click">挑选礼品</a>
      <a class="btn mhero-cta-ghost" href="/custom-commission/" data-event="custom_entry">了解定制</a>
    </div>

    <ul class="mhero-facts">
      <li><strong>{priceFrom}</strong><span>元起</span></li>
      <li><strong>{itemCount}</strong><span>件在册</span></li>
      <li><strong class="mhero-facts-zh">现货</strong><span>24h 直发</span></li>
    </ul>

    {/* 搜索胶囊（2026-10-31 业主指令隐藏）：
        首屏下方已有 2 列商品流 + 分类 chip + 「分类」面板，搜索在这里
        属于「第四种找货方式」，反而把首屏到商品的距离拉长。
        保留 DOM 与 data-search-open 钩子（桌面端 header 的搜索仍可用），
        只加 hidden，需要恢复时删掉这个属性即可。 */}
    <button class="mhero-search" type="button" data-search-open aria-label="搜索站内作品" hidden>
      <span aria-hidden="true">⌕</span>想找什么字？先搜一下
    </button>
  </div>
</section>

<style>
  .mhero { display: none; }

  @media (max-width: 767px) {
    .mhero {
      position: relative; display: block; overflow: hidden;
      padding: 34px 20px 26px; text-align: center;
    }
    /* demo .ink-blot：两团缓慢漂移的墨晕，给纸面呼吸感 */
    .mhero-blot { position: absolute; border-radius: 50%; filter: blur(40px); opacity: .35; pointer-events: none; }
    .mhero-blot1 { width: 240px; height: 240px; left: -70px; top: 40px; background: radial-gradient(circle, #e5d9bd, transparent 70%); animation: mhero-drift 12s ease-in-out infinite; }
    .mhero-blot2 { width: 210px; height: 210px; right: -60px; top: 140px; background: radial-gradient(circle, rgba(165, 72, 59, .2), transparent 70%); animation: mhero-drift 15s ease-in-out infinite reverse; }
    @keyframes mhero-drift { 50% { transform: translateY(24px) scale(1.06); } }
    @media (prefers-reduced-motion: reduce) { .mhero-blot { animation: none; } }

    .mhero-inner { position: relative; z-index: 1; }
    .mhero-eyebrow { display: block; margin-bottom: 12px; color: var(--cinnabar); font-size: 11.5px; letter-spacing: .14em; font-family: var(--font-body-zh); }
    /* 标题：2026-10-31 业主改两行（「一字一礼」+「你的心意被看见」），
       字号由 30px 收一档到 26px——两行句子长度不同（4 字 / 7 字），
       同字号下会显得头轻脚重，26px 时两行宽度差更收敛，
       配合 letter-spacing 略收（.12em → .08em），整块更居中匀称。 */
    .mhero h1 { font-size: 26px; line-height: 1.62; font-weight: 500; letter-spacing: .08em; margin: 0 0 14px; }
    .mhero-sub { margin: 0 0 20px; color: var(--ink-soft); font-size: 13px; line-height: 1.9; letter-spacing: .06em; }

    /* 双 CTA：朱砂渐变主胶囊 + 幽灵胶囊（demo .hero-cta） */
    .mhero-cta { display: flex; justify-content: center; gap: 12px; margin: 0 0 22px; }
    .mhero-cta .btn { min-height: 46px; padding: 11px 24px; font-size: 14px; letter-spacing: .2em; border-radius: 999px; }
    .mhero-cta-main { box-shadow: 0 6px 18px rgba(160, 44, 32, .3); }
    .mhero-cta-ghost { color: var(--ink); border: 1px solid var(--line); background: rgba(255, 255, 255, .55); }

    /* 三张事实瓷片（转化件，保留） */
    .mhero-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 0 0 14px; padding: 0; list-style: none; }
    .mhero-facts li { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 12px 4px 10px; background: rgba(255, 253, 247, .8); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 2px 8px rgba(60, 50, 30, .06); }
    .mhero-facts strong { font: 600 20px var(--font-display-en), Georgia, serif; color: var(--cinnabar); letter-spacing: .01em; }
    .mhero-facts .mhero-facts-zh { font-family: var(--font-display-zh); font-size: 17px; font-weight: 500; }
    .mhero-facts span { color: var(--ink-soft); font-size: 11px; letter-spacing: .08em; }

    /* 搜索胶囊（移动端唯一的搜索入口，保留） */
    .mhero-search { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255, 255, 255, .7); color: var(--ink-soft); font: inherit; font-size: 13.5px; letter-spacing: .04em; }
    .mhero-search[hidden] { display: none; }
    .mhero-search span[aria-hidden] { font-size: 16px; color: var(--cinnabar); line-height: 1; }
  }
</style>
