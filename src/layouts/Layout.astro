---
// ═════════════════════════════════════════════════════════════
// 全站布局：只做「组装」，不装业务
//
// 2026-10-12 按职责拆分。此前本文件 495 行 / 40KB，7 天内被改 18 次 ——
// 根因不是写得不好，而是它同时承担了 6 类互不相关的职责，
// 任何一处需求（调 SEO、改导航、加弹层、修埋点）都要动这个文件。
//
// 拆分后的职责边界：
//   · 本文件         → props 解析 + 面包屑推导 + 全局样式 + 区块组装
//   · SeoHead        → <head> 全部（meta / OG / JSON-LD / 验证）
//   · AnalyticsScript→ 统计脚本 + 同意门禁
//   · SiteHeader     → 页头与主导航
//   · SiteFooter     → 页脚与信任信号
//   · MobileBar      → 移动底栏 + 微信弹层
//   · scripts/layout-interactions.ts → 全部客户端交互
//
// ⚠ 新增东西时先问「它属于上面哪一块」，放进对应文件，
//   不要再往本文件里堆 —— 这正是过去 18 次返工的成因。
// ═════════════════════════════════════════════════════════════
import '../styles/global.css';
// 自托管 Web 字体：跨系统（iOS / 鸿蒙 / 安卓 / 桌面）统一渲染，中文分片按需加载
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import SeoHead from '../components/SeoHead.astro';
import AnalyticsScript from '../components/AnalyticsScript.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileBar from '../components/MobileBar.astro';
import ShareButton from '../components/ShareButton.astro';
import WishlistDrawer from '../components/WishlistDrawer.astro';
import SearchModal from '../components/SearchModal.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { chatConfig } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; href: string }>;
  bodyData?: Record<string, string>;
  /** og:type（2026-10-17）：商品详情页传 'product'，其余默认 'website' */
  ogType?: 'website' | 'article' | 'product';
}

const { title = '小民艺术｜用心好礼', description = '小民艺术，用心为你写一份好礼。以亲笔书写为起点，见字如面，心意表达。', canonical, image = '/assets/images/og-image.png', noindex = false, breadcrumbs = [], bodyData, ogType = 'website' } = Astro.props;

/**
 * 页面级 body data-* 属性（2026-10-14 加）。
 *
 * 用途：让页面把「这一页特有的标识」交给全站脚本读取，而不必靠在 DOM 里
 * 找某个元素来反推 —— 后者一旦元素被删（如二维码收进折叠区），
 * 选择器会静默取到 null，埋点全部丢失 code 归属且不报错。
 *
 * 例：作品档案页传 { 'archive-code': work.code }
 *     → <body data-archive-code="XMA-CL-WA-26-0001-T2-0">
 *
 * 值以字符串序列化，布尔值 true 序列化为空串（HTML 布尔属性惯例）。
 */
const bodyDataAttrs = Object.fromEntries(
  Object.entries((bodyData as Record<string, string | number | boolean> | undefined) ?? {})
    .filter(([, v]) => v !== false && v !== undefined && v !== null)
    .map(([k, v]) => [`data-${k}`, v === true ? '' : String(v)]),
);
const seoTitle = title.replace(/xiaominart/gi, 'XIAOMINART');
const url = canonical ?? Astro.url.href;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => { const normalized = href.replace(/\/$/, '') || '/'; return currentPath === normalized || (normalized !== '/' && currentPath.startsWith(`${normalized}/`)); };

// ── 面包屑全站兜底（T-06，2026-10-07）──
// 显式传入 breadcrumbs 的页面照旧；未传入的页面按路径自动生成：
// 深度 1（/about/）→ 首页 / 关于我们；深度 2+（/seasons/spring/）→ 首页 / 四季节气 / {title 首段}。
const SECTION_LABELS: Record<string, string> = {
  'about': '关于我们', 'business-gifts': '企业定制', 'contact': '联系我们',
  'custom': '定制业务', 'custom-commission': '定制创作', 'notes': '创作笔记', 'zodiac': '字游记',
  'gift-guide': '选礼指南', 'gifts': '小民好礼', 'help': '帮助中心',
  'progress': '定制进度', 'scenes': '灵感参考',
  'stories': '墙上的故事', 'wishlist': '心愿单', 'works': '作品档案',
  'artists': '艺术家', 'seasons': '四季节气', 'occasions': '送礼场合',
  'recipients': '送礼对象', 'partners': '机构合作', 'channel': '购买渠道', 'privacy': '隐私政策',
  // 2026-10-15 精简下线的 art-direction/pricing-guide/referral/your-story/blessings 已移除
};
const PATH_LABELS: Record<string, string> = {
  '/partners/cases/': '合作案例', '/partners/heritage/': '非遗面塑活动',
  '/partners/museum-tourism/': '博物馆与文旅', '/partners/publishing/': '出版社插画',
};
const autoBreadcrumbs = (() => {
  if (breadcrumbs.length > 0) return breadcrumbs;
  if (currentPath === '/') return [];
  const segments = currentPath.split('/').filter(Boolean);
  const pathKey = `${currentPath}/`;
  const leaf = PATH_LABELS[pathKey] ?? title.split('｜')[0];
  if (segments.length === 1) return [{ name: '首页', href: '/' }, { name: SECTION_LABELS[segments[0]] ?? leaf, href: Astro.url.pathname }];
  const section = SECTION_LABELS[segments[0]];
  if (!section) return [];
  return [{ name: '首页', href: '/' }, { name: section, href: `/${segments[0]}/` }, { name: leaf, href: Astro.url.pathname }];
})();
const effectiveBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : autoBreadcrumbs;

// ── 数据分析脚手架（T-05，2026-10-07）──
// 三套分析工具都在 Cloudflare Pages 环境变量里配 PUBLIC_* 值即生效，不配则零注入（现状）。
// 接入步骤、UTM 规范与 CSP 域名要求见 docs/数据分析接入指南.md。
//
// 2026-10-09（WO-P2-03 埋点）：统一加 `!noindex` 闸门 —— 功能页与内部后台
// （/wishlist/、/progress/、/admin/*）本身带 noindex，不应进任何统计口径，
// 否则后台访问会污染「访客数 / 转化率」。此处一并修正既有三家的遗漏。
const trackPage = !noindex;
const gaId = trackPage ? (import.meta.env.PUBLIC_GA4_ID as string | undefined) : undefined;
const umamiSrc = trackPage ? (import.meta.env.PUBLIC_UMAMI_SRC as string | undefined) : undefined;
const umamiId = trackPage ? (import.meta.env.PUBLIC_UMAMI_ID as string | undefined) : undefined;
const clarityId = trackPage ? (import.meta.env.PUBLIC_CLARITY_ID as string | undefined) : undefined;

// 百度统计（2026-10-09 接入）：ID 固定写死 —— 它本就是公开的站点标识，
// 不构成密钥（与 GA4 measurement id 同性质）。同样受 noindex 闸门约束。
const BAIDU_TONGJI_ID = 'ecd08d2b5b02b8982ae7fdf7836e8a3b';
const baiduId = trackPage ? BAIDU_TONGJI_ID : undefined;

// Knocket SDK 地址（2026-10-18）。identifier 为空时整段不渲染，页面零变化。
const chatSdkSrc = chatConfig.knocketIdentifier
  ? `https://trtc.io/knocket-sdk/sdk.js?identifier=${encodeURIComponent(chatConfig.knocketIdentifier)}${
      chatConfig.knocketVersion ? `&amp;v=${encodeURIComponent(chatConfig.knocketVersion)}` : ''
    }`
  : '';
---
<html lang="zh-CN">
  <head>
    <SeoHead title={seoTitle} description={description} url={url} image={image} noindex={noindex} breadcrumbs={effectiveBreadcrumbs} ogType={ogType} />
    <AnalyticsScript gaId={gaId} umamiSrc={umamiSrc} umamiId={umamiId} clarityId={clarityId} baiduId={baiduId} />
    <link rel="icon" href="/assets/brand/xiaominart-logo-icon.svg" />
    <title>{seoTitle}</title>
  </head>
  <body {...bodyDataAttrs}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader isCurrent={isCurrent} />
    {/* noindex 的功能页（心愿单、进度查询、内部后台）不进搜索索引：
        它们的内容依赖 localStorage 或查询码，索引下来只会是空壳，
        搜索命中后点进去反而看到空白页。用 noindex 这个已有信号统一判定，
        避免每加一个功能页就忘了标一次 data-pagefind-ignore。 */}
    <main id="main" data-pagefind-ignore={noindex ? '' : undefined}><slot /></main>
    {/* 2026-10-16 业主裁决：删除页脚「或先说一句想说的话」入口（主页已有「与我们聊聊」按钮），
        FloatingConsultation 弹层因此失去唯一触发点（.ink-seek），整体下线；
        组件文件保留在 src/components/ 备用，不再渲染。 */}
    <ShareButton />
    <WishlistDrawer />
    <SearchModal />
    <CookieConsent />
    <MobileBar />
    <button class="back-top" type="button" data-back-top aria-label="回到顶部">↑</button>
    {/* 网页实时聊天（Knocket，2026-10-18）。
        未配 identifier 时**完全不加载**，页面体积与行为零变化。
        async 加载、不阻塞渲染；访客点底栏「私信」时由 MobileBar 调
        window.contactWidget.showChat() 拉起面板。 */}
    {chatSdkSrc ? (
      <Fragment set:html={`<script src="${chatSdkSrc}" async></script>`} />
    ) : null}
    <SiteFooter isHome={currentPath === '/'} />
  </body>
</html>
<script>
  // 全站布局级交互（菜单 / 返回键 / 滚动显现 / 埋点 / 微信弹层 / 心愿单角标）
  // 2026-10-12 从本文件内联脚本抽出，见 src/scripts/layout-interactions.ts
  import '../scripts/layout-interactions';
</script>
<style is:global>
  /* ── 玻璃拟态悬浮导航（2026-10-29，新中式底座 + 现代交互层）──────────
     ① 玻璃层一律挂 .header-inner::before 伪元素，绝不挂本体 ——
        本体上的 backdrop-filter 会成为 absolute/fixed 后代的包含块，
        桌面 .nav-dropdown 的 absolute 定位会被劫持到胶囊头上（移动端已踩过同坑）。
     ② 悬浮 = sticky + 上边距 + 圆角胶囊，不再是通栏色带。
     ③ --radius 阶梯值见 tokens.css（sm 6 / md 10 / lg 14）。 */
  .site-header { position: sticky; top: 12px; z-index: 5; background: transparent; border-bottom: 0; backdrop-filter: none; }
  .site-header .container.header-inner,
  .header-inner { position: relative; display: flex; align-items: center; gap: 26px; min-height: 64px; padding: 0 10px 0 22px; border-radius: var(--radius-lg); background: transparent; }
  .header-inner::before { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); background: var(--glass-bg); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); border: 1px solid var(--glass-border); box-shadow: var(--glass-shadow); }
  .header-inner > :not(#site-nav) { position: relative; z-index: 1; }
  /* ⚠️ nav 自身定位策略：桌面端 nav 是 flex 流内元素，保持默认；
        上一行 `.header-inner > *` 的 relative 对桌面无害（dropdown 仍锚定 .nav-item），
        但移动端 #site-nav 是 fixed 抽屉 —— 那边已有 :not(#site-nav) 豁免，别动。 */
  .brand { display: flex; align-items: center; min-width: 280px; flex-shrink: 0; }
  .brand-logo { display: block; width: 270px; height: auto; }
  .brand-logo-zh { display: none; }
  .brand-subtitle { color: var(--ink-soft); width: 280px; font-size: 12px; letter-spacing: .08em; line-height: 1.3; white-space: nowrap; text-align: left; }
  .mobile-shopping-bar { display: none; }
  .mobile-tabbar { display: none; }
  .mobile-ask-fab { display: none; }
  .back-top { display: none; }
  /* 2026-10-31：移动抽屉菜单文案覆盖（navItems[].navLabel）的基础开关。
     ⚠️ 必须放在媒体查询之外 —— 否则桌面端两个 span 同时显示
     （实测线上出现「机构合作非遗合作」连排）。桌面只看 desk、只看 mob。 */
  .nav-zh-mob { display: none; }
  .nav-zh-desk { display: inline; }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-left: auto; font-size: 16px; }
  .nav-item { position: relative; }
  /* ── 磁吸印章滑块（2026-10-29）─────────────────────────────────
     「当前态」不再只是文字变红 + 下划线，而是一枚吸过去的淡朱砂印：
     ① 印泥底（rgba 朱砂 .1）+ 细印框，不遮文字、不反转颜色 —— 中式印是「盖章在纸上」，不是「高亮选中」；
     ② 位移曲线用 --ease-magnet（轻微回弹），才有「磁吸」手感；
     ③ 仅桌面端显示，移动抽屉里这颗元素被 display:none 掉；
     ④ JS 未激活时 opacity:0，无 JS 环境零痕迹。 */
  nav { position: relative; }
  .nav-magnet { position: absolute; top: 50%; left: 0; width: 0; height: 52px; transform: translate(0, -50%); border-radius: var(--radius-md); background: rgba(165, 72, 59, .09); border: 1px solid rgba(165, 72, 59, .16); box-shadow: inset 0 0 14px rgba(165, 72, 59, .06); opacity: 0; pointer-events: none; transition: transform .38s var(--ease-magnet), width .38s var(--ease-magnet), opacity .25s ease; }
  .nav-magnet.on { opacity: 1; }
  .nav-magnet::after { content: ''; position: absolute; left: 50%; bottom: 7px; width: 16px; height: 2px; transform: translateX(-50%); background: var(--cinnabar); border-radius: 1px; opacity: .55; }
  nav a { display: flex; flex-direction: column; gap: 2px; white-space: nowrap; line-height: inherit; font-weight: inherit; }
  .nav-dropdown { z-index: 6; }
  .nav-dropdown a { flex-direction: column; }
  nav a small { color: var(--ink-soft); font-size: 12px; letter-spacing: .02em; }
  .footer-grid a small { color: var(--ink-soft); font-size: 10px; letter-spacing: .02em; }
  nav a:hover, nav a:hover small, nav a.current, nav a.current small { color: var(--cinnabar); }
  nav a.current { border-bottom: 1px solid var(--cinnabar); padding-bottom: 5px; }
  .nav-dropdown { position: absolute; top: calc(100% + 16px); left: -16px; min-width: 190px; padding: 12px 16px; background: rgba(250,247,240,.98); border: 1px solid var(--line); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .25s ease, transform .25s ease, visibility .25s ease; }
  .nav-dropdown a { padding: 9px 0; border-bottom: 1px solid var(--line-soft); font-size: 13px; min-height: 44px; }
  .nav-dropdown a:last-child { border-bottom: 0; }
  .nav-item:hover .nav-dropdown, .nav-item:focus-within .nav-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .menu-toggle { display: none; margin-left: auto; background: transparent; border: 1px solid var(--ink); color: var(--ink); padding: 9px 12px; min-height: 44px; }  /* 桌面端工具区：心愿单 + 搜索。
     不放进主导航 —— 业主要求 4 个导航项保持不动（2026-10-08 裁决）。 */
  .header-tools { display: flex; align-items: center; gap: 4px; margin-left: 6px; padding-left: 16px; border-left: 1px solid var(--line); }
  .header-tools button { display: flex; align-items: center; gap: 7px; min-height: 44px; padding: 0 10px; border: 0; background: transparent; color: var(--ink-soft); font: inherit; font-size: 13px; cursor: pointer; }
  .header-tools button:hover { color: var(--cinnabar); }
  .header-tools button > span[aria-hidden] { font-size: 17px; line-height: 1; }
  .wishlist-entry-count { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; background: var(--cinnabar); color: var(--paper-light); border-radius: 9px; font: 11px var(--font-mono); }
  .wishlist-entry-count[hidden] { display: none; }
  /* 搜索面板打开时锁住页面滚动 */
  body.drawer-open { overflow: hidden; }
  .back-btn { display: none; }
  .site-footer { border-top: 1px solid var(--line); padding: 80px 0 24px; margin-top: 0; }

  /* 内页精简页脚（2026-10-14）：只有首页保留完整页脚，
     内页收成一行版权 + 三个必要入口，避免同一块内容反复出现。 */
  .site-footer.is-slim { padding: 26px 0 24px; }
  .footer-slim { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 26px; }
  .footer-slim-copy { color: var(--muted); font-size: 11.5px; letter-spacing: .04em; }
  .footer-slim-nav { display: flex; flex-wrap: wrap; gap: 20px; }
  .footer-slim-nav a { color: var(--ink-soft); font-size: 12px; letter-spacing: .04em; }
  .footer-slim-nav a:hover { color: var(--cinnabar); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 36px; align-items: start; }
  .footer-grid a { display: flex; flex-direction: column; gap: 2px; margin: 10px 0; color: var(--ink-soft); min-height: 44px; justify-content: center; }
  .footer-contact p { color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
  /* 2026-10-16 联系区排版：邮箱提级为醒目主入口；二维码与微信文字并排；指引与政策分组 */
  .footer-contact .footer-email { display: inline-block; min-height: 0; margin: 10px 0 4px; font-size: 17px; color: var(--ink); border-bottom: 1px solid var(--line); }
  .footer-contact .footer-email:hover { color: var(--cinnabar); border-bottom-color: var(--cinnabar); }
  .footer-wechat { display: flex; align-items: center; gap: 16px; margin: 10px 0 4px; }
  .footer-wechat p { margin: 0; }
  .footer-hint { color: var(--muted); margin-top: 8px; }
  /* ⚠️ .footer-grid a 会给所有后链接上 display:flex + min-height:44px，
     行内说明里的链接因此被撑成一个个高块（2026-10-16 截图实测）。
     这里强制回行内，字号也回到正文，不让它像「按钮墙」。 */
  .footer-hint a { display: inline; min-height: 0; margin: 0; color: var(--cinnabar); border-bottom: 1px solid var(--cinnabar); }
  .footer-contact a[href^="/custom-commission"] { color: var(--cinnabar); border-bottom: 1px solid var(--cinnabar); }
  .footer-policy { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line-soft); display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .footer-policy a { color: var(--cinnabar); font-size: 13px; border-bottom: 1px solid var(--cinnabar); display: inline-block; margin: 0; min-height: 0; }
  /* 2026-11-01 业主：页脚微信区下方的功能入口统一成胶囊按钮组（含「我的收藏」）。
     设计要点（skill 规范）：
       · 淡纸底 + 细边框的轻胶囊，朱砂只做 hover 态——七个入口不能变成「按钮墙」；
       · ⚠️ 必须覆盖 .footer-grid a 的 display:flex / min-height:44px（见上 10-16 注释），
         否则胶囊被撑成高块；
       · button 与 a 同样式，保证「我的收藏」和其他入口视觉完全一致。 */
  .site-footer .footer-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line-soft); }
  /* .site-footer .footer-pill（0-2-0/0-2-1）压过 .footer-grid a（0-1-1）的 flex + 44px 撑高 */
  .site-footer .footer-pill, .footer-grid a.footer-pill { display: inline-flex; align-items: center; flex-direction: row; gap: 0; min-height: 0; margin: 0; padding: 7px 16px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255, 255, 255, .62); color: var(--ink-soft); font: inherit; font-size: 13px; letter-spacing: .03em; line-height: 1.4; text-decoration: none; cursor: pointer; transition: color .2s, border-color .2s, background-color .2s; }
  .site-footer .footer-pill:hover, .footer-grid a.footer-pill:hover { color: var(--cinnabar); border-color: rgba(192, 57, 43, .45); background: rgba(192, 57, 43, .05); }
  .footer-pill[hidden] { display: none; }
  /* 2026-10-28：页脚「继续看」区。给 /scenes/ /seasons/ /works/ 三个此前零入链的页面
     一个可见入口。字号与 footer-policy 同级但不用朱砂色，避免和合规链接抢注意力。 */
  .footer-explore { margin-top: 20px; display: flex; flex-direction: column; gap: 6px; }
  .footer-explore .eyebrow { color: var(--meta); font-size: 12px; letter-spacing: .12em; }
