---
import '../styles/global.css';
// 自托管 Web 字体：跨系统（iOS / 鸿蒙 / 安卓 / 桌面）统一渲染，中文分片按需加载
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import { navItems } from '../data/content';
import { siteContact } from '../data/site';
import Newsletter from '../components/Newsletter.astro';
import FloatingConsultation from '../components/FloatingConsultation.astro';
import ShareButton from '../components/ShareButton.astro';
import WishlistDrawer from '../components/WishlistDrawer.astro';
import SearchModal from '../components/SearchModal.astro';
const { title = '小民艺术｜日常之礼', description = '小民艺术，以亲笔书写为起点的东方日常之礼。见字如面，心意表达。', canonical, image = '/assets/images/og-image.png', noindex = false, breadcrumbs = [] } = Astro.props;
const seoTitle = title.replace(/xiaominart/gi, 'XIAOMINART');
const url = canonical ?? Astro.url.href;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => { const normalized = href.replace(/\/$/, '') || '/'; return currentPath === normalized || (normalized !== '/' && currentPath.startsWith(`${normalized}/`)); };

// ── 面包屑全站兜底（T-06，2026-10-07）──
// 显式传入 breadcrumbs 的页面照旧；未传入的页面按路径自动生成：
// 深度 1（/about/）→ 首页 / 关于我们；深度 2+（/seasons/spring/）→ 首页 / 四季节气 / {title 首段}。
const SECTION_LABELS: Record<string, string> = {
  'about': '关于我们', 'art-direction': '艺术方向', 'business-gifts': '企业礼赠', 'contact': '联系我们',
  'custom-commission': '定制创作', 'gift-guide': '选礼指南', 'gifts': '小民好礼', 'help': '帮助中心',
  'pricing-guide': '价格参考', 'progress': '定制进度', 'referral': '分享推荐', 'scenes': '灵感参考',
  'stories': '墙上的故事', 'wishlist': '心愿单', 'works': '作品档案', 'your-story': '心事成字',
  'artists': '艺术家', 'blessings': '祝愿字典', 'seasons': '四季节气', 'occasions': '送礼场合',
  'recipients': '送礼对象', 'partners': '机构合作', 'channel': '购买渠道',
};
const PATH_LABELS: Record<string, string> = {
  '/partners/cases/': '合作案例', '/partners/heritage/': '非遗面塑活动',
  '/partners/museum-tourism/': '博物馆与文旅', '/partners/publishing/': '出版社插画',
};
const autoBreadcrumbs = (() => {
  if (breadcrumbs.length > 0) return breadcrumbs;
  if (currentPath === '/') return [];
  const segments = currentPath.split('/').filter(Boolean);
  const pathKey = `${currentPath}/`;
  const leaf = PATH_LABELS[pathKey] ?? title.split('｜')[0];
  if (segments.length === 1) return [{ name: '首页', href: '/' }, { name: SECTION_LABELS[segments[0]] ?? leaf, href: Astro.url.pathname }];
  const section = SECTION_LABELS[segments[0]];
  if (!section) return [];
  return [{ name: '首页', href: '/' }, { name: section, href: `/${segments[0]}/` }, { name: leaf, href: Astro.url.pathname }];
})();
const effectiveBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : autoBreadcrumbs;

// ── 数据分析脚手架（T-05，2026-10-07）──
// 三套分析工具都在 Cloudflare Pages 环境变量里配 PUBLIC_* 值即生效，不配则零注入（现状）。
// 接入步骤、UTM 规范与 CSP 域名要求见 docs/数据分析接入指南.md。
const gaId = import.meta.env.PUBLIC_GA4_ID as string | undefined;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC as string | undefined;
const umamiId = import.meta.env.PUBLIC_UMAMI_ID as string | undefined;
const clarityId = import.meta.env.PUBLIC_CLARITY_ID as string | undefined;
---
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="XIAOMINART" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="小民艺术 XIAOMINART｜见字如面，郑重表达" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? Astro.url).href} />
    <meta name="theme-color" content="#f4efe5" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [ { '@type': 'LocalBusiness', name: '小民艺术', alternateName: 'Xiaomin Art', description, url: new URL('/', Astro.site ?? Astro.url).href, logo: new URL('/assets/brand/xiaominart-logo.png', Astro.site ?? Astro.url).href, email: 'hi@xiaominart.com', priceRange: '咨询制', areaServed: 'CN' }, { '@type': 'WebSite', name: '小民艺术 XIAOMINART', alternateName: 'XIAOMINART', url: new URL('/', Astro.site ?? Astro.url).href, inLanguage: 'zh-CN' } ] })} />
    {effectiveBreadcrumbs.length > 0 && <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: effectiveBreadcrumbs.map((item: { name: string; href: string }, i: number) => ({ '@type': 'ListItem', position: i + 1, name: item.name, item: new URL(item.href, Astro.site ?? Astro.url).href })) })} />}
    {gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${gaId}');`}></script>}
    {umamiSrc && umamiId && <script is:inline defer data-website-id={umamiId} src={umamiSrc}></script>}
    {clarityId && <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];if(y&&y.parentNode){y.parentNode.insertBefore(t,y);}})(window,document,"clarity","script","${clarityId}");`}></script>}
    <link rel="icon" href="/assets/brand/xiaominart-logo-icon.svg" />
    <title>{seoTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header" data-component="site-header">
      <div class="container header-inner">
        <button class="back-btn" type="button" data-back-button aria-label="返回上一页"><span class="back-arrow" aria-hidden="true">‹</span>返回</button>
        <a class="brand" href="/" aria-label="小民艺术｜日常之礼首页"><img class="brand-logo" src="/assets/brand/xiaominart-logo.png" width="270" height="51" alt="小民艺术 XIAOMINART｜方寸之境，也藏山河" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">菜单 / Menu</button>
        <nav id="site-nav" aria-label="主导航">
          {navItems.map((item) => <div class="nav-item"><a href={item.href} class:list={{ current: isCurrent(item.href) }} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.zh}</span><small lang="en">{item.en}</small></a>{item.children?.length ? <div class="nav-dropdown">{item.children.map((child) => <a href={child.href}><span>{child.zh}</span><small lang="en">{child.en}</small></a>)}</div> : null}</div>)}
        </nav>
        {/* 桌面端没有移动底栏，心愿单需要一个常驻入口：
            它不能塞进主导航（业主明确要求保持 4 个导航项不动），
            因此做成导航右侧的图标按钮，与移动底栏的「心愿单」开的是同一个抽屉。 */}
        <div class="header-tools">
          <button class="wishlist-entry" type="button" data-wishlist-open aria-label="打开心愿单">
            <span aria-hidden="true">♡</span>
            <span class="wishlist-entry-zh">心愿单</span>
            <span class="wishlist-entry-count" data-wishlist-count hidden></span>
          </button>
          <button class="search-entry" type="button" data-search-open aria-label="搜索站内内容（快捷键 Ctrl 或 ⌘ 加 K）">
            <span aria-hidden="true">⌕</span>
            <span class="search-entry-zh">搜索</span>
          </button>
        </div>
      </div>
    </header>
    {/* noindex 的功能页（心愿单、进度查询、内部后台）不进搜索索引：
        它们的内容依赖 localStorage 或查询码，索引下来只会是空壳，
        搜索命中后点进去反而看到空白页。用 noindex 这个已有信号统一判定，
        避免每加一个功能页就忘了标一次 data-pagefind-ignore。 */}
    <main id="main" data-pagefind-ignore={noindex ? '' : undefined}><slot /></main>
    <FloatingConsultation />
    <ShareButton />
    <WishlistDrawer />
    <SearchModal />
    <nav class="mobile-shopping-bar" aria-label="移动端底部导航"><a href="/gifts/" aria-label="浏览小民好礼"><span class="bar-zh">礼物</span><small lang="en">Gifts</small></a><button class="wishlist-bar" type="button" data-wishlist-open aria-label="打开心愿单"><span class="bar-zh">心愿单</span><small lang="en">Saved <span data-wishlist-count></span></small></button><button class="wechat-link" type="button" aria-controls="wechat-sheet" aria-expanded="false" aria-label="加微信直接聊"><span class="bar-zh">微信直联</span><small lang="en">WeChat</small></button><button class="bar-share" type="button" data-share-button data-event="share_click" aria-label="分享本页给微信好友或朋友圈"><span class="bar-zh">分享</span><small lang="en">Share</small></button></nav>
    <div class="wechat-sheet" id="wechat-sheet" role="dialog" aria-modal="true" aria-labelledby="wechat-sheet-title" hidden>
      <div class="wechat-sheet-card">
        <button class="wechat-sheet-close" type="button" aria-label="关闭">×</button>
        <span class="eyebrow">WeChat / 微信直联</span>
        <h2 id="wechat-sheet-title" class="serif">想快点聊上，加微信最快。</h2>
        <a class="wechat-sheet-qr" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img src={siteContact.wechatQr} width="176" height="176" alt="小民艺术微信二维码" loading="lazy" /></a>
        <p class="wechat-sheet-hint">长按上方二维码识别添加，备注一句来意即可。</p>
        {siteContact.wechatId ? <div class="wechat-sheet-id"><code data-wechat-id>{siteContact.wechatId}</code><button class="btn btn-secondary btn-sm" type="button" data-copy-wechat>复制微信号</button></div> : null}
        <p class="wechat-sheet-note">不方便加微信也可以<a href="/custom-commission/">提交定制咨询</a>，留下联系方式，我们主动找你。</p>
      </div>
    </div>
    <footer class="site-footer" data-component="site-footer">
      <div class="container footer-grid">
        <div><p class="eyebrow">XIAOMINART / 日常之礼</p><p class="footer-claim serif">愿你在这方寸之间，<br />找到属于自己的定制心意。</p></div>
        <div class="footer-contact"><p class="eyebrow">Contact / 联系</p><a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>{siteContact.wechatId ? <p>微信 / 企业微信：<strong>{siteContact.wechatId}</strong>（备注来意，尽快回复）</p> : siteContact.wechatQr ? <p>微信 / 企业微信：扫码添加（备注来意，尽快回复）</p> : <p>微信 / 企业微信：提交<a href="/custom-commission/">定制咨询表单</a>并留下你的微信号，我们会主动添加你。</p>}{siteContact.wechatQr ? <a class="wechat-qr-link" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img class="wechat-qr" src={siteContact.wechatQr} width="112" height="112" alt="小民艺术微信二维码" loading="lazy" /></a> : null}<p>送礼问题可先从送礼指南开始；需要个性化建议，可提交咨询。</p><button class="ink-seek footer-seek" type="button" aria-controls="quick-message" aria-expanded="false">或先说一句想说的话 →</button></div>
      </div>
      <div class="container trust-signals" aria-label="信息边界 / Information boundaries"><div><span class="eyebrow">Artist / 艺术家</span><strong>由具体创作方向与沟通内容开始</strong></div><div><span class="eyebrow">Projects / 项目</span><strong>已确认内容才会公开呈现</strong></div><div class="trust-privacy"><span class="eyebrow">Privacy / 隐私</span><strong>客户故事与图像获得授权后发布</strong></div><p>我们不使用未经核验的客户数量、媒体曝光或合作机构作为背书。</p></div>
      <div class="container footer-newsletter"><Newsletter /></div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} XIAOMINART | 守艺 · 传情</span><span>世间无双，只此一幅 | Every piece is one of a kind.</span></div>
    </footer>
  </body>
</html>
<script>
  import { trackEvent } from '../scripts/cloud-forms';
  import { readWishlist, onWishlistChange } from '../scripts/wishlist';
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#site-nav');
  const closeMenu = () => { if (!toggle || !nav) return; toggle.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); document.body.classList.remove('menu-open'); };
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); document.body.classList.toggle('menu-open', open); });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  // 移动端返回键：非首页显示，优先浏览器历史回退，无历史则回首页
  const backBtn = document.querySelector<HTMLButtonElement>('[data-back-button]');
  if (backBtn) {
    if (window.location.pathname === '/') backBtn.remove();
    else backBtn.addEventListener('click', () => { if (window.history.length > 1) window.history.back(); else window.location.href = '/'; });
  }
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    revealItems.forEach((item) => revealObserver.observe(item));
  } else revealItems.forEach((item) => item.classList.add('is-visible'));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
  document.querySelectorAll<HTMLElement>('[data-event]').forEach((element) => element.addEventListener('click', () => {
    const eventName = element.dataset.event;
    if (!eventName) return;
    window.dispatchEvent(new CustomEvent('xiaominart:event', { detail: { name: eventName, path: window.location.pathname, slot: element.dataset.slot, channel: element.dataset.channel } }));
  }));
  // 站内所有交互事件统一在这里汇入上报（只上报核心漏斗的 6 个，服务端另有白名单）
  window.addEventListener('xiaominart:event', (event) => {
    const detail = ((event as CustomEvent).detail || {}) as Record<string, unknown>;
    const name = typeof detail.name === 'string' ? detail.name : '';
    if (!name) return;
    const data: Record<string, unknown> = {};
    Object.entries(detail).forEach(([key, value]) => { if (key !== 'name' && value) data[key] = value; });
    trackEvent(name, data);
  });
  // 移动端「微信直联」弹层（WO-P0-04）
  // 触点：底栏按钮 → 弹出二维码 + 可选微信号复制。微信内打开时提示「长按识别」，
  // 其他浏览器补一句「截图后用微信扫一扫」，因为站内无法直接唤起微信加好友。
  const wechatTrigger = document.querySelector<HTMLButtonElement>('.wechat-link');
  const wechatSheet = document.querySelector<HTMLElement>('#wechat-sheet');
  const closeWechat = () => { if (!wechatSheet || !wechatTrigger) return; wechatSheet.hidden = true; wechatTrigger.setAttribute('aria-expanded', 'false'); };
  wechatTrigger?.addEventListener('click', () => {
    if (!wechatSheet) return;
    wechatSheet.hidden = false;
    wechatTrigger.setAttribute('aria-expanded', 'true');
    window.dispatchEvent(new CustomEvent('xiaominart:event', { detail: { name: 'wechat_direct_open', path: window.location.pathname } }));
    wechatSheet.querySelector<HTMLButtonElement>('.wechat-sheet-close')?.focus();
  });
  wechatSheet?.querySelector('.wechat-sheet-close')?.addEventListener('click', closeWechat);
  wechatSheet?.addEventListener('click', (event) => { if (event.target === wechatSheet) closeWechat(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeWechat(); });
  // 一键复制微信号：成功与否都给明确反馈（失败时回退为选中文本，方便手动复制）
  const copyWechatBtn = document.querySelector<HTMLButtonElement>('[data-copy-wechat]');
  copyWechatBtn?.addEventListener('click', async () => {
    const id = document.querySelector<HTMLElement>('[data-wechat-id]')?.textContent?.trim() || '';
    if (!id) return;
    const restore = () => setTimeout(() => { if (copyWechatBtn) copyWechatBtn.textContent = '复制微信号'; }, 1800);
    try {
      await navigator.clipboard.writeText(id);
      copyWechatBtn.textContent = '已复制 ✓';
      window.dispatchEvent(new CustomEvent('xiaominart:event', { detail: { name: 'wechat_id_copy', path: window.location.pathname } }));
      restore();
    } catch {
      // 剪贴板不可用（非 HTTPS 或权限被拒）时，选中文本让用户手动复制，不留死路
      const node = document.querySelector<HTMLElement>('[data-wechat-id]');
      if (node) {
        const range = document.createRange();
        range.selectNodeContents(node);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      copyWechatBtn.textContent = '长按上方号码复制';
      restore();
    }
  });
  // 底栏 / 桌面导航的心愿单角标。
  // 读写与订阅统一走 src/scripts/wishlist.ts —— 此前这里是第 4 份独立实现，
  // 抽屉上线后必须与其他三处共享同一份逻辑，否则会出现「抽屉里移除了一件、
  // 角标却还停在旧数字」的状态不同步。
  const updateWishlistCount = () => {
    const count = readWishlist().length;
    document.querySelectorAll<HTMLElement>('[data-wishlist-count]').forEach((node) => {
      node.textContent = String(count);
      // 桌面端是胶囊数字，0 时整颗隐藏；移动端底栏是文字后缀，0 时留空即可
      if (node.classList.contains('wishlist-entry-count')) node.hidden = count === 0;
    });
  };
  updateWishlistCount();
  onWishlistChange(updateWishlistCount);
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 5; background: rgba(244, 239, 229, .96); border-bottom: 1px solid var(--line); backdrop-filter: blur(8px); }
  .header-inner { min-height: 80px; display: flex; align-items: center; gap: 26px; }
  .brand { display: flex; align-items: center; min-width: 280px; flex-shrink: 0; }
  .brand-logo { display: block; width: 270px; height: auto; }
  .brand-subtitle { color: var(--ink-soft); width: 280px; font-size: 12px; letter-spacing: .08em; line-height: 1.3; white-space: nowrap; text-align: left; }
  .mobile-shopping-bar { display: none; }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-left: auto; font-size: 16px; }
  .nav-item { position: relative; }
  nav a { display: flex; flex-direction: column; gap: 2px; white-space: nowrap; line-height: inherit; font-weight: inherit; }
  .nav-dropdown { z-index: 6; }
  .nav-dropdown a { flex-direction: column; }
  nav a small { color: var(--ink-soft); font-size: 12px; letter-spacing: .02em; }
  .footer-grid a small { color: var(--ink-soft); font-size: 10px; letter-spacing: .02em; }
  nav a:hover, nav a:hover small, nav a.current, nav a.current small { color: var(--cinnabar); }
  nav a.current { border-bottom: 1px solid var(--cinnabar); padding-bottom: 5px; }
  .nav-dropdown { position: absolute; top: calc(100% + 16px); left: -16px; min-width: 190px; padding: 12px 16px; background: rgba(250,247,240,.98); border: 1px solid var(--line); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .25s ease, transform .25s ease, visibility .25s ease; }
  .nav-dropdown a { padding: 9px 0; border-bottom: 1px solid var(--line-soft); font-size: 13px; min-height: 44px; }
  .nav-dropdown a:last-child { border-bottom: 0; }
  .nav-item:hover .nav-dropdown, .nav-item:focus-within .nav-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .menu-toggle { display: none; margin-left: auto; background: transparent; border: 1px solid var(--ink); color: var(--ink); padding: 9px 12px; min-height: 44px; }
  /* 桌面端工具区：心愿单 + 搜索。
