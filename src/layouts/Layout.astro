---
import '../styles/global.css';
import { navItems } from '../data/content';
import { siteContact } from '../data/site';
import Newsletter from '../components/Newsletter.astro';
import FloatingConsultation from '../components/FloatingConsultation.astro';
import ShareButton from '../components/ShareButton.astro';
const { title = '小民艺术｜日常之礼', description = '小民艺术，以亲笔书写为起点的东方日常之礼。见字如面，心意表达。', canonical, image = '/assets/images/og-image.png', noindex = false } = Astro.props;
const seoTitle = title.replace(/xiaominart/gi, 'XIAOMINART');
const url = canonical ?? Astro.url.href;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => { const normalized = href.replace(/\/$/, '') || '/'; return currentPath === normalized || (normalized !== '/' && currentPath.startsWith(`${normalized}/`)); };
---
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="XIAOMINART" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="小民艺术 XIAOMINART｜见字如面，郑重表达" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? Astro.url).href} />
    <meta name="theme-color" content="#f4efe5" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'LocalBusiness', name: '小民艺术', alternateName: 'Xiaomin Art', description, url, email: 'hi@xiaominart.com', priceRange: '咨询制', areaServed: 'CN' })} />
    <link rel="icon" href="/assets/brand/xiaominart-logo-icon.svg" />
    <title>{seoTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header" data-component="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="小民艺术｜日常之礼首页"><img class="brand-logo" src="/assets/brand/xiaominart-logo.svg" width="270" height="51" alt="小民艺术 XIAOMINART｜方寸之境，也藏山河" /></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">菜单 / Menu</button>
        <nav id="site-nav" aria-label="主导航">
          {navItems.map((item) => <div class="nav-item"><a href={item.href} class:list={{ current: isCurrent(item.href) }} aria-current={isCurrent(item.href) ? 'page' : undefined}><span>{item.zh}</span><small lang="en">{item.en}</small></a>{item.children?.length ? <div class="nav-dropdown">{item.children.map((child) => <a href={child.href}><span>{child.zh}</span><small lang="en">{child.en}</small></a>)}</div> : null}</div>)}
        </nav>
        <a class="header-cta" href="/contact/" data-event="commission_open">与我们聊聊 <span>→</span></a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <FloatingConsultation />
    <ShareButton />
    <nav class="mobile-shopping-bar" aria-label="移动端底部导航"><a href="/gifts/" aria-label="浏览小民好礼"><span class="bar-zh">礼物</span><small lang="en">Gifts</small></a><a href="/scenes/" aria-label="浏览生活场景"><span class="bar-zh">场景</span><small lang="en">Scenes</small></a><a href="/journal/" aria-label="阅读静气生活"><span class="bar-zh">故事</span><small lang="en">Stories</small></a><a href="/gift-guide/#wishlist" aria-label="我的心愿单"><span class="bar-zh">我的</span><small lang="en">Mine <span data-wishlist-count></span></small></a></nav>
    <footer class="site-footer" data-component="site-footer">
      <div class="container footer-grid">
        <div><p class="eyebrow">XIAOMINART / 日常之礼</p><p class="footer-claim serif">愿你在这方寸之间，<br />找到属于自己的山河。</p><p class="muted">方寸之境，也藏山河。A quiet corner for what you want to say.</p></div>
        <div><p class="eyebrow">Explore</p>{navItems.slice(0, 5).map((item) => <a href={item.href}>{item.zh}<small lang="en">{item.en}</small></a>)}</div>
        <div><p class="eyebrow">Connect</p><a href="/gift-guide/">送礼指南 / Gift Guide</a><a href="/journal/">静气生活 / Quiet Living</a><a href="/business-gifts/">企业礼赠 / Business Gifts</a><a href="/about/">关于我们 / About</a><a href="/contact/">联系 / Contact</a><a href="/help/">FAQ / 常见问题</a><a class="footer-cta" href="/contact/">与我们聊聊 →</a></div>
        <div class="footer-contact"><p class="eyebrow">Contact / 联系</p><a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>{siteContact.wechatId ? <p>微信 / 企业微信：<strong>{siteContact.wechatId}</strong>（备注来意，尽快回复）</p> : siteContact.wechatQr ? <p>微信 / 企业微信：扫码添加（备注来意，尽快回复）</p> : <p>微信 / 企业微信：提交<a href="/custom-commission/">定制咨询表单</a>并留下你的微信号，我们会主动添加你。</p>}{siteContact.wechatQr ? <a class="wechat-qr-link" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img class="wechat-qr" src={siteContact.wechatQr} width="112" height="112" alt="小民艺术微信二维码" loading="lazy" /></a> : null}<p>送礼问题可先从送礼指南开始；需要个性化建议，可提交咨询。</p></div>
      </div>
      <div class="container trust-signals" aria-label="信息边界 / Information boundaries"><div><span class="eyebrow">Artist / 艺术家</span><strong>由具体创作方向与沟通内容开始</strong></div><div><span class="eyebrow">Projects / 项目</span><strong>已确认内容才会公开呈现</strong></div><div><span class="eyebrow">Privacy / 隐私</span><strong>客户故事与图像获得授权后发布</strong></div><p>我们不使用未经核验的客户数量、媒体曝光或合作机构作为背书。</p></div>
      <div class="container"><Newsletter /></div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} XIAOMINART | 守艺 · 传情</span><span>世间无双，只此一幅 | Every piece is one of a kind, inspired by real stories.</span></div>
    </footer>
  </body>
</html>
<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#site-nav');
  const closeMenu = () => { if (!toggle || !nav) return; toggle.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); document.body.classList.remove('menu-open'); };
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('open', open); document.body.classList.toggle('menu-open', open); });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealObserver = new IntersectionObserver((entries, observer) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    revealItems.forEach((item) => revealObserver.observe(item));
  } else revealItems.forEach((item) => item.classList.add('is-visible'));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
  document.querySelectorAll<HTMLElement>('[data-event]').forEach((element) => element.addEventListener('click', () => {
    const eventName = element.dataset.event;
    if (!eventName) return;
    window.dispatchEvent(new CustomEvent('xiaominart:event', { detail: { name: eventName, path: window.location.pathname } }));
  }));
  const wishlistKey = 'xiaominart-wishlist';
  const readWishlist = (): string[] => { try { return JSON.parse(localStorage.getItem(wishlistKey) || '[]'); } catch { return []; } };
  const updateWishlistCount = () => document.querySelectorAll<HTMLElement>('[data-wishlist-count]').forEach((node) => { node.textContent = String(readWishlist().length); });
  updateWishlistCount();
  window.addEventListener('storage', updateWishlistCount);
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 5; background: rgba(244, 239, 229, .96); border-bottom: 1px solid var(--line); backdrop-filter: blur(8px); }
  .header-inner { min-height: 80px; display: flex; align-items: center; gap: 26px; }
  .brand { display: flex; align-items: center; min-width: 280px; flex-shrink: 0; }
  .brand-logo { display: block; width: 270px; height: auto; }
  .brand-subtitle { color: var(--ink-soft); width: 280px; font-size: 12px; letter-spacing: .08em; line-height: 1.3; white-space: nowrap; text-align: left; }
  .mobile-shopping-bar { display: none; }
  nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-left: auto; font-size: 16px; }
  .nav-item { position: relative; }
  nav a { display: flex; flex-direction: column; gap: 2px; white-space: nowrap; line-height: inherit; font-weight: inherit; }
  .nav-dropdown { z-index: 6; }
  .nav-dropdown a { flex-direction: column; }
  nav a small { color: var(--ink-soft); font-size: 12px; letter-spacing: .02em; }
  .footer-grid a small { color: var(--ink-soft); font-size: 10px; letter-spacing: .02em; }
  nav a:hover, nav a:hover small, nav a.current, nav a.current small, .header-cta:hover { color: var(--cinnabar); }
  nav a.current { border-bottom: 1px solid var(--cinnabar); padding-bottom: 5px; }
  .nav-dropdown { position: absolute; top: calc(100% + 16px); left: -16px; min-width: 190px; padding: 12px 16px; background: rgba(250,247,240,.98); border: 1px solid var(--line); box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .25s ease, transform .25s ease, visibility .25s ease; }
  .nav-dropdown a { padding: 9px 0; border-bottom: 1px solid var(--line-soft); font-size: 13px; min-height: 44px; }
  .nav-dropdown a:last-child { border-bottom: 0; }
  .nav-item:hover .nav-dropdown, .nav-item:focus-within .nav-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
  .header-cta { border-bottom: 1px solid var(--cinnabar); padding: 3px 0; color: var(--cinnabar); font-size: 13px; white-space: nowrap; }
  .header-cta span { margin-left: 8px; }
  .menu-toggle { display: none; margin-left: auto; background: transparent; border: 1px solid var(--ink); padding: 9px 12px; min-height: 44px; }
  .site-footer { border-top: 1px solid var(--line); padding: 80px 0 24px; margin-top: 0; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 36px; }
  .footer-grid a { display: flex; flex-direction: column; gap: 2px; margin: 10px 0; color: var(--ink-soft); min-height: 44px; justify-content: center; }
  .footer-contact p { color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
  .footer-contact a[href^="/custom-commission"] { color: var(--cinnabar); border-bottom: 1px solid var(--cinnabar); }
  .footer-contact .wechat-qr { display: block; border: 1px solid var(--line); background: var(--paper-light); padding: 4px; }
  .footer-contact .wechat-qr-link { display: inline-block; margin: 10px 0 0; min-height: 0; line-height: 0; }
  .footer-contact small { color: var(--muted); font-size: 11px; }
  .social-pending { display: block; min-height: 44px; padding: 10px 0; color: var(--muted); font-size: 12px; border-top: 1px solid var(--line-soft); }
  .trust-signals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); }
  .trust-signals div { display: flex; flex-direction: column; gap: 8px; }
  .trust-signals strong { font-size: 13px; font-weight: 400; color: var(--ink-soft); }
  .trust-signals p { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: 11px; }
  .footer-grid a:hover { color: var(--cinnabar); }
  .footer-cta { color: var(--cinnabar) !important; border-bottom: 1px solid var(--cinnabar); padding-bottom: 4px; }
  .footer-claim { font-size: 39px; line-height: 1.25; margin: 20px 0 8px; }
  .muted { color: var(--ink-soft); }
  .footer-bottom { border-top: 1px solid var(--line); margin-top: 58px; padding-top: 16px; display: flex; justify-content: space-between; gap: 16px; color: var(--ink-soft); font-size: 11px; }
  @media (max-width: 1100px) { .header-inner { gap: 16px; } nav { gap: 12px; font-size: 16px; } .header-cta { display: none; } }
  @media (max-width: 767px) {
    .header-inner { min-height: 72px; position: relative; }
    .brand { display: flex; min-width: 0; max-width: calc(100% - 118px); gap: 5px; align-items: center; }
    .brand-logo { width: clamp(180px, 52vw, 240px); }
    .brand-subtitle { display: none; }
    .menu-toggle { display: block; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 72px; padding: 12px 16px 18px; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
    nav.open { display: grid; gap: 0; }
    nav a { padding: 12px 0; border-bottom: 1px solid var(--line); min-height: 44px; }
    .nav-dropdown { position: static; display: block; opacity: 1; visibility: visible; transform: none; padding: 0 0 4px 16px; border: 0; box-shadow: none; background: transparent; }
    .nav-dropdown a { font-size: 12px; padding: 8px 0; min-height: 44px; }
    nav a:last-child { border-bottom: 0; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-grid > div:first-child { grid-column: 1 / -1; }
    .footer-contact { grid-column: 1 / -1; }
    .trust-signals { grid-template-columns: 1fr; gap: 16px; margin-top: 36px; }
    .trust-signals p { grid-column: auto; }
    .footer-bottom { display: block; }
     .footer-bottom span { display: block; margin-top: 8px; }
     .site-footer { padding-top: 56px; padding-bottom: 92px; }
     .mobile-shopping-bar { position: fixed; top: auto; display: grid; grid-template-columns: repeat(4, 1fr); left: 0; right: 0; bottom: 0; z-index: 8; background: rgba(250, 247, 240, .98); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgba(77, 56, 34, .08); padding: 7px 8px calc(7px + env(safe-area-inset-bottom)); }
     .mobile-shopping-bar a { min-height: 50px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: var(--ink-soft); }
     .mobile-shopping-bar .bar-zh { font-size: 13px; letter-spacing: .12em; }
     .mobile-shopping-bar small { font-size: 9px; color: var(--muted); font-family: var(--font-body-en), sans-serif; letter-spacing: .1em; text-transform: uppercase; }
     .mobile-shopping-bar a:first-child .bar-zh { color: var(--cinnabar); }
     .mobile-shopping-bar span[data-wishlist-count] { color: var(--cinnabar); font-family: var(--font-mono); }
   }
  }
</style>
