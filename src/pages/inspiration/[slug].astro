---
import Layout from '../../layouts/Layout.astro';
import CaseNotice from '../../components/CaseNotice.astro';
import { inspirations, customerStories } from '../../data/content';
export function getStaticPaths(){ return inspirations.map((item) => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const story = customerStories.find((entry) => entry.caseSlug === item.slug);
---
<Layout title={`${item.title}｜灵感参考｜XIAOMINART`} description={item.note}><section class="inspiration-detail container"><div class="detail-image" data-tone={item.slug}><span class="serif">{item.title.slice(0,1)}</span><small>{item.tag}</small></div><div><span class="eyebrow">{item.category}</span><h1 class="serif">{item.title}</h1><p lang="en">{item.en}</p><p>{item.note}</p><CaseNotice /><a class="btn btn-primary" href={`/custom-commission/?inspiration=${encodeURIComponent(item.title)}&tag=${encodeURIComponent(item.tag)}`}>从这个方向开始定制 / Commission from this direction →</a></div></section><section id="client-story" class="container section client-story"><span class="eyebrow">Client story / 客户故事</span><h2 class="serif">从创作过程，到作品如何进入日常。</h2>{story && <div class="story-template"><div><span class="story-placeholder">{story.initials}</span><strong>{story.client}</strong><p>{story.type}</p></div><div><blockquote>“{story.quote}”</blockquote><p lang="en">{story.en}</p><span class="status">{story.status}</span></div></div>}<div class="story-sections"><div><span class="mono">01</span><h3 class="serif">创作过程记录</h3><p>从意图、空间、材质与尺度开始，记录每一次方向确认。公开内容须经客户与艺术家共同授权。</p></div><div><span class="mono">02</span><h3 class="serif">艺术家访谈片段</h3><p>通过提问理解作品为何这样回应具体的人与场景，访谈内容待资料确认后补充。</p></div><div><span class="mono">03</span><h3 class="serif">材质与尺寸说明</h3><p>最终材质、尺寸与交付边界以项目沟通确认为准，不构成现货或同款商品说明。</p></div></div></section><section class="container section detail-note"><span class="eyebrow">Reference only / 仅作参考</span><h2 class="serif">你可以带走的是气息，不是同一件作品。</h2><p>我们会从你的空间、关系、使用场景与预算边界重新讨论形式。参考页不构成商品目录，也不代表同款开放。</p></section></Layout>
<style>.inspiration-detail{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;padding:96px 0 70px}.detail-image{aspect-ratio:1;background:var(--paper-deep);display:grid;place-items:center;align-content:center;position:relative;color:var(--cinnabar)}.detail-image span{font-size:170px}.detail-image small{font:10px var(--font-mono);color:var(--ink-soft)}.inspiration-detail h1{font-size:clamp(52px,7vw,86px);font-weight:500;margin:22px 0 4px}.inspiration-detail p{color:var(--ink-soft);font-size:18px}.inspiration-detail p[lang=en]{font:25px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.inspiration-detail .btn{margin-top:20px}.client-story{border-top:1px solid var(--line)}.client-story h2{font-size:clamp(36px,5vw,64px);font-weight:500;max-width:760px;line-height:1.3;margin:18px 0 36px}.story-template{display:grid;grid-template-columns:1fr 2fr;gap:44px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0}.story-placeholder{width:48px;height:48px;display:grid;place-items:center;border:1px solid var(--line);color:var(--cinnabar);font-family:var(--font-display-zh);margin-bottom:12px}.story-template strong{display:block;font-size:14px;font-weight:500}.story-template p{color:var(--ink-soft);font-size:14px}.story-template blockquote{margin:0 0 8px;color:var(--ink-soft);font-size:18px;line-height:1.8}.story-template p[lang=en]{font:16px/1.55 var(--font-display-en),Georgia,serif;color:var(--muted)}.story-sections{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px}.story-sections h3{font-size:25px;font-weight:500;margin:16px 0 8px}.story-sections p{color:var(--ink-soft);font-size:14px;line-height:1.8}.detail-note{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.detail-note h2{font-size:clamp(36px,5vw,64px);font-weight:500;max-width:760px;line-height:1.3}.detail-note p{max-width:670px;color:var(--ink-soft)}@media(max-width:767px){.inspiration-detail{grid-template-columns:1fr;gap:34px;padding:58px 0 50px}.detail-image span{font-size:120px}.inspiration-detail h1{font-size:54px}.inspiration-detail p[lang=en]{font-size:21px}.inspiration-detail .btn{width:100%}.story-template,.story-sections{grid-template-columns:1fr;gap:24px}.story-template blockquote{font-size:16px}}
</style>
