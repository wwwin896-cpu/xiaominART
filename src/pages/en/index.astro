<style>.en-home{padding:120px 0;min-height:65vh}.en-home h1{font-size:clamp(56px,8vw,100px);font-weight:500;line-height:1.1;margin:24px 0}.en-home p{max-width:640px;color:var(--ink-soft);font:20px/1.8 Georgia,serif}@media(max-width:767px){.en-home{padding:78px 0}.en-home h1{font-size:56px}.en-home p{font-size:18px}}
