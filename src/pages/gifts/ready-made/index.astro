---
import Layout from '../../../layouts/Layout.astro';
import Pic from '../../../components/Pic.astro';
import { readyMadeWorks } from '../../../data/content';
---
<Layout title="现货好礼｜书法小品｜小民艺术" description="已经写好的书法小品，每一幅都独一无二，装裱完成，看中即可直接发货。">
  <section class="container page-head"><span class="eyebrow">Ready to Ship / 现货好礼</span><h1 class="serif">已经写好，<br />等一个懂它的人。</h1><p lang="en">Already written. Ready to go.</p><p>下面这些，是小民已经完成的小幅书法作品。每一幅都只有一件，装裱完成即可直接发货——你在页面上看到的这一幅，就是将来到家的那一幅。</p></section>
  <section class="container section works-section">
    <div class="works-grid">
      {readyMadeWorks.map((work) => <article class="work-card reveal" data-reveal><figure><Pic src={work.sceneImage ?? work.image} alt={work.sceneAlt ?? work.alt} loading="lazy" decoding="async" />{work.sceneImage && <span class="scene-tag">空间示意</span>}</figure><div class="work-copy"><span class="work-badge">现货 · 可直接发货</span><h2 class="serif"><a href={`/gifts/ready-made/${work.slug}/`}>{work.title}</a></h2><p lang="en">{work.en}</p><p class="work-price">¥{work.price} <span>RMB · {work.form === '挂墙' ? '挂墙' : '摆件'}</span></p><p class="work-note">{work.note}</p><a class="work-cta" href={`/gifts/ready-made/${work.slug}/`} data-event="ready_work_click" data-slot={work.slug}>查看详情与价格 →</a></div></article>)}
    </div>
    <p class="works-fineprint">每幅作品均附唯一编号与藏品证书（一物一码）。框体为榫卯结构实木框（无钉无胶），木种有柚木与胡桃木两种，胡桃木色泽更深。页面标价为人民币含装裱价：案头摆件 ¥199（装框后 A4 幅面 21 × 29.7 cm）、圆光小品《禅》¥299（50 × 50 cm）、墙面悬挂 ¥399（60 × 33 cm）；以上均为外框尺寸，具体画心与纸墨细节随作品档案在咨询时提供。</p>
  </section>
  <section class="container section not-sure"><span class="eyebrow">Not found / 没有挑到合适的</span><h2 class="serif">现货之外，还可以从一句话开始，<br />定制一幅只属于你们的。</h2><div class="not-sure-actions"><a class="btn btn-primary" href="/custom-commission/" data-event="custom_entry">进入定制环节 →</a></div></section>
</Layout>
<style>
  .page-head { padding: 90px 0 58px; } .page-head h1 { font-size: clamp(30px, 4vw, 52px); line-height: 1.3; font-weight: 500; margin: 20px 0; } .page-head p { max-width: 700px; color: var(--ink-soft); font-size: 18px; } .page-head p[lang='en'] { font: 24px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); }
  .works-section { border-top: 1px solid var(--line); }
  .works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; align-items: stretch; }
  .work-card { margin: 0; border: 1px solid var(--line); background: var(--paper-light); display: flex; flex-direction: column; }
  .work-card figure { margin: 0; overflow: hidden; background: var(--paper-deep); position: relative; }
  .scene-tag { position: absolute; top: 12px; left: 12px; padding: 3px 9px; background: rgba(250, 248, 243, .92); color: var(--ink-soft); font-size: 11px; letter-spacing: .14em; }
  .work-card img { width: 100%; display: block; transition: transform .6s ease; }
  .work-card:hover img { transform: scale(1.03); }
  .work-copy { padding: 20px 20px 24px; flex: 1; display: flex; flex-direction: column; }
  .work-badge { display: inline-block; padding: 4px 10px; border: 1px solid var(--cinnabar); color: var(--cinnabar-deep); font-size: 11px; letter-spacing: .12em; }
  .work-copy h2 { font-size: 26px; font-weight: 500; line-height: 1.4; margin: 14px 0 2px; }
  .work-copy h2 a { color: inherit; }
  .work-copy h2 a:hover { color: var(--cinnabar); }
  .work-copy p[lang='en'] { font: 15px var(--font-display-en), Georgia, serif; color: var(--ink-soft); margin: 0 0 8px; }
  .work-price { margin: 0 0 12px; color: var(--cinnabar); font: 500 20px var(--font-display-en), var(--font-body-zh); }
  .work-price span { color: var(--ink-soft); font: 12px var(--font-body-zh); letter-spacing: .04em; }
  .work-note { color: var(--ink-soft); font-size: 14px; line-height: 1.85; margin: 0 0 16px; }
  .work-cta { display: inline-block; align-self: flex-start; margin-top: auto; color: var(--cinnabar); font-size: 14px; border-bottom: 1px solid var(--cinnabar); padding-bottom: 3px; }
  .works-fineprint { margin: 26px 0 0; padding: 14px 16px; border-left: 2px solid var(--cinnabar); background: var(--paper-light); color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
  .not-sure { border-top: 1px solid var(--line); } .not-sure h2 { max-width: 820px; font-size: clamp(24px, 3vw, 38px); font-weight: 500; line-height: 1.45; margin: 16px 0 26px; } .not-sure-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 1023px) { .works-grid { grid-template-columns: repeat(2, 1fr); gap: 22px; } }
  @media (max-width: 767px) { .page-head { padding: 56px 0 42px; } .page-head h1 { font-size: 30px; } .page-head p { font-size: 16px; } .page-head p[lang='en'] { font-size: 20px; } .works-grid { grid-template-columns: 1fr; } .work-copy h2 { font-size: 22px; } .not-sure-actions { display: grid; } .not-sure-actions .btn { width: 100%; } }
</style>
