---
import Layout from '../../../layouts/Layout.astro';
import Pic from '../../../components/Pic.astro';
import { getReadyMadeWorks } from '../../../lib/ready-made';
import { siteContact } from '../../../data/site';

export function getStaticPaths() {
  return getReadyMadeWorks().map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
// 推荐位只放仍在售的作品：已售出的推荐出去只会带来无谓询问
const others = getReadyMadeWorks().filter((item) => item.slug !== work.slug && !item.sold).slice(0, 3);
const isWall = work.form === '挂墙';
const isZen = work.slug === 'chan';
// 尺寸按档位由业主确认（2026-10-06）：摆件 A4（21 × 29.7）、圆光《禅》50 × 50、挂墙 60 × 33。
const sizeShape = isZen ? '（圆光方幅）' : isWall ? '' : '（A4 幅面）';
const sizeNote = work.size
  ? `装框后 ${work.size.w} × ${work.size.h} cm${sizeShape}`
  : '以随附作品档案为准';
const sizeFineprint = isWall
  ? '为装框后的外框尺寸，横挂或竖挂皆可；画心尺寸随作品档案提供。'
  : isZen
    ? '为装框后的方形外框尺寸；圆光形制留白较多，画心约为外框的六成。'
    : '为装框后的 A4 幅面外框尺寸；画心尺寸随作品档案提供。';
const material = work.material ?? '手写书法原作（非印刷）· 榫卯结构实木框';
const woodNote = '框体为榫卯结构实木框（无钉无胶），木种为柚木或胡桃木；胡桃木色泽更深、柚木偏暖。如需指定木种，咨询时说明即可。';
const mountNote = isWall
  ? '出厂即装框完成：卡纸留白衬裱，背部预装挂点，随附安装说明，可直接上墙，无需二次装裱。'
  : '出厂即装框完成：可直接立于案头、边柜或博古架，无需二次装裱；如需配支架或挂用配件，咨询时说明即可。';
const packNote = '装框成品以护角与缓冲材料整体包裹，外加加固纸箱寄出；随附唯一编号与藏品证书（一物一码），礼盒包装需求可在咨询时提出。';
const deliverNote = work.sold
  ? '这一幅已售出，不再重复书写同样的内容。如你希望要一件气息接近的作品，可以走定制方向，从你的空间与心意重新讨论；企业批量礼赠另有单独方案。'
  : '现货唯一一件，在册可直接发货；确认后安排寄出。如需要同款的批量礼赠（企业答谢、节日礼盒等），可以走企业礼赠方向另外沟通。';
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${work.title}｜手写书法小品`,
  description: work.note,
  image: [new URL(work.image, Astro.site ?? 'https://xiaominart.com').href],
  brand: { '@type': 'Brand', name: 'XIAOMINART 小民艺术' },
  material,
  ...(work.size
    ? { width: { '@type': 'QuantitativeValue', value: work.size.w, unitCode: 'CMT' }, height: { '@type': 'QuantitativeValue', value: work.size.h, unitCode: 'CMT' } }
    : {}),
  offers: {
    '@type': 'Offer',
    price: work.price,
    priceCurrency: 'CNY',
    // 售出后标 SoldOut：避免搜索引擎与聚合渠道继续把这一幅当在售商品推荐
    availability: work.sold ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    url: new URL(`/gifts/ready-made/${work.slug}/`, Astro.site ?? 'https://xiaominart.com').href,
  },
};
---
<Layout title={`${work.title}｜手写书法小品｜现货好礼｜小民艺术`} description={`${work.title}（${work.en}）：${work.note} 现货唯一一件，装裱完成可直接发货，¥${work.price}。`} breadcrumbs={[{ name: '首页', href: '/' }, { name: '小民好礼', href: '/gifts/' }, { name: '现货好礼', href: '/gifts/ready-made/' }, { name: work.title, href: `/gifts/ready-made/${work.slug}/` }]}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <nav class="container crumb" aria-label="面包屑"><a href="/gifts/">小民好礼</a><span>/</span><a href="/gifts/ready-made/">现货好礼</a><span>/</span><span aria-current="page">{work.title}</span></nav>
  <section class="container work-detail">
    <figure class="detail-figure"><Pic src={work.image} alt={work.alt} loading="eager" decoding="async" /><figcaption>作品实拍 · 装裱完成</figcaption></figure>
    <div class="detail-copy">
      <span class="eyebrow">{work.sold ? 'Sold / 已售出 · 唯一一件' : 'Ready to Ship / 现货唯一一件'}</span>
      <h1 class="serif">{work.title}</h1>
      <p class="en" lang="en">{work.en}</p>
      {
        work.code && (
          <p class="work-code">
            <span class="wc-label">作品编码</span>
            <a class="wc-value" href={`/verify/${work.code}/`} title="查看这件作品的公开档案">
              {work.code}
            </a>
            <span class="wc-year">{work.year} 年创作</span>
          </p>
        )
      }
      {work.sold && <p class="sold-notice"><strong>这一幅已经有主人了。</strong> 现货每幅只写一件，不再重复同样的内容——如果你喜欢它的气息，我们可以按你的空间与心意重新写一件。</p>}
      <p class="price"><span class="price-num">¥{work.price}</span><span class="price-meta">RMB · 含装裱 / {isWall ? '墙面悬挂' : '案头摆件'}{work.sold ? ' · 已售出' : ''}</span></p>
      <p class="note">{work.note}</p>
      {work.sold
        ? <div class="detail-actions"><a class="btn btn-primary" href="/custom-commission/?context=礼赠或纪念&inspiration={encodeURIComponent(`类似「${work.title}」的定制`)}" data-event="custom_inquiry_start" data-slot={`${work.slug}_sold`}>定制一件类似的 →</a><button class="btn btn-secondary" type="button" data-wx-open data-event="ready_work_click" data-slot={work.slug}>想聊这一幅的来龙去脉 →</button><button class="btn btn-secondary wishlist-toggle" type="button" data-wishlist={work.slug} aria-pressed="false">♡ 先存个念想</button></div>
        : <div class="detail-actions"><button class="btn btn-primary" type="button" data-wx-open data-event="ready_work_click" data-slot={work.slug}>咨询这一幅 / 微信直聊 →</button><a class="btn btn-secondary" href="/custom-commission/?context=礼赠或纪念&inspiration={encodeURIComponent(`现货定制 · 类似「${work.title}」`)}">定制类似的 →</a><button class="btn btn-secondary wishlist-toggle" type="button" data-wishlist={work.slug} aria-pressed="false">♡ 先收进心愿单</button></div>}
      <p class="detail-fineprint">{work.sold ? '这一幅已售出并交付，详情页保留作为作品档案。想要气息接近的一件，最直接的方式是走定制——点上方按钮，或按「联系我们」页的微信二维码添加（备注来意）。' : '点「咨询这一幅」弹出微信二维码，扫码即可与我们直接沟通；尺寸与纸墨细节也以随附作品档案为准。'}</p>
      <p class="biz-cross-link">需要同款的批量礼赠（企业答谢、节日礼盒、会议伴手礼）？<a href="/business-gifts/" data-event="ready_to_business">了解企业礼赠与批量定制 →</a></p>
    </div>
  </section>

  {/* ── 字源释读 + 场景联想（2026-10-16 新增）─────────────────────────
      文档要求的作品页三层递进：
        ① 这是什么   → 本区块的「字源释读」
        ② 它可以为你做什么 → 本区块的「场景联想」
        ③ 如果你想拥有它   → 上方详情区的咨询 / 心愿单按钮（已在）

      顺序刻意放在规格（work-facts）**之前**：先讲清「字」，再讲「框」。
      之前的页面从标题直接跳到材质尺寸，跳过了「这个字为什么值得挂」这一步，
      对不懂书法的访客来说，「规格表」读起来像在解释一件他还不想要的东西。

      两个字段都是可选的（见 content.ts 的 ReadyMadeWork 类型注释）：
      未填时整块不渲染，不会留空标题——12 幅现货已全部补齐，但内容后台
      新增的作品可能没填，这里必须容错。 ── */}
  {(work.source || work.sceneFit) && (
    <section class="container section work-source" aria-labelledby="source-title">
      <div class="source-grid">
        {work.source && (
          <div class="source-block">
            <span class="eyebrow">Chapter 01 / 释读</span>
            <div class="source-head">
              <h2 id="source-title" class="serif">这个字，从哪儿来。</h2>
              <span class="source-char serif" aria-hidden="true">{work.source.char}</span>
            </div>
            <p class="source-origin"><span class="mono">{work.source.origin}</span></p>
            <p class="source-note">{work.source.note}</p>
            <p class="source-foot">字源考据为简释版；完整释读随作品档案一并提供，也可在咨询时向我们索取。</p>
          </div>
        )}
        {work.sceneFit && (
          <div class="scene-block">
            <span class="eyebrow">Chapter 02 / 陈设</span>
            <h2 class="serif">它可以为你做什么。</h2>
            <p class="scene-fit">{work.sceneFit}</p>
            <ul class="scene-list">
              <li>一件世间唯一的手写原作，不是印刷复制品</li>
              <li>出厂即装框完成，{isWall ? '可直接上墙' : '可直接立于案头'}，无需二次装裱</li>
              <li>随附唯一编号与藏品证书，可在站内按编码核对</li>
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="container section work-facts" aria-labelledby="facts-title">
    <div class="section-lead"><span class="eyebrow">Work Details / 作品详情</span><h2 id="facts-title" class="serif">关于这一幅，你想知道的都在这里。</h2></div>
    <dl class="facts-grid">
      <div class="fact"><dt><span class="mono">01</span>材质</dt><dd>{material}<em>{woodNote}题字「{work.title}」为手写原作，墨迹有细微浓淡变化，是手写与印刷最大的分别。</em></dd></div>
      <div class="fact"><dt><span class="mono">02</span>尺寸</dt><dd>{sizeNote}<em>{sizeFineprint}</em></dd></div>
      <div class="fact"><dt><span class="mono">03</span>装裱与装帧</dt><dd>{mountNote}</dd></div>
      <div class="fact"><dt><span class="mono">04</span>包装</dt><dd>{packNote}</dd></div>
      <div class="fact"><dt><span class="mono">05</span>价格</dt><dd>¥{work.price} RMB（{isWall ? '挂墙档' : work.title === '禅' ? '圆光摆件档' : '摆件档统一价'}），含装裱，不含运费。</dd></div>
      <div class="fact"><dt><span class="mono">06</span>交付</dt><dd>{deliverNote}</dd></div>
      {
        work.code && (
          <div class="fact">
            <dt><span class="mono">07</span>作品编码</dt>
            <dd>
              <a class="fact-code" href={`/verify/${work.code}/`}>{work.code}</a>
              <em>
                一物一码，印于随附的藏品证书。编码第 4 段为创作年份（{work.year}），末位为校验位。
                可到「作品档案」页按编码核对图像与年份。
              </em>
            </dd>
          </div>
        )
      }
    </dl>
    <div class="facts-cta"><button class="btn btn-primary" type="button" data-wx-open data-event="ready_work_click" data-slot={`${work.slug}_facts`}>有其他问题？微信问我们 →</button></div>
  </section>

  <section class="container section others" aria-labelledby="others-title">
    <div class="section-lead"><span class="eyebrow">More / 还有这些现货</span><h2 id="others-title" class="serif">同批现货，也可一并看看。</h2></div>
    <div class="others-grid">
      {others.map((item) => <a class="other-card" href={`/gifts/ready-made/${item.slug}/`}><figure><Pic src={item.image} alt={item.alt} loading="lazy" decoding="async" /></figure><div><h3 class="serif">{item.title}</h3><p lang="en">{item.en}</p><span class="other-meta">¥{item.price} · {item.form === '挂墙' ? '挂墙' : '摆件'}</span></div></a>)}
    </div>
    <a class="btn btn-link others-back" href="/gifts/ready-made/">看全部现货 →</a>
  </section>

  <dialog class="wx-dialog" data-wx-dialog aria-label="微信咨询">
    <div class="wx-panel">
      <button class="wx-close" type="button" data-wx-close aria-label="关闭">×</button>
      <span class="eyebrow">WeChat / 微信咨询（最快）</span>
      <h2 class="serif">扫码，直接和我们聊。</h2>
      <a class="wx-qr-link" href={siteContact.wechatQr} target="_blank" rel="noopener" title="点击查看大图，长按识别添加"><img class="wx-qr" src={siteContact.wechatQr} width="200" height="200" alt="小民艺术微信二维码" /></a>
      <p class="wx-tip"><strong>微信扫一扫</strong>，或在手机上<strong>长按二维码识别</strong>添加。添加时请备注来意：<em>咨询现货 · {work.title}</em>，工作日通常当天回复。</p>
      <p class="wx-alt">不方便加微信？<a href="/contact/">用邮件或表单联系我们 →</a></p>
    </div>
  </dialog>
  <script>
    import { isWishlisted, toggleWishlist, onWishlistChange } from '../../../scripts/wishlist';
    const dialog = document.querySelector('[data-wx-dialog]') as HTMLDialogElement | null;
    document.querySelectorAll('[data-wx-open]').forEach((btn) => btn.addEventListener('click', () => dialog?.showModal()));
    dialog?.querySelector('[data-wx-close]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog?.close(); });
    // 收进心愿单（T-03）：读写统一走 src/scripts/wishlist.ts（与抽屉、卡片按钮共享同一份逻辑）
    const wlButton = document.querySelector<HTMLButtonElement>('[data-wishlist]');
    const wlSlug = wlButton?.dataset.wishlist || '';
    const syncWishlist = () => {
      if (!wlButton) return;
      const on = isWishlisted(wlSlug);
      wlButton.setAttribute('aria-pressed', String(on));
      wlButton.textContent = on ? '♥ 已收进心愿单' : '♡ 先收进心愿单';
    };
    syncWishlist();
    wlButton?.addEventListener('click', () => { toggleWishlist(wlSlug); syncWishlist(); });
    // 覆盖 bfcache 恢复（从心愿单页返回时浏览器复用旧 DOM）与抽屉内移除
    onWishlistChange(syncWishlist);
  </script>
</Layout>
<style>
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; padding: 28px 0 0; color: var(--muted); font-size: 13px; }
  .crumb a { color: var(--ink-soft); }
  .crumb a:hover { color: var(--cinnabar); }
  .work-detail { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 60px; padding: 34px 0 20px; align-items: start; }
  .detail-figure { margin: 0; border: 1px solid var(--line); background: var(--paper-deep); position: relative; }
  .detail-figure :global(img) { width: 100%; display: block; }
  .detail-figure figcaption { padding: 10px 14px; border-top: 1px solid var(--line); background: var(--paper-light); color: var(--muted); font-size: 12px; letter-spacing: .08em; }
  .detail-copy h1 { font-size: clamp(34px, 4.4vw, 56px); font-weight: 500; line-height: 1.25; margin: 16px 0 4px; }
  .detail-copy .en { font: 20px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); margin: 0 0 20px; }
  /* 作品编码条（2026-10-14）：把「一物一码」从文字承诺变成可点可验的实体入口 */
  .work-code { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; margin: 0 0 20px; padding: 11px 14px; border: 1px solid var(--line); background: var(--paper-deep); }
  .wc-label { color: var(--muted); font-size: 12px; letter-spacing: .12em; }
  .wc-value { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 14px; font-weight: 600; color: var(--cinnabar); letter-spacing: .04em; }
  .wc-value:hover { text-decoration: underline; }
  .wc-year { color: var(--ink-soft); font-size: 12px; }
  .price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12px; margin: 0 0 20px; padding: 16px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .price-num { font: 500 34px var(--font-display-en), var(--font-body-zh); color: var(--cinnabar); letter-spacing: .01em; }
  .price-meta { color: var(--ink-soft); font-size: 13px; }
  .note { color: var(--ink-soft); font-size: 16px; line-height: 1.95; margin: 0 0 26px; }
  /* 已售出提示（B2）：一整块的温和说明，不用红色告警感 */
  .sold-notice { margin: 0 0 20px; padding: 14px 16px; border-left: 2px solid var(--ink-soft); background: var(--paper-deep); color: var(--ink-soft); font-size: 14px; line-height: 1.9; }
  .sold-notice strong { color: var(--ink); font-weight: 500; }
  .detail-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .detail-fineprint { margin: 18px 0 0; padding: 14px 16px; border-left: 2px solid var(--cinnabar); background: var(--paper-light); color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
  .biz-cross-link { margin: 14px 0 0; color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
  .biz-cross-link a { color: var(--cinnabar-deep); border-bottom: 1px solid var(--cinnabar); padding-bottom: 2px; }
  /* ── 字源释读 + 场景联想（2026-10-16）──
     双栏：左「字」右「用」。左栏以大字形态字作视觉锚点，
     与首页作品区的 .work-char 同一语言（低透明度朱砂 + display 字体）。 */
  .work-source { border-top: 1px solid var(--line); }
  .source-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; }
  .source-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .source-head h2 { font-size: clamp(22px, 2.6vw, 32px); font-weight: 500; line-height: 1.45; letter-spacing: .02em; margin: 14px 0 12px; }
  .source-char { flex-shrink: 0; color: var(--cinnabar); opacity: .22; font-size: 72px; line-height: 1; }
  .source-origin { margin: 0 0 14px; }
  .source-origin .mono { display: inline-block; padding: 4px 10px; border: 1px solid var(--line); color: var(--cinnabar-deep); font-size: 12px; letter-spacing: .14em; }
  .source-note { margin: 0; color: var(--ink); font-size: 16px; line-height: 2.05; }
  .source-foot { margin: 18px 0 0; color: var(--muted); font-size: 12px; line-height: 1.9; }
  .scene-block h2 { font-size: clamp(22px, 2.6vw, 32px); font-weight: 500; line-height: 1.45; letter-spacing: .02em; margin: 14px 0 12px; }
  .scene-fit { margin: 0 0 24px; color: var(--ink); font-size: 16px; line-height: 2.05; }
  .scene-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-soft); }
  .scene-list li { padding: 11px 0 11px 22px; border-bottom: 1px solid var(--line-soft); color: var(--ink-soft); font-size: 13px; line-height: 1.85; position: relative; }
  .scene-list li::before { content: ''; position: absolute; left: 2px; top: 19px; width: 6px; height: 6px; border-radius: 50%; background: var(--cinnabar); }
  .work-facts { border-top: 1px solid var(--line); }
  .facts-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .fact { padding: 22px 22px 26px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .fact dt { font-size: 16px; font-weight: 500; margin-bottom: 10px; }
  .fact dt .mono { color: var(--cinnabar); font-size: 12px; margin-right: 8px; }
  .fact dd { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.9; }
  .fact dd em { display: block; font-style: normal; color: var(--muted); font-size: 13px; margin-top: 8px; }
  .fact-code { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 14px; font-weight: 600; color: var(--cinnabar); letter-spacing: .03em; }
  .fact-code:hover { text-decoration: underline; }
  .facts-cta { margin-top: 26px; }
  .others { border-top: 1px solid var(--line); }
  .others-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .other-card { border: 1px solid var(--line); background: var(--paper-light); display: flex; flex-direction: column; }
  .other-card figure { margin: 0; overflow: hidden; background: var(--paper-deep); }
  .other-card :global(img) { width: 100%; display: block; transition: transform .6s ease; }
  .other-card:hover :global(img) { transform: scale(1.03); }
