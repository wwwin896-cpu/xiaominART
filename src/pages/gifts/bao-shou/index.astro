---
// 301 兜底：商品「寶壽」已按实物更名为「鶴壽」（2026-11-07）。
// 静态站无法发真 301，这里用 meta refresh + canonical + noindex 做等价处理，
// 把外链与已收录的权重导到新地址，避免 404 流失。
export const prerender = true;
const TARGET = '/gifts/he-shou/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>已更名为「鶴壽」｜小民艺术</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://xiaominart.com${TARGET}`} />
    <meta http-equiv="refresh" content={`0; url=${TARGET}`} />
    <script is:inline>location.replace('/gifts/he-shou/');</script>
  </head>
  <body>
    <p>这件作品已更名为「鶴壽」，正在带你去 <a href={TARGET}>新页面</a>。</p>
  </body>
</html>
