---
import Layout from '../../layouts/Layout.astro';
import GiftCard from '../../components/GiftCard.astro';
import { getGiftCatalog } from '../../lib/keystatic';
const { products: giftProducts, tiers: giftTierLabels } = getGiftCatalog();
---
<Layout title="私享礼遇｜小民艺术" description="小民艺术的私享礼遇，以书写、器物和礼盒为日常关系准备一份有东方审美的心意。">
  <section class="container page-head"><span class="eyebrow">Private Gifts / 私享礼遇</span><h1 class="serif">把一份心意，<br />送进真实的日常。</h1><p lang="en">Thoughtful gifts for everyday rituals.</p><p>这里是小民艺术的礼品集合。你可以先看预算、品类和节气系列，再进入详情了解适合对象、礼物寓意、包装和交付参考。</p><div class="quick-links"><a class="btn btn-primary" href="/gift-guide/" data-event="gift_guide_view">进入选礼指南 →</a><a class="btn btn-secondary" href="/gift-guide/by-occasion/">按场合选礼</a><a class="btn btn-secondary" href="/gift-guide/by-recipient/">按对象选礼</a></div></section>
  <section class="container section tier-section"><div class="tier-grid">{Object.entries(giftTierLabels).map(([key, tier]) => <a href={`/gift-guide/?tier=${key}#gift-list`}><span class="eyebrow">{tier.name}</span><strong>{tier.range}</strong><p>{tier.body}</p><span class="btn btn-link">浏览这一档 →</span></a>)}</div></section>
  <section class="container section gift-list-section"><div class="list-heading"><div><span class="eyebrow">Curated gifts / 私享礼遇</span><h2 class="serif">先从一件具体的礼物开始。</h2></div><span class="saved-note">心愿单保存在本机浏览器</span></div><div class="gift-grid">{giftProducts.map((product) => <GiftCard product={product} />)}</div></section>
  <section class="container section next-step"><span class="eyebrow">Not sure yet / 还不确定</span><h2 class="serif">如果你还不知道送什么，先从对象、场合和预算告诉我们。</h2><a class="btn btn-primary" href="/custom-commission/?context=送礼建议" data-event="gift_advice_click">获取送礼建议 →</a></section>
</Layout>
<style>
  .page-head { padding: 90px 0 58px; } .page-head h1 { font-size: clamp(48px, 7vw, 86px); line-height: 1.18; font-weight: 500; margin: 20px 0; } .page-head p { max-width: 700px; color: var(--ink-soft); font-size: 18px; } .page-head p[lang='en'] { font: 24px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); } .quick-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .tier-section, .gift-list-section, .next-step { border-top: 1px solid var(--line); } .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--line); } .tier-grid a { padding: 24px 22px 28px 0; } .tier-grid a + a { border-left: 1px solid var(--line); padding-left: 22px; } .tier-grid strong { display: block; margin: 16px 0 8px; color: var(--cinnabar-deep); font: 24px var(--font-display-en), Georgia, serif; } .tier-grid p { color: var(--ink-soft); font-size: 14px; } .list-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 36px; } .list-heading h2 { font-size: 38px; font-weight: 500; margin: 12px 0 0; } .saved-note { color: var(--muted); font-size: 12px; } .gift-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 24px; } .next-step h2 { max-width: 760px; font-size: clamp(38px, 5vw, 64px); font-weight: 500; margin: 18px 0 28px; }
  @media (max-width: 767px) { .page-head { padding: 56px 0 42px; } .page-head h1 { font-size: 47px; } .page-head p { font-size: 16px; } .page-head p[lang='en'] { font-size: 20px; } .quick-links, .quick-links .btn { width: 100%; } .quick-links { display: grid; } .tier-grid, .gift-grid { grid-template-columns: 1fr; } .tier-grid a, .tier-grid a + a { padding: 20px 0; border-left: 0; border-bottom: 1px solid var(--line); } .tier-grid a:last-child { border-bottom: 0; } .list-heading { display: block; } .saved-note { display: block; margin-top: 16px; } .list-heading h2 { font-size: 30px; } }
</style>
