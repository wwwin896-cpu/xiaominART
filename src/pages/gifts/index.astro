---
import Layout from '../../layouts/Layout.astro';
import { getGiftCatalog } from '../../lib/keystatic';
const { tiers: giftTierLabels } = getGiftCatalog();

const craftSteps = [
  {
    no: '第一步', title: '一笔一画皆自心出，飞白枯润墨见真性',
    body: '从你的一句话开始。写什么、送给谁、为什么送——先聊清楚，再落笔。飞白是快意，枯润见性情，毛笔是软的，每一笔的轻重缓急都留在纸上，不可修改，也无法复制。',
    image: '/assets/craft/step-1-writing.jpg', alt: '毛笔在宣纸上落笔书写的特写',
  },
  {
    no: '第二步', title: '素手抚宣，排气定型，宽境留白，气度自生',
    body: '写完不等于完成。书写之后要上浆抚平、排实纸下的空气，让纸与墨真正安定下来；留白留多宽、字放哪里，决定这幅字最终的气度与呼吸感。',
    image: '/assets/craft/step-2-mounting.jpg', alt: '双手用棕刷抚平装裱中的书法作品',
  },
  {
    no: '第三步', title: '实木装帧，成品入框',
    body: '实木框、衬纸、留距，一步都省不得。装帧完成的作品，挂在墙上即是作品，摆在案头即是礼——你收到的就是可以直接送出的样子。',
    image: '/assets/craft/step-3-framing.jpg', alt: '装裱入框后的书法小品',
  },
  {
    no: '第四步', title: '一物一码一知音，见字如面不负卿',
    body: '每幅作品附唯一编号与藏品证书，一物一码。它为谁而写、写在哪一天、用了什么纸墨，都有迹可循。世间没有第二幅与它相同，正如你要说的那句话。',
    image: '/assets/craft/step-4-packaging.jpg', alt: '小民艺术黑色礼盒与藏品证书包装',
  },
];
---
<Layout title="小民好礼｜小民艺术" description="小民好礼，以书写、器物和礼盒为日常关系准备一份有东方审美的心意。">
  <section class="container page-head"><span class="eyebrow">Xiaomin Gifts / 小民好礼</span><h1 class="serif">把一份心意，<br />送进真实的日常。</h1><p lang="en">Thoughtful gifts for everyday rituals.</p><p>这里是小民好礼的礼物集合。你可以先看预算、品类和节气系列，再进入详情了解适合对象、礼物寓意、包装和交付参考。</p><div class="quick-links"><a class="btn btn-primary" href="/gift-guide/" data-event="gift_guide_view">进入选礼指南 →</a></div></section>
  <section class="container section tier-section"><div class="tier-grid">{Object.entries(giftTierLabels).map(([, tier]) => <div class="tier-item"><span class="eyebrow">{tier.name}</span><strong>{tier.range}</strong><p>{tier.body}</p></div>)}</div></section>
  <section class="container section craft-section" id="craft-journey"><div class="craft-head" data-reveal><span class="eyebrow">Handmade Journey / 手作匠心</span><h2 class="serif craft-title">手作匠心｜开始旅程</h2><p class="craft-sub serif">「你的心意，会被认真解读，认真看见」</p><p class="craft-note">每一幅，都是世间唯一的相遇</p></div><div class="craft-steps">{craftSteps.map((step, i) => <div class:list={['craft-row', { reverse: i % 2 === 1 }]} data-reveal><figure class="craft-fig"><img src={step.image} alt={step.alt} loading="lazy" decoding="async" /></figure><div class="craft-copy"><span class="craft-no">{step.no}</span><h3 class="serif">{step.title}</h3><p>{step.body}</p></div></div>)}</div></section>
  <section class="container section next-step"><span class="eyebrow">Not sure yet / 还不确定</span><h2 class="serif">如果你还不知道送什么，先从对象、场合和预算告诉我们。</h2><a class="btn btn-primary" href="/custom-commission/?context=送礼建议" data-event="gift_advice_click">获取送礼建议 →</a></section>
</Layout>
<style>
  .page-head { padding: 90px 0 58px; } .page-head h1 { font-size: clamp(30px, 4vw, 52px); line-height: 1.3; font-weight: 500; margin: 20px 0; } .page-head p { max-width: 700px; color: var(--ink-soft); font-size: 18px; } .page-head p[lang='en'] { font: 24px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); } .quick-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .tier-section, .craft-section, .next-step { border-top: 1px solid var(--line); } .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--line); } .tier-item { padding: 24px 22px 28px 0; } .tier-item + .tier-item { border-left: 1px solid var(--line); padding-left: 22px; } .tier-grid strong { display: block; margin: 16px 0 8px; color: var(--cinnabar-deep); font: 24px var(--font-display-en), Georgia, serif; } .tier-grid p { color: var(--ink-soft); font-size: 14px; } .next-step h2 { max-width: 760px; font-size: clamp(26px, 3.2vw, 40px); font-weight: 500; margin: 18px 0 28px; }
  .craft-head { text-align: center; max-width: 720px; margin: 0 auto 64px; } .craft-title { font-size: clamp(28px, 3.6vw, 44px); font-weight: 500; margin: 16px 0 18px; } .craft-sub { font-size: clamp(19px, 2.2vw, 26px); color: var(--cinnabar-deep); margin: 0 0 10px; } .craft-note { color: var(--ink-soft); font-size: 15px; letter-spacing: 0.12em; margin: 0; }
  .craft-steps { display: flex; flex-direction: column; gap: 72px; } .craft-row { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: center; } .craft-row.reverse { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } .craft-row.reverse .craft-fig { order: 2; } .craft-row.reverse .craft-copy { order: 1; } .craft-fig { margin: 0; overflow: hidden; background: var(--paper-deep); } .craft-fig img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; transition: transform .6s ease; } .craft-row:hover .craft-fig img { transform: scale(1.03); } .craft-no { display: inline-block; font: 13px var(--font-display-en), Georgia, serif; letter-spacing: 0.2em; color: var(--cinnabar-deep); border-bottom: 1px solid var(--cinnabar); padding-bottom: 6px; } .craft-copy h3 { font-size: clamp(20px, 2.2vw, 26px); font-weight: 500; line-height: 1.5; margin: 18px 0 14px; } .craft-copy p { color: var(--ink-soft); font-size: 16px; line-height: 1.9; margin: 0; }
  @media (max-width: 767px) { .page-head { padding: 56px 0 42px; } .page-head h1 { font-size: 30px; } .page-head p { font-size: 16px; } .page-head p[lang='en'] { font-size: 20px; } .quick-links, .quick-links .btn { width: 100%; } .quick-links { display: grid; } .tier-grid { grid-template-columns: 1fr; } .tier-item, .tier-item + .tier-item { padding: 20px 0; border-left: 0; border-bottom: 1px solid var(--line); } .tier-item:last-child { border-bottom: 0; } .craft-head { margin-bottom: 44px; } .craft-steps { gap: 52px; } .craft-row, .craft-row.reverse { grid-template-columns: 1fr; gap: 22px; } .craft-row.reverse .craft-fig { order: 0; } .craft-row.reverse .craft-copy { order: 1; } .craft-copy p { font-size: 15px; } }
</style>
