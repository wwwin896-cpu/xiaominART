---
import Layout from '../../layouts/Layout.astro';
import ArtistCard from '../../components/ArtistCard.astro';
import { artists } from '../../data/content';
// 四条创作与承接路径（每项：适合谁 / 得到什么 / 点哪里），自首页「谁来写」迁入
const capabilities = [
  { tag: 'Ready to ship / 手写现货', title: '已经写好的小品', fit: '想尽快送出、不想等创作周期', gain: '装裱完成的手写小品，一物一码，看中即可直接发货', href: '/gifts/ready-made/', cta: '看现货方向' },
  { tag: 'Made to order / 定制手写', title: '从一句话开始写', fit: '有具体的人、场合或房间需要照看', gain: '专属创作、装裱与礼盒，附藏品证书', href: '/custom-commission/', cta: '发起定制咨询' },
  { tag: 'Craft / 非遗面塑与插画', title: '手上的另一门功夫', fit: '学校、社区、机构需要可参与的活动', gain: '面塑体验活动与出版插画方向的合作', href: '/partners/heritage/', cta: '看机构合作' },
  { tag: 'Business / 机构合作', title: '一群人的礼与空间', fit: '企业答谢、员工福利、会客空间陈设', gain: '从批量礼赠到空间定制的方案沟通', href: '/business-gifts/', cta: '提交企业需求' },
];
---
<Layout title="品牌介绍｜About XIAOMINART" description="了解 XIAOMINART 的东方艺术定制方法、共同创作理念与创作者介绍。"><section class="page-head container"><span class="eyebrow">About / 品牌介绍</span><h1 class="serif">把东方艺术，<br />带回具体的生活。</h1><p lang="en">Translating the sensibility of Eastern art into contemporary, personal works.</p><p>我们相信，艺术不必先被放进一个遥远的殿堂。它可以从一个人的故事、一处空间的气息和一件礼物的分量开始。</p></section><section class="container section about-block"><div><span class="eyebrow">Why XIAOMINART / 为什么存在</span><h2 class="serif">不是复制传统，<br />而是重新找到它与今天的关系。</h2></div><div><p>书写、器物、空间与礼赠，并不是彼此孤立的类别。它们共享一种被认真对待的判断力：什么值得留下，什么需要留白，什么应该被亲手完成。</p><p>因此 XIAOMINART 保留一组已经写好、装裱完成的小幅手写现货，看中即可直接寄出；也为需要郑重表达的时刻，保留一条从意图到作品的定制路径。</p></div></section><section class="container section values"><div><span class="mono">01</span><h2 class="serif">现货与定制并行</h2><p>小幅现货可直接寄出；重要时刻一人一作。</p></div><div><span class="mono">02</span><h2 class="serif">一人一作</h2><p>你的字句，你的心境，独一无二。</p></div><div><span class="mono">03</span><h2 class="serif">东方美学</h2><p>以升斗小民的视角，让书法回归日常。</p></div><div><span class="mono">04</span><h2 class="serif">长期关系</h2><p>不止于一件作品，更是一段关系的开始。</p></div></section><section class="container section capability" id="capability" aria-labelledby="capability-title"><div class="capability-lead"><span class="eyebrow">Who we work with / 谁来写</span><h2 id="capability-title" class="serif">两个人，四条路。</h2><p>小民艺术目前的创作与承接范围：一位以书写为入口，一位以面塑和手作为功夫。四条路的适合人群、你能得到什么、从哪里开始，都写在下面——看清再选，比直接下单省事。</p></div><div class="capability-grid">{capabilities.map((item) => <article class="cap-card"><span class="eyebrow">{item.tag}</span><h3 class="serif">{item.title}</h3><dl><dt>适合谁</dt><dd>{item.fit}</dd><dt>得到什么</dt><dd>{item.gain}</dd></dl><a class="btn btn-link" href={item.href}>{item.cta} →</a></article>)}</div><p class="capability-note">两位创作者：升斗小民（书写与东方日常）、非遗小宁（面塑与手作体验）。<a href="/artists/">看艺术家介绍 →</a></p></section><section class="container section makers"><div class="section-lead"><span class="eyebrow">Makers / 创作者介绍</span><h2 class="serif">每一种意图，都值得找到合适的手。</h2><p>小民艺术背后的两位创作者：一位以书写安放心意，一位以面塑传递手艺。</p></div><div class="makers-grid">{artists.map((artist) => <ArtistCard artist={artist} />)}</div></section><section class="container section about-cta"><h2 class="serif">如果你有一个还没成形的想法，<br />可以从定制表单开始。</h2><a class="btn btn-primary" href="/custom-commission/">开始定制 / Start a commission →</a></section></Layout>
<style>.page-head{padding:94px 0 72px}.page-head h1{font-size:clamp(52px,7vw,90px);font-weight:500;line-height:1.16;margin:22px 0}.page-head p{max-width:680px;color:var(--ink-soft);font-size:18px}.page-head p[lang=en]{font:24px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.capability{border-top:1px solid var(--line)}.capability-lead{max-width:660px;margin-bottom:36px}.capability-lead h2{font-size:clamp(24px,2.8vw,38px);font-weight:400;line-height:1.4;margin:14px 0 12px}.capability-lead p{margin:0;color:var(--ink-soft);line-height:1.9}.capability-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.cap-card{display:flex;flex-direction:column;padding:24px 22px 28px 0;border-bottom:1px solid var(--line)}.cap-card+.cap-card{padding-left:22px;border-left:1px solid var(--line)}.cap-card h3{font-size:23px;font-weight:400;line-height:1.45;margin:12px 0 16px}.cap-card dl{margin:0 0 14px}.cap-card dt{color:var(--muted);font-size:11px;letter-spacing:.12em}.cap-card dd{margin:5px 0 13px;color:var(--ink-soft);font-size:14px;line-height:1.8}.cap-card .btn{margin-top:auto;align-self:flex-start}.capability-note{margin:18px 0 0;color:var(--muted);font-size:12px}.capability-note a{color:var(--cinnabar)}.about-block{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line)}.about-block h2{font-size:clamp(38px,5vw,64px);font-weight:500;line-height:1.3}.about-block p{max-width:600px;color:var(--ink-soft);font-size:17px}.values{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.values>div{padding:22px 20px 28px 0}.values>div+div{border-left:1px solid var(--line);padding-left:20px}.values>div:last-child{border-right:0}.values .mono{color:var(--cinnabar)}.values h2{font-size:38px;font-weight:500;margin:30px 0 8px}.values p{color:var(--ink-soft);font-size:14px}.about-cta{border-bottom:1px solid var(--line)}.about-cta h2{font-size:clamp(38px,5vw,64px);font-weight:500;line-height:1.3;margin-top:0}.makers-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 28px}.makers .section-lead h2{font-size:clamp(36px,5vw,58px);font-weight:500;line-height:1.3;margin:18px 0}.makers .section-lead p{color:var(--ink-soft);max-width:620px}@media(max-width:767px){.page-head{padding:58px 0 48px}.page-head h1{font-size:53px}.page-head p[lang=en]{font-size:20px}.about-block,.values{grid-template-columns:1fr;gap:22px}.makers-grid{grid-template-columns:1fr;gap:26px}.about-block h2{font-size:38px}.values>div,.values>div+div{padding:20px 0;border-left:0;border-bottom:1px solid var(--line)}.values>div:last-child{border-bottom:0}.capability-grid{grid-template-columns:1fr}.cap-card,.cap-card+.cap-card{padding:22px 0;border-left:0}.cap-card:last-child{border-bottom:0}.cap-card .btn{align-self:stretch}}
</style>
