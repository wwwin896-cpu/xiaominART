---
import Layout from '../../layouts/Layout.astro';
import { creatorCreed } from '../../data/creator-creed';

// 品牌名的来处：「小」是细节，「民」是看见
const nameMeaning = [
  {
    char: '小',
    roman: 'xiǎo / small',
    lead: '我们做的事情，是细节。',
    body: '它不追求宏大的复刻，而是一种微式的传承——把一件事做小、做细，细到可以被反复看见，细到能够日日相见。传统不是被搬来的，是被一点一点，重新用起来的。',
  },
  {
    char: '民',
    roman: 'mín / to see',
    lead: '古人造字时，它是一只眼睛看见。',
    body: '我们愿意从细微处去看见事物的过去与现在——看见一件器物如何被使用，看见一句话如何被安放，看见一门手艺如何一路走到今天。看见了，才谈得上懂得；懂得了，才敢动手。',
  },
];

// 品牌理念三条
const philosophy = [
  {
    no: '01',
    title: '从东方文化开始',
    en: 'Eastern roots',
    body: '不是复刻古人的样子，而是先弄懂它：什么东西值得留下，什么地方需要留白，什么要亲手完成才算数。',
  },
  {
    no: '02',
    title: '以现代人的视觉，融入现代生活',
    en: 'Contemporary eye',
    body: '让东方艺术回到今天的人、今天的房间与场合里——可以被用起来、被天天看见，而不是被供起来。',
  },
  {
    no: '03',
    title: '传递知识，传递美学，致敬历史',
    en: 'Knowledge & beauty',
    body: '每件作品都带着一段可以说清的来处。在这条很长的线上，我们只是其中一小段，愿意把知道的讲给你听，也把敬意留在作品里。',
  },
];

// 品牌主理人（同时是两位创作者）
const founders = [
  {
    slug: 'xiaomin',
    name: '升斗小民',
    en: 'Shengdou Xiaomin',
    role: '品牌主理人 · 书者',
    discipline: '书写与东方日常 / Calligraphy',
    line: '一个致力于用书法解读历史的书者。',
    body: '她以书写为入口，把字看作一段可以重读的历史。写下的不只是吉语与心事，也是一个人在某个时刻想郑重说出的那句话：什么该说，什么该停，什么值得留在纸上。',
  },
  {
    slug: 'xiaoning',
    name: '非遗小宁',
    en: 'Xiao Ning',
    role: '品牌主理人 · 传承人',
    discipline: '非遗面塑与手作体验 / Dough figurine',
    line: '一个致力于非遗面塑的传承人。',
    body: '她以面塑为手上的功夫，把这门有来处的手艺带进校园、社区与机构。材料、步骤和一段慢慢的时间，一起交到参与者手上——传承不只是被讲述，更要被亲手做过一次。',
  },
];

// 四条创作与承接路径（每项：适合谁 / 得到什么 / 点哪里），自首页「谁来写」迁入
const capabilities = [
  { tag: 'Ready to ship / 已经写好的', title: '看中了，随时寄出', fit: '想尽快把一份心意送出去的人', gain: '装裱完成的手写小品，一物一码，看中了我们当天就安排寄出', href: '/gifts/ready-made/', cta: '看看最近写了什么' },
  { tag: 'Made to order / 为你写一张', title: '从一句话开始', fit: '心里有一句话想留住的人', gain: '只为一个人写的作品，连同装裱与礼盒，附一张藏品证书', href: '/custom-commission/', cta: '说说你的那句话' },
  { tag: 'Craft / 亲手捏一次', title: '把手艺交到手上', fit: '想带孩子或朋友摸一摸传统的人', gain: '面塑体验活动与出版插画方向的合作，材料和时间都备好了', href: '/partners/heritage/', cta: '看看活动安排' },
  { tag: 'Business / 一群人的心意', title: '替团队说声谢谢', fit: '想为答谢、周年或会客空间准备礼物的人', gain: '批量的礼物，也可以一份一份被认真对待', href: '/business-gifts/', cta: '聊聊你们的场合' },
];
---
<Layout title="关于我们｜品牌故事与主理人｜XIAOMINART" description="小民艺术 XIAOMINART：从「小」的细节与「民」的看见出发，把东方艺术融入现代人的生活方式。了解品牌故事、品牌理念与两位主理人——升斗小民与非遗小宁。">
  <section class="page-head container"><span class="eyebrow">About us / 关于我们</span><h1 class="serif">把东方艺术，<br />带回具体的生活。</h1><p lang="en">Translating the sensibility of Eastern art into contemporary, personal works.</p><p>小民艺术，是两个愿意把日子过得慢一点的人做起来的小品牌。我们写字，也捏面塑——一个人从字里读历史，一个人守着有来处的手艺。来这里的人，心里多半有一句想说的话，或是一处想安顿好的空间；我们替你把它做成一件可以留下的东西。艺术不必遥远，它本来就在日子里。</p></section>

  <section class="container section name-meaning" id="name">
    <div class="section-lead"><span class="eyebrow">The name / 品牌名的来处</span><h2 class="serif">「小」是细节，<br />「民」是看见。</h2></div>
    <div class="name-grid">
      {nameMeaning.map((item) => <article class="name-card"><div class="name-char" aria-hidden="true"><span class="serif">{item.char}</span><small>{item.roman}</small></div><div><h3 class="serif">{item.lead}</h3><p>{item.body}</p></div></article>)}
    </div>
    <p class="name-note">两个字放在一起，就是我们的来路：<strong>愿意从细微处看见过去与现在，然后，用今天的方式向它致意。</strong></p>
  </section>

  <section class="container section story" id="story">
    <div><span class="eyebrow">Brand story / 品牌故事</span><h2 class="serif">两个人，<br />两门手艺，<br />一个品牌。</h2></div>
    <div>
      <p>小民艺术由两位创作者共同创建。她们也是这里所有作品的主理人：一位是升斗小民，致力于用书法解读历史的书者；一位是非遗小宁，致力于非遗面塑的传承人。</p>
      <p>她们的手艺并不相同，看的东西却很像——都舍不得那些正在被日常生活忽略的细节。一个人从纸本上读历史，一个人从材料里传手艺；一个让字成为可以留下的表达，一个让手艺成为可以被亲手做过一次的记忆。</p>
      <p>于是有了 XIAOMINART。没有宏大的叙事，只有各自手上那一点确定的功夫：用自己的专业和技艺，用力所能及的方式对外表达；也借这样的方式，往更大的美学空间里走一走。所以对我们来说，品牌不只是一个名字，更像一场还没写完的共同创作。</p>
    </div>
  </section>

  <section class="container section philosophy" id="philosophy">
    <div class="section-lead"><span class="eyebrow">Philosophy / 品牌理念</span><h2 class="serif">从东方文化开始，<br />以现代人的视觉。</h2><p>我们做的事情，归结起来是三句话。它决定了我们接什么、放什么，也解释了为什么我们愿意把一件事做得慢一点。</p></div>
    <div class="philosophy-grid">{philosophy.map((item) => <article class="philo-card"><span class="mono">{item.no}</span><h3 class="serif">{item.title}</h3><p lang="en">{item.en}</p><p>{item.body}</p></article>)}</div>
  </section>

  <section class="container section creed" id="creed" aria-labelledby="creed-title">
    <div class="creed-head">
      <span class="eyebrow">From the calligrapher / 书者如是说</span>
      <h2 id="creed-title" class="serif">字写得好不好，<br />看它在日子里作不作数。</h2>
      <p>下面两则，是主理人升斗小民谈书写时说过的话。一则是她怎么看「把格言挂上墙」这件事，一则是她自己的手上功夫从哪里来。放在这里，是想让你在决定要不要请我们写字之前，先知道我们怎么看待这支笔。</p>
    </div>

    <div class="creed-list">
      {creatorCreed.map((creed, index) => (
        <article class="creed-block" id={creed.id}>
          <header class="creed-lead">
            <span class="mono">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <span class="eyebrow">{creed.eyebrow}</span>
              <h3 class="serif">{creed.lead}</h3>
            </div>
          </header>

          <p class="creed-motto serif">{creed.motto}</p>
          <p class="creed-motto-en" lang="en">{creed.mottoEn}</p>

          <div class="creed-grid">
            {creed.items.map((item) => (
              <div class="creed-item">
                <span class="mono">{item.no}</span>
                <h4 class="serif">{item.title}</h4>
                <p>{item.body}</p>
              </div>
            ))}
          </div>

          <p class="creed-closing">{creed.closing}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container section founders" id="founders">
    <div class="section-lead"><span class="eyebrow">Founders / 品牌主理人</span><h2 class="serif">两位主理人，<br />也是两位创作者。</h2><p>她们既是品牌的主理人，也是作品的创作者——从一句想说的话，到纸本、材料与包装，都出自她们自己的手。</p></div>
    <div class="founders-grid">
      {founders.map((person) => <article class="founder-card">
        <div class="founder-mark" aria-hidden="true"><span class="serif">{person.name.slice(-1)}</span><small>FOUNDER</small></div>
        <div class="founder-body">
          <span class="eyebrow">{person.role}</span>
          <h3 class="serif">{person.name}</h3>
          <p lang="en">{person.en}</p>
          <p class="founder-line">{person.line}</p>
          <p>{person.body}</p>
          <div class="founder-tags"><span>{person.discipline}</span></div>
          <a class="btn btn-link" href={`/artists/${person.slug}/`}>看艺术家详情 / View profile →</a>
        </div>
      </article>)}
    </div>
    <p class="founders-note">想直接了解她们的创作方向与媒介倾向？<a href="/artists/">进入艺术家页面 →</a>　·　两位创作者的作品与经历会随创作笔记持续补充。</p>
  </section>

  <section class="container section values"><div><span class="mono">01</span><h2 class="serif">慢一点，没关系</h2><p>好的字和好的手艺都急不来。等得起的事，我们慢慢做；等不起的心意，我们用已经写好的来接。</p></div><div><span class="mono">02</span><h2 class="serif">一人一作</h2><p>同一个词，不同的人写出来是不一样的心事。你的字，只为你写一次。</p></div><div><span class="mono">03</span><h2 class="serif">字有来处</h2><p>写什么、怎么写，先弄清这句话的来路与去处。懂得多一点，笔下的分寸才稳一点。</p></div><div><span class="mono">04</span><h2 class="serif">一次委托，一段来往</h2><p>很多客人写完一幅，还会回来写第二幅。比起做成一单生意，我们更喜欢这样的来往。</p></div></section>

  <section class="container section capability" id="capability" aria-labelledby="capability-title"><div class="capability-lead"><span class="eyebrow">Where to begin / 从哪里开始</span><h2 id="capability-title" class="serif">不知道从哪里开始？<br />从你心里那句话开始。</h2><p>有人想尽快送出一份心意，有人想把一面空墙安顿好，有人想带孩子亲手摸一摸传统，也有人想替一群人说声谢谢。这四件事我们都在做，也都乐意做——选不选得好，来了聊几句就知道了。</p></div><div class="capability-grid">{capabilities.map((item) => <article class="cap-card"><span class="eyebrow">{item.tag}</span><h3 class="serif">{item.title}</h3><dl><dt>适合谁</dt><dd>{item.fit}</dd><dt>你会得到</dt><dd>{item.gain}</dd></dl><a class="btn btn-link" href={item.href}>{item.cta} →</a></article>)}</div><p class="capability-note">哪一条都拿不准也没关系，直接来说说你的情况就好。<a href="/custom-commission/">来聊聊 →</a></p></section>

  <section class="container section about-cta"><h2 class="serif">如果你有一句还没说出口的话，<br />我们帮你写下来。</h2><a class="btn btn-primary" href="/custom-commission/">开始聊聊 / Start a conversation →</a></section>
</Layout>
<style>
.page-head{padding:94px 0 72px}
.page-head h1{font-size:clamp(52px,7vw,90px);font-weight:500;line-height:1.16;margin:22px 0}
.page-head p{max-width:680px;color:var(--ink-soft);font-size:18px}
.page-head p[lang=en]{font:24px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}
.section-lead{max-width:660px;margin-bottom:34px}
.section-lead h2{font-size:clamp(30px,4vw,50px);font-weight:500;line-height:1.3;margin:16px 0 14px}
.section-lead p{color:var(--ink-soft);font-size:16px;line-height:1.9;margin:0}
.capability{border-top:1px solid var(--line)}
.capability-lead{max-width:660px;margin-bottom:36px}
.capability-lead h2{font-size:clamp(24px,2.8vw,38px);font-weight:400;line-height:1.4;margin:14px 0 12px}
.capability-lead p{margin:0;color:var(--ink-soft);line-height:1.9}
.capability-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}
.cap-card{display:flex;flex-direction:column;padding:24px 22px 28px 0;border-bottom:1px solid var(--line)}
.cap-card+.cap-card{padding-left:22px;border-left:1px solid var(--line)}
.cap-card h3{font-size:23px;font-weight:400;line-height:1.45;margin:12px 0 16px}
.cap-card dl{margin:0 0 14px}
.cap-card dt{color:var(--muted);font-size:11px;letter-spacing:.12em}
.cap-card dd{margin:5px 0 13px;color:var(--ink-soft);font-size:14px;line-height:1.8}
.cap-card .btn{margin-top:auto;align-self:flex-start}
.capability-note{margin:18px 0 0;color:var(--muted);font-size:12px}
.capability-note a{color:var(--cinnabar)}
/* 品牌名的来处 */
.name-meaning{border-top:1px solid var(--line)}
.name-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
.name-card{display:grid;grid-template-columns:minmax(0,150px) minmax(0,1fr);gap:26px;align-items:start;border-top:2px solid var(--ink);padding-top:22px}
.name-char{display:flex;flex-direction:column;align-items:center;justify-content:center;background:var(--paper-deep);padding:22px 10px}
.name-char span{font-size:clamp(64px,8vw,104px);line-height:1;color:var(--cinnabar)}
.name-char small{font:10px var(--font-mono);color:var(--muted);letter-spacing:.08em;margin-top:12px;text-align:center}
.name-card h3{font-size:clamp(20px,2.2vw,26px);font-weight:500;line-height:1.5;margin:0 0 12px}
.name-card p{color:var(--ink-soft);font-size:15px;line-height:1.9;margin:0}
.name-note{margin:26px 0 0;padding-top:18px;border-top:1px solid var(--line-soft);color:var(--ink-soft);font-size:16px;line-height:1.9;max-width:820px}
.name-note strong{color:var(--cinnabar-deep);font-weight:500}
/* 品牌故事 */
.story{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line)}
.story h2{font-size:clamp(34px,4.6vw,58px);font-weight:500;line-height:1.3;margin:18px 0 0}
.story p{max-width:600px;color:var(--ink-soft);font-size:17px;line-height:1.95;margin:0 0 18px}
.story p:last-child{margin-bottom:0}
/* 品牌理念 */
.philosophy{border-top:1px solid var(--line)}
.philosophy-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}
.philo-card{padding:24px 24px 26px 0;border-bottom:1px solid var(--line)}
.philo-card+.philo-card{padding-left:24px;border-left:1px solid var(--line)}
.philo-card .mono{color:var(--cinnabar)}
.philo-card h3{font-size:22px;font-weight:500;line-height:1.5;margin:22px 0 6px}
.philo-card p[lang=en]{font:14px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep);margin:0 0 14px}
.philo-card p:last-child{color:var(--ink-soft);font-size:14px;line-height:1.85;margin:0}
/* 书者手记（升斗小民关于书法的两则见解） */
.creed{border-top:1px solid var(--line)}
.creed-head{max-width:720px;margin-bottom:48px}
.creed-head h2{font-size:clamp(30px,4vw,50px);font-weight:500;line-height:1.3;margin:16px 0 14px}
.creed-head p{color:var(--ink-soft);font-size:16px;line-height:1.95;margin:0}
.creed-list{display:grid;gap:56px}
.creed-block{border-top:1px solid var(--line);padding-top:26px;scroll-margin-top:96px}
.creed-lead{display:flex;gap:20px;align-items:flex-start}
.creed-lead>.mono{color:var(--cinnabar);font-size:13px;padding-top:5px}
.creed-lead h3{font-size:clamp(24px,3vw,36px);font-weight:500;line-height:1.35;margin:12px 0 0}
.creed-motto{max-width:820px;font-size:clamp(20px,2.5vw,30px);font-weight:500;line-height:1.55;margin:30px 0 6px;letter-spacing:.03em}
.creed-motto-en{max-width:720px;margin:0;color:var(--cinnabar-deep);font:16px/1.6 var(--font-display-en),Georgia,serif}
.creed-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin-top:34px;border-top:1px solid var(--line)}
.creed-item{padding:20px 22px 24px 0;border-bottom:1px solid var(--line)}
.creed-item+.creed-item{padding-left:22px;border-left:1px solid var(--line)}
.creed-item>.mono{color:var(--muted);font-size:11px;letter-spacing:.14em}
.creed-item h4{font-size:18px;font-weight:500;line-height:1.55;margin:14px 0 10px}
.creed-item p{color:var(--ink-soft);font-size:14px;line-height:1.9;margin:0}
.creed-closing{margin:24px 0 0;padding-left:16px;border-left:2px solid var(--cinnabar);color:var(--ink);font-size:15px;line-height:1.9}
@media (max-width:900px){.creed-grid{grid-template-columns:1fr}.creed-item,.creed-item+.creed-item{padding:18px 0 20px;border-left:0}}
@media (max-width:767px){.creed-head{margin-bottom:34px}.creed-list{gap:40px}.creed-block{padding-top:22px}.creed-motto{font-size:20px;margin-top:22px}.creed-motto-en{font-size:15px}}
/* 品牌主理人 */
.founders{border-top:1px solid var(--line)}
.founders-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 30px}
.founder-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:24px;border-top:1px solid var(--line);padding-top:20px}
.founder-mark{aspect-ratio:.86;background:var(--paper-deep);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--cinnabar)}
.founder-mark span{font-size:clamp(52px,6vw,84px);line-height:1}
.founder-mark small{font:10px var(--font-mono);color:var(--ink-soft);letter-spacing:.14em;margin-top:14px}
.founder-body h3{font-size:clamp(24px,2.6vw,30px);font-weight:500;margin:10px 0 2px}
.founder-body p{color:var(--ink-soft);font-size:14px;line-height:1.85;margin:8px 0;overflow-wrap:anywhere}
.founder-body p[lang=en]{font:15px var(--font-display-en),Georgia,serif;color:var(--ink);margin:0}
.founder-body .founder-line{color:var(--cinnabar-deep);font-size:15px;margin:12px 0 6px}
.founder-tags{display:flex;flex-wrap:wrap;gap:6px 12px;color:var(--meta);font-size:11px;margin-top:14px}
.founders-note{margin:22px 0 0;color:var(--muted);font-size:12px}
.founders-note a{color:var(--cinnabar)}
/* 做法四条 */
.values{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.values>div{padding:22px 20px 28px 0}
.values>div+div{border-left:1px solid var(--line);padding-left:20px}
.values>div:last-child{border-right:0}
.values .mono{color:var(--cinnabar)}
.values h2{font-size:clamp(24px,2.6vw,34px);font-weight:500;margin:30px 0 8px}
