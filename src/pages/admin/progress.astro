---
// 定制进度录入后台（内部使用）
// - noindex：搜索引擎不收录，也不进 sitemap（见 scripts/check-sitemap.mjs 白名单）
// - 鉴权：页面本身是空壳，所有数据都需带 x-admin-key 调 /api/admin/progress；
//   密钥只存在浏览器 localStorage，不写进任何构建产物。
import Layout from '../../layouts/Layout.astro';
const stages = [
  { key: 'received', zh: '已收到愿望' },
  { key: 'review', zh: '字句审核' },
  { key: 'match', zh: '书体匹配' },
  { key: 'writing', zh: '创作中' },
  { key: 'delivery', zh: '待交付' },
  { key: 'done', zh: '已交付' },
];
---
<Layout title="定制进度录入｜内部后台" description="内部使用。" noindex>
  <section class="container admin-head">
    <span class="eyebrow">Internal / 内部后台</span>
    <h1 class="serif">定制进度录入</h1>
    <p>给每个定制项目建一条记录，把生成的查询码发给委托方。此页仅供内部使用，不会被搜索引擎收录。</p>
  </section>

  <section class="container admin-gate" data-gate>
    <label for="admin-key">管理密钥 / Admin key</label>
    <div class="gate-row">
      <input id="admin-key" type="password" autocomplete="off" placeholder="粘贴 ADMIN_ACCESS_KEY" />
      <button class="btn btn-primary" type="button" data-gate-save>进入</button>
    </div>
    <p class="gate-hint">密钥保存在你自己的浏览器里，不会上传到任何地方；换设备需要重新输入。</p>
    <p class="gate-status" data-gate-status role="status" aria-live="polite"></p>
  </section>

  <div data-panel hidden>
    <section class="container admin-form-wrap">
      <form data-admin-form>
        <h2 class="serif">新增 / 更新项目</h2>
        <label>项目名称 / Project<input name="projectName" required placeholder="例如：给张老师的谢师礼" maxlength="120" /></label>
        <label>查询码 / Code <span class="opt">留空自动生成</span><input name="code" placeholder="XM-7K2P9A" maxlength="9" /></label>
        <label>联系方式提示 / Contact hint <span class="opt">脱敏展示给客户</span><input name="contactHint" placeholder="例如：138****8888" maxlength="60" /></label>
        <label>当前阶段 / Stage<select name="stage">{stages.map((s) => <option value={s.key}>{s.zh}</option>)}</select></label>
        <label>给客户看的一句话 / Note<textarea name="note" rows="3" maxlength="500" placeholder="例如：已按你选的洒金纸起笔，预计周五前完成初稿。"></textarea></label>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit">保存项目 →</button>
          <button class="btn btn-secondary" type="button" data-reset>清空</button>
        </div>
        <p class="admin-status" data-admin-status role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="container admin-list-wrap">
      <div class="list-head">
        <h2 class="serif">已有项目</h2>
        <button class="btn btn-secondary btn-sm" type="button" data-refresh>刷新</button>
      </div>
      <p class="list-empty" data-list-empty hidden>还没有项目记录。用上面的表单建第一条。</p>
      <div class="admin-list" data-admin-list></div>
    </section>
  </div>
</Layout>
<script>
  const KEY_STORE = 'xiaominart-admin-key';
  const STAGE_ZH: Record<string, string> = {
    received: '已收到愿望', review: '字句审核', match: '书体匹配', writing: '创作中', delivery: '待交付', done: '已交付',
  };

  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const gateInput = document.querySelector<HTMLInputElement>('#admin-key');
  const gateSave = document.querySelector<HTMLButtonElement>('[data-gate-save]');
  const gateStatus = document.querySelector<HTMLElement>('[data-gate-status]');
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const form = document.querySelector<HTMLFormElement>('[data-admin-form]');
  const status = document.querySelector<HTMLElement>('[data-admin-status]');
  const listEl = document.querySelector<HTMLElement>('[data-admin-list]');
  const listEmpty = document.querySelector<HTMLElement>('[data-list-empty]');
  const refreshBtn = document.querySelector<HTMLButtonElement>('[data-refresh]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]');

  const getKey = () => { try { return localStorage.getItem(KEY_STORE) || ''; } catch { return ''; } };
  const setKey = (v: string) => { try { v ? localStorage.setItem(KEY_STORE, v) : localStorage.removeItem(KEY_STORE); } catch { /* ignore */ } };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

  async function loadList() {
    if (!listEl || !listEmpty) return;
    const key = getKey();
    if (!key) return;
    try {
      const res = await fetch('/api/admin/progress', { headers: { 'x-admin-key': key, Accept: 'application/json' } });
      const data = (await res.json().catch(() => null)) as { ok?: boolean; items?: Array<Record<string, string>>; message?: string } | null;
      if (!res.ok || !data?.ok) {
        if (res.status === 401) { status && (status.textContent = '密钥不正确，请重新输入。'); }
        else { status && (status.textContent = data?.message || '读取失败。'); }
        return;
      }
      const items = data.items ?? [];
      listEmpty.hidden = items.length > 0;
      listEl.innerHTML = items.map((it) => `<article class="admin-item">
        <div class="item-main">
          <div class="item-top"><code class="item-code">${esc(it.code || '')}</code><span class="item-stage">${esc(STAGE_ZH[it.stage] || it.stage || '')}</span></div>
          <h3 class="serif">${esc(it.project_name || '')}</h3>
          <p class="item-meta">${esc(it.contact_hint || '未填联系方式')}${it.updated_at ? ` · 更新于 ${esc(String(it.updated_at).slice(0, 10))}` : ''}</p>
          ${it.note ? `<p class="item-note">${esc(it.note)}</p>` : ''}
        </div>
        <div class="item-actions">
          <button class="btn btn-secondary btn-sm" type="button" data-copy-code="${esc(it.code || '')}">复制查询码</button>
          <button class="btn btn-secondary btn-sm" type="button" data-edit="${esc(it.code || '')}">编辑</button>
        </div>
      </article>`).join('');
      listEl.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((btn) => btn.addEventListener('click', async () => {
        const code = btn.dataset.copyCode || '';
        try { await navigator.clipboard.writeText(code); btn.textContent = '已复制 ✓'; }
        catch { btn.textContent = code; }
        setTimeout(() => { btn.textContent = '复制查询码'; }, 1800);
      }));
      listEl.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((btn) => btn.addEventListener('click', () => {
        const code = btn.dataset.edit || '';
        const src = items.find((i) => i.code === code);
        if (!src || !form) return;
        (form.elements.namedItem('projectName') as HTMLInputElement).value = src.project_name || '';
        (form.elements.namedItem('code') as HTMLInputElement).value = src.code || '';
        (form.elements.namedItem('contactHint') as HTMLInputElement).value = src.contact_hint || '';
        (form.elements.namedItem('stage') as HTMLSelectElement).value = src.stage || 'received';
        (form.elements.namedItem('note') as HTMLTextAreaElement).value = src.note || '';
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }));
    } catch {
      status && (status.textContent = '读取失败，请检查网络。');
    }
  }

  function enter() {
    if (gate) gate.hidden = true;
    if (panel) panel.hidden = false;
    void loadList();
  }
  if (getKey()) enter();
  gateSave?.addEventListener('click', () => {
    const v = gateInput?.value.trim() || '';
    if (!v) { gateStatus && (gateStatus.textContent = '请填写密钥。'); return; }
    setKey(v);
    gateStatus && (gateStatus.textContent = '');
    enter();
  });
  gateInput?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') gateSave?.click(); });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    const data = new FormData(form);
    const payload = {
      projectName: String(data.get('projectName') || '').trim(),
      code: String(data.get('code') || '').trim().toUpperCase(),
      contactHint: String(data.get('contactHint') || '').trim(),
      stage: String(data.get('stage') || 'received'),
      note: String(data.get('note') || '').trim(),
    };
    if (!payload.projectName) { status.textContent = '请填写项目名称。'; return; }
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;
    status.textContent = '正在保存…';
    try {
      const res = await fetch('/api/admin/progress', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-admin-key': getKey() },
        body: JSON.stringify(payload),
      });
      const out = (await res.json().catch(() => null)) as { ok?: boolean; item?: { code?: string }; message?: string } | null;
      if (res.ok && out?.ok) {
        const code = out.item?.code || payload.code;
        status.innerHTML = `已保存 ✓ 查询码 <code>${esc(code)}</code>（直接发给委托方）。`;
        form.reset();
        void loadList();
      } else {
        status.textContent = out?.message || '保存失败。';
      }
    } catch {
      status.textContent = '网络异常，请稍后再试。';
    } finally {
      if (btn) btn.disabled = false;
    }
  });
  resetBtn?.addEventListener('click', () => { form?.reset(); if (status) status.textContent = ''; });
  refreshBtn?.addEventListener('click', () => void loadList());
</script>
<style>
  .admin-head { padding: 72px 0 40px; }
  .admin-head h1 { font-size: clamp(32px, 4.4vw, 50px); font-weight: 500; margin: 16px 0 12px; }
  .admin-head p { max-width: 620px; color: var(--ink-soft); font-size: 16px; line-height: 1.9; }

  .admin-gate { max-width: 620px; padding: 26px 28px; border: 1px solid var(--line); border-left: 2px solid var(--cinnabar); background: var(--paper-light); }
  .admin-gate[hidden] { display: none; }
  .admin-gate label { display: block; color: var(--ink-soft); font-size: 13px; margin-bottom: 10px; }
  .gate-row { display: flex; gap: 12px; }
  .gate-row input { flex: 1; min-height: 48px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 0; background: var(--paper); color: var(--ink); font: inherit; }
  .gate-hint { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
  .gate-status { margin: 8px 0 0; color: var(--cinnabar-deep); font-size: 14px; }
  .gate-status:empty { display: none; }

  [data-panel][hidden] { display: none; }
  .admin-form-wrap { padding: 8px 0 0; }
  .admin-form-wrap form { max-width: 720px; padding: 28px; border: 1px solid var(--line); background: var(--paper-light); }
  .admin-form-wrap h2 { font-size: 26px; font-weight: 500; margin: 0 0 20px; }
  .admin-form-wrap label { display: block; color: var(--ink-soft); font-size: 13px; margin-bottom: 16px; }
  .admin-form-wrap .opt { color: var(--meta); font-size: 11px; }
  .admin-form-wrap input, .admin-form-wrap select, .admin-form-wrap textarea { display: block; width: 100%; margin-top: 6px; min-height: 44px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 0; background: var(--paper); color: var(--ink); font: inherit; }
  .admin-form-wrap textarea { resize: vertical; }
  .admin-form-wrap input:focus, .admin-form-wrap select:focus, .admin-form-wrap textarea:focus { border-color: var(--cinnabar); outline: none; }
  .form-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .admin-status { margin: 14px 0 0; color: var(--cinnabar-deep); font-size: 14px; line-height: 1.8; }
  .admin-status:empty { display: none; }
  .admin-status code { padding: 2px 7px; background: var(--paper-deep); letter-spacing: .08em; }

  .admin-list-wrap { padding: 48px 0 80px; }
  .list-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 18px; }
  .list-head h2 { font-size: 26px; font-weight: 500; margin: 0; }
  .btn-sm { min-height: 38px; padding: 7px 14px; font-size: 13px; }
  .list-empty { color: var(--muted); font-size: 14px; }
  .list-empty[hidden] { display: none; }
  .admin-list { display: grid; gap: 14px; }
  .admin-item { display: grid; grid-template-columns: 1fr auto; gap: 18px; padding: 18px 20px; border: 1px solid var(--line); background: var(--paper-light); }
  .item-top { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .item-code { padding: 2px 8px; background: var(--paper-deep); color: var(--ink); font: 500 13px Consolas, monospace; letter-spacing: .1em; }
  .item-stage { color: var(--cinnabar); font-size: 12px; border: 1px solid var(--cinnabar); padding: 1px 8px; }
  .admin-item h3 { font-size: 20px; font-weight: 500; margin: 10px 0 4px; }
  .item-meta { margin: 0; color: var(--muted); font-size: 12px; }
  .item-note { margin: 8px 0 0; color: var(--ink-soft); font-size: 13px; line-height: 1.8; }
  .item-actions { display: flex; flex-direction: column; gap: 8px; }

  @media (max-width: 767px) {
    .admin-head { padding: 48px 0 32px; }
    .gate-row { display: grid; }
    .gate-row .btn { width: 100%; }
    .admin-form-wrap form { padding: 20px 18px; }
    .admin-item { grid-template-columns: 1fr; }
    .item-actions { flex-direction: row; }
    .item-actions .btn { flex: 1; }
  }
</style>
