---
import Layout from '../../layouts/Layout.astro';
import FactBoundary from '../../components/FactBoundary.astro';
import CommissionGuidance from '../../components/CommissionGuidance.astro';
import { processSteps, artists } from '../../data/content';
---
<Layout title="定制创作｜Custom Commission｜XIAOMINART" description="从一个人、一处空间或一句话开始，共同创作一件东方艺术作品。"><section class="page-head container"><span class="eyebrow">Custom Commission / 定制创作</span><h1 class="serif">在形式之前，<br />先把你的意图说清楚。</h1><p lang="en">A commission begins with an intention, not an inventory.</p><p>这里不是商品下单页，而是一次低压力的创作前沟通。你可以带来一个场景、一段关系或一个还没有成形的想法。</p></section><section class="container section commission-steps"><div class="step-list">{processSteps.map((step) => <div><span class="mono">{step.no}</span><h2 class="serif">{step.zh}</h2><p lang="en">{step.en}</p><p>{step.body}</p></div>)}</div></section><section class="container section form-section"><div><span class="eyebrow">Commission brief / 定制意向</span><h2 class="serif">写给我们，<br />你希望作品留下什么。</h2><p>提交后仅用于初步沟通，不代表项目确认。我们会先阅读内容，再回复是否适合进入下一次交流。</p><CommissionGuidance /><FactBoundary /></div><form class="commission-form" aria-labelledby="commission-form-title" action="mailto:hello@xiaominart.com" method="post" enctype="text/plain"><h3 id="commission-form-title" class="sr-only">定制咨询表单 / Commission consultation form</h3><div class="form-prep"><strong>填写建议 / Before you start</strong><span>准备你的想法描述、空间照片或尺寸（如有）、期望交付时间与预算区间，可加快沟通效率。</span></div><label for="commission-name">你的称呼 / Your name<input id="commission-name" name="name" autocomplete="name" placeholder="怎么称呼你？" required /></label><label for="commission-contact">联系方式 / Contact<input id="commission-contact" name="contact" autocomplete="email" placeholder="微信优先，邮箱备选" required /></label><label for="commission-inspiration">灵感来源 / Inspiration source<input id="commission-inspiration" name="inspiration" placeholder="从案例或作品方向开始时可自动带入" /></label><label for="commission-artist">意向艺术家（可选） / Artist preference (optional)<select id="commission-artist" name="artist"><option value="">尚未确定 / Not sure yet</option>{artists.map((artist) => <option value={artist.name}>{artist.name} / {artist.en}</option>)}</select></label><label for="commission-context">作品所在的场景 / Context<select id="commission-context" name="context"><option>家居空间 / Home</option><option>企业或文化空间 / Business or cultural space</option><option>礼赠或纪念 / Gift or milestone</option><option>艺术礼盒 / Art gift</option><option>其他 / Other</option></select></label><label for="commission-use">作品用途 / Intended use<select id="commission-use" name="use"><option>居家装饰 / Home decor</option><option>礼赠 / Gift</option><option>其他 / Other</option></select></label><label for="commission-size">期望尺寸 / 媒介<input id="commission-size" name="size" placeholder="如有偏好可填写，暂不确定也可以" /></label><label for="commission-budget">预算区间 / Budget range<select id="commission-budget" name="budget"><option>无需限定 / No fixed range</option><option>5k 以内 / Under 5k</option><option>5k–2w</option><option>2w–10w</option><option>10w 以上 / Above 100k</option></select></label><label for="commission-display-space">陈设空间（可选） / Display space (optional)<select id="commission-display-space" name="displaySpace"><option value="">请选择 / Select a space</option><option>玄关</option><option>客厅</option><option>茶室</option><option>书房</option><option>办公室</option><option>企业会客厅</option><option>民宿空间</option><option>其他 / Other</option></select></label><label class="custom-space" for="commission-display-space-other">其他空间 / Other space<input id="commission-display-space-other" name="displaySpaceOther" placeholder="如有需要，请补充具体空间" /></label><label for="commission-intention">你想表达的意图 / Intention<textarea id="commission-intention" name="intention" rows="5" placeholder="写给谁、在哪里被看见、希望它带来怎样的气息？" required></textarea></label><label for="commission-direction">希望的艺术方向 / Artistic direction<input id="commission-direction" name="direction" placeholder="书写、器物、空间、色彩，或还不确定" /></label><label for="commission-artist">意向合作艺术家（可选） / Preferred artist<select id="commission-artist" name="artist"><option value="">暂不确定 / Not sure yet</option>{artists.map((artist) => <option value={artist.name}>{artist.name} / {artist.en}</option>)}</select></label><label for="commission-images">空间照片 / 参考图（可选） / Images<input id="commission-images" name="images" type="file" accept="image/*" multiple /></label><label for="commission-timeline">期望交付时间 / Desired timeline<input id="commission-timeline" name="timeline" placeholder="例如：今年秋季，或暂不确定" /></label><label class="consent"><input type="checkbox" name="private" checked /> 默认私密，仅用于沟通 / Keep my brief private by default</label><button class="btn btn-primary" type="submit">提交定制意向 / Send brief →</button><p class="form-note">提交后将打开默认邮件客户端，请在发送前检查内容。</p><p class="form-note" data-form-status aria-live="polite">提交后我们会在 1–2 个工作日内联系你；如需补充材料，也可直接邮件联系 hello@xiaominart.com。</p></form></section></Layout>
<script>
  const params = new URLSearchParams(window.location.search);
  const setValue = (name: string, value: string | null) => { const field = document.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`); if (field && value) field.value = value; };
  setValue('inspiration', params.get('inspiration') ? `${params.get('inspiration')}${params.get('tag') ? ` / ${params.get('tag')}` : ''}` : null);
  setValue('direction', params.get('direction'));
  setValue('artist', params.get('artist'));
  const contextParam = params.get('context') || (params.get('scene') === 'gift' ? '艺术礼盒' : null);
  setValue('context', contextParam === '艺术礼盒' ? '艺术礼盒 / Art gift' : contextParam);
  setValue('displaySpace', params.get('space'));
  setValue('intention', params.get('style') ? `方向工具选择：${params.get('style')}；预算：${params.get('budget') || '尚未确定'}；时间：${params.get('timeline') || '不急'}` : null);
  const displaySpace = document.querySelector<HTMLSelectElement>('select[name="displaySpace"]');
  const customSpace = document.querySelector<HTMLElement>('.custom-space');
  if (customSpace) customSpace.style.display = displaySpace?.value.includes('其他') ? 'block' : 'none';
  displaySpace?.addEventListener('change', () => { if (customSpace) customSpace.style.display = displaySpace.value.includes('其他') ? 'block' : 'none'; });
  const commissionForm = document.querySelector<HTMLFormElement>('.commission-form');
  if (commissionForm) {
    const status = document.createElement('p');
    status.className = 'form-feedback';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');
    commissionForm.append(status);
    commissionForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => field.addEventListener('invalid', () => {
      field.setCustomValidity('请先填写或选择这一项，再继续提交。 / Please complete this field before continuing.');
    }));
    commissionForm.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((field) => field.addEventListener('input', () => field.setCustomValidity('')));
    commissionForm.addEventListener('submit', () => {
      status.textContent = '已准备好打开默认邮件客户端。邮件发送后，我们会在 1–2 个工作日内联系你；也可直接补充邮件至 hello@xiaominart.com。 / Your email client is ready to open. After sending, we will reply within 1–2 business days.';
    });
  }
</script>
<style>
.page-head{padding:94px 0 72px;max-width:1200px}.page-head h1{font-size:clamp(52px,7vw,92px);line-height:1.16;font-weight:500;letter-spacing:var(--tracking-display);margin:22px 0}.page-head p{max-width:650px;color:var(--ink-soft);font-size:18px}.page-head p[lang=en]{font:24px/1.5 var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.commission-steps{border-top:1px solid var(--line)}.step-list{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}.step-list>div{padding:22px 22px 28px 0;min-height:250px}.step-list>div+div{border-left:1px solid var(--line);padding-left:22px}.step-list h2{font-size:30px;font-weight:500;margin:34px 0 4px}.step-list p{font-size:14px;color:var(--ink-soft)}.step-list p[lang=en]{font:17px var(--font-display-en),Georgia,serif;color:var(--ink)}.form-section{display:grid;grid-template-columns:1fr 1fr;gap:90px;border-top:1px solid var(--line)}.form-section h2{font-size:46px;font-weight:500;line-height:1.3;margin:18px 0}.form-section>div>p{color:var(--ink-soft);max-width:520px}.commission-form{border-top:1px solid var(--line);padding-top:16px}.commission-form label{display:block;color:var(--ink-soft);font-size:13px;margin-bottom:18px}.commission-form input:not([type=checkbox]),.commission-form select,.commission-form textarea{display:block;width:100%;margin-top:7px;border:1px solid var(--line);border-radius:0;background:var(--paper-light);color:var(--ink);padding:12px 13px}.commission-form textarea{resize:vertical}.commission-form input:focus,.commission-form select:focus,.commission-form textarea:focus{border-color:var(--cinnabar)}.commission-form .consent{display:flex;align-items:flex-start;gap:9px}.commission-form .consent input{margin-top:5px;accent-color:var(--cinnabar)}.form-prep{display:flex;flex-direction:column;gap:6px;margin-bottom:22px;padding:12px 14px;border-left:2px solid #2A5A6B;background:var(--paper-light);color:var(--ink-soft);font-size:12px;line-height:1.7}.form-prep strong{color:var(--ink);font-weight:500}.custom-space{display:none}.form-note{color:var(--meta);font-size:11px;margin-top:14px}@media(max-width:767px){.page-head{padding:58px 0 48px}.page-head h1{font-size:54px}.page-head p[lang=en]{font-size:20px}.step-list,.form-section{grid-template-columns:1fr;gap:28px}.step-list>div,.step-list>div+div{min-height:0;padding:18px 0;border-left:0;border-bottom:1px solid var(--line)}.step-list>div:last-child{border-bottom:0}.step-list h2{margin:12px 0 4px}.form-section h2{font-size:36px}}
.form-feedback{margin:14px 0 0;padding:10px 12px;border-left:2px solid var(--cinnabar);color:var(--cinnabar-deep);font-size:12px;line-height:1.7}
</style>
