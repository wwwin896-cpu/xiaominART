---
import Layout from '../../layouts/Layout.astro'; import { seasons } from '../../data/content';
export function getStaticPaths(){ return seasons.map((season)=>({params:{slug:season.slug},props:{season}})); }
const { season } = Astro.props;
---
<Layout title={`${season.name}｜${season.line}｜小民艺术`} description={`${season.name}季内容与祝愿入口。`}><section class="container page-head"><span class="eyebrow">Season / 四季节气</span><h1 class="serif">{season.name}，{season.line}</h1><p>{season.note}</p></section><section class="container season-note"><span class="eyebrow">Today / 当下</span><h2 class="serif">今天适合写给谁？</h2><p>这一页记录节气与日常祝愿。更多主题、推荐祝愿、视频与故事会随着创作笔记持续呈现。</p><span class="pending">更多节气内容将持续呈现。</span></section></Layout>
<style>.page-head{padding:96px 0 72px}.page-head h1{font-size:clamp(52px,7vw,84px);margin:20px 0}.page-head p{color:var(--muted);font-size:18px}.season-note{border-block:1px solid var(--border);padding:56px 0;max-width:760px}.season-note h2{font-size:42px;margin:18px 0}.season-note p{color:var(--muted)}.pending{display:inline-block;border-bottom:1px dashed var(--border);color:var(--meta);font-size:13px;margin-top:18px}@media(max-width:767px){.page-head{padding:56px 0 40px}.season-note h2{font-size:34px}}
</style>
