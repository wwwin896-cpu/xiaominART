---
/**
 * 定制业务 · 总入口（2026-10-19 新建）
 *
 * 为什么要有这一页：业主把「企业礼赠」改名为「定制业务」并把二级拆成
 * 企业定制 / 个人定制之后，一级菜单需要一个落点。它不该直接跳到企业页，
 * 因为个人定制会显得像附属业务；也不该做成只有两个链接的空壳页。
 *
 * GEO 理由：AI 助手被问「小民艺术能做什么定制」时，需要一个能一次说清
 * 「两条线分别是什么、起订量差多少、周期差多少」的页面。
 * 因此本页核心不是排版，是那张「两条线怎么选」的对照表。
 *
 * ⚠️ 路径说明：/custom/ 此前是 301 到 /custom-commission/ 的旧地址，
 *    本轮已从 public/_redirects 删除那两条规则（该路径从未上线过独立页面，
 *    没有外链价值损失）。
 */
import Layout from '../../layouts/Layout.astro';

const lines = [
  {
    href: '/business-gifts/',
    eyebrow: 'For Business',
    name: '企业定制',
    en: 'Corporate',
    lead: '面向企业采购：员工福利、客户答谢、庆典纪念与校园活动。可定制企业标识，对公结算，可开增值税专票。',
    facts: ['不设固定起订量', '常规 25–45 个工作日', '可开专票 · 分地址寄送'],
    subs: [
      { href: '/business-gifts/gifts/', name: '商务伴手礼' },
      { href: '/business-gifts/keep/', name: '庆典墨宝礼' },
      { href: '/business-gifts/space/', name: '空间书法礼' },
      { href: '/business-gifts/campus/', name: '校园纪念礼' },
    ],
  },
  {
    href: '/custom/personal/',
    eyebrow: 'For Individuals',
    name: '个人定制',
    en: 'Personal',
    lead: '面向个人与家庭：送礼、婚庆、乔迁、自用与节庆。按对象与场合给题字建议，单幅起做，含装裱与礼盒。',
    facts: ['单幅起做', '常规 7–14 个工作日', '含装裱 · 7 天内可退换'],
    subs: [
      { href: '/custom/personal/gifting/', name: '送礼定制' },
      { href: '/custom/personal/wedding/', name: '婚庆纪念' },
      { href: '/custom/personal/housewarming/', name: '乔迁新居' },
      { href: '/custom/personal/study/', name: '自用雅趣' },
      { href: '/custom/personal/festival/', name: '节日定制' },
    ],
  },
];

const faqs = [
  {
    q: '企业定制和个人定制的区别是什么？',
    a: '三条：规模、周期、结算方式。企业定制不设固定起订量，按项目评估，常规交付 25–45 个工作日，支持对公结算与增值税专票；个人定制单幅起做，常规 7–14 个工作日发出，个人支付。内容与工艺标准两条线一致。',
  },
  {
    q: '定制需要先准备什么？',
    a: '三件事：送给谁（或挂在哪个空间）、大概什么时候要、想表达什么。第三件想不清楚也没关系，把前两件说清楚，我们会给题字方向。',
  },
  {
    q: '提交之后多久有回复？',
    a: '工作日 24 小时内回复。企业采购需求表提交后 2 个工作日内给方案与报价；个人定制通常先回一轮题字与尺寸建议，确认后再报价。',
  },
  {
    q: '可以只买现货，不定制吗？',
    a: '可以。站内已有写好的现货作品，装裱完成即可发出，不需要等待创作周期。现货是固定内容与尺寸，定制则可以改内容、改尺寸、加姓名与日期。',
  },
  {
    q: '定制品可以退换吗？',
    a: '可以。签收后 7 天内均可提出退换，定制品同样适用——书法不满意可以重新写。运费按原因承担：买家原因由买家承担，卖家原因由卖家承担。',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '书法定制',
  serviceType: '书法作品定制',
  description: '企业批量定制与个人单幅定制两条业务线：企业侧不设固定起订量、可开专票、25–45 个工作日交付；个人侧单幅起做、含装裱、7–14 个工作日发出。',
  url: 'https://xiaominart.com/custom/',
  areaServed: { '@type': 'Country', name: 'China' },
  provider: { '@type': 'Organization', name: '小民艺术', url: 'https://xiaominart.com' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: '定制业务',
    itemListElement: lines.flatMap((line) =>
      line.subs.map((sub) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: sub.name, url: `https://xiaominart.com${sub.href}` },
      })),
    ),
  },
};
---

<Layout
  title="定制业务｜企业批量定制与个人书法定制｜小民艺术"
  description="小民艺术定制业务分两条线：企业定制不设固定起订量，可定制企业标识、对公结算、可开专票，常规 25–45 个工作日；个人定制单幅起做，按对象与场合给题字建议，含装裱，常规 7–14 个工作日发出。"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />

  <section class="container page-head">
    <span class="eyebrow">Custom / 定制业务</span>
    <h1 class="serif">先沟通，再落笔。</h1>
    <p class="hero-lead">
      书法不是标准品。写哪几个字、多大、用什么纸，取决于送给谁、挂在哪里。所以我们不设「加入购物车」，先谈清楚，再报价。
    </p>
    <p class="hero-lead hero-lead--sub">
      定制分两条线：企业批量与个人单幅。规模、周期、结算方式都不同，先看下方对照再选。
    </p>
  </section>

  <section class="container section" aria-labelledby="lines-title">
    <div class="section-lead">
      <span class="eyebrow">Two Lines</span>
      <h2 id="lines-title" class="serif">你属于哪一条线</h2>
    </div>
    <div class="line-grid">
      {lines.map((line) => (
        <article class="line-card">
          <span class="eyebrow">{line.eyebrow}</span>
          <h3 class="serif">{line.name}<small lang="en">{line.en}</small></h3>
          <p class="line-lead">{line.lead}</p>
          <ul class="line-facts">
            {line.facts.map((f) => <li>{f}</li>)}
          </ul>
          <ul class="line-subs">
            {line.subs.map((sub) => (
              <li><a href={sub.href}>{sub.name}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
          <a class="line-cta" href={line.href} data-event="custom_entry">
            进入{line.name} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="container section" aria-labelledby="compare-title">
    <div class="section-lead">
      <span class="eyebrow">Comparison</span>
      <h2 id="compare-title" class="serif">两条线的关键差别</h2>
      <p>以下为常规口径。具体项目在报价阶段逐项确认。</p>
    </div>
    <div class="compare-table" role="table" aria-label="企业定制与个人定制对照">
      <div class="compare-row compare-head" role="row">
        <span role="columnheader">项目</span>
        <span role="columnheader">企业定制</span>
        <span role="columnheader">个人定制</span>
      </div>
      {[
        ['规模', '按项目评估 · 不设固定量', '单幅起做'],
        ['主要内容', '商务伴手礼 · 庆典墨宝 · 空间书法 · 校园纪念', '送礼 · 婚庆 · 乔迁 · 自用 · 节庆'],
        ['定制范围', '企业标识 · 内容 · 尺寸 · 包装', '内容 · 书体 · 尺寸 · 装裱'],
        ['交付周期', '常规 25–45 个工作日（含打样）', '常规 7–14 个工作日'],
        ['结算与发票', '对公结算 · 可开增值税专票', '个人支付'],
        ['寄送', '可分地址寄送至收礼人', '单地址寄送'],
        ['退换', '按合同约定', '签收后 7 天内，定制品同样适用'],
      ].map((row) => (
        <div class="compare-row" role="row">
          <span role="rowheader">{row[0]}</span>
          <span role="cell">{row[1]}</span>
          <span role="cell">{row[2]}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container section" aria-labelledby="process-title">
    <div class="section-lead">
      <span class="eyebrow">Process</span>
      <h2 id="process-title" class="serif">四步，从一句话到一幅字</h2>
    </div>
    <ol class="process-list">
      <li><span class="mono">01</span><h3 class="serif">倾听</h3><p>说清楚送给谁、挂在哪里、想留下什么。一段话就够。</p></li>
      <li><span class="mono">02</span><h3 class="serif">取意</h3><p>我们给题字方向、书体与尺寸建议，附报价，你确认后再动笔。</p></li>
      <li><span class="mono">03</span><h3 class="serif">创作</h3><p>亲笔书写，完成后先给成品，不满意可以重写。</p></li>
      <li><span class="mono">04</span><h3 class="serif">抵达</h3><p>装裱、包装、寄出；企业侧可分地址配送并附清单。</p></li>
    </ol>
  </section>

  <section class="container section" aria-labelledby="faq-title">
    <div class="section-lead">
      <span class="eyebrow">FAQ</span>
      <h2 id="faq-title" class="serif">常见问题</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container cta-band">
    <div>
      <p class="cta-title serif">还没想好写什么？</p>
      <p>先说说送给谁、为什么送。题字方向我们来给，不合适可以换。</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href="/custom-commission/" data-event="custom_inquiry_start">提交定制需求 →</a>
      <a class="btn btn-ghost" href="/gifts/ready-made/">先看现货 →</a>
    </div>
  </section>
</Layout>

<style>
  .hero-lead {
    max-width: 660px;
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.9;
    color: var(--ink-soft);
  }
  .hero-lead--sub {
    margin-top: 10px;
    font-size: 15px;
    color: var(--muted);
  }

  .line-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin-top: 26px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .line-card {
    display: flex;
    flex-direction: column;
    padding: 30px 28px;
    background: var(--paper);
  }
  .line-card h3 {
    margin: 10px 0 0;
    font-size: 26px;
  }
  .line-card h3 small {
    margin-left: 10px;
    font-family: var(--font-body-en);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .line-lead {
    margin: 14px 0 0;
    font-size: 14.5px;
    line-height: 1.95;
    color: var(--ink-soft);
  }
  .line-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 13.5px;
    color: var(--cinnabar-deep);
  }
  .line-facts li::before {
    content: '·';
    margin-right: 6px;
  }
  .line-subs {
    margin: 22px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    flex: 1;
  }
  .line-subs a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    font-size: 14.5px;
    color: var(--ink);
    text-decoration: none;
  }
  .line-subs a:hover {
    color: var(--cinnabar-deep);
  }
  .line-cta {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 14.5px;
    color: var(--cinnabar);
    text-decoration: none;
  }

  .compare-table {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  .compare-row {
    display: grid;
    grid-template-columns: 140px 1fr 1fr;
    gap: 20px;
    padding: 15px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14.5px;
    line-height: 1.8;
  }
  .compare-row > span:first-child {
    color: var(--muted);
  }
  .compare-head {
    padding: 12px 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .compare-head > span {
    color: var(--muted);
  }

  .process-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }
  .process-list li {
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .process-list .mono {
    font-size: 12px;
    color: var(--cinnabar);
  }
  .process-list h3 {
    margin: 8px 0 6px;
    font-size: 17px;
  }
  .process-list p {
    margin: 0;
    font-size: 14px;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .faq-list {
    margin-top: 22px;
    border-top: 1px solid var(--line);
  }
  .faq-list details {
    border-bottom: 1px solid var(--line);
  }
  .faq-list summary {
    padding: 16px 0;
    cursor: pointer;
    font-size: 15.5px;
    color: var(--ink);
  }
  .faq-list p {
    margin: 0 0 18px;
    max-width: 760px;
    font-size: 14.5px;
    line-height: 1.95;
    color: var(--ink-soft);
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 8px;
    padding: 26px 28px;
    background: var(--paper-light);
    border: 1px solid var(--line);
  }
  .cta-band .cta-title {
    margin: 0 0 6px;
    font-size: 18px;
    color: var(--ink);
  }
  .cta-band p {
    margin: 0;
    max-width: 560px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-soft);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
  }
  .cta-actions .btn {
    margin: 0;
  }

  @media (max-width: 860px) {
    .line-grid {
      grid-template-columns: 1fr;
    }
    .process-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .line-card {
      padding: 24px 20px;
    }
    .compare-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .compare-head {
      display: none;
    }
    .compare-row > span:first-child::before {
      content: '';
    }
    .compare-row > span:first-child {
      font-size: 12px;
      letter-spacing: 0.08em;
    }
    .compare-row > span:not(:first-child)::before {
      content: attr(data-none);
    }
    .process-list {
      grid-template-columns: 1fr;
    }
    .cta-band {
      padding: 20px 18px;
    }
    .cta-actions {
      width: 100%;
    }
    .cta-actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
