---
/**
 * 个人定制 · 节日定制
 * 素材依据：首页场景卡「四季流转」与 /seasons/ 四季节气页已公开的节庆方向。
 */
import CustomDetailPage from '../../../components/CustomDetailPage.astro';

const siblings = [
  { href: '/custom/personal/gifting/', name: '送礼定制', desc: '送老师、送长辈、送领导，不知道写什么我们给方向。' },
  { href: '/custom/personal/wedding/', name: '婚庆纪念', desc: '订婚、结婚、周年与新生儿，把两个人的日子写成字。' },
  { href: '/custom/personal/housewarming/', name: '乔迁新居', desc: '搬进新家，墙上该有一句属于这间屋子的话。' },
  { href: '/custom/personal/study/', name: '自用雅趣', desc: '书房、茶室、斋号与个人签名，写给自己看。' },
];
---

<CustomDetailPage
  name="节日定制"
  nameEn="Festive"
  tagline="赶在日子之前，把祝福写好。"
  seoTitle="节日定制书法｜春节、中秋与节庆题的题字与礼盒｜小民艺术"
  seoDescription="节日书法定制：春节、中秋、端午、重阳与七夕的题字与节庆礼。可按家庭或亲友分别定制，含装裱与节庆礼盒，常规 7–14 个工作日发出，节前高峰建议提前三周沟通。"
  contextValue="节日定制"
  quickFacts={[
    { label: '适合', value: '春节 · 中秋 · 端午 · 重阳 · 七夕' },
    { label: '篇幅', value: '斗方、横幅、对联；可做小幅卡纸与摆件' },
    { label: '周期', value: '常规 7–14 个工作日；节前高峰建议提前三周' },
    { label: '怎么开始', value: '告诉我们节日与送给谁，先说截止时间' },
  ]}
  intro={[
    '节日的字有一个硬约束：它必须在那个日子之前到。所以节日定制第一件事不是选内容，是确认时间。',
    '第二件事是分清用途。贴门上的对联、挂客厅的斗方、送亲友的小幅摆件，三种做法完全不同——对联讲究对仗与尺寸匹配，斗方讲究一眼看懂，小幅摆件讲究便于寄送。',
    '如果是要送给多位亲友，可以把名单给我们，一人一幅会太慢，通常做法是同一句吉语写多幅，每幅单独落款，这样既统一又不撞。',
  ]}
  scenarios={[
    { title: '春节', body: '门联、福字、客厅斗方。年前是全年最挤的时段，越早定内容越稳。' },
    { title: '中秋', body: '家宴、送礼。写「花好月圆」这类团圆意象，配素纸与浅色框更耐看。' },
    { title: '端午 / 重阳', body: '偏文化性的节日，适合写与节气、安康相关的句子，送给长辈尤其合适。' },
    { title: '七夕', body: '两个人的节日，写一句只有你们懂的话，比通用祝福更适合。' },
  ]}
  wordings={[
    { scene: '春节', words: '新春大吉 · 万事如意 · 岁岁平安 · 福', note: '对联需成对撰写，上下联与横批一并确认。' },
    { scene: '中秋', words: '花好月圆 · 阖家团圆 · 月满人安', note: '团圆意象为主，避免过于个人的句子。' },
    { scene: '端午 / 重阳', words: '安康 · 长安 · 松鹤延年 · 岁岁安康', note: '送长辈优先选安康类，语气稳。' },
    { scene: '七夕', words: '一期一会 · 与子偕老 · 两个人的名字', note: '字少一点更好，留白比写满耐看。' },
  ]}
  specs={[
    { label: '排期怎么算', value: '按下单日加 7–14 个工作日估算，再留出快递时间。春节前四周起进入高峰，建议提前三周以上沟通。' },
    { label: '对联', value: '需成对撰写，上下联字数、平仄与横批一并确认。门框宽度决定尺寸，请提前量好。' },
    { label: '送多位亲友', value: '同一句吉语写多幅、每幅单独落款，是效率与体面兼顾的做法；每幅内容都不同则需要更长周期。' },
    { label: '包装', value: '含装裱与礼盒。节庆礼盒可按节日更换腰封，适合直接寄给收礼人。' },
    { label: '费用', value: '按内容、字数、尺寸与装裱方式计价；多幅同一内容会另行报价。' },
    { label: '售后', value: '签收后 7 天内可提出退换，定制品同样适用。运输损坏可退回修复后重发。' },
  ]}
  faqs={[
    { q: '春节要提前多久？', a: '建议提前三周以上，春节前四周起进入全年最挤的时段。常规制作周期是 7–14 个工作日，再加快递时间。如果现在离节日不足两周，请直接告诉我们日期，我们答复能否赶上，赶不上会明说。' },
    { q: '对联可以自己出内容吗？', a: '可以，但需要对仗与平仄，我们会先校对再动笔。也可以从我们给出的几组里选，改动其中一两个字更稳妥。' },
    { q: '想送给好几位亲友，怎么做？', a: '推荐同一句吉语写多幅，每幅单独落款写对方名字。这样风格统一、周期可控，也不会出现两家人收到一模一样作品的尴尬。数量多时请先给名单与地址，我们按批安排。' },
    { q: '节日礼盒和平时有区别吗？', a: '有。节庆礼盒可以按节日更换腰封与内衬，例如春节用朱红、中秋用月白。作品本身不变，包装更贴合节令。' },
    { q: '错过了节日还能定吗？', a: '可以，节日内容不作为限定。只是过了那个日子再送，语义会弱一些；这种情况我们通常建议改成通用吉语或纪念性内容。' },
    { q: '福字可以倒着写吗？', a: '可以，这是常见做法。但正式赠礼场合建议正写——倒福偏居家趣味，送给长辈或客户时容易把握不好分寸。' },
  ]}
  siblings={siblings}
/>
