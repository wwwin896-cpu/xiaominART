---
/**
 * 个人定制 · 送礼定制
 *
 * 素材依据：站内已交付故事「康而寿」（首页 storyCards 第 1 条，送给结婚三十年的父母），
 * 以及 /help/ 页已公开的售后与周期口径。未新增任何站上查不到的承诺。
 */
import CustomDetailPage from '../../../components/CustomDetailPage.astro';

const siblings = [
  { href: '/custom/personal/wedding/', name: '婚庆纪念', desc: '订婚、结婚、周年与新生儿，把两个人的日子写成字。' },
  { href: '/custom/personal/housewarming/', name: '乔迁新居', desc: '搬进新家，墙上该有一句属于这间屋子的话。' },
  { href: '/custom/personal/study/', name: '自用雅趣', desc: '书房、茶室、斋号与个人签名，写给自己看。' },
  { href: '/custom/personal/festival/', name: '节日定制', desc: '春节、中秋与节庆礼，赶在日子之前写好。' },
];
---

<CustomDetailPage
  name="送礼定制"
  nameEn="Gifting"
  tagline="送人的字，得先想清楚送给谁。"
  seoTitle="送礼定制定制书法｜送老师、送长辈、送领导的题字内容与尺寸｜小民艺术"
  seoDescription="个人书法定制：送老师、送长辈父母、送领导与合作伙伴。按对象与场合给题字建议，亲笔手写、含装裱与礼盒，常规 7–14 个工作日发出，签收后 7 天内可提出退换，定制品同样适用。"
  contextValue="送礼定制"
  quickFacts={[
    { label: '适合送', value: '老师与导师 · 长辈父母 · 领导与合作伙伴' },
    { label: '篇幅', value: '单幅起，画芯 16×8cm 起，可做横幅、斗方、对联' },
    { label: '周期', value: '常规 7–14 个工作日发出，赶日子请先说明' },
    { label: '怎么开始', value: '说清楚送给谁、为什么送，我们给题字建议' },
  ]}
  intro={[
    '送礼最难的一步不是挑东西，是想清楚要说什么。字写在纸上，比说出口的话留得久，所以它适合那些「当面说不出口、但确实想说」的场合。',
    '我们不做现成的祝福语批发。你先说清楚这个人是谁、你们之间发生过什么、这幅字将来会挂在哪里，我们再一起定写哪几个字、用什么书体、多大尺寸。',
    '如果你已经有想写的那句话，直接告诉我们就行。书法能承载的内容比多数人以为的宽——四字吉语可以，一句家训可以，一个人的名字也可以。',
  ]}
  scenarios={[
    { title: '送老师与导师', body: '毕业季、教师节、谢师宴。写师恩，也写他教给你的那件事——比「桃李满天下」更具体。' },
    { title: '送长辈与父母', body: '寿辰、节日、结婚纪念。写健康与长久，也写这个家这些年攒下来的东西。' },
    { title: '送领导与合作伙伴', body: '升职、合作达成、节日问候。分寸感比辞藻重要，我们会给几个不同力度的方向供你选。' },
  ]}
  wordings={[
    { scene: '送老师 / 导师', words: '师恩难忘 · 桃李芬芳 · 传道授业 · 春风化雨', note: '想更具体，可以写他常说的那句话，或你们的师门名。' },
    { scene: '送长辈 / 父母', words: '松鹤延年 · 福寿康宁 · 家和万事兴 · 康而寿', note: '「康而寿」是我们真实交付过的一幅：康是平安，寿是长久。' },
    { scene: '送领导 / 合作伙伴', words: '厚德载物 · 高瞻远瞩 · 合作共赢 · 行稳致远', note: '不建议写过于私人化的句子，分寸比文采更重要。' },
    { scene: '想写自己的话', words: '一句家训 · 一段回忆 · 对方的姓名或字号', note: '把原话发给我们，我们会判断它适合写成几个字、什么书体。' },
  ]}
  specs={[
    { label: '篇幅与形式', value: '以单幅为主。常见为横幅、斗方与对联；画芯 16×8cm 起，可按墙面或摆放位置放大。' },
    { label: '书体', value: '楷、行、隶、篆均可。古文字（甲骨、金文、篆书）需要先确认字形出处，会多花一点沟通时间。' },
    { label: '装裱与包装', value: '含装裱与礼盒。木框、卷轴、卡纸三种形式按用途选，挂墙与摆放的尺寸建议不同。' },
    { label: '周期', value: '常规 7–14 个工作日发出。内容需考据、尺寸特殊或赶上节前高峰时，会在确认阶段告知具体天数。' },
    { label: '费用', value: '按内容、尺寸与装裱方式计价，方向确认后给报价，报价即最终价。' },
    { label: '售后', value: '签收后 7 天内可提出退换，定制品同样适用。作品不满意可以重写；物流损坏可退回修复后重发。' },
  ]}
  cases={[
    {
      title: '结婚三十年的父母 · 康而寿',
      image: '/assets/scenes/study-kang-er-shou.jpg',
      alt: '书房案头的「康而寿」书法横幅，旁有台灯与书卷',
      note: '客人想给结婚三十年的爸妈留一件东西。最后写了「康而寿」三个字——康是平安，寿是长久。挂进书房那天，他父亲说，这三个字比什么都实在。',
    },
  ]}
  faqs={[
    { q: '不知道写什么字，能给建议吗？', a: '可以，这是沟通里最先解决的一步。你只需要说清楚送给谁、为什么送、大概挂在哪里，我们会给 3–5 个题字方向，并说明各自适合的分寸与语气，你从中选一个再动笔。' },
    { q: '可以先看效果再决定吗？', a: '可以先确认题字内容、书体与尺寸，再进入创作。作品完成后会先给你看成品，不满意可以重写——这是定制品也支持 7 天无理由的原因。' },
    { q: '多久能收到？', a: '常规 7–14 个工作日发出。如果是要赶教师节、寿辰或某个具体日子，请在咨询时先说明时间点，我们会直接答复能不能赶上；赶不上也会提前讲清楚，不让您空等。' },
    { q: '送领导会不会太私人？', a: '分寸由题字内容决定，不由形式决定。四字吉语、行楷横幅是稳妥的选择；如果关系更近，可以写一句更具体的话。我们会先问清楚你们的关系，再给方向。' },
    { q: '字是手写的还是印的？', a: '亲笔手写，每一幅都是单独创作，因此笔迹会有自然差异，这是手写作品的基本特征，不视为质量问题。需要完全一致的呈现（例如批量复制同一幅），请提前说明用途。' },
    { q: '收到后怎么挂？', a: '横幅与斗方建议按视线高度居中悬挂，卷轴适合书房与茶室。下单时告诉我们墙面朝向与家具高度，我们会给出尺寸与装裱形式的建议。' },
  ]}
  siblings={siblings}
/>
