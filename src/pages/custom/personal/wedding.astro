---
/**
 * 个人定制 · 婚庆纪念
 * 素材依据：首页场景卡「琴瑟和鸣」与 /gifts/qin-se-he-ming-gift/ 商品页已公开的题字与用法。
 */
import CustomDetailPage from '../../../components/CustomDetailPage.astro';

const siblings = [
  { href: '/custom/personal/gifting/', name: '送礼定制', desc: '送老师、送长辈、送领导，不知道写什么我们给方向。' },
  { href: '/custom/personal/housewarming/', name: '乔迁新居', desc: '搬进新家，墙上该有一句属于这间屋子的话。' },
  { href: '/custom/personal/study/', name: '自用雅趣', desc: '书房、茶室、斋号与个人签名，写给自己看。' },
  { href: '/custom/personal/festival/', name: '节日定制', desc: '春节、中秋与节庆礼，赶在日子之前写好。' },
];
---

<CustomDetailPage
  name="婚庆纪念"
  nameEn="Wedding & Milestone"
  tagline="两个人的日子，值得写成字挂起来。"
  seoTitle="婚庆纪念定制书法｜结婚、周年、新生儿题字与婚礼现场用字｜小民艺术"
  seoDescription="婚庆纪念书法定制：订婚结婚、结婚周年、新生儿满月百日的题字与现场用字。可写两人姓名与日期，含装裱与礼盒，常规 7–14 个工作日发出，签收后 7 天内可提出退换。"
  contextValue="婚庆纪念"
  quickFacts={[
    { label: '适合', value: '订婚结婚 · 结婚周年 · 新生儿满月与周岁' },
    { label: '篇幅', value: '横幅、斗方、对联；可按婚礼现场尺寸放大' },
    { label: '周期', value: '常规 7–14 个工作日发出，婚礼日期请提前说明' },
    { label: '怎么开始', value: '告诉我们日子、姓名与挂的位置' },
  ]}
  intro={[
    '婚礼上用到的东西，多数会收进箱子里。一幅字不太一样——它会被挂在客厅、卧室或者书房，成为这个家每天都会看见的背景。',
    '所以婚庆的字不应该只写「百年好合」。你们怎么认识的、一起经历过什么、想让这幅字将来提醒你们什么，这些才是让它区别于淘宝印刷品的部分。',
    '我们的做法是先把内容定下来：写哪几个字、要不要带两人的姓名与日期、落款写什么。内容确认之后，尺寸与装裱才有的放矢。',
  ]}
  scenarios={[
    { title: '订婚 / 结婚', body: '婚礼现场背景、签到区，或婚后挂进新房的客厅与卧室。' },
    { title: '结婚周年', body: '一周年、五周年、十周年。写这一年你们最想记住的那件事，比通用祝福更耐看。' },
    { title: '新生儿满月 / 百日 / 周岁', body: '写平安与期许。可以带孩子的名字，也可以只写一句将来他会懂的话。' },
    { title: '送新人', body: '作为贺礼送到婚礼现场或新家，落款写上你的名字，比红包留得久。' },
  ]}
  wordings={[
    { scene: '订婚 / 结婚', words: '百年好合 · 琴瑟和鸣 · 永结同心 · 佳偶天成', note: '最常用的一组。「琴瑟和鸣」我们做过朱砂底横幅，适合卧室与边柜。' },
    { scene: '结婚周年', words: '岁月静好 · 执子之手 · 初心如故 · 与子偕老', note: '可以加一行小字写结婚日期与地点，作为私人记号。' },
    { scene: '新生儿', words: '平安喜乐 · 前程似锦 · 聪慧灵秀 · 长乐', note: '带名字时建议用小字题跋，主体保持一句吉语，避免画面拥挤。' },
    { scene: '想写自己的话', words: '相识的日期 · 一句只有你们懂的话 · 两个人的姓氏', note: '把原话发给我们，会判断适合的字数与书体。' },
  ]}
  specs={[
    { label: '能否写姓名与日期', value: '可以。通常放在落款或小字题跋，也可作为主体。姓名用字需你逐字确认，避免同音字写错。' },
    { label: '婚礼现场用', value: '可按现场背景尺寸放大，做成卷轴或装框立牌。需要提前给现场照片与摆放位置，确认视觉比例。' },
    { label: '形式与装裱', value: '朱砂底、洒金笺、素纸均可选；木框、卷轴、卡纸三种装裱，含礼盒。' },
    { label: '周期', value: '常规 7–14 个工作日发出。婚礼、满月酒这类固定日期，请在下单时直接说明，我们先判断能否赶上。' },
    { label: '费用', value: '按内容、尺寸与装裱方式计价，方向确认后给报价，报价即最终价。' },
    { label: '售后', value: '签收后 7 天内可提出退换，定制品同样适用。作品不满意可以重写。' },
  ]}
  faqs={[
    { q: '可以把两个人的名字写进去吗？', a: '可以。常见做法是主体写吉语，落款处并排写两个名字与日期，兼顾正式与私人感。名字作为主体也可以，但字数一多，画面会变满，需要调整尺寸。' },
    { q: '婚礼现场用，来得及吗？', a: '取决于日子离现在多久。现场用字通常要留出装裱与外框制作时间，建议至少提前三周沟通。请直接告诉我们婚礼日期与现场摆放方式，我们答复能不能做，不做模糊承诺。' },
    { q: '写错字或者不满意怎么办？', a: '动笔前会把题字内容、书体与落款逐字确认，确认后再写。成品仍不满意可以重写——定制品同样适用签收后 7 天无理由。' },
    { q: '选什么颜色？', a: '婚礼场合常用朱砂底配金或墨，喜庆且上镜；新房客厅若偏素雅，可以用素纸配木框，更耐看。把家里的照片发我们，可以一起定。' },
    { q: '新生儿写什么好？', a: '「平安喜乐」「长乐」这类不过度用力的词更耐看，孩子长大也不会觉得尴尬。「前程似锦」更偏仪式感，适合满月与周岁场合。' },
    { q: '可以只买现货吗？', a: '可以。站内已有婚庆方向的现货作品，写好即可发出。现货是固定内容与尺寸，定制则可以改内容、改尺寸、加姓名与日期。' },
  ]}
  siblings={siblings}
/>
