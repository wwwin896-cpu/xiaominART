---
/**
 * 个人定制 · 自用雅趣
 * 素材依据：首页场景卡「墨有呼吸」「案上有山」与 /scenes/ 页已公开的书房、茶室陈设方向。
 */
import CustomDetailPage from '../../../components/CustomDetailPage.astro';

const siblings = [
  { href: '/custom/personal/gifting/', name: '送礼定制', desc: '送老师、送长辈、送领导，不知道写什么我们给方向。' },
  { href: '/custom/personal/wedding/', name: '婚庆纪念', desc: '订婚、结婚、周年与新生儿，把两个人的日子写成字。' },
  { href: '/custom/personal/housewarming/', name: '乔迁新居', desc: '搬进新家，墙上该有一句属于这间屋子的话。' },
  { href: '/custom/personal/festival/', name: '节日定制', desc: '春节、中秋与节庆礼，赶在日子之前写好。' },
];
---

<CustomDetailPage
  name="自用雅趣"
  nameEn="For Yourself"
  tagline="写给自己看的那幅字，不必解释给谁听。"
  seoTitle="书房茶室书法定制｜斋号、个人签名与座右铭题字｜小民艺术"
  seoDescription="自用书法定制：书房与茶室的挂字、个人斋号、姓名题字与座右铭。按空间气质选书体与尺寸，亲笔手写、含装裱，常规 7–14 个工作日发出，签收后 7 天内可提出退换。"
  contextValue="自用雅趣"
  quickFacts={[
    { label: '适合', value: '书房 · 茶室 · 工作室 · 个人斋号与签名' },
    { label: '篇幅', value: '斗方、横幅、竖幅；小空间也可做卡纸摆件' },
    { label: '周期', value: '常规 7–14 个工作日发出' },
    { label: '怎么开始', value: '说清楚挂在哪里、想要什么气息' },
  ]}
  intro={[
    '送人的字要考虑对方怎么看，写给自己的字只需要考虑：你每天愿不愿意看见它。',
    '书房和茶室是最适合挂字的两个空间，因为它们安静，视线停留得久。也正因为停留得久，内容要经得起反复看——一句太满的话，三个月就腻了。',
    '斋号是另一件事。它是你给自己的空间起的名字，可以是一个字、两个字，也可以是别人不知道来历的一句话。写出来挂在门上或书桌后，这个空间就有了归属。',
  ]}
  scenarios={[
    { title: '书房', body: '书桌后方或侧墙。写「宁静致远」这类常见句，也可以写你正在读的那本书里的一句。' },
    { title: '茶室', body: '视线低、距离近，字宜少不宜多。两个字或四个字，配素纸与细框最好看。' },
    { title: '斋号', body: '给自己的空间命名，写成横幅挂在门楣或书桌后，可加小字说明来历。' },
    { title: '个人签名 / 姓名', body: '用于落款、个人品牌或书房标识。可以只写名，也可以写全名加字号。' },
  ]}
  wordings={[
    { scene: '书房常用', words: '宁静致远 · 淡泊明志 · 知行合一 · 半日闲', note: '常见但不俗。想更个人化，换成你真正在意的那句话。' },
    { scene: '茶室常用', words: '禅茶一味 · 清心自在 · 自在随缘 · 一期一会', note: '字少、留白多，配素纸与细木框。' },
    { scene: '斋号', words: '一个字 · 两个字 · 一句话压缩成的名字', note: '例如「半山」「观复」「不系舟」。可以加一行小字写来历。' },
    { scene: '座右铭', words: '自己写的一句 · 书里抄的一句', note: '字数多时建议做成小字长卷或册页，不适合单幅大字。' },
  ]}
  specs={[
    { label: '书体怎么选', value: '楷书端正、行书松弛、隶书古拙、篆书（含甲骨与金文）最有出处感但辨识度低。我们会按内容与空间给建议。' },
    { label: '斋号', value: '可写一个字到四个字，附小字题跋说明来历。若用古文字写法，需要先确认字形出处。' },
    { label: '形式', value: '斗方、横幅、竖幅、卡纸摆件均可。书房建议横幅，茶室建议斗方或小竖幅。' },
    { label: '周期', value: '常规 7–14 个工作日发出。需要考据古文字字形时，会多一轮确认。' },
    { label: '费用', value: '按内容、字数、尺寸与装裱方式计价，方向确认后给报价，报价即最终价。' },
    { label: '售后', value: '签收后 7 天内可提出退换，定制品同样适用。作品不满意可以重写。' },
  ]}
  faqs={[
    { q: '斋号是什么？', a: '旧时读书人给自己的书房起的名字，用来自称，也用来落款。今天可以理解成「给你的空间命名」——一个词、两个字，或者一句只有你知道来历的话。我们会帮你判断它适合写成几个字、用什么书体。' },
    { q: '可以写我自己的名字吗？', a: '可以。单写名、全名、姓名加字号都行。用作落款时通常用小字，用作个人标识时可以做成一幅独立作品。' },
    { q: '古文字好看，但我怕别人不认识。', a: '这是常见顾虑。甲骨文、金文的字形有出处感，但辨识度低。折中做法是主体用古文字，旁边配一行小字释文；或者主体用行楷，落款用古文字。两种我们都做过。' },
    { q: '不知道选什么书体。', a: '把要挂的空间照片和想写的内容发我们，会给两到三个书体方向并说明差别：楷书更端正、行书更松弛、隶书更古拙、篆书更有出处感。选定后再动笔。' },
    { q: '挂字需要打孔吗？', a: '木框与卷轴都可以不打孔安装（无痕钉、挂轨或直接摆放）。租房建议卷轴或卡纸摆件，退租时收起带走。' },
    { q: '可以先看小样吗？', a: '题字内容、书体与尺寸会先确认；作品完成后给你看成品，不满意可以重写。这是定制品也支持 7 天无理由的前提。' },
  ]}
  siblings={siblings}
/>
