---
import Layout from '../../layouts/Layout.astro'; import { blessings } from '../../data/content';
export function getStaticPaths(){ return blessings.map((item)=>({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props;
---
<Layout title={`${item.title}｜${item.pinyin}｜小民艺术`} description={`${item.title}：${item.meaning}`}><section class="container blessing-hero"><span class="eyebrow">Blessing / 祝愿</span><div><span class="glyph serif">{item.title}</span><div><p class="mono">{item.pinyin}</p><p lang="en" class="muted">{item.en}</p></div></div><p class="lede">{item.meaning}</p></section><section class="container facts"><div><span class="eyebrow">Meaning / 直译</span><h2 class="serif">{item.meaning}</h2></div><div><span class="eyebrow">Scene / 适用场景</span><p>{item.scene}</p><span class="eyebrow">English note</span><p lang="en">An English explanation will accompany this blessing as the bilingual edition develops.</p></div></section><section class="container section"><div class="cta-box"><h2 class="serif">把你的心事，交给这一笔。</h2><p>祝愿不是结果保证，而是我们开始认真听你说话的入口。</p><a class="btn btn-primary" href="/custom-commission/">以此为灵感定制 <span>→</span></a></div></section></Layout>
<style>.blessing-hero{padding:96px 0 72px;border-bottom:1px solid var(--border)}.blessing-hero>div{display:flex;align-items:end;gap:28px}.glyph{font-size:clamp(140px,20vw,240px);line-height:1;color:var(--accent)}.blessing-hero .mono{margin-bottom:0}.lede{font:24px/1.6 var(--font-display);max-width:620px}.facts{display:grid;grid-template-columns:1fr 1fr;gap:72px;padding-top:64px}.facts h2{font-size:34px;margin-top:18px}.facts p{color:var(--muted)}.facts .eyebrow~.eyebrow{display:block;margin-top:28px}.cta-box{border-top:2px solid var(--accent);padding-top:20px}.cta-box h2{font-size:40px;margin:18px 0}.cta-box p{color:var(--muted)}@media(max-width:767px){.blessing-hero{padding:56px 0 40px}.blessing-hero>div{gap:14px}.glyph{font-size:140px}.lede{font-size:20px}.facts{grid-template-columns:1fr;gap:28px;padding-top:40px}.cta-box h2{font-size:32px}}
</style>
