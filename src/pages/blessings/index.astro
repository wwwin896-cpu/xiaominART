---
import Layout from '../../layouts/Layout.astro'; import { blessings } from '../../data/content';
---
<Layout title="选择一个祝愿｜小民艺术" description="从福、禄、寿、喜、财五个主题开始，了解字义与适用场景。"><section class="container page-head"><span class="eyebrow">Choose a blessing / 选择一个祝愿</span><h1 class="serif">先看含义，<br/>再决定要不要写。</h1><p>五个常青主题，不是结果保证，而是我们一起开始谈心事的入口。</p></section><section class="container blessing-list">{blessings.map((item, i) => <a class="blessing-row" href={`/blessings/${item.slug}/`}><span class="mono">0{i+1}</span><span class="glyph serif">{item.title}</span><span><b>{item.pinyin}</b><small lang="en">{item.en}</small></span><p>{item.meaning}<br/><em>{item.scene}</em></p><span class="arrow">→</span></a>)}</section></Layout>
<style>.page-head{padding:96px 0 72px}.page-head h1{font-size:clamp(48px,7vw,82px);line-height:1.1;margin:20px 0}.page-head p{color:var(--muted);font-size:17px}.blessing-list{border-top:1px solid var(--border)}.blessing-row{display:grid;grid-template-columns:56px 90px 150px 1fr 40px;align-items:center;gap:18px;border-bottom:1px solid var(--border);padding:22px 0;transition:padding .2s,background .2s}.blessing-row:hover{padding-left:12px;padding-right:12px;background:var(--surface)}.blessing-row .glyph{font-size:58px;color:var(--accent)}.blessing-row small,.blessing-row p em{display:block;color:var(--meta);font-size:12px;font-style:normal}.blessing-row p{color:var(--muted);margin:0}.blessing-row p em{margin-top:4px}.arrow{font-size:24px;color:var(--accent)}@media(max-width:767px){.page-head{padding:56px 0 40px}.page-head h1{font-size:48px}.blessing-row{grid-template-columns:30px 48px 1fr 24px;gap:10px}.blessing-row>p{grid-column:3/-1;font-size:13px}.blessing-row .glyph{font-size:40px}}
</style>
