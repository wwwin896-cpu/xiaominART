---
// ═══════════════════════════════════════════════════════════════
// 作品公开档案页 /verify/{编码}
//
// 这一页是**防伪体系的核心**：
//   仿冒者可以抄走编码，但拿不到「与该编码对应的那幅作品」。
//   只要这一页公开可访问、可被搜索引擎收录，
//   客户买前搜一下编码，就能对照实物验真。
//
// 设计取向（与全站调性一致）：
//   · 静态生成——不依赖后端，边缘即可扛住流量
//   · 一物一页——每幅作品的编码是唯一 URL，天然 SEO 友好
//   · 不做「红色告警」式的验真 UI，用冷静的档案语言
// ═══════════════════════════════════════════════════════════════
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { getArchives } from '../../lib/code-registry';
import { getReadyMadeWorks } from '../../lib/ready-made';
import { qrSvg } from '../../lib/qr';
import { siteContact, hasOfficialAccount } from '../../data/site';

export function getStaticPaths() {
  // 只给「在册且有合法编码」的作品生成档案页；
  // 未登记的编码不会生成页面 → 访问 404 → 本身就是验真关卡
  const soldMap = new Map(getReadyMadeWorks().map((w) => [w.slug, w.sold]));
  return getArchives().map((archive) => ({
    params: { code: archive.parts.raw },
    props: { archive, sold: soldMap.get(archive.work.slug) ?? false },
  }));
}

const { archive, sold } = Astro.props;
const { work, parts } = archive;

const isWall = work.form === '挂墙';
const formText = isWall ? '墙面悬挂' : '案头摆件';
const sizeText = work.size ? `装框后 ${work.size.w} × ${work.size.h} cm` : '以随附作品档案为准';

const pageTitle = `${work.title} · 作品档案 ${work.code}｜小民艺术`;
const pageDesc = `${work.code} 是小民艺术为《${work.title}》签发的作品编码，创作于 ${parts.year} 年。核对此页可确认编码与作品是否一致。`;

// 二维码：指向本页自身的规范地址。
// 静态生成时就把 SVG 直接写进 HTML —— 零运行时开销、零外部请求、不外泄扫码数据。
const canonicalUrl = new URL(`/verify/${work.code}/`, Astro.site ?? 'https://xiaominart.com').href;
const archiveQrSvg = qrSvg(canonicalUrl, 200, 3);

const archiveSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${work.title}｜手写书法小品`,
  sku: work.code,
  description: work.note,
  image: [new URL(work.image, Astro.site ?? 'https://xiaominart.com').href],
  brand: { '@type': 'Brand', name: 'XIAOMINART 小民艺术' },
  material: work.material ?? '手写书法原作 · 榫卯结构实木框',
  ...(work.size
    ? {
        width: { '@type': 'QuantitativeValue', value: work.size.w, unitCode: 'CMT' },
        height: { '@type': 'QuantitativeValue', value: work.size.h, unitCode: 'CMT' },
      }
    : {}),
  offers: {
    '@type': 'Offer',
    price: work.price,
    priceCurrency: 'CNY',
    availability: sold ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    url: new URL(`/verify/${work.code}/`, Astro.site ?? 'https://xiaominart.com').href,
  },
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: '作品档案', href: '/verify/' },
    { name: work.title, href: `/verify/${work.code}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(archiveSchema)} />

  <nav class="container crumb" aria-label="面包屑">
    <a href="/">首页</a><span>/</span><a href="/verify/">作品档案</a><span>/</span><span aria-current="page">{work.code}</span>
  </nav>

  <section class="container archive-head">
    <span class="eyebrow">Work Archive / 作品公开档案</span>
    <h1 class="serif">这一页，为《{work.title}》存证。</h1>
    <p class="lead">
      小民艺术为每一件手写作品签发唯一编码。<strong>编码可被抄写，作品不能。</strong>
      如你手中的作品与此页在编码、图像、年份上一致，即为在册原件。
    </p>
  </section>

  <section class="container archive-body">
    <figure class="archive-figure">
      <Pic src={work.image} alt={work.alt} loading="eager" decoding="async" />
      <figcaption>本编码对应的作品实拍 · 装裱完成</figcaption>
    </figure>

    <div class="archive-copy">
      <div class="status-row">
        <span class="status-dot" data-sold={sold ? 'true' : 'false'} aria-hidden="true"></span>
        <span class="status-text">{sold ? '已售出 · 在册档案保留' : '在售 · 现货唯一一件'}</span>
      </div>

      <h2 class="serif work-title">{work.title}</h2>
      <p class="work-en" lang="en">{work.en}</p>

      <dl class="meta">
        <div class="meta-row">
          <dt>作品编码</dt>
          <dd><code class="code">{work.code}</code></dd>
        </div>
        <div class="meta-row">
          <dt>创作年份</dt>
          <dd><strong>{parts.year} 年</strong><em>创作完成年份，非上架年份</em></dd>
        </div>
        <div class="meta-row">
          <dt>年内序号</dt>
          <dd>{parts.year} 年第 {parts.seq} 号 · {parts.formLabel}</dd>
        </div>
        <div class="meta-row">
          <dt>品类 / 档位</dt>
          <dd>{parts.categoryLabel} · {parts.tierLabel}</dd>
        </div>
        <div class="meta-row">
          <dt>材质与装帧</dt>
          <dd>{work.material ?? '手写书法原作 · 榫卯结构实木框'}</dd>
        </div>
        <div class="meta-row">
          <dt>成品尺寸</dt>
          <dd>{sizeText} · {formText}</dd>
        </div>
        <div class="meta-row">
          <dt>释读</dt>
          <dd class="note-dd">{work.note}</dd>
        </div>
      </dl>

      <a class="btn btn-link" href={`/gifts/ready-made/${work.slug}/`}>
        {sold ? '查看这件作品的详情页 →' : '查看这一幅 · 在售详情 →'}
      </a>
    </div>
  </section>

  <section class="container section qr-section" aria-labelledby="qr-title">
    <div class="qr-panel">
      <div class="qr-figure">
        <div class="qr-box" set:html={archiveQrSvg} />
        <span class="qr-cap mono">{work.code}</span>
      </div>
      <div class="qr-copy">
        <span class="eyebrow">Scan / 扫码验真</span>
        <h2 id="qr-title" class="serif">手机一扫，直达这一页。</h2>
        <p>
          证书上印着这枚二维码。任何人用手机扫一扫，都会打开你现在看到的这一页——
          <strong>编码、年份、作品实拍，一一对照，无需手工输入那串长编码。</strong>
        </p>
        <ul class="qr-points">
          <li><span class="mono">01</span>扫出来的是本站地址 <code>xiaominart.com</code>，不是第三方页面</li>
          <li><span class="mono">02</span>核对实拍笔迹——这一关仿冒者过不去</li>
          <li><span class="mono">03</span>查不到本页，即为存疑，请联系我们核实</li>
        </ul>
        <p class="qr-note">
          二维码本身可以被复制。<strong>真正无法复制的是这一页的作品实拍。</strong>
          如果你手里那件的笔迹与此页不符，编码再对也不算数。
        </p>
      </div>
    </div>
  </section>

  <section class="container section verify-explain" aria-labelledby="explain-title">
    <div class="section-lead">
      <span class="eyebrow">How to Verify / 如何核对</span>
      <h2 id="explain-title" class="serif">三步，确认你手里的是原件。</h2>
    </div>
    <ol class="steps">
      <li class="step">
        <span class="mono">01</span>
        <h3>核对作品图像</h3>
        <p>你手中作品的笔迹、印章与装裱形态，应与上方实拍一致。这是最可靠的一关——<strong>仿冒者能抄到编码，却复制不出同一幅笔迹。</strong></p>
      </li>
      <li class="step">
        <span class="mono">02</span>
        <h3>核对编码与年份</h3>
        <p>作品随附的藏品证书上印有完整编码。证书编码、本页编码、与作品本身，三者应完全一致。编码第 4 段即创作年份。</p>
      </li>
      <li class="step">
        <span class="mono">03</span>
        <h3>有疑问，直接问我们</h3>
        <p>如编码查不到本页、或图像有明显出入，请带实物照片联系我们核实。<strong>我们只认自己签发的编码。</strong></p>
      </li>
    </ol>
  </section>

  <section class="container section code-explain" aria-labelledby="code-title">
    <div class="section-lead">
      <span class="eyebrow">Code Anatomy / 编码怎么读</span>
      <h2 id="code-title" class="serif">一串编码，读得出这些信息。</h2>
    </div>
    <div class="code-anatomy">
      {
        [
          { seg: 'XMA', label: '品牌', value: '小民艺术出品', width: 'brand' },
          { seg: 'CL', label: '品类', value: parts.categoryLabel, width: 'cat' },
          { seg: 'WA', label: '形态', value: parts.formLabel, width: 'form' },
          { seg: '26', label: '年份', value: `${parts.year} 年创作`, width: 'year', hi: true },
          { seg: '0001', label: '序号', value: `年内第 ${parts.seq} 号`, width: 'seq' },
          { seg: 'T2', label: '档位', value: parts.tierLabel, width: 'tier' },
          { seg: String(parts.check), label: '校验', value: '防抄错', width: 'chk' },
        ].map((s) => (
          <div class={`seg ${s.width}`} data-hi={s.hi ? 'true' : 'false'}>
            <code>{s.seg}</code>
            <span class="seg-label">{s.label}</span>
            <span class="seg-value">{s.value}</span>
          </div>
        ))
      }
    </div>
    <p class="code-note">
      编码末位是校验位，用于发现抄写错误；<strong>它只说明编码抄得对不对，不说明作品真伪</strong>。
      真正的验真标准是：<strong>该编码是否在本站档案库中存在</strong>——也就是你现在看到的这一页。
    </p>
  </section>

  <section class="container section archive-cta">
    <div class="cta-panel">
      <div>
        <span class="eyebrow">Query / 查另一件作品</span>
        <h2 class="serif">手里还有别的编码？</h2>
        <p>把编号补进网址即可打开对应档案，例如 <code>/verify/XMA-CL-WA-26-0002-T2-3/</code>。</p>
      </div>
      <a class="btn btn-primary" href="/verify/" data-event="archive_query_click">打开编码查询 →</a>
    </div>
  </section>

  {/* ─────────────────────────────────────────────────────────────
      转化段（扫码后的第 ② ③ 步）

      顺序是刻意的：先给结论建立信任，再要关注，最后才谈定制。
      ① 验真 → 已在页面上方完成（实拍 + 编码 + 年份）
      ② 关注 → 本段。公众号未配置时自动隐藏，降级为个人微信。
      ③ 定制 → 本段。带来源标记，用于衡量扫码带来的咨询量。
     ───────────────────────────────────────────────────────────── */}
  <section class="container section convert" aria-labelledby="convert-title">
    <div class="convert-head">
      <span class="eyebrow">From This Piece / 由这件作品开始</span>
      <h2 id="convert-title" class="serif">验过了，接下来想做点什么？</h2>
      <p class="convert-lead">
        你刚确认了一件在册原件。如果这份笔墨让你多看了一眼，这里有两件事可以继续。
      </p>
    </div>

    <div class="convert-grid">
      {/* ② 关注段 */}
      {hasOfficialAccount && (
        <article class="convert-card follow">
          <span class="mono card-step">02</span>
          <h3 class="serif">看看它是怎么写出来的</h3>
          <p>
            每一幅字背后都有一段过程——落笔前的斟酌、钤印时的取舍。
            关注「{siteContact.mpName || '小民艺术'}」，新作与创作过程先发在这里。
          </p>
          <div class="follow-body">
            {siteContact.mpQr ? (
              <img class="follow-qr" src={siteContact.mpQr} alt={`${siteContact.mpName || '小民艺术'}公众号二维码`} width="132" height="132" loading="lazy" decoding="async" />
            ) : null}
            <div class="follow-text">
              <p class="follow-hint">长按识别二维码，或在微信搜索关注。</p>
              <p class="follow-warn">
                <strong>注意：</strong>微信内的网页无法一键跳转关注，需长按上面的二维码识别。
              </p>
            </div>
          </div>
          <a class="btn btn-link" href="/verify/" data-event="archive_follow_click">先看看其他作品 →</a>
        </article>
      )}

      {/* ③ 定制段 */}
      <article class="convert-card custom">
        <span class="mono card-step">{hasOfficialAccount ? '03' : '02'}</span>
        <h3 class="serif">也想有一件属于你的？</h3>
        <p>
          现成的是「这一幅」，定制的才是「你的那一幅」。
          说清要写给谁、挂在哪儿、何时要用，我们会给出尺寸与方案建议。
        </p>
        <div class="custom-actions">
          <a
            class="btn btn-primary"
            href={`/contact/?from=archive&code=${encodeURIComponent(work.code)}`}
            data-event="archive_custom_click"
            data-code={work.code}
          >发起定制咨询 →</a>
          {siteContact.wechatId && (
            <a
              class="btn btn-link"
              href="/contact/"
              data-event="archive_follow_click"
              data-code={work.code}
            >或先加微信聊聊 · {siteContact.wechatId}</a>
          )}
        </div>
        <p class="custom-meta">
          咨询时提到编码 <code>{work.code}</code>，我们能直接对应到这件作品，省去反复描述。
        </p>
      </article>
    </div>
  </section>
</Layout>

<script>
  // 档案页浏览埋点：扫码进来的每一跳都记一次，用于统计「扫码验真」的实际发生量。
  // 走与全站一致的 /api/event，事件名已在三处同登记白名单。
  const code = document.querySelector('.qr-cap')?.textContent?.trim() ?? '';
  const fire = (name: string, data: Record<string, unknown> = {}) => {
    try {
      void fetch('/api/event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, data: { code, page: 'verify', ...data } }),
        keepalive: true,
      }).catch(() => {});
    } catch {
      /* 埋点失败绝不影响页面功能 */
    }
  };

  fire('archive_view');

  // 带 data-event 的转化入口，统一由这里转发；
  // 若全站已有委托监听，这里只补 data-code，避免重复上报。
  document.querySelectorAll<HTMLElement>('[data-event]').forEach((el) => {
    if (!el.dataset.code && code) el.dataset.code = code;
  });
</script>

<style>
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; padding: 28px 0 0; color: var(--muted); font-size: 13px; }
  .crumb a { color: var(--ink-soft); }
  .crumb a:hover { color: var(--cinnabar); }

  .archive-head { padding: 26px 0 8px; text-align: center; }
  .archive-head h1 { font-size: clamp(30px, 4vw, 46px); font-weight: 500; line-height: 1.35; margin: 14px 0 18px; }
  .archive-head .lead { max-width: 640px; margin: 0 auto; color: var(--ink-soft); font-size: 16px; line-height: 2; }
  .archive-head .lead strong { color: var(--ink); font-weight: 500; }

  .archive-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; padding: 44px 0 10px; align-items: start; }
  .archive-figure { margin: 0; border: 1px solid var(--line); background: var(--paper-deep); }
  .archive-figure :global(img) { width: 100%; display: block; }
  .archive-figure figcaption { padding: 10px 14px; border-top: 1px solid var(--line); background: var(--paper-light); color: var(--muted); font-size: 12px; letter-spacing: .08em; }

  .status-row { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--cinnabar); flex: none; }
  .status-dot[data-sold='true'] { background: var(--muted); }
  .status-text { color: var(--ink-soft); font-size: 13px; letter-spacing: .06em; }

  .work-title { font-size: clamp(30px, 3.6vw, 44px); font-weight: 500; margin: 0 0 4px; }
  .work-en { font: 19px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); margin: 0 0 22px; }

  .meta { margin: 0; border-top: 1px solid var(--line); }
  .meta-row { display: grid; grid-template-columns: 108px 1fr; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .meta-row dt { color: var(--muted); font-size: 13px; padding-top: 2px; }
  .meta-row dd { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.85; }
  .meta-row dd strong { color: var(--ink); font-weight: 500; }
  .meta-row dd em { display: block; font-style: normal; color: var(--muted); font-size: 12px; margin-top: 3px; }
  .meta-row .note-dd { color: var(--ink-soft); }
  code.code { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 14px; font-weight: 600; color: var(--cinnabar); letter-spacing: .04em; }
  .archive-copy .btn-link { margin-top: 22px; }

  .verify-explain { border-top: 1px solid var(--line); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .step { padding: 24px 24px 28px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .step .mono { display: block; color: var(--cinnabar); font-size: 12px; letter-spacing: .14em; margin-bottom: 10px; }
  .step h3 { font-size: 17px; font-weight: 500; margin: 0 0 10px; }
  .step p { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.9; }
  .step p strong { color: var(--ink); font-weight: 500; }

  .code-explain { border-top: 1px solid var(--line); }
  .code-anatomy { display: flex; flex-wrap: wrap; gap: 10px; align-items: stretch; }
  .seg { flex: 1 1 88px; min-width: 82px; padding: 14px 12px; border: 1px solid var(--line); background: var(--paper-light); text-align: center; }
  .seg[data-hi='true'] { border-color: var(--cinnabar); background: var(--paper-deep); }
  .seg code { display: block; font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 17px; font-weight: 600; color: var(--ink); letter-spacing: .06em; margin-bottom: 7px; }
  .seg[data-hi='true'] code { color: var(--cinnabar); }
  .seg-label { display: block; font-size: 11px; color: var(--muted); letter-spacing: .12em; margin-bottom: 3px; }
  .seg-value { display: block; font-size: 12px; color: var(--ink-soft); }
  .code-note { max-width: 720px; margin: 22px 0 0; color: var(--ink-soft); font-size: 14px; line-height: 2; }
  .code-note strong { color: var(--ink); font-weight: 500; }

  .archive-cta { border-top: 1px solid var(--line); }
  .cta-panel { display: flex; flex-wrap: wrap; gap: 26px; align-items: center; justify-content: space-between; padding: 30px 32px; border: 1px solid var(--line); background: var(--paper-deep); }
  .cta-panel h2 { font-size: 24px; font-weight: 500; margin: 8px 0 8px; }
  .cta-panel p { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.9; }
  .cta-panel code { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); color: var(--cinnabar); font-size: 13px; }

  /* ── 二维码区 ── */
  .qr-section { border-top: 1px solid var(--line); }
  .qr-panel { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 44px; align-items: center; padding: 34px 32px; border: 1px solid var(--line); background: var(--paper-deep); }
  .qr-figure { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .qr-box { width: 200px; height: 200px; padding: 10px; background: #fff; border: 1px solid var(--line); line-height: 0; }
  /* set:html 注入的 SVG 不带作用域属性，必须用 :global */
  .qr-box :global(svg) { display: block; width: 100%; height: auto; }
  .qr-cap { color: var(--muted); font-size: 11px; letter-spacing: .1em; word-break: break-all; text-align: center; max-width: 220px; }
  .qr-copy h2 { font-size: clamp(23px, 2.8vw, 32px); font-weight: 500; margin: 10px 0 14px; }
