---
// ═══════════════════════════════════════════════════════════════
// 作品公开档案页 /verify/{编码}
//
// 这一页是**防伪体系的核心**：
//   仿冒者可以抄走编码，但拿不到「与该编码对应的那幅作品」。
//   只要这一页公开可访问、可被搜索引擎收录，
//   客户买前搜一下编码，就能对照实物验真。
//
// 设计取向（与全站调性一致）：
//   · 静态生成——不依赖后端，边缘即可扛住流量
//   · 一物一页——每幅作品的编码是唯一 URL，天然 SEO 友好
//   · 不做「红色告警」式的验真 UI，用冷静的档案语言
// ═══════════════════════════════════════════════════════════════
import Layout from '../../layouts/Layout.astro';
import Pic from '../../components/Pic.astro';
import { getArchives } from '../../lib/code-registry';
import { getReadyMadeWorks } from '../../lib/ready-made';
import { qrSvg } from '../../lib/qr';
import { siteContact, hasOfficialAccount, shareEnabled } from '../../data/site';

export function getStaticPaths() {
  // 只给「在册且有合法编码」的作品生成档案页；
  // 未登记的编码不会生成页面 → 访问 404 → 本身就是验真关卡
  const soldMap = new Map(getReadyMadeWorks().map((w) => [w.slug, w.sold]));
  return getArchives().map((archive) => ({
    params: { code: archive.parts.raw },
    props: { archive, sold: soldMap.get(archive.work.slug) ?? false },
  }));
}

const { archive, sold } = Astro.props;
const { work, parts } = archive;

const isWall = work.form === '挂墙';
const formText = isWall ? '墙面悬挂' : '案头摆件';
const sizeText = work.size ? `装框后 ${work.size.w} × ${work.size.h} cm` : '以随附作品档案为准';

// ── 结论优先（2026-10-14 业主反馈后重做）──
// 业主原话：「用户停留时间不会很长，他只关心是不是正品。你只要告诉他一个结果。」
// 所以这一页的信息层级被压成三层：结论 → 证据 → 下一步。
// 解释性的内容（编码怎么读、如何核对三步）已移除，改为浓缩进说明文字。
const verdict = sold ? '原件已认领' : '在册原件';
const verdictSub = sold
  ? `这件作品已于 ${parts.year} 年被一位藏家收藏，档案永久保留。`
  : '这件作品现在在售，全世界只此一件。';

const pageTitle = `${work.title} · 作品档案 ${work.code}｜小民艺术`;
const pageDesc = `${work.code} 是小民艺术为《${work.title}》签发的作品编码，创作于 ${parts.year} 年。核对此页可确认编码与作品是否一致。`;

// 二维码：指向本页自身的规范地址。
// 静态生成时就把 SVG 直接写进 HTML —— 零运行时开销、零外部请求、不外泄扫码数据。
const canonicalUrl = new URL(`/verify/${work.code}/`, Astro.site ?? 'https://xiaominart.com').href;
const archiveQrSvg = qrSvg(canonicalUrl, 200, 3);

const archiveSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${work.title}｜手写书法小品`,
  sku: work.code,
  description: work.note,
  image: [new URL(work.image, Astro.site ?? 'https://xiaominart.com').href],
  brand: { '@type': 'Brand', name: 'XIAOMINART 小民艺术' },
  material: work.material ?? '手写书法原作 · 榫卯结构实木框',
  ...(work.size
    ? {
        width: { '@type': 'QuantitativeValue', value: work.size.w, unitCode: 'CMT' },
        height: { '@type': 'QuantitativeValue', value: work.size.h, unitCode: 'CMT' },
      }
    : {}),
  offers: {
    '@type': 'Offer',
    price: work.price,
    priceCurrency: 'CNY',
    availability: sold ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    url: new URL(`/verify/${work.code}/`, Astro.site ?? 'https://xiaominart.com').href,
  },
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  bodyData={{ 'archive-code': work.code }}
  breadcrumbs={[
    { name: '首页', href: '/' },
    { name: '作品档案', href: '/verify/' },
    { name: work.title, href: `/verify/${work.code}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(archiveSchema)} />

  <nav class="container crumb" aria-label="面包屑">
    <a href="/">首页</a><span>/</span><a href="/verify/">作品档案</a><span>/</span><span aria-current="page">{work.code}</span>
  </nav>

  <section class="container archive-head">
    <span class="eyebrow">Work Archive / 作品公开档案</span>
    <h1 class="serif">这一页，为《{work.title}》存证。</h1>
  </section>

  {/* ─────────────────────────────────────────────────────────────
      结论 + 实拍（并排，一屏内看完）

      2026-10-14 业主反馈后重做：客户只想知道「是不是正品」，停留时间很短。
      因此把「结论」提到最显眼处，实拍紧邻结论作为唯一需要的证据。
      原先的「如何核对三步」「编码怎么读」两段已移除 —— 解释成本太高，
      收益为零，反而稀释了结论。解释浓缩为结论下方一行小字。
     ───────────────────────────────────────────────────────────── */}
  <section class="container archive-body">
    <figure class="archive-figure">
      <Pic src={work.image} alt={work.alt} loading="eager" decoding="async" />
      <figcaption>与编码 {work.code} 对应的作品实拍 · 请与手中实物核对笔迹</figcaption>
    </figure>

    <div class="archive-copy">
      <div class="verdict" data-sold={sold ? 'true' : 'false'} role="status">
        <span class="verdict-badge">
          <span class="verdict-dot" aria-hidden="true"></span>
          正品
        </span>
        <h2 class="verdict-title serif">{verdict}</h2>
        <p class="verdict-sub">{verdictSub}</p>
      </div>

      <dl class="meta">
        <div class="meta-row">
          <dt>作品</dt>
          <dd><strong>{work.title}</strong><em>{work.en}</em></dd>
        </div>
        <div class="meta-row">
          <dt>编码</dt>
          <dd><code class="code">{work.code}</code></dd>
        </div>
        <div class="meta-row">
          <dt>创作年份</dt>
          <dd><strong>{parts.year} 年</strong></dd>
        </div>
        <div class="meta-row">
          <dt>规格</dt>
          <dd>{sizeText} · {formText} · {parts.categoryLabel}</dd>
        </div>
      </dl>

      <p class="verdict-note">
        编码已在本站档案库中登记，即为原件。<strong>最可靠的一关是笔迹</strong>——
        仿冒者能抄走编码，抄不走这一幅。
      </p>

      <div class="archive-actions">
        {!sold && (
          <a class="btn btn-primary" href={`/gifts/ready-made/${work.slug}/`} data-event="ready_work_click" data-code={work.code}>
            这件还在 · 看看详情 →
          </a>
        )}
        <a class="btn btn-link" href="/gifts/ready-made/" data-event="archive_browse_click" data-code={work.code}>
          看看其他作品 →
        </a>
      </div>

      <details class="qr-mini">
        <summary>证书二维码</summary>
        <div class="qr-mini-body">
          <div class="qr-box" set:html={archiveQrSvg} />
          <p>
            藏品证书上印有此码。用手机相机或微信扫一扫，直达本页，省去手工输入编码。
            <span class="qr-mini-warn">
              本页的码是给证书排版用的，长按它无法识别——网页里的图片不具备「扫一扫」能力，
              请对准纸质证书上的那枚，或用手机相机的取景框扫。
            </span>
          </p>
        </div>
      </details>
    </div>
  </section>

  {/* ─────────────────────────────────────────────────────────────
      下一步：引导看更多作品 / 分享自己的作品

      2026-10-14 业主反馈：原先的「查另一件作品」没有意义（客户只有一件），
      「关注公众号」在公众号就绪前也落不了地。改为引导看更多作品，
      并为「分享自己的作品得积分」埋好入口。

      积分未启用（无后端配置）时，分享卡片降级为「联系我们」，不留死链。
     ───────────────────────────────────────────────────────────── */}
  <section class="container section next-step" aria-labelledby="next-title">
    <div class="section-lead">
      <span class="eyebrow">Next / 接下来</span>
      <h2 id="next-title" class="serif">这一件，只是开始。</h2>
    </div>

    <div class="next-grid">
      <a class="next-card" href="/gifts/ready-made/" data-event="archive_browse_click" data-code={work.code}>
        <span class="next-kicker">看作品</span>
        <h3 class="serif">还有这些，正在等一个人</h3>
        <p>每一件都只有一个。看看有没有哪一幅，正好说出你想说的话。</p>
        <span class="next-go">浏览在售作品 →</span>
      </a>

      <a class="next-card" href="/stories/" data-event="archive_stories_click" data-code={work.code}>
        <span class="next-kicker">看故事</span>
        <h3 class="serif">别人把它送给了谁</h3>
        <p>送出时的场景、收到时的反应。真实的人，真实的心意。</p>
        <span class="next-go">读客户故事 →</span>
      </a>

      {shareEnabled ? (
        <a class="next-card is-highlight" href="/share/" data-event="archive_share_click" data-code={work.code}>
          <span class="next-kicker">分享有礼</span>
          <h3 class="serif">晒出你的那一件</h3>
          <p>晒作品、聊感受，即可获得积分。积分可以兑换我们的其他作品。</p>
          <span class="next-go">了解怎么参与 →</span>
        </a>
      ) : (
        <a class="next-card" href="/contact/?from=archive" data-event="archive_custom_click" data-code={work.code}>
          <span class="next-kicker">定制</span>
          <h3 class="serif">也想有一件属于你的</h3>
          <p>说清写给谁、挂在哪里，我们给出尺寸与内容建议。</p>
          <span class="next-go">聊聊定制 →</span>
        </a>
      )}
    </div>
  </section>
</Layout>

<script>
  // 档案页浏览埋点：扫码进来的每一跳都记一次，用于统计「扫码验真」的实际发生量。
  // 走与全站一致的 /api/event，事件名已在三处同登记白名单。
  //
  // 2026-10-14：编码来源由 `.qr-cap` 改为 body 上的 data 属性 ——
  // 二维码已收进折叠区，`.qr-cap` 元素不复存在，原选择器会静默取到空串，
  // 导致所有埋点丢失 code 归属（这类「埋点全空且无报错」的坑本仓库已踩过多次）。
  const code = document.body.dataset.archiveCode ?? '';
  const fire = (name: string, data: Record<string, unknown> = {}) => {
    try {
      void fetch('/api/event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, data: { code, page: 'verify', ...data } }),
        keepalive: true,
      }).catch(() => {});
    } catch {
      /* 埋点失败绝不影响页面功能 */
    }
  };

  fire('archive_view');
</script>

<style>
  .crumb { display: flex; flex-wrap: wrap; gap: 8px; padding: 28px 0 0; color: var(--muted); font-size: 13px; }
  .crumb a { color: var(--ink-soft); }
  .crumb a:hover { color: var(--cinnabar); }

  .archive-head { padding: 22px 0 4px; text-align: center; }
  .archive-head h1 { font-size: clamp(26px, 3.4vw, 38px); font-weight: 500; line-height: 1.35; margin: 12px 0 0; }

  .archive-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; padding: 34px 0 10px; align-items: start; }
  .archive-figure { margin: 0; border: 1px solid var(--line); background: var(--paper-deep); }
  .archive-figure :global(img) { width: 100%; display: block; }
  .archive-figure figcaption { padding: 10px 14px; border-top: 1px solid var(--line); background: var(--paper-light); color: var(--muted); font-size: 12px; letter-spacing: .04em; }

  /* 结论块 —— 全页视觉重心，客户一屏内看到「是不是正品」 */
  .verdict { padding: 22px 24px 20px; border: 1px solid var(--line); background: var(--paper-deep); margin-bottom: 24px; }
  .verdict-badge { display: inline-flex; align-items: center; gap: 7px; padding: 4px 11px 4px 9px; border: 1px solid var(--cinnabar); color: var(--cinnabar); font-size: 12px; letter-spacing: .12em; }
  .verdict-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cinnabar); flex: none; }
  .verdict[data-sold='true'] .verdict-badge { border-color: var(--muted); color: var(--muted); }
  .verdict[data-sold='true'] .verdict-dot { background: var(--muted); }
  .verdict-title { font-size: clamp(26px, 3.2vw, 36px); font-weight: 500; margin: 14px 0 8px; }
  .verdict-sub { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.9; }

  .meta { margin: 0; border-top: 1px solid var(--line); }
  .meta-row { display: grid; grid-template-columns: 92px 1fr; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .meta-row dt { color: var(--muted); font-size: 13px; padding-top: 2px; }
  .meta-row dd { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.8; }
  .meta-row dd strong { color: var(--ink); font-weight: 500; }
  .meta-row dd em { display: block; font-style: normal; color: var(--muted); font-size: 12px; margin-top: 2px; }
  code.code { font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: 13.5px; font-weight: 600; color: var(--cinnabar); letter-spacing: .03em; word-break: break-all; }

  .verdict-note { margin: 18px 0 0; padding-top: 15px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; line-height: 1.9; }
  .verdict-note strong { color: var(--ink-soft); font-weight: 500; }

  .archive-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 20px; }

  /* 二维码收进折叠区 —— 证书上已有码，网页上不必占主视觉 */
  .qr-mini { margin-top: 22px; border-top: 1px solid var(--line); padding-top: 14px; }
  .qr-mini summary { color: var(--muted); font-size: 13px; letter-spacing: .06em; cursor: pointer; list-style: none; }
  .qr-mini summary::-webkit-details-marker { display: none; }
  .qr-mini summary::before { content: '＋ '; color: var(--cinnabar); }
  .qr-mini[open] summary::before { content: '− '; }
  .qr-mini summary:hover { color: var(--cinnabar); }
  .qr-mini-body { display: flex; gap: 18px; align-items: flex-start; margin-top: 14px; }
  .qr-box { width: 148px; height: 148px; padding: 8px; background: #fff; border: 1px solid var(--line); line-height: 0; flex: none; }
  /* set:html 注入的 SVG 不带作用域属性，必须用 :global */
  .qr-box :global(svg) { display: block; width: 100%; height: auto; }
  .qr-mini-body p { margin: 0; color: var(--muted); font-size: 12.5px; line-height: 1.85; }
  .qr-mini-warn { display: block; margin-top: 7px; color: var(--ink-soft); }

  /* ── 下一步（看作品 / 看故事 / 分享）── */
  .next-step { border-top: 1px solid var(--line); }
  .next-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(268px, 1fr)); gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .next-card { display: flex; flex-direction: column; padding: 26px 24px 28px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background .2s; }
  .next-card:hover { background: var(--paper-light); }
  .next-card.is-highlight { background: var(--paper-deep); }
  .next-card.is-highlight:hover { background: var(--paper-light); }
  .next-kicker { display: block; color: var(--cinnabar); font-size: 12px; letter-spacing: .14em; margin-bottom: 11px; }
  .next-card h3 { font-size: 20px; font-weight: 500; margin: 0 0 11px; }
  .next-card p { margin: 0 0 18px; color: var(--ink-soft); font-size: 14px; line-height: 1.9; }
  .next-go { margin-top: auto; color: var(--cinnabar); font-size: 13.5px; letter-spacing: .04em; }

  @media (max-width: 1023px) {
    .archive-body { grid-template-columns: 1fr; gap: 30px; }
  }
  @media (max-width: 767px) {
    .crumb { padding-top: 20px; }
    .archive-body { padding-top: 24px; }
    .verdict { padding: 18px 18px 16px; }
    .meta-row { grid-template-columns: 1fr; gap: 4px; }
    .qr-mini-body { flex-direction: column; }
    .next-card { padding: 22px 18px 24px; }
  }
</style>
