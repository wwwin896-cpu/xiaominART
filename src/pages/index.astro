---
import Layout from '../layouts/Layout.astro';
import VideoShot from '../components/VideoShot.astro';
import ImageStrip from '../components/ImageStrip.astro';
import ServiceMatrix from '../components/ServiceMatrix.astro';
import CraftEvidence from '../components/CraftEvidence.astro';
import ThemeGrid from '../components/ThemeGrid.astro';
import WishCard from '../components/WishCard.astro';
import BranchExit from '../components/BranchExit.astro';

// ── 01 序 · 品牌第一眼（保留原有三屏文案，改为滚动驱动、不再自动轮播）──
const heroSlides = [
  {
    image: '/assets/scenes/tea-gold-calligraphy.jpg',
    eyebrow: 'XIAOMINART / 书画礼品定制',
    title: '方寸之境，<br />也藏山河。',
    sub: '在喧嚣之外，寻一处安放身心的角落。<br />这里的每一笔墨痕，都是对生活的另一种回答。',
  },
  {
    image: '/assets/scenes/imperfect-real.jpg',
    eyebrow: 'XIAOMINART / 书画礼品定制',
    title: '它不完美，<br />却很真实。',
    sub: '手写的墨痕、粗陶的窑变与麻纸的毛边，<br />都是生活本来的样子。',
  },
  {
    image: '/assets/scenes/bird-seal-tearoom.jpg',
    eyebrow: 'XIAOMINART / 书画礼品定制',
    title: '看似条条框框，<br />实则分寸有序。',
    sub: '融古老鸟虫篆意趣，字如游鱼，昂首摆尾，穿梭自如。<br />在生活的洪流里，愿你也能找到自己的节奏，游刃有余。',
  },
];

// 首屏下方身份分流：让用户不必等看完两个 5 秒镜头，就能先认领自己属于哪一类
const audienceRoutes = [
  { label: '送给自己', desc: '一张小笺，安放自己的情绪', href: '/gifts/', event: 'route_self_click' },
  { label: '送给重要的人', desc: '按对象与场合挑一份心意', href: '/gift-guide/', event: 'route_others_click' },
  { label: '企业与机构', desc: '礼赠、空间与非遗体验活动', href: '/partners/', event: 'route_business_click' },
];

// ── 03 章一 · 书法细节三图：一屏只看三张，各回答一个「凭什么好」──
const inkDetails = [
  {
    image: '/assets/scenes/study-desk-scroll.jpg',
    tag: '纸',
    title: '纸纹与吃墨',
    caption: '每一张纸吃墨的方式都不同，落笔之前先看纸。',
  },
  {
    image: '/assets/scenes/bird-seal-tearoom.jpg',
    tag: '墨',
    title: '墨色的浓淡与停顿',
    caption: '一笔里有速度，也有呼吸——这是印刷品没有的东西。',
  },
  {
    image: '/assets/scenes/sideboard-fan-calligraphy.jpg',
    tag: '裱',
    title: '装裱的边角',
    caption: '作品怎么进入一个家，从这一圈边开始。',
  },
];

// ── 05 章二 · 面塑细节三图：素材尚未到位，先占住版面，拿到实拍后替换 ──
const clayDetails = [
  { slot: '面塑成品图', tag: '作品', title: '它最终长成什么样', caption: '单个成品的正面平视，素背景，让手艺自己说话。' },
  { slot: '手作痕迹图', tag: '手迹', title: '手上的痕迹', caption: '工具、半成品与过渡状态，让「手工」不只是个形容词。' },
  { slot: '活动现场图', tag: '在场', title: '有人拿着的作品', caption: '面塑体验活动的现场记录，作品在手里才有温度。' },
];
---
<Layout
  title="小民艺术 XIAOMINART｜方寸之境，也藏山河"
  description="小民艺术：升斗小民的书法作品与非遗小宁的面塑手作。手写作品可直接选购，也可以从一个人、一处空间、一句话开始定制一件只属于你的作品。"
>
  <!-- ══ 01 序 ══ -->
  <section class="hero" aria-label="品牌横幅">
    <div class="hero-track" data-hero-track>
      {heroSlides.map((slide, i) => (
        <article class="hero-slide" data-hero-slide>
          <div class="hero-media" aria-hidden="true">
            <img src={slide.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
          </div>
          <div class="hero-inner">
            <span class="eyebrow">{slide.eyebrow}</span>
            {i === 0
              ? <h1 class="hero-title serif" set:html={slide.title} />
              : <p class="hero-title serif" role="heading" aria-level="2" set:html={slide.title} />}
            <p class="hero-sub" set:html={slide.sub} />
          </div>
        </article>
      ))}
    </div>
    <div class="hero-dots" aria-label="横幅切换">
      {heroSlides.map((slide, i) => (
        <button class={`hero-dot${i === 0 ? ' is-active' : ''}`} type="button" data-hero-dot aria-label={`第 ${i + 1} 屏：${slide.title.replace(/<br \/>/g, '')}`}></button>
      ))}
    </div>
  </section>
  <script>
    const track = document.querySelector('[data-hero-track]');
    const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
    if (track instanceof HTMLElement && dots.length) {
      const slides = Array.from(track.children);
      const sync = () => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        slides.forEach((slide, i) => slide.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
      };
      dots.forEach((dot, i) => dot.addEventListener('click', () => track.scrollTo({ left: track.clientWidth * i, behavior: 'smooth' })));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
  </script>

  <nav class="audience" aria-label="按人群快速进入">
    <div class="container audience-inner" data-reveal>
      <span class="audience-lead">你可以从这里开始</span>
      {audienceRoutes.map((route) => (
        <a class="audience-item" href={route.href} data-event={route.event}>
          <strong class="serif">{route.label}</strong>
          <span>{route.desc}</span>
        </a>
      ))}
    </div>
  </nav>

  <!-- ══ 02 / 03 章一 · 纸上 ══ -->
  <section class="chapter" aria-labelledby="ink-title">
    <div class="container">
      <header class="chapter-head" data-reveal>
        <span class="eyebrow">02 / 章一 · 纸上 ｜ 5 秒书写镜头</span>
        <h2 id="ink-title" class="serif">一支笔落下，<br />一句话就有了重量。</h2>
        <p>小民艺术有书法作品——由升斗小民手写，一笔一笔落成纸本。不是印刷，也不是在输入法里挑一个好看的字。</p>
      </header>
      <VideoShot
        src="/assets/video/ink-writing.mp4"
        label="书法书写镜头"
        meta="5 秒 · 书写镜头 · 无声循环 ｜ 滚动到此处自动播放，划走即暂停"
      />

      <div class="chapter-sub" data-reveal>
        <span class="eyebrow">03 / 章一 · 从历史走进日常 ｜ 三张细节</span>
        <h3 class="serif">它从来不在博物馆里，等着被参观。</h3>
        <p>门楣上的一个福字，书桌上的一张小笺，送给人的一句话——书法一直是中国人过日子的方式。下面三张，只看细节。</p>
      </div>
      <ImageStrip items={inkDetails} label="书法细节三图" />
    </div>
  </section>

  <!-- ══ 04 / 05 章二 · 手上 ══ -->
  <section class="chapter chapter-clay" aria-labelledby="clay-title">
    <div class="container">
      <header class="chapter-head" data-reveal>
        <span class="eyebrow">04 / 章二 · 手上 ｜ 5 秒手作镜头</span>
        <h2 id="clay-title" class="serif">一团面，<br />在手里慢慢有了表情。</h2>
        <p>非遗小宁做面塑。揉、搓、捏、压，几分钟里，手把一段记忆变成可以拿在手上的东西。</p>
      </header>
      <VideoShot label="面塑创作镜头（影像整理中）" meta="5 秒 · 手作镜头 ｜ 素材到位后直接替换，页面结构不变" />

      <div class="chapter-sub" data-reveal>
        <span class="eyebrow">05 / 章二 · 面塑作品 ｜ 三张细节</span>
        <h3 class="serif">捏出来的那一刻，你会想起某个人。</h3>
        <p>面塑的情绪价值不在于手艺多难，而在于它把一段时间捏成了一个具体的东西。</p>
      </div>
      <ImageStrip items={clayDetails} label="面塑细节三图" />
    </div>
  </section>

  <!-- ══ 06 ══ -->
  <section class="container section" aria-labelledby="services-title">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">06 / 我们能为你做什么</span>
        <h2 id="services-title" class="serif">看完手艺，说回你的事。</h2>
      </div>
      <p>四件具体的事，每一件都带参考价与落地页面。</p>
    </div>
    <ServiceMatrix />
  </section>

  <!-- ══ 07 ══ -->
  <section class="container section" aria-labelledby="process-title">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">07 / 创作过程与品质证据</span>
        <h2 id="process-title" class="serif">你知道它是怎么做出来的，<br />才敢把它送人。</h2>
      </div>
      <p>把心事交给我们，剩下的慢慢来。</p>
    </div>
    <CraftEvidence />
  </section>

  <!-- ══ 08 ══ -->
  <section class="container section" aria-labelledby="themes-title">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">08 / 作品精选 · 手写现货四主题</span>
        <h2 id="themes-title" class="serif">四个主题，<br />四种说不出口的心事。</h2>
      </div>
      <p>每一栏对应一件具体的作品，点开可以看到适合对象、寓意与交付参考。</p>
    </div>
    <ThemeGrid />
  </section>

  <!-- ══ 09 ══ -->
  <section class="container section" aria-labelledby="wish-title">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">09 / 给这份心意一句话</span>
        <h2 id="wish-title" class="serif">先别急着挑，<br />先把那句话写下来。</h2>
      </div>
      <p>不用登录、不留手机号。写下你想对谁说什么，右边会立刻长成一张纸。</p>
    </div>
    <WishCard />
  </section>

  <!-- ══ 10 ══ -->
  <section class="container section" aria-labelledby="branch-title">
    <div class="section-head" data-reveal>
      <div>
        <span class="eyebrow">10 / 下一步</span>
        <h2 id="branch-title" class="serif">你是哪一类，<br />就走哪一条路。</h2>
      </div>
      <p>三条路各自清楚：送礼、定制、机构合作。</p>
    </div>
    <BranchExit />
  </section>
</Layout>

<style>
  /* ── 01 序 ── */
  .hero { position: relative; }
  .hero-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .hero-track::-webkit-scrollbar { display: none; }
  .hero-slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; display: flex; align-items: center; min-height: min(86vh, 780px); }
  .hero-media { position: absolute; inset: 0; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(244, 239, 229, .96) 0%, rgba(244, 239, 229, .84) 42%, rgba(244, 239, 229, .38) 100%); }
  .hero-inner { position: relative; z-index: 1; width: min(var(--container), calc(100% - 48px)); margin: 0 auto; padding: 96px 0; }
  .hero-title { font-size: clamp(38px, 5.6vw, 72px); line-height: 1.25; font-weight: 500; letter-spacing: .04em; margin: 22px 0 26px; }
  .hero-sub { max-width: 560px; color: var(--ink-soft); font-size: 17px; line-height: 2; margin: 0; }
  .hero-dots { position: absolute; right: 30px; bottom: 28px; z-index: 2; display: flex; gap: 10px; }
  .hero-dot { width: 30px; height: 3px; padding: 0; border: 0; background: rgba(43, 41, 36, .28); cursor: pointer; transition: background .3s ease; }
  .hero-dot.is-active { background: var(--cinnabar); }

  /* 首屏下方身份分流 */
  .audience { border-top: 1px solid var(--line-soft); border-bottom: 1px solid var(--line-soft); background: var(--paper-light); }
  .audience-inner { display: grid; grid-template-columns: auto repeat(3, 1fr); align-items: center; gap: 28px; padding: 22px 0; }
  .audience-lead { color: var(--meta); font-size: 12px; letter-spacing: .16em; white-space: nowrap; }
  .audience-item { display: flex; flex-direction: column; gap: 3px; padding-left: 18px; border-left: 1px solid var(--line); }
  .audience-item strong { font-size: 16px; font-weight: 500; transition: color .25s ease; }
  .audience-item span { color: var(--ink-soft); font-size: 12.5px; }
  .audience-item:hover strong { color: var(--cinnabar); }

  /* ── 章节 ── */
  .chapter { padding: var(--space-24) 0; border-top: 1px solid var(--line-soft); }
  .chapter-clay { background: var(--paper-light); }
  .chapter-head { max-width: 620px; margin-bottom: 40px; }
  .chapter-head h2 { font-size: clamp(26px, 3.4vw, 42px); font-weight: 500; letter-spacing: .02em; line-height: 1.32; margin: 16px 0 16px; }
  .chapter-head p { margin: 0; color: var(--ink-soft); line-height: 1.95; }
  .chapter-sub { max-width: 620px; margin: 72px 0 34px; }
  .chapter-sub h3 { font-size: clamp(21px, 2.4vw, 28px); font-weight: 500; margin: 14px 0 12px; line-height: 1.45; }
  .chapter-sub p { margin: 0; color: var(--ink-soft); line-height: 1.95; }

  @media (max-width: 900px) {
    .audience-inner { grid-template-columns: 1fr 1fr; gap: 18px 20px; }
    .audience-lead { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .hero-slide { min-height: 78vh; }
    .hero-inner { width: min(var(--container), calc(100% - 32px)); padding: 72px 0; }
    .hero-title { font-size: clamp(32px, 9vw, 44px); }
    .hero-sub { font-size: 15px; }
    .hero-dots { right: 16px; bottom: 18px; }
    .hero-media::after { background: linear-gradient(180deg, rgba(244, 239, 229, .94) 0%, rgba(244, 239, 229, .78) 60%, rgba(244, 239, 229, .5) 100%); }
    .audience-inner { grid-template-columns: 1fr; gap: 16px; }
    .audience-item { padding-left: 0; border-left: 0; border-top: 1px solid var(--line-soft); padding-top: 14px; }
    .chapter { padding: 56px 0; }
    .chapter-head { margin-bottom: 28px; }
    .chapter-sub { margin: 48px 0 24px; }
  }
</style>
