import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
// ── 作品展示 · 一字一源（2026-10-16 业主裁决）────────────────────────────
// 业主原话：「作品区要 6，不要恒/安/归，把心意之选换成作品展示」。
//
// 此前这一格是「01 / 心意之选」——6 张**送礼场景卡**（节日问候、传情达意…），
// 讲的是「什么时候送 / 送给谁」。业主判定它与紧随其后的「02 / 客户分享」
// （讲「这份礼是怎么来的」）职能重叠：两格都在讲礼，没人讲「字」。
//
// 现在改为「一字一源」作品展示：讲**这个字从哪来**——字形源流 + 场景联想。
// 与 02 客户分享形成文档要求的边界：作品区讲「字」，客户区讲「人」，内容不重叠。
//
// ── 选件标准（业主授权「先上线再核」，此标准待业主用专业考据覆盖）──
// 1. 必须能追溯到**具体的字形/实物遗存**（不是文学出处），这是「一字一源」的题眼；
// 2. 前 4 件是**已真实交付**的委托作品（业主 2026-10-16 确认），带真实委托背景；
// 3. 后 2 件从现货十二幅中选字源最硬的两件：长乐（汉瓦当实物）> 其余。
//
// ⚠️ 2026-10-16 关键区分：**已交付作品 vs 可购商品**。
//    前 4 件（康而寿 / 择吉日 / 古为今用 / 百福图）是**委托已交付的案例**，
//    slug 不在商品目录（giftProducts + readyMadeWorks）里 —— 它们**不可购买**。
//    初版给这 4 件也加了「以此为灵感」收藏按钮，浏览器实测点击后
//    localStorage 立刻被清空：WishlistDrawer 的 render() 会把「不在 catalog 里的 slug」
//    当孤儿项剔除并写回（见 WishlistDrawer.astro 的 known 过滤逻辑）。
//    从产品语义上讲，让用户「收藏」一件已经属于别人的作品本来就是错的，
//    所以正解不是把 4 件塞进 catalog，而是**不给它们收藏按钮**：
//      · 已交付作品 → 「以此为灵感定制」（带 slug 作为 inspiration 参数，走定制）
//      · 在售现货   → 「以此为灵感」（真收藏，写入心愿单）
//    页面不暴露这两个分支的技术原因，读者只会看到两个都说得通的入口。
type SourceWork = {
  slug: string;          // 现货作品与商品目录对齐；委托案例仅作定制灵感标识
  title: string;         // 作品词面
  en: string;
  char: string;          // 主打字的古文字形展示字（页面用 display 字体放大表现）
  origin: string;        // 字源出处（朝代 / 载体）
  originNote: string;    // 字源考据一句话
  scene: string;         // 场景联想：它可以为你做什么
  image: string;
  alt: string;
  href: string;          // 「看看这一件」的去处
  delivered: boolean;    // true = 已真实交付的委托作品（不可收藏，只能以之为灵感定制）
  /** 在售现货才填：心愿单 slug（必须存在于商品目录，否则会被抽屉当孤儿清掉） */
  wishSlug?: string;
};
const sourceWorks: SourceWork[] = [
  {
    slug: 'kang-er-shou',
    title: '康而寿',
    en: 'Health and Longevity',
    char: '寿',
    origin: '西周金文',
    originNote: '「寿」在青铜器铭文里写作上「老」下「畴」的会意结构，本义是「久经岁月而身体不衰」。金文铸刻的线条厚实匀停，写出来自然带着一份稳当。',
    scene: '给父母、长辈，或送给一个刚刚熬过难关的人。它不说「祝你健康」，它说的是「愿你的日子长久而安稳」。',
    image: '/assets/scenes/study-kang-er-shou.jpg',
