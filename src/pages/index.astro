---
import Layout from '../layouts/Layout.astro';
import Pic from '../components/Pic.astro';
const sceneCards = [
  { tag: '节日问候', title: '四时一笺', body: '岁有寒暑，月有圆缺——把四季的流转写成一幅字，让问候在案头留得久一点。', price: '¥300', image: '/assets/scenes/theme-four-seasons.jpg', href: '/gifts/seasonal-letter-gift/', alt: '书房木案上的四季题跋书法横幅，旁有兰草与砚台' },
  { tag: '传情达意', title: '一点朱砂', body: '朱砂作底，古字为凭——值得庆祝的事，就该这样郑重地讲出来。', price: '¥300', image: '/assets/scenes/theme-cinnabar.jpg', href: '/gifts/cinnabar-note-gift/', alt: '朱砂红卡的「欢喜」古文字书法框，旁有红梅与灯笼' },
  { tag: '文房雅趣', title: '墨有呼吸', body: '书房雅趣，自古值得被记录——一笔一画的浓淡停顿都看得见，写出来的字，才是活的书香。', price: '¥800', image: '/assets/scenes/theme-ink-breath.jpg', href: '/gifts/ink-breath-teacher/', alt: '阳光下的毛边纸密字书法作品，笔触清晰可辨' },
  { tag: '风生水起', title: '案上有山', body: '书房之内，自有山河——大境之气，亦有大静之气，把开阔与生长安放进日常。', price: '¥800', image: '/assets/scenes/theme-desk-mountain.jpg', href: '/gifts/desk-mountain-keepsake/', alt: '茶室绿墙上的长卷书法与原木长案茶席' },
  { tag: '校庆谢师', title: '桃李不言', body: '校庆周年、谢师情谊——把校训或写给恩师的那句话写成字。桃李不言，下自成蹊，深深的感谢不必多言。', price: '¥800', image: '/assets/scenes/theme-teacher-calligraphy-desklamp.jpg', href: '/business-gifts/#campus', alt: '书房木案上的洒金笺古文字书法横幅，黑色台灯暖光下旁有青瓷瓶插山茶、放大镜与笔记本' },
  { tag: '婚庆纪念', title: '琴瑟和鸣', body: '订婚、结婚、周年——把两个人的名字与祝愿写成一幅。琴瑟在御，莫不静好，愿此后岁岁年年。', price: '¥800', image: '/assets/scenes/theme-wedding-calligraphy-lantern.jpg', href: '/contact/', alt: '柚木边柜上的白底古文字书法横幅，旁有暖光纸灯笼、蕨类绿植与书册' },
];
const storyCards = [
  { title: '书房定制 · 给父母的周年纪念礼', quote: '想给结婚三十年的爸妈留一件东西，最后写了「康而寿」。康是平安，寿是长久——挂进书房那天，我爸说，这三个字比什么都实在。', image: '/assets/scenes/study-kang-er-shou.jpg', alt: '书房案头的「康而寿」书法横幅，旁有台灯与书卷' },
  { title: '乔迁好礼 · 分享朋友的迁居之喜', quote: '朋友搬新家，红包太轻、摆件太俗。写了一幅「择吉日」——好日子不用翻黄历，挂在墙上，搬进来的每一天都算数。', image: '/assets/scenes/housewarming-ze-ji-ri.jpg', alt: '赭色卡纸的「择吉日」书法横幅，摆在卧室边柜上，旁有台灯与鲜花' },
  { title: '感谢师恩 · 成长路上的指路人', quote: '给带了三年的导师准备谢师礼，写了一幅「古为今用」。老师说，把老学问讲成新道理，是她做了一辈子的事——这四个字，算是替我们谢过她。', image: '/assets/scenes/teacher-gu-wei-jin-yong.jpg', alt: '餐边柜上的「古为今用」古文字书法横幅，旁有陶瓶与绿枝' },
  { title: '企业礼赠 · 合作伙伴周年庆典', quote: '给合作了十年的伙伴选了一份「百福图」，对方收到后说「这比任何商务礼品都让我感动」。后来那份作品一直挂在他办公室最显眼的位置。', image: '/assets/scenes/dining-room-long-calligraphy.jpg', alt: '企业空间里的书法横幅' },
];
const steps = [
  { no: '壹', title: '倾听', body: '告诉我们空间、人物与想留下的情绪，不必先懂艺术。' },
  { no: '贰', title: '取意', body: '从字、色、材质中，找到属于你的视觉方向。' },
  { no: '叁', title: '创作', body: '匹配的艺术家为你专属创作，过程中保留必要的确认节点。' },
  { no: '肆', title: '抵达', body: '作品以适合你的方式，带着温度抵达。' },
];
// 见艺术 · 文字源流区的时间轴节点。
// 史实口径：甲骨文（商）、金文（商周）、石鼓文（先秦，与首屏「秦王猎碣」同一出处）、秦篆（秦）。
// 关键词沿用品牌侧定稿的「苍茫 / 厚重 / 古拙 / 雄浑」。
const originNodes = [
  { era: '商', name: '甲骨文', keyword: '苍茫', body: '契刻于龟甲兽骨，是汉字最老的模样。' },
  { era: '商周', name: '金文', keyword: '厚重', body: '铸于青铜彝器，与礼乐一同庄重。' },
  { era: '先秦', name: '石鼓文', keyword: '古拙', body: '刻于鼓形碣石，猎猎犹闻车马声。' },
  { era: '秦', name: '秦篆', keyword: '雄浑', body: '书同文的范式，线条圆劲而匀整。' },
];
---
<Layout title="小民艺术 XIAOMINART｜方寸藏境，山河入章" description="书画礼品定制平台。在喧嚣之外，寻一处安放身心的角落。这里的每一笔墨痕，都是对生活的另一种回答。">
  <section class="hero" aria-label="品牌横幅">
    <div class="hero-slide is-active hero-slide--soft" data-hero-slide>
      <div class="hero-media" aria-hidden="true"><Pic src="/assets/scenes/hero-shiguwen-light.jpg" alt="" width={1536} height={1024} loading="eager" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <h1 class="serif">方寸藏境，<br />山河入章。</h1>
        <p class="hero-sub">取自秦王猎碣——「吾车既工，吾马既同；<br />吾车既好，吾马既阜。」最古老的石刻文字，就悬在这方寸之间。</p>
      </div>
    </div>
    <div class="hero-slide" data-hero-slide aria-hidden="true">
      <div class="hero-media" aria-hidden="true"><Pic src="/assets/scenes/bird-seal-tearoom.jpg" alt="" width={1280} height={720} loading="lazy" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <p class="serif hero-title">线条藏界，<br />意趣无疆。</p>
        <p class="hero-sub">融古老鸟虫篆意趣，字如游鱼，昂首摆尾，穿梭自如。<br />在生活的洪流里，愿你也能找到自己的节奏，游刃有余。</p>
      </div>
    </div>
    <div class="hero-slide" data-hero-slide aria-hidden="true">
      <div class="hero-media" aria-hidden="true"><Pic src="/assets/scenes/imperfect-real.jpg" alt="" width={1280} height={720} loading="lazy" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <p class="serif hero-title">字里藏光，<br />岁月无恙。</p>
        <p class="hero-sub">一方魏晋碑刻，记下一纸寻常地契，文字若记得，时光便记得。<br />记录，让我们看见过去，也被未来看见。</p>
      </div>
    </div>
    <div class="hero-dots" aria-label="横幅切换">
      <button class="hero-dot is-active" type="button" data-hero-dot aria-label="第一屏：方寸藏境，山河入章"></button>
      <button class="hero-dot" type="button" data-hero-dot aria-label="第二屏：线条藏界，意趣无疆"></button>
      <button class="hero-dot" type="button" data-hero-dot aria-label="第三屏：字里藏光，岁月无恙"></button>
    </div>
  </section>
  <script>
    const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
    const hero = document.querySelector<HTMLElement>('.hero');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const show = (index: number) => {
      current = index % slides.length;
      slides.forEach((slide, i) => { slide.classList.toggle('is-active', i === current); slide.setAttribute('aria-hidden', i === current ? 'false' : 'true'); });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const play = () => { stop(); if (reduceMotion.matches || document.hidden) return; timer = setInterval(() => show(current + 1), 6000); };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); play(); }));
    if (slides.length > 1) {
      play();
      // 悬停暂停只绑在「有真实悬停能力」的设备上（2026-10-08 修复）：
      // 触屏 (hover: none) 上 touchend 后浏览器会合成 mouseenter，且永远不会来
      // mouseleave——若绑定，首次触摸 banner 后轮播就永久冻结在当前一张。
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
      if (canHover.matches) {
        hero?.addEventListener('mouseenter', stop);
        hero?.addEventListener('mouseleave', play);
        hero?.addEventListener('focusin', stop);
        hero?.addEventListener('focusout', play);
      } else {
        // 触屏：按下暂停、抬手恢复
        hero?.addEventListener('touchstart', stop, { passive: true });
        hero?.addEventListener('touchend', play);
        hero?.addEventListener('touchcancel', play);
      }
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
      // 系统切换「减少动态效果」时立即生效（WCAG 2.2.2）
      reduceMotion.addEventListener('change', play);
    }
  </script>

  {/* ── 承载 / 承接：从「见山河」的气势承接进道法与书法。
      背景用业主提供的浅纸调古文字墙卷（甲骨/金文/石鼓文/篆书四段），文字深墨居中。 ── */}
  <section class="art-hero" aria-labelledby="art-hero-title">
    <div class="art-hero-texture" aria-hidden="true"></div>
    <div class="container art-hero-inner" data-reveal>
      <span class="eyebrow">承载 / 承接</span>
      <h2 id="art-hero-title" class="serif">道法有形，<br />书法有源。</h2>
      <p class="art-hero-sub serif">溯字之源，以书载道；<br />字有所本，道有所传。</p>
      <p class="art-hero-note">道法在天地运行的秩序里，书法在汉字生长的脉络中。</p>
    </div>
  </section>

  {/* ── 见艺术 · 文字源流区：把古文字书法流派的来龙去脉说清楚。
      附件原拟 CTA「字游记」页面尚不存在，先链到祝愿字典（最接近的现有内容）。 ── */}
  <section class="container section origins" aria-labelledby="origins-title">
    <div class="section-lead" data-reveal>
      <span class="eyebrow">见艺术 / 文字源流</span>
      <h2 id="origins-title" class="serif">回到源头的观看方式。</h2>
      <p>从甲骨文的苍茫、金文的厚重、石鼓文的古拙，到秦篆的雄浑——每一笔都不是凭空而来，而是从千年文字里提炼出的秩序、气韵与美感。小民艺术不只是一门书法，更是一种回到源头的观看方式：在古文字的法度里，看见中国美学的根基。</p>
    </div>
    <ol class="origin-rail" data-reveal>
      {originNodes.map((node) => <li class="origin-node"><span class="mono origin-era">{node.era}</span><strong class="serif origin-name">{node.name}</strong><span class="origin-key">{node.keyword}</span><p>{node.body}</p></li>)}
    </ol>
    <a class="btn btn-link origins-more" href="/blessings/">了解古文字与字义 →</a>
  </section>

  {/* ── 见自己 · 修身入口区：从「艺术」转向「人」。配图用业主提供的书写近景实拍。 ── */}
  <section class="container section self-section" aria-labelledby="self-title">
    <div class="self-grid">
      <figure class="self-fig" data-reveal><Pic src="/assets/scenes/self-practice-writing.jpg" alt="书写近景：手执毛笔在亚麻纸上写下浓墨大字，旁有砚台，暖光下笔锋清晰可见" loading="lazy" decoding="async" /></figure>
      <div class="self-copy" data-reveal>
        <span class="eyebrow">见自己 / 修身入口</span>
        <h2 id="self-title" class="serif">看见，是理解的开始；<br />理解，是修身的入口。</h2>
        <p>当一个字被认真辨认，一段历史便不再遥远；当一种书写被慢慢临习，心性也会随之沉静下来。</p>
        <p class="self-close">小民艺术希望你在方寸之间，遇见更从容的自己。</p>
      </div>
    </div>
  </section>

  {/* ── 见来处 · 品牌承接区：品牌内核落点（看见—理解—解读—修身）。
      三条背书均与站内既有事实页对应，不做无凭据的夸示。 ── */}
  <section class="container section brand-landing" aria-labelledby="brand-title">
    <div class="section-lead brand-lead" data-reveal>
      <span class="eyebrow">见来处 / 品牌来处</span>
      <h2 id="brand-title" class="serif">见来处，方知去向。</h2>
    </div>
    <p class="brand-body" data-reveal>小民艺术承接的，不只是古文字的形，更是它背后的来处：看见文明的源头，理解汉字的深意，解读先人的智慧，并在书写中安顿自己。</p>
    <p class="brand-body brand-close" data-reveal>我们希望，每一个走近小民艺术的人，都能在方寸之间，遇见更从容的自己，也重新认出自己文化的来处。</p>
    <ul class="brand-facts" data-reveal>
      <li><a href="/partners/museum-tourism/"><span class="mono">壹</span>博物馆与文旅合作</a></li>
      <li><a href="/partners/heritage/"><span class="mono">贰</span>非遗面塑传承</a></li>
      <li><a href="/about/"><span class="mono">叁</span>以书法解读历史</a></li>
    </ul>
    <a class="btn btn-primary" href="/about/" data-reveal>走进小民艺术 →</a>
  </section>

  <section class="container section choices" aria-labelledby="choices-title">
    <div class="section-lead"><span class="eyebrow">01 / 心意之选</span><h2 id="choices-title" class="serif">为生活添一份心意。</h2><p>不是冰冷的印刷品，而是带着温度的手泽。或是案头的一抹清欢，或是心头的一声叹息。</p></div>
    <div class="choice-grid">
      {sceneCards.map((card) => <a class="choice-card" href={card.href} data-event="scene_view"><figure><Pic src={card.image} alt={card.alt} loading="lazy" decoding="async" /></figure><div class="choice-copy"><span class="mono choice-tag">{card.tag}</span><h3 class="serif">{card.title}</h3><p>{card.body}</p><div class="choice-meta"><span class="price">心意起点约 {card.price}</span><span class="card-link">以此为灵感 →</span></div></div></a>)}
    </div>
  </section>

  <section class="container section stories" aria-labelledby="stories-title">
    <div class="section-lead"><span class="eyebrow">02 / 客户分享</span><h2 id="stories-title" class="serif">从一句话，到一件作品。</h2><p>每一份委托，都从委托人的那句话开始。下面是按常见送礼情境整理的客户分享，用来说明一份心意如何成形——你的定制，也将从你的那句话开始。</p></div>
    <div class="story-grid">
      {storyCards.map((card) => <article class="story-card"><figure><Pic src={card.image} alt={card.alt} loading="lazy" decoding="async" /></figure><div class="story-copy"><h3 class="serif">{card.title}</h3><blockquote>「{card.quote}」</blockquote><span class="story-tag">客户分享 · 按委托情境整理</span></div></article>)}
    </div>
    <a class="btn btn-link stories-more" href="/stories/">看看更多客户分享 →</a>
  </section>

  <section class="container section process" aria-labelledby="process-title">
    <div class="section-lead"><span class="eyebrow">03 / 我们的共创过程</span><h2 id="process-title" class="serif">一份作品的诞生。</h2><p>把心事交给我们，剩下的慢慢来。</p></div>
    <div class="process-rail">
      {steps.map((step) => <article class="process-card"><span class="mono step-no">{step.no}</span><h3 class="serif">{step.title}</h3><p>{step.body}</p></article>)}
    </div>
  </section>

  <section class="container section closing" aria-labelledby="closing-title">
    <span class="eyebrow">04 / 与我们聊聊</span>
    <h2 id="closing-title" class="serif">每一份心意，都值得被认真对待。</h2>
    <a class="btn btn-primary" href="/contact/" data-event="custom_inquiry_start">与我们聊聊 →</a>
  </section>
</Layout>
<style>
  .hero { position: relative; min-height: min(88vh, 820px); overflow: hidden; }
  .hero-slide { position: absolute; inset: 0; display: flex; align-items: center; opacity: 0; transition: opacity 1.1s ease; pointer-events: none; }
  .hero-slide.is-active { opacity: 1; pointer-events: auto; }
  .hero-dots { position: absolute; right: 30px; bottom: 28px; z-index: 2; display: flex; gap: 10px; }
  .hero-dot { width: 30px; height: 3px; padding: 0; border: 0; background: rgba(43, 41, 36, .28); cursor: pointer; transition: background .3s ease, width .3s ease; }
  .hero-dot.is-active { background: var(--cinnabar); }
  .hero-media { position: absolute; inset: 0; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(244, 239, 229, .96) 0%, rgba(244, 239, 229, .84) 42%, rgba(244, 239, 229, .38) 100%); }
  .hero-slide--soft .hero-media::after { background: linear-gradient(100deg, rgba(244, 239, 229, .95) 0%, rgba(244, 239, 229, .74) 28%, rgba(244, 239, 229, .30) 52%, rgba(244, 239, 229, .08) 100%); }
  .hero-inner { position: relative; z-index: 1; width: min(var(--container), calc(100% - 48px)); margin: 0 auto; padding: 96px 0; text-align: left; }
  .hero :is(h1, .hero-title) { font-size: clamp(38px, 5.6vw, 72px); line-height: 1.25; font-weight: 400; letter-spacing: .06em; margin: 22px 0 26px; }
  .hero-sub { max-width: 560px; color: var(--ink-soft); font-size: 17px; line-height: 2; margin: 0 0 34px; }
  /* ── 见艺术 · 主标题区：全幅留白 + 石鼓文低透明度纹理，字是绝对主角 ── */
  .art-hero { position: relative; overflow: hidden; padding: clamp(76px, 10vw, 128px) 0; text-align: center; }
  /* 业主提供的古文字墙卷（浅纸调，甲骨/金文/石鼓文/篆书四段），全幅铺底；
     中段轻覆纸色让文字浮出，上下沿渐隐回纸色，与相邻段落衔接 */
  .art-hero-texture { position: absolute; inset: 0; background: url('/assets/scenes/art-hero-wall.webp') center / cover no-repeat; }
  .art-hero-texture::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, var(--paper) 0%, rgba(244, 239, 229, .62) 32%, rgba(244, 239, 229, .62) 68%, var(--paper) 100%); }
  .art-hero-inner { position: relative; z-index: 1; }
  .art-hero :is(h2, .art-hero-sub) { letter-spacing: .1em; color: var(--ink); }
  .art-hero h2 { font-size: clamp(36px, 5.4vw, 64px); font-weight: 400; line-height: 1.3; margin: 22px 0 26px; }
  .art-hero-sub { font-size: clamp(18px, 2.2vw, 24px); line-height: 2; margin: 0 0 30px; }
  .art-hero-note { color: var(--ink-soft); font-size: 15px; letter-spacing: .05em; margin: 0; }
  /* ── 见艺术 · 文字源流区：时间轴沿用 process-card 的「上边线 + 序号」语言 ── */
  .origins { border-top: 1px solid var(--line-soft); }
