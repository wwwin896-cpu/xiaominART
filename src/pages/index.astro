---
import Layout from '../layouts/Layout.astro';
const sceneCards = [
  { title: '书房与玄关的静谧点缀', body: '一幅小字，让进门的那一刻安静下来。', price: '¥100', image: '/assets/scenes/entry-console-scroll.jpg', href: '/occasions/housewarming/', alt: '玄关案头的书法小字' },
  { title: '传递温度的社交名片', body: '比鲜花更持久的，是一句认真写下的话。', price: '¥300', image: '/assets/scenes/sideboard-fan-calligraphy.jpg', href: '/gifts/', alt: '礼盒中的手写扇面书法' },
  { title: '安放情绪的私密空间', body: '茶室或客厅里，一处让你深呼吸的角落。', price: '¥500', image: '/assets/scenes/tea-wall-scroll.jpg', href: '/scenes/', alt: '茶室墙上的书法横卷' },
];
const storyCards = [
  { title: '书房定制 · 给父母的生日礼物', quote: '一直想送给父母一份不一样的生日礼物，小民老师把那句「平安喜乐」写在了宣纸上，装裱好送到家里那一刻，妈妈红了眼眶。', image: '/assets/scenes/study-desk-scroll.jpg', alt: '书房案头的手写书法' },
  { title: '企业礼赠 · 合作伙伴周年庆', quote: '给合作了十年的伙伴选了一份定制作品，对方收到后说「这比任何商务礼品都让我感动」。后来那份作品一直挂在他办公室最显眼的位置。', image: '/assets/scenes/dining-room-long-calligraphy.jpg', alt: '企业空间里的书法横幅' },
];
const steps = [
  { no: '壹', title: '倾听', body: '告诉我们空间、人物与想留下的情绪，不必先懂艺术。' },
  { no: '贰', title: '取意', body: '从字、色、材质中，找到属于你的视觉方向。' },
  { no: '叁', title: '创作', body: '匹配的艺术家为你专属创作，过程中保留必要的确认节点。' },
  { no: '肆', title: '抵达', body: '作品以适合你的方式，带着温度抵达。' },
];
---
<Layout title="小民艺术 XIAOMINART｜方寸之境，也藏山河" description="书画礼品定制平台。在喧嚣之外，寻一处安放身心的角落。这里的每一笔墨痕，都是对生活的另一种回答。">
  <section class="hero" aria-label="品牌横幅">
    <div class="hero-slide is-active" data-hero-slide>
      <div class="hero-media" aria-hidden="true"><img src="/assets/scenes/tea-gold-calligraphy.jpg" alt="" loading="eager" fetchpriority="high" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <h1 class="serif">方寸之境，<br />也藏山河。</h1>
        <p class="hero-sub">在喧嚣之外，寻一处安放身心的角落。<br />这里的每一笔墨痕，都是对生活的另一种回答。</p>
      </div>
    </div>
    <div class="hero-slide" data-hero-slide aria-hidden="true">
      <div class="hero-media" aria-hidden="true"><img src="/assets/scenes/imperfect-real.jpg" alt="" loading="lazy" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <h1 class="serif">它不完美，<br />却很真实。</h1>
        <p class="hero-sub">手写的墨痕、粗陶的窑变与麻纸的毛边，<br />都是生活本来的样子。</p>
      </div>
    </div>
    <div class="hero-dots" aria-label="横幅切换">
      <button class="hero-dot is-active" type="button" data-hero-dot aria-label="第一屏：方寸之境，也藏山河"></button>
      <button class="hero-dot" type="button" data-hero-dot aria-label="第二屏：它不完美，却很真实"></button>
    </div>
  </section>
  <script>
    const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const show = (index: number) => {
      current = index % slides.length;
      slides.forEach((slide, i) => { slide.classList.toggle('is-active', i === current); slide.setAttribute('aria-hidden', i === current ? 'false' : 'true'); });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
    };
    const play = () => { timer = setInterval(() => show(current + 1), 6000); };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { if (timer) clearInterval(timer); show(i); play(); }));
    if (slides.length > 1) play();
  </script>

  <section class="container section choices" aria-labelledby="choices-title">
    <div class="section-lead"><span class="eyebrow">01 / 心意之选</span><h2 id="choices-title" class="serif">为生活添一份心意。</h2><p>不是冰冷的印刷品，而是带着温度的手泽。或是案头的一抹清欢，或是心头的一声叹息。</p></div>
    <div class="choice-grid">
      {sceneCards.map((card) => <a class="choice-card" href={card.href} data-event="scene_view"><figure><img src={card.image} alt={card.alt} loading="lazy" decoding="async" /></figure><div class="choice-copy"><h3 class="serif">{card.title}</h3><p>{card.body}</p><div class="choice-meta"><span class="price">心意起点约 {card.price}</span><span class="card-link">以此为灵感 →</span></div></div></a>)}
    </div>
  </section>

  <section class="container section stories" aria-labelledby="stories-title">
    <div class="section-lead"><span class="eyebrow">02 / 他们的定制故事</span><h2 id="stories-title" class="serif">从一句话，到一件作品。</h2><p>每一份心意背后，都有一段真实的故事。</p></div>
    <div class="story-grid">
      {storyCards.map((card) => <article class="story-card"><figure><img src={card.image} alt={card.alt} loading="lazy" decoding="async" /></figure><div class="story-copy"><h3 class="serif">{card.title}</h3><blockquote>「{card.quote}」</blockquote><span class="story-tag">灵感源自真实故事</span></div></article>)}
    </div>
    <a class="btn btn-link stories-more" href="/journal/">看看更多故事 →</a>
  </section>

  <section class="container section process" aria-labelledby="process-title">
    <div class="section-lead"><span class="eyebrow">03 / 我们的共创过程</span><h2 id="process-title" class="serif">一份作品的诞生。</h2><p>把心事交给我们，剩下的慢慢来。</p></div>
    <div class="process-rail">
      {steps.map((step) => <article class="process-card"><span class="mono step-no">{step.no}</span><h3 class="serif">{step.title}</h3><p>{step.body}</p></article>)}
    </div>
  </section>

  <section class="container section closing" aria-labelledby="closing-title">
    <span class="eyebrow">04 / 与我们聊聊</span>
    <h2 id="closing-title" class="serif">每一份心意，都值得被认真对待。</h2>
    <p>无需先懂艺术，我们先聊聊您想表达的话。</p>
    <a class="btn btn-primary" href="/contact/" data-event="custom_inquiry_start">与我们聊聊 →</a>
  </section>
</Layout>
<style>
  .hero { position: relative; min-height: min(88vh, 820px); overflow: hidden; }
  .hero-slide { position: absolute; inset: 0; display: flex; align-items: center; opacity: 0; transition: opacity 1.1s ease; pointer-events: none; }
  .hero-slide.is-active { opacity: 1; pointer-events: auto; }
  .hero-dots { position: absolute; right: 30px; bottom: 28px; z-index: 2; display: flex; gap: 10px; }
  .hero-dot { width: 30px; height: 3px; padding: 0; border: 0; background: rgba(43, 41, 36, .28); cursor: pointer; transition: background .3s ease, width .3s ease; }
  .hero-dot.is-active { background: var(--cinnabar); }
  .hero-media { position: absolute; inset: 0; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(244, 239, 229, .9) 0%, rgba(244, 239, 229, .62) 46%, rgba(244, 239, 229, .78) 100%); }
  .hero-inner { position: relative; z-index: 1; width: 100%; padding: 96px 0; text-align: center; }
  .hero h1 { font-size: clamp(38px, 5.6vw, 72px); line-height: 1.25; font-weight: 500; letter-spacing: .04em; margin: 22px auto 26px; }
  .hero-sub { max-width: 460px; color: var(--ink-soft); font-size: 17px; line-height: 2; margin: 0 auto 34px; }
  .choices, .stories, .process, .closing { border-top: 1px solid var(--line-soft); }
  .section-lead { max-width: 560px; margin-bottom: 44px; }
  .section-lead h2 { font-size: clamp(24px, 2.8vw, 38px); font-weight: 500; line-height: 1.4; margin: 14px 0 12px; letter-spacing: .02em; }
  .section-lead p { color: var(--ink-soft); margin: 0; line-height: 1.9; }
  .choice-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .choice-card { display: flex; flex-direction: column; }
  .choice-card figure { margin: 0; overflow: hidden; aspect-ratio: 4 / 5; background: var(--paper-deep); }
  .choice-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease, filter .5s ease; }
  .choice-card:hover img { transform: scale(1.035); filter: brightness(1.05); }
  .choice-copy { padding: 18px 2px 0; }
  .choice-copy h3 { font-size: 20px; font-weight: 500; margin: 0 0 8px; }
  .choice-copy p { color: var(--ink-soft); font-size: 14px; line-height: 1.8; margin: 0 0 14px; }
  .choice-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .choice-meta .price { color: var(--cinnabar-deep); font-size: 13px; }
  .choice-meta .card-link { color: var(--cinnabar); font-size: 12px; white-space: nowrap; }
  .story-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; }
  .story-card { display: grid; grid-template-columns: .9fr 1.1fr; border: 1px solid var(--line); background: var(--paper-light); }
  .story-card figure { margin: 0; overflow: hidden; }
  .story-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease, filter .5s ease; }
  .story-card:hover img { transform: scale(1.03); filter: brightness(1.05); }
  .story-copy { padding: 26px 26px 24px; display: flex; flex-direction: column; gap: 12px; }
  .story-copy h3 { font-size: 19px; font-weight: 500; margin: 0; line-height: 1.5; }
  .story-copy blockquote { margin: 0; color: var(--ink-soft); font-size: 14px; line-height: 1.95; }
  .story-tag { margin-top: auto; color: var(--muted); font-size: 11px; letter-spacing: .08em; }
  .stories-more { margin-top: 30px; }
  .process-rail { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; }
  .process-card { border-top: 1px solid var(--line); padding: 22px 18px 0 0; }
  .step-no { color: var(--cinnabar); font-size: 13px; }
  .process-card h3 { font-size: 22px; font-weight: 500; margin: 16px 0 10px; }
  .process-card p { color: var(--ink-soft); font-size: 14px; line-height: 1.9; margin: 0; }
  .closing { text-align: center; border-top: 1px solid var(--line-soft); }
  .closing h2 { font-size: clamp(24px, 2.8vw, 36px); font-weight: 500; margin: 16px 0 12px; }
  .closing p { color: var(--ink-soft); margin: 0 0 28px; }
  @media (max-width: 900px) { .choice-grid { gap: 20px; } .story-card { grid-template-columns: 1fr; } .story-card figure { aspect-ratio: 16 / 9; } }
  @media (max-width: 767px) {
    .hero { min-height: 78vh; }
    .hero-dots { right: 16px; bottom: 18px; }
    .hero-media::after { background: linear-gradient(180deg, rgba(244, 239, 229, .94) 0%, rgba(244, 239, 229, .78) 60%, rgba(244, 239, 229, .5) 100%); }
    .hero-inner { padding: 72px 0; }
    .hero h1 { font-size: clamp(34px, 10vw, 46px); }
    .hero-sub { font-size: 15px; }
    .section { padding: 56px 0; }
    .section-lead { margin-bottom: 30px; }
    .choice-grid { grid-template-columns: 1fr; gap: 34px; }
    .choice-card figure { aspect-ratio: 4 / 3; }
    .story-grid { grid-template-columns: 1fr; gap: 20px; }
    .process-rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; padding-bottom: 8px; margin: 0 -16px; padding-inline: 16px; }
    .process-card { flex: 0 0 74%; scroll-snap-align: start; }
  }
</style>
