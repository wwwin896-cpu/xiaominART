---
<Layout title="小民艺术 XIAOMINART｜方寸藏境，山河入章" description="书画礼品定制平台。在喧嚣之外，寻一处安放身心的角落。这里的每一笔墨痕，都是对生活的另一种回答。">
  <section class="hero" aria-label="品牌横幅">
    <div class="hero-slide is-active hero-slide--soft" data-hero-slide>
      <div class="hero-media" aria-hidden="true"><Pic src="/assets/scenes/hero-shiguwen-light.jpg" alt="" width={1536} height={1024} loading="eager" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <h1 class="serif">方寸藏境，<br />山河入章。</h1>
        <p class="hero-sub">取自秦王猎碣——「吾车既工，吾马既同；<br />吾车既好，吾马既阜。」最古老的石刻文字，就悬在这方寸之间。</p>
      </div>
    </div>
    <div class="hero-slide" data-hero-slide aria-hidden="true">
      <div class="hero-media" aria-hidden="true"><Pic src="/assets/scenes/bird-seal-tearoom.jpg" alt="" width={1280} height={720} loading="lazy" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <p class="serif hero-title">线条藏界，<br />意趣无疆。</p>
        <p class="hero-sub">融古老鸟虫篆意趣，字如游鱼，昂首摆尾，穿梭自如。<br />在生活的洪流里，愿你也能找到自己的节奏，游刃有余。</p>
      </div>
    </div>
    <div class="hero-slide" data-hero-slide aria-hidden="true">
      <div class="hero-media" aria-hidden="true"><Pic src="/assets/scenes/imperfect-real.jpg" alt="" width={1280} height={720} loading="lazy" /></div>
      <div class="container hero-inner">
        <span class="eyebrow">XIAOMINART / 书画礼品定制</span>
        <p class="serif hero-title">字里藏光，<br />岁月无恙。</p>
        <p class="hero-sub">一方魏晋碑刻，记下一纸寻常地契，文字若记得，时光便记得。<br />记录，让我们看见过去，也被未来看见。</p>
      </div>
    </div>
    <div class="hero-dots" aria-label="横幅切换">
      <button class="hero-dot is-active" type="button" data-hero-dot aria-label="第一屏：方寸藏境，山河入章"></button>
      <button class="hero-dot" type="button" data-hero-dot aria-label="第二屏：线条藏界，意趣无疆"></button>
      <button class="hero-dot" type="button" data-hero-dot aria-label="第三屏：字里藏光，岁月无恙"></button>
    </div>
  </section>
  <script>
    const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
    const hero = document.querySelector<HTMLElement>('.hero');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const show = (index: number) => {
      current = index % slides.length;
      slides.forEach((slide, i) => { slide.classList.toggle('is-active', i === current); slide.setAttribute('aria-hidden', i === current ? 'false' : 'true'); });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === current));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const play = () => { stop(); if (reduceMotion.matches || document.hidden) return; timer = setInterval(() => show(current + 1), 6000); };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); play(); }));
    if (slides.length > 1) {
      play();
      // 悬停暂停只绑在「有真实悬停能力」的设备上（2026-10-08 修复）：
      // 触屏 (hover: none) 上 touchend 后浏览器会合成 mouseenter，且永远不会来
      // mouseleave——若绑定，首次触摸 banner 后轮播就永久冻结在当前一张。
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
      if (canHover.matches) {
        hero?.addEventListener('mouseenter', stop);
        hero?.addEventListener('mouseleave', play);
        hero?.addEventListener('focusin', stop);
        hero?.addEventListener('focusout', play);
      } else {
        // 触屏：按下暂停、抬手恢复
        hero?.addEventListener('touchstart', stop, { passive: true });
        hero?.addEventListener('touchend', play);
        hero?.addEventListener('touchcancel', play);
      }
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : play()));
      // 系统切换「减少动态效果」时立即生效（WCAG 2.2.2）
      reduceMotion.addEventListener('change', play);
    }
  </script>

  {/* ── 作品展示 ·「以此为灵感」写入心愿单（任务 #106）─────────────────────
      背景：文档把「以此为灵感」列为作品的轻量入口。此前首页这块的「以此为灵感」
      只是一个指向详情页的箭头（`<span class="card-link">`），**不是收藏动作**——
      用户点了会被带走，而不是把作品先收着。这与 /gifts/ 列表页的「加入心愿单」
      是两种不同语义，文档要求的「轻量入口」应是后者。

      实现直接复用 src/scripts/wishlist.ts（全站唯一读写入口，
      见该文件头部注释：此前有 4 份独立实现，抽屉上线后必须收敛）。

      ⚠️ 2026-10-16 实测踩坑：初版用「加载时 querySelectorAll 逐个绑定」的写法，
      浏览器实测**点击完全无反应**（localStorage 不写入、aria-pressed 不变、
      无任何报错）。原因是该 <script> 是 module，被 Astro 提到作品区**之前**
      （实测 script 标签在 HTML 的 11867 字符处、作品卡在 16999 字符处），
      执行时 [data-work-wish] 节点尚未解析出来 → querySelectorAll 返回空数组，
      绑定循环一次都没进，且静默无错。
      改为**事件委托到 document**（与本仓库 Layout 的 [data-event] 同一范式，
      见 layout-interactions.ts 的注释：同样因为「动态插入的节点收不到监听」
      而从逐个绑定改为委托）。委托对解析先后天然免疫。

      选择器用 data-work-wish 而非复用 data-wishlist —— 后者是 GiftCard.astro
      的专属选择器，若同页同时存在两套脚本会双层绑定，点一次 → toggle 两次 →
      收藏状态原地抵消，且不报错（本仓库踩过同类静默事故）。 ── */}
  <script>
    import { isWishlisted, toggleWishlist, onWishlistChange } from '../scripts/wishlist';

    /** 同步单个按钮的收藏态与文案 */
    const syncButton = (button: HTMLButtonElement) => {
      const slug = button.dataset.workWish || '';
      if (!slug) return;
      const saved = isWishlisted(slug);
      button.setAttribute('aria-pressed', String(saved));
      button.textContent = saved ? '已收藏' : '以此为灵感';
    };

    // 事件委托：不依赖节点何时被解析出来
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>('[data-work-wish]');
      if (!button) return;
      const slug = button.dataset.workWish || '';
      if (!slug) return;
      toggleWishlist(slug);
      syncButton(button);
      // 落库统计：与 /gifts/ 的 wishlist_submit（提交清单）不是一回事，
      // 这里衡量的是「在作品区被种草并收藏」这一步的转化。
      window.dispatchEvent(new CustomEvent('xiaominart:event', {
        detail: { name: 'source_work_wish', path: window.location.pathname, slot: slug },
      }));
    });

    // 初始态 + bfcache 恢复（移动端 Safari / 微信返回时浏览器复用旧 DOM）
    const syncAll = () => {
      document.querySelectorAll<HTMLButtonElement>('[data-work-wish]').forEach(syncButton);
    };
    syncAll();
    onWishlistChange(syncAll);
  </script>

  {/* ── 见山河 / 笔墨之根：从「见山河」的气势承接进道法与书法。
