const storyCards = [
  { title: '书房定制 · 给父母的周年纪念礼', quote: '想给结婚三十年的爸妈留一件东西，最后写了「康而寿」。康是平安，寿是长久——挂进书房那天，我爸说，这三个字比什么都实在。', image: '/assets/scenes/study-kang-er-shou.jpg', alt: '书房案头的「康而寿」书法横幅，旁有台灯与书卷' },
  { title: '乔迁好礼 · 分享朋友的迁居之喜', quote: '朋友搬新家，红包太轻、摆件太俗。写了一幅「择吉日」——好日子不用翻黄历，挂在墙上，搬进来的每一天都算数。', image: '/assets/scenes/housewarming-ze-ji-ri.jpg', alt: '赭色卡纸的「择吉日」书法横幅，摆在卧室边柜上，旁有台灯与鲜花' },
  { title: '感谢师恩 · 成长路上的指路人', quote: '给带了三年的导师准备谢师礼，写了一幅「古为今用」。老师说，把老学问讲成新道理，是她做了一辈子的事——这四个字，算是替我们谢过她。', image: '/assets/scenes/teacher-gu-wei-jin-yong.jpg', alt: '餐边柜上的「古为今用」古文字书法横幅，旁有陶瓶与绿枝' },
  { title: '企业礼赠 · 合作伙伴周年庆典', quote: '给合作了十年的伙伴选了一份「百福图」，对方收到后说「这比任何商务礼品都让我感动」。后来那份作品一直挂在他办公室最显眼的位置。', image: '/assets/scenes/dining-room-long-calligraphy.jpg', alt: '企业空间里的书法横幅' },
