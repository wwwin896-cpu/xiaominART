---
/**
 * 商务伴手礼详情页。
 *
 * 文案准则（业主 2026-10-15 明确）：
 *   · B 端采购商是「筛选者与决策者」，不是文艺读者 —— 用商务书面语，不用口语与抒情
 *   · 每句话都要能作为「可引用的采购事实」存在（数量、工艺、周期、开票、寄送）
 *   · 不向访客解释内部收付款规则（那属于合同条款）
 */
import BusinessDetailPage from '../../components/BusinessDetailPage.astro';

const facts = [
  '按项目评估',
  '可定制企业 Logo',
  '手写落笔，非印刷',
  '可开增值税专票',
  '支持分地址寄送',
];

const intro = [
  '商务伴手礼用于客户答谢、员工福利、会议与活动赠礼等需要「批量表达致意」的场合。产品形态为装裱小品、卡笺或扇面，每份随附一张以贵司名义手写的贺卡。',
  '与印刷品的区别在于书写方式：全部由人手逐份落笔，因此允许存在自然笔迹差异，这也是该品类的基本工艺特征。若贵司需要完全一致的呈现，建议在需求表中说明，我们另行评估工艺方案。',
];

const scenarios = [
  '客户答谢（年终、合作节点、答谢会）',
  '员工福利（节日、入职、周年）',
  '会议与论坛伴手礼',
  '品牌活动与展会赠礼',
  '开业、乔迁与庆典赠礼',
];

const specRows = [
  { label: '起订', value: '不设固定起订量。按用途、场合与预算一起评估，数量先给大致范围即可。' },
  { label: '产品形态', value: '装裱小品、卡笺、扇面。具体规格可在方案阶段按贵司场合调整。' },
  { label: '企业标识', value: '支持企业 Logo 与品牌元素定制。轻量规格配企业 Logo 卡片；定制规格可调整图案、尺寸与包装。' },
  { label: '贺卡书写', value: '随附以贵司名义手写的贺卡，可选统一祝辞或分批定制内容。' },
  { label: '包装', value: '常规包装随件提供。需定制企业 VI 包装（结构、印刷、材质）的，请在需求表中说明。' },
  { label: '交付周期', value: '方案与报价 2 个工作日内；打样确认 5–7 个工作日；批量创作与包装 15–30 个工作日；配送 3–7 个工作日。常规总量 25–45 个工作日（含打样）。' },
  { label: '寄送方式', value: '保价配送。支持按贵司提供的名单分地址寄送至收礼人本人，包裹内不含价格单据。' },
  { label: '结算与发票', value: '支持对公结算，可开具增值税普通发票或专用发票。具体条款以双方合同为准。' },
  { label: '打样', value: '可在批量前先看实物样。打样的范围、费用与时间在开始前告知。' },
];

// ⚠️ 案例图片当前为站内既有作品图占位，待业主提供真实素材后替换（改 image / alt 即可）
const cases = [
  {
    title: '某制造业企业 · 年度客户答谢',
    clientType: '制造业 · 客户答谢',
    facts: ['120 份', '装裱小品 + 定制贺卡', '含企业 Logo'],
    body: '为年度答谢会准备统一规格伴手礼，随附按客户称谓分别书写的贺卡，按销售提供的名单分地址寄送至客户本人。',
    image: '/assets/stories/story-jinwen-xiaopin-600.webp',
    alt: '装裱小品伴手礼示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
  {
    title: '某科技公司 · 员工周年福利',
    clientType: '科技 · 员工福利',
    facts: ['200 份', '卡笺', '统一祝辞'],
    body: '按入职年份分批交付，包装内附统一祝辞卡。全批采用同一书写规格，保证视觉一致。',
    image: '/assets/stories/story-du-shu-gu-xiang.webp',
    alt: '卡笺伴手礼示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
];

const faqs = [
  {
    q: '起订量是多少？',
    a: '不设固定起订量。数量不设门槛，先说清用途与场合，我们按项目给出合适的规模建议。',
  },
  {
    q: '可以定制企业 Logo 与品牌元素吗？',
    a: '可以。轻量规格配企业 Logo 卡片；定制规格可调整图案、尺寸与包装。请在设计稿或品牌资料确认后再进入打样。',
  },
  {
    q: '手写件会不会存在笔迹差异？',
    a: '会。全部由人手逐份落笔，自然存在笔迹差异，这是该品类的基本工艺特征，不视为质量问题。需要完全一致的呈现，请提前说明。',
  },
  {
    q: '可以先打样再批量吗？',
    a: '可以。先看实物样或效果图，确认后再进入批量。打样的范围、费用与时间在开始前告知。',
  },
  {
    q: '可以分地址寄送给收礼人吗？',
    a: '可以。按贵司提供的名单分地址寄送至收礼人本人，包裹内不含价格单据。名单可提供 Excel 表格。',
  },
  {
    q: '发票怎么处理？',
    a: '支持增值税普通发票与专用发票。开具专票需提供公司全称、纳税人识别号、地址电话与开户行账号。',
  },
  {
    q: '交付需要多久？',
    a: '常规总量 25–45 个工作日，含打样环节。如有明确的时间节点，请在需求表中写明，我们优先评估可行性；无法满足会直接答复，不延误贵司另行安排。',
  },
];

const breadcrumbName = '商务伴手礼';
---

<BusinessDetailPage
  name={breadcrumbName}
  nameEn="Corporate Gifting"
  tagline="面向批量答谢场合的手写礼品，可定制企业标识，支持分地址寄送。"
  facts={facts}
  seoTitle="商务伴手礼定制｜企业答谢礼与员工福利批量定制｜小民艺术"
  seoDescription="商务伴手礼定制：不设固定起订量，手写书法小品、卡笺或扇面，随附企业名义手写贺卡。支持企业 Logo 定制、增值税专票与分地址寄送，常规交付 25–45 个工作日。"
  intro={intro}
  scenarios={scenarios}
  specRows={specRows}
  cases={cases}
  faqs={faqs}
/>
