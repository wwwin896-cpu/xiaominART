---
import Layout from '../../layouts/Layout.astro';

// 企业礼赠 FAQ（T-06）：数据与 FAQPage 结构化数据同源，改这里即可，HTML 与 JSON-LD 同步更新
const faqItems: Array<{ q: string; a: string }> = [
  { q: '起订量是多少？', a: '轻量款 50 份起、定制款 100 份起、专属款 200 份起。数量不足或超出这些档位，也可以先说说情况，我们再看怎么安排。' },
  { q: '可以定制企业 Logo 和品牌元素吗？', a: '可以。轻量款配企业 Logo 卡片；定制款和专属款里，图案、尺寸、包装都能围绕你们来商量。' },
  { q: '可以先打样再批量吗？', a: '可以。先看一件实物再决定批量，打样的范围、费用和时间，我们会提前说清楚。' },
  { q: '怎么付款？可以在官网直接下单吗？', a: '企业礼赠走对公结算，不在官网在线付款。流程是：需求沟通 → 方案与报价确认 → 签订采购合同 → 对公转账。付款节点一般为「签订后预付 50%，发货前付清尾款」，具体以合同约定为准。' },
  { q: '可以开增值税发票吗？', a: '可以，支持增值税普通发票与专用发票。需要专票的话，请在沟通时提供公司全称、纳税人识别号、地址电话与开户行账号。' },
  { q: '可以分地址寄送并去掉价格单据吗？', a: '可以。收礼人的地址信息、包裹里不放价格单据——这些细节，确认方案时我们会一一安排好。' },
  { q: '交期需要多久？', a: '取决于数量、定制深度与包装。告诉我们你希望的时间，我们先判断做不做得出来；做不出来会直说，不耽误你另作安排。' },
  { q: '包装能否定制企业 VI？', a: '定制款和专属款可以讨论企业 VI 的使用范围、包装结构与印刷方式。' },
  { q: '校庆、校友会周年纪念可以做吗？', a: '可以，这是我们专门开辟的一条业务线。从校训或周年主题句出发：批量纪念小品配以学校名义的手写贺卡，重点作品带唯一编号与藏品证书，支持分地址寄送、直接到校友手上。数量参考上面的轻量款、定制款、专属款三档。' },
  { q: '没有准备好完整需求也能咨询吗？', a: '当然。场景、数量、时间，说个大概就行，剩下的我们一起理。' },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<Layout title="企业礼品定制｜商务伴手礼与书法答谢礼｜小民艺术" description="企业礼品定制与批量伴手礼：手写书法答谢礼、员工福利、会议伴手礼、开业庆典与校庆纪念礼。支持企业 Logo 定制、对公结算、开具增值税发票与分地址寄送。">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <section class="container page-head"><span class="eyebrow">Business Gifts / 企业礼赠</span><h1 class="serif">企业礼品定制，<br />从一份需求表开始。</h1><p class="hero-facts"><strong>50 份起</strong> · 手写落笔 · 可定制企业 Logo · 对公结算 · 可开专票 · 分地址寄送</p><p class="hero-timeline">交期参考：打样 5–7 个工作日，批量 15–30 个工作日</p>
    <div class="hero-cta"><a class="btn btn-primary" href="#downloads" data-event="biz_hero_download">下载采购需求表 ↓</a><a class="btn btn-ghost" href="#business-form" data-event="biz_hero_form">直接在线提交需求 →</a><button type="button" class="hero-wechat" data-wechat-open data-event="biz_hero_wechat">或加微信直接聊</button></div></section>
  <section id="downloads" class="container section biz-downloads" aria-labelledby="biz-dl-title"><div class="section-lead"><span class="eyebrow">Download / 采购需求表</span><h2 id="biz-dl-title" class="serif">填好这张表发我们，<br />省掉十几轮来回。</h2><p>九章，覆盖选品、定制、包装、开票、验收。一次填清，我们直接出方案与报价。</p></div>
    <div class="dl-grid">
      <article class="dl-card dl-primary"><span class="dl-tag">推荐</span><h3 class="serif">Word 版</h3><p>在电脑上直接填写、勾选，填完发回即可。</p><a class="btn btn-primary" href="/downloads/小民艺术-企业礼赠采购需求表.docx" download data-event="biz_dl_docx">下载 .docx ↓</a><span class="dl-meta">约 40 KB</span></article>
      <article class="dl-card"><span class="dl-tag">打印</span><h3 class="serif">PDF 版</h3><p>打印手写，或发给同事传阅后统一填写。</p><a class="btn btn-ghost" href="/downloads/小民艺术-企业礼赠采购需求表.pdf" target="_blank" rel="noopener" data-event="biz_dl_pdf">下载 .pdf →</a><span class="dl-meta">A4 · 2 页</span></article>
      <article class="dl-card"><span class="dl-tag">网页</span><h3 class="serif">在线打印版</h3><p>不想下载？打开就能打印或存成 PDF。</p><a class="btn btn-ghost" href="/downloads/小民艺术-企业礼赠采购需求表.html" target="_blank" rel="noopener" data-event="biz_dl_print">打开网页版 →</a><span class="dl-meta">免下载</span></article>
    </div>
    <p class="dl-note">填好发到 <a href="mailto:hi@xiaominart.com" data-event="biz_dl_email">hi@xiaominart.com</a> 或微信发回均可。<strong>我们 2 个工作日内回复方案与报价。</strong>不想填表也行 —— <button type="button" class="dl-inline-btn" data-wechat-open data-wechat-source="downloads" data-event="biz_dl_wechat">加微信直接聊</button>，说清场景、数量、时间三件事就能开工。</p></section>
  <section class="container section biz-timeline" aria-labelledby="biz-timeline-title"><div class="section-lead"><span class="eyebrow">Lead time / 交付周期</span><h2 id="biz-timeline-title" class="serif">要多久，<br />给你个确切数。</h2><p>下面是从确认到收货的常规节奏。赶特定日期请提前说明。</p></div>
    <div class="timeline-table" role="table" aria-label="企业礼赠各环节参考周期">
      <div class="tl-row tl-head" role="row"><span role="columnheader">环节</span><span role="columnheader">参考时长</span><span role="columnheader">说明</span></div>
      <div class="tl-row" role="row"><span role="cell" data-label="环节">方案与报价</span><span role="cell" data-label="参考时长">2 个工作日内</span><span role="cell" data-label="说明">收到需求表或表单后开始计时</span></div>
      <div class="tl-row" role="row"><span role="cell" data-label="环节">打样确认</span><span role="cell" data-label="参考时长">5–7 个工作日</span><span role="cell" data-label="说明">实物样或效果图。打样费在开始前告知</span></div>
      <div class="tl-row" role="row"><span role="cell" data-label="环节">批量创作与包装</span><span role="cell" data-label="参考时长">15–30 个工作日</span><span role="cell" data-label="说明">手写件逐件落笔，数量大取上限</span></div>
      <div class="tl-row" role="row"><span role="cell" data-label="环节">配送</span><span role="cell" data-label="参考时长">3–7 个工作日</span><span role="cell" data-label="说明">保价配送，可按名单分地址寄送</span></div>
    </div>
    <p class="timeline-note">常规总量约 <strong>25–45 个工作日</strong>（含打样）。时间紧的请在咨询时直接说期望日期，我们先判断做不做得出，做不出会直说。</p></section>
  <section class="container section biz-directions" aria-labelledby="biz-dir-title"><div class="section-lead"><span class="eyebrow">Corporate Gifting / 企业礼赠</span><h2 id="biz-dir-title" class="serif">四条产品线，<br />按你的场合选。</h2><p>不确定选哪条也没关系，填表时说明场景，我们帮你归位。</p></div>
    <nav class="scene-nav" aria-labelledby="scene-nav-title"><h3 id="scene-nav-title" class="scene-nav-title">你们这次，属于哪一种？</h3><ul>
      <li><a href="#gifts" data-event="biz_scene_nav"><span class="mono">01</span><strong>要送出去的一批礼</strong><small>客户答谢 · 节日福利 · 会议伴手礼</small></a></li>
      <li><a href="#keep" data-event="biz_scene_nav"><span class="mono">02</span><strong>要留很多年的一件纪念</strong><small>周年 · 开业 · 里程碑</small></a></li>
      <li><a href="#space" data-event="biz_scene_nav"><span class="mono">03</span><strong>要挂进空间的一句话</strong><small>前台 · 会客区 · 办公室</small></a></li>
      <li><a href="#campus" data-event="biz_scene_nav"><span class="mono">04</span><strong>学校的一次纪念日</strong><small>校庆 · 校友会周年 · 毕业</small></a></li>
    </ul></nav>
    <div class="dir-list">
    <article id="gifts" class="dir-item"><span class="mono dir-no">01</span><div><h3 class="serif">商务伴手礼</h3><p>装裱小品、卡笺或扇面，配一张以企业名义手写的贺卡。适合量大、需逐份送达的场合。</p><span class="dir-scenes">50 份起 · 客户答谢 · 节日礼盒 · 活动签到 · 员工福利</span></div></article>
    <article id="keep" class="dir-item"><span class="mono dir-no">02</span><div><h3 class="serif">庆典墨宝礼</h3><p>把企业自己的那句话写成书法原作，每幅带唯一编号与藏品证书。</p><span class="dir-scenes">100 份起 · 周年纪念 · 开业题字 · 里程碑</span></div></article>
    <article id="space" class="dir-item"><span class="mono dir-no">03</span><div><h3 class="serif">空间书法礼</h3><p>按空间尺度、光线与气质写字装裱，挂在前台、会客区或走廊。</p><span class="dir-scenes">按空间定 · 前台 · 会客空间 · 走廊 · 办公室</span></div></article>
    <article id="campus" class="dir-item"><span class="mono dir-no">04</span><div><h3 class="serif">校园纪念礼</h3><p>校训或周年主题句写成书法。批量纪念小品配学校名义的手写贺卡，重点作品带编号与藏品证书，可直接寄到校友手上。</p><span class="dir-scenes">50 份起 · 校庆 · 校友会周年 · 校训题写 · 毕业纪念</span></div></article>
  </div></section>
  <section class="container plans"><article><span class="mono">01</span><span class="eyebrow">Light / 轻量款</span><h2 class="serif">标准字样，<br />配手写卡片。</h2><strong>50 份起</strong><p>会议伴手礼、节日慰问、首次合作。</p></article><article><span class="mono">02</span><span class="eyebrow">Custom / 定制款</span><h2 class="serif">图案尺寸包装，<br />围着场景做。</h2><strong>100 份起</strong><p>客户答谢、员工福利、品牌活动。</p></article><article><span class="mono">03</span><span class="eyebrow">Bespoke / 专属款</span><h2 class="serif">为一件大事，<br />专写一件。</h2><strong>200 份起</strong><p>周年、开业、重要合作，从企业那句话出发。</p></article></section>
  <section class="container section business-faq"><span class="eyebrow">Corporate FAQ / 企业礼赠 FAQ</span><h2 class="serif">先把话说在前面。</h2><div class="faq-grid">{faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
  <section class="container mid-cta"><p>看到这里，如果大方向合适——</p><div class="mid-cta-actions"><a class="btn btn-primary" href="#downloads" data-event="biz_mid_download">下载采购需求表 ↓</a><a class="btn btn-ghost" href="#business-form" data-event="biz_mid_form">在线提交需求 →</a><button type="button" class="btn-ghost" data-wechat-open data-wechat-source="mid-cta" data-event="biz_mid_wechat">加微信直接聊</button></div></section>
  <section class="container section biz-process" aria-labelledby="biz-process-title"><div class="section-lead"><span class="eyebrow">How we work / 合作方式</span><h2 id="biz-process-title" class="serif">六步，<br />每步给你确切答复。</h2></div>
    <ol class="process-list">
      <li><span class="mono">01</span><div><h3 class="serif">需求沟通</h3><p>填表或加微信，说清场景、数量、时间。</p></div></li>
      <li><span class="mono">02</span><div><h3 class="serif">方案与报价</h3><p>2 个工作日内给方案与报价单。</p></div></li>
      <li><span class="mono">03</span><div><h3 class="serif">打样确认</h3><p>看实物样或效果图，确认后再开工。</p></div></li>
      <li><span class="mono">04</span><div><h3 class="serif">签约与对公结算</h3><p>签合同后对公转账，可开普票或专票。</p></div></li>
      <li><span class="mono">05</span><div><h3 class="serif">创作与交付</h3><p>保价配送，可按名单分地址寄送。</p></div></li>
      <li><span class="mono">06</span><div><h3 class="serif">售后与补件</h3><p>运输破损免费补发，创作瑕疵协商修改。</p></div></li>
    </ol></section>
  <section class="container section biz-trust" aria-labelledby="biz-trust-title"><div class="section-lead"><span class="eyebrow">With whom / 合作对象</span><h2 id="biz-trust-title" class="serif">我们把名字，<br />留给愿意署名的人。</h2><p>企业礼赠涉及客户的品牌与场合，作品与案例的公开，一律以对方书面授权为前提。有授权的合作记录，会陆续放在这里——在此之前，我们不用任何无从核实的数字来说明自己。</p></div>
    <div class="trust-placeholder"><p class="trust-placeholder-zh">合作案例与伙伴名单，将随授权陆续公开。</p><p class="trust-placeholder-en" lang="en">Case studies and partner names are published only with written permission.</p><a class="trust-placeholder-link" href="#business-form" data-event="biz_trust_to_form">想了解我们做过的类似场景？直接说，我们当面聊 →</a></div></section>
  <section id="business-form" class="container section business-form"><div class="form-aside"><span class="eyebrow">Business needs / 企业项目需求</span><h2 class="serif">或者，<br />直接在线提交。</h2><p>填这一页表单也可以，说个大概就行。想一次说全，就下载需求表。</p>
    <div class="aside-dl"><p class="aside-dl-title">要填得更细？</p><a href="/downloads/小民艺术-企业礼赠采购需求表.docx" download data-event="biz_form_dl_docx">下载采购需求表（Word）↓</a><a href="/downloads/小民艺术-企业礼赠采购需求表.pdf" target="_blank" rel="noopener" data-event="biz_form_dl_pdf">下载 PDF 版</a><button type="button" data-wechat-open data-wechat-source="form-aside" data-event="biz_form_wechat">加微信直接聊</button></div></div><form data-business-form><label>公司名称 / Company<input name="company" required /></label><label>联系人与联系方式 / Contact<input name="contact" required placeholder="微信优先，邮箱或手机号备选" /></label><label>预算范围 / Budget<select name="budget"><option>尚未确定 / To be discussed</option><option>¥5,000 以下 / Under 5k</option><option>¥5,000–20,000</option><option>¥20,000–50,000</option><option>¥50,000 以上 / Above 50k</option></select></label><label>预计数量 / Quantity<select name="quantity"><option>50 份起</option><option>100 份起</option><option>200 份起</option><option>尚未确定</option></select></label><label>用途场景 / Use case<select name="scene"><option>客户答谢</option><option>员工福利</option><option>会议礼品</option><option>开业庆典</option><option>节日慰问</option><option>校庆/校友会纪念</option><option>其他</option></select></label><label>期望交付时间 / Timeline<input name="timeline" placeholder="例如：2026 年 12 月前" /></label><label>开票需求 / Invoice<select name="invoice"><option>尚未确定 / To be discussed</option><option>增值税普通发票</option><option>增值税专用发票</option><option>不需要发票</option></select></label><label>项目说明 / Brief<textarea name="brief" rows="4" placeholder="品牌背景、希望表达的文化、包装想法等"></textarea></label><label class="honeypot-field" aria-hidden="true">网址 / Website<input name="website" tabindex="-1" autocomplete="off" class="honeypot" /></label><button class="btn btn-primary" type="submit">把需求发给我们 →</button><p class="form-note" data-form-status role="status" aria-live="polite">走对公结算，不在官网在线付款。<strong>2 个工作日内回复。</strong></p></form></section>
</Layout>
<script>
  import { submitLead, isHoneypotFilled, CONTACT_FALLBACK, successHtml } from '../../scripts/cloud-forms';
  const form = document.querySelector<HTMLFormElement>('[data-business-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !submitButton) return;
      if (isHoneypotFilled(form)) { status.textContent = '企业需求已收到，我们会尽快回复。'; return; }
      const data = new FormData(form);
      const pick = (key: string) => String(data.get(key) || '').trim();
      const company = pick('company');
      const contact = pick('contact');
      if (!company || !contact) { status.textContent = '请补全公司名称与联系方式后再提交。'; return; }
      submitButton.disabled = true;
      status.textContent = '正在提交…';
      const result = await submitLead('business_gift', company, contact, {
        budget: pick('budget'),
        quantity: pick('quantity'),
        scene: pick('scene'),
        timeline: pick('timeline'),
        invoice: pick('invoice'),
        brief: pick('brief'),
        page: window.location.pathname,
        referrer: document.referrer || null,
      });
      submitButton.disabled = false;
      if (result.ok) {
        // B3：企业需求回复周期更长，成功态必须写明时限，避免对方反复追问
        // innerHTML 用于渲染带结构的成功卡；入参为本行写死的字面量，非用户输入
        status.innerHTML = successHtml('<strong>两个工作日内</strong>我们会通过你留下的联系方式回复。', '如果时间比较紧，可以在微信里补一句期望日期，我们会优先看。');
        form.reset();
      } else {
        status.textContent = `提交失败，请稍后重试；${CONTACT_FALLBACK}`;
      }
    });
  }
</script>
<style>
  .page-head { padding: 90px 0 66px; } .page-head h1 { font-size: clamp(30px, 4vw, 52px); line-height: 1.3; font-weight: 500; margin: 20px 0; } .page-head p { max-width: 710px; color: var(--ink-soft); font-size: 18px; } .page-head p[lang='en'] { font: 24px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); } .page-head .btn { margin-top: 18px; }
  /* 首屏事实行（2026-10-15 重做）：B 端采购第一眼要的是「起订量 / 能不能开票 / 怎么结算」，
     而不是抒情文案。把六个硬信息压成一行，扫一眼就够。 */
  .hero-facts { font-size: 15px; line-height: 2; color: var(--ink) !important; letter-spacing: .02em; }
  .hero-facts strong { color: var(--cinnabar-deep); font-weight: 600; }
  .hero-timeline { font-size: 14px !important; color: var(--muted) !important; margin-top: -6px; }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 26px; }
  .hero-cta .btn { margin-top: 0; }
  .hero-wechat { padding: 0; border: 0; background: transparent; color: var(--cinnabar-deep); font: inherit; font-size: 14px; cursor: pointer; border-bottom: 1px solid var(--cinnabar); }
  .btn-ghost { display: inline-block; padding: 12px 22px; border: 1px solid var(--ink); background: transparent; color: var(--ink); font: inherit; font-size: 14px; cursor: pointer; }
  .btn-ghost:hover { background: var(--ink); color: var(--paper-light); }
  /* 下载区（2026-10-15 新增）：业主提供采购需求表，让采购商自行下载填写再回传，
     免去逐条问答的往返。三张卡覆盖三类人：要正式流程的 / 要打印传阅的 / 想先聊的。 */
