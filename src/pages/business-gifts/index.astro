---
import Layout from '../../layouts/Layout.astro';

/**
 * 企业礼赠主页。
 *
 * 2026-10-15 按业主五条意见重写：
 *   ① 下载入口由 8 处收敛到 2 处，且只保留 DOCX 一种格式
 *   ② 文案全面改为商务书面语 —— B 端采购商是筛选者与决策者，不是文艺读者
 *   ③ 结构按采购决策链条重排，删除场景导航 / 页中转化条 / 六步流程等冗余区块
 *   ④ 删除「不对公结算、不在官网在线付款」类向访客解释内部收付款规则的表述
 *      （保留「对公结算」作为能力关键词 —— 它是采购商的筛选条件，不是流程说明）
 *   ⑤ 明确反馈机制：提交后多久回复、通过什么渠道回复
 *
 * 副产品（业主同日追加要求）：四条产品线各自有独立详情页，
 * 因为 GEO 准则要求每条业务线独立可寻址（AI 助手需要能指到具体 URL）。
 */

// FAQ：与页面展示同源。⚠️ 已删除原「怎么付款？可以在官网直接下单吗？」一条 ——
// 该问答向访客解释了内部收付款规则，属于合同条款范畴，不应出现在官网。
const faqItems: Array<{ q: string; a: string }> = [
  { q: '起订量是多少？', a: '不设固定起订量。按项目、场合与预算一起评估——先说清用途与大致数量即可，我们会给出合适的方案规模。' },
  { q: '可以定制企业 Logo 与品牌元素吗？', a: '可以。轻量规格配企业 Logo 卡片；定制规格可调整图案、尺寸与包装。需在设计稿确认后再进入打样。' },
  { q: '可以先打样再批量吗？', a: '可以。先看实物样或效果图，确认后再进入批量。打样的范围、费用与时间在开始前告知。' },
  { q: '可以开具增值税发票吗？', a: '可以，支持增值税普通发票与专用发票。开具专票需提供公司全称、纳税人识别号、地址电话与开户行账号。' },
  { q: '可以分地址寄送吗？包裹里会放价格单据吗？', a: '可以分地址寄送至收礼人本人，包裹内不含价格单据。名单请提供 Excel 表格（收件人、地址、联系方式），我们按表核对后分批交付。' },
  { q: '交付需要多久？', a: '常规总量 25–45 个工作日（含打样）。如贵司有明确的时间节点，请在需求表中写明，我们优先评估可行性；无法满足会直接答复，以便贵司另行安排。' },
  { q: '包装可以定制企业 VI 吗？', a: '可以。包装结构、材质与印刷方式可在方案阶段按企业 VI 要求确定，需以设计稿确认后再进入制作。' },
  { q: '校庆、校友会周年纪念可以承接吗？', a: '可以，这是我们单独设立的一条业务线。从校训或周年主题句出发，批量纪念小品配以学校名义手写的贺卡，重点作品带唯一编号与藏品证书，支持按校友名单分地址寄送。校方如需走招标或政府采购流程，我们可配合提供所需材料。' },
  { q: '手写件会有笔迹差异吗？', a: '会有。全部由人手逐份落笔，自然存在笔迹差异，这是该品类的基本工艺特征，不视为质量问题。需要完全一致的呈现，请提前说明。' },
  { q: '需求还不完整，可以先沟通吗？', a: '可以。场景、数量、时间三项有初步方向即可提交，其余部分我们协助梳理。' },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// 四条业务线 —— 各自链接到独立详情页（GEO 要求独立可寻址）
//
// 2026-10-31 业主修订（两条指令）：
//   ① 业务线口径改为：商务伴手礼 / 校庆纪念 / 年会礼品 / 会客空间
//   ② 全面去除起订量（原「50 份起」「100 份起」）——
//      业主判断：起订量门槛会把还在评估阶段的采购需求直接拒之门外，
//      削弱「先聊起来」的意愿。故 facts 只保留能力项，数量留到需求沟通时再谈。
//   ⚠️ URL 不变（/gifts/ /keep/ /space/ /campus/）——四个页面均已被搜索引擎
//      收录，换地址等于把积累推倒；只换展示名与文案，
//      「庆典墨宝礼」→「年会礼品」沿用 keep 页（本就是周年/里程碑场景），
//      「空间书法礼」→「会客空间」沿用 space 页（本就是前台/会客区场景）——
//      名称更贴采购方的搜索词，页面内容本来就是讲这两件事。
const businessLines = [
  {
    id: 'gifts',
    no: '01',
    name: '商务伴手礼',
    href: '/business-gifts/gifts/',
    desc: '装裱小品、卡笺或扇面，配以企业名义手写的贺卡。适用于客户答谢、员工福利、会议与活动赠礼。',
    facts: '可定制 Logo · 可开专票 · 分地址寄送',
  },
  {
    id: 'campus',
    no: '02',
    name: '校庆纪念',
    href: '/business-gifts/campus/',
    desc: '面向校庆、校友会周年与毕业季。校训或周年主题句写成书法，支持按校友名单分地址寄送。',
    facts: '重点作品带编号 · 可配合招标 · 分地址寄送',
  },
  {
    id: 'keep',
    no: '03',
    name: '年会礼品',
    href: '/business-gifts/keep/',
    desc: '把企业自己的那句话写成书法原作，每幅带唯一编号与藏品证书。适用于年会表彰、周年纪念与里程碑。',
    facts: '书法原作 · 唯一编号 · 附藏品证书',
  },
  {
    id: 'space',
    no: '04',
    name: '会客空间',
    href: '/business-gifts/space/',
    desc: '按空间尺度、光线与气质定制书法装置，含装裱方案与安装建议。适用于前台、会客区与走廊。',
    facts: '按空间定尺寸 · 含勘测 · 可配合设计方',
  },
];
---

<Layout
  title="企业礼品定制｜商务伴手礼与书法答谢礼批量定制｜小民艺术"
  description="企业礼品定制与批量伴手礼：手写书法答谢礼、员工福利、会议伴手礼、年会礼品与校庆纪念。不设固定起订量，支持企业 Logo 定制、对公结算、增值税专票与分地址寄送，常规交付 25–45 个工作日。"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- ① 首屏：只给采购决策需要的硬条件 -->
  <section class="container page-head">
    <span class="eyebrow">Business Custom / 企业定制</span>
    <h1 class="serif">企业礼品定制</h1>
    <p class="hero-lead">手写书法礼品批量定制，面向企业答谢、庆典纪念与校园活动。可定制企业标识，支持对公结算与分地址寄送。</p>
    <dl class="hero-conditions">
      <div><dt>起订</dt><dd>不设固定量 · 按项目评估</dd></div>
      <div><dt>定制范围</dt><dd>企业 Logo · 内容 · 尺寸 · 包装</dd></div>
      <div><dt>交付周期</dt><dd>常规 25–45 个工作日（含打样）</dd></div>
      <div><dt>结算与发票</dt><dd>对公结算 · 可开增值税专票</dd></div>
    </dl>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/downloads/小民艺术-企业礼赠采购需求表.docx" download data-event="biz_hero_dl">下载采购需求表 ↓</a>
      <a class="btn btn-ghost" href="#business-form" data-event="biz_hero_form">在线提交采购需求 →</a>
    </div>
  </section>

  <!-- ② 业务范围：帮采购商判断自己属于哪一类 -->
  <section class="container section biz-lines" aria-labelledby="biz-lines-title">
    <div class="section-lead">
      <span class="eyebrow">Business Lines / 业务范围</span>
      <h2 id="biz-lines-title" class="serif">四条业务线</h2>
      <p>按采购标的区分。点击可查看各业务线的规格条件与过往项目。</p>
    </div>
    <div class="line-list">
      {
        businessLines.map((line) => (
          <article class="line-item">
            <span class="mono line-no">{line.no}</span>
            <div class="line-body">
              <h3 class="serif"><a href={line.href} data-event="biz_line_nav">{line.name}</a></h3>
              <p>{line.desc}</p>
              <span class="line-facts">{line.facts}</span>
            </div>
            <a class="line-more" href={line.href} aria-label={`查看${line.name}详情`} data-event="biz_line_nav_more">查看详情 →</a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ③ 采购规格：三档对应的场合与数量 -->
  <section class="container plans" aria-labelledby="plans-title">
    <div class="plans-head">
      <span class="eyebrow">Specification Tiers / 采购规格</span>
      <h2 id="plans-title" class="serif">三档规格</h2>
    </div>
    <div class="plans-grid">
      <article>
        <span class="mono">01</span>
        <span class="eyebrow">Light / 轻量规格</span>
        <h3 class="serif">标准字样，配企业 Logo 卡片</h3>
        <strong>按项目评估</strong>
        <p>会议伴手礼、节日福利、首次合作。</p>
      </article>
      <article>
        <span class="mono">02</span>
        <span class="eyebrow">Custom / 定制规格</span>
        <h3 class="serif">图案、尺寸与包装按场合定制</h3>
        <strong>按项目评估</strong>
        <p>客户答谢、员工福利、品牌活动。</p>
      </article>
      <article>
        <span class="mono">03</span>
        <span class="eyebrow">Bespoke / 专属规格</span>
        <h3 class="serif">内容与形制完全按项目定制</h3>
        <strong>按项目评估</strong>
        <p>周年纪念、开业庆典、重要合作。</p>
      </article>
    </div>
  </section>

  <!-- ④ 采购需求表：全页唯一的下载入口 -->
  <section id="downloads" class="container section biz-download" aria-labelledby="biz-dl-title">
    <div class="section-lead">
      <span class="eyebrow">Purchase Brief / 采购需求表</span>
      <h2 id="biz-dl-title" class="serif">采购需求表</h2>
      <p>填写后发送至我们，即可获得方案与报价。含选品、定制、包装、开票与验收等内容，一次填写完毕，减少往返确认。</p>
    </div>
    <div class="dl-box">
      <div class="dl-file">
        <span class="dl-format">DOCX</span>
        <div>
          <strong>企业礼赠采购需求表</strong>
          <span class="dl-meta">Word 文档 · 约 40 KB · 可在电脑上直接填写勾选</span>
        </div>
      </div>
      <a class="btn btn-primary" href="/downloads/小民艺术-企业礼赠采购需求表.docx" download data-event="biz_dl_docx">下载采购需求表 ↓</a>
    </div>
    <div class="dl-return">
      <h3>填写后如何提交</h3>
      <ul>
        <li>发送至邮箱 <a href="mailto:hi@xiaominart.com" data-event="biz_dl_email">hi@xiaominart.com</a></li>
        <li>或通过微信发送给对接人</li>
      </ul>
      <p class="dl-sla"><strong>收到后 2 个工作日内</strong>，我们回复方案与报价。若需求信息不完整，我们会先就已明确的部分给出初步方案，并列出需要补充确认的内容。</p>
    </div>
  </section>

  <!-- ⑤ 合作流程：一行说明，不让客户逐条对照 -->
  <section class="container section biz-flow" aria-labelledby="biz-flow-title">
    <div class="section-lead">
      <span class="eyebrow">Process / 合作流程</span>
      <h2 id="biz-flow-title" class="serif">合作流程</h2>
    </div>
    <ol class="flow-inline">
      <li>提交采购需求</li>
      <li>2 个工作日内回复方案与报价</li>
      <li>打样确认</li>
      <li>签订采购合同</li>
      <li>批量创作与交付</li>
    </ol>
    <p class="flow-note">交付后如遇运输破损，我们免费补发；创作瑕疵可协商修改。</p>
  </section>

  <!-- ⑥ 常见问题 -->
  <section class="container section business-faq" aria-labelledby="faq-title">
    <span class="eyebrow">FAQ / 常见问题</span>
    <h2 id="faq-title" class="serif">常见问题</h2>
    <div class="faq-grid">
      {faqItems.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ⑦ 在线提交：即时反馈机制在此 -->
  <section id="business-form" class="container section business-form">
    <div class="form-aside">
      <span class="eyebrow">Purchase Request / 采购需求</span>
      <h2 class="serif">在线提交采购需求</h2>
      <p>若不便下载表格，可直接填写本表单。信息有初步方向即可，其余部分我们协助梳理。</p>
      <div class="form-sla">
        <strong>提交后即时确认</strong>
        <span>表单提交成功后，页面会立即显示确认信息。我们将在 2 个工作日内通过您留下的联系方式回复方案与报价。</span>
      </div>
    </div>
    <form data-business-form>
      <label>公司 / 机构名称<input name="company" required /></label>
      <label>联系人与联系方式<input name="contact" required placeholder="手机、邮箱或微信号" /></label>
      <label>预算范围
        <select name="budget">
          <option>尚未确定</option>
          <option>¥5,000 以下</option>
          <option>¥5,000–20,000</option>
          <option>¥20,000–50,000</option>
          <option>¥50,000 以上</option>
        </select>
      </label>
      <label>预计数量
        <select name="quantity">
          <option>尚未确定</option>
          <option>20 份以内</option>
          <option>20–50 份</option>
          <option>50–200 份</option>
          <option>200 份以上</option>
        </select>
      </label>
      <label>用途场景
        <select name="scene">
          <option>客户答谢</option>
          <option>员工福利</option>
          <option>会议礼品</option>
          <option>开业庆典</option>
          <option>周年纪念</option>
          <option>节日慰问</option>
          <option>校庆/校友会纪念</option>
          <option>其他</option>
        </select>
      </label>
      <label>期望交付时间<input name="timeline" placeholder="例如：2026 年 12 月前" /></label>
      <label>开票需求
        <select name="invoice">
          <option>尚未确定</option>
          <option>增值税普通发票</option>
          <option>增值税专用发票</option>
          <option>不需要发票</option>
        </select>
      </label>
      <label>项目说明<textarea name="brief" rows="4" placeholder="品牌背景、使用场合、包装要求等"></textarea></label>
      <label class="honeypot-field" aria-hidden="true">网址<input name="website" tabindex="-1" autocomplete="off" class="honeypot" /></label>
      <button class="btn btn-primary" type="submit">提交采购需求 →</button>
      <p class="form-note" data-form-status role="status" aria-live="polite">提交后页面会即时显示确认信息，我们将在 2 个工作日内回复方案与报价。</p>
    </form>
  </section>
</Layout>

<script>
  import { submitLead, isHoneypotFilled, CONTACT_FALLBACK, successHtml } from '../../scripts/cloud-forms';
  const form = document.querySelector<HTMLFormElement>('[data-business-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      if (isHoneypotFilled(form)) return;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      status.dataset.state = 'pending';
      status.innerHTML = '正在提交…';
      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      // submitLead(formType, name, contact, payload) —— name/contact 单独取出，
      // 其余字段作为 payload 原样上报，便于在后台按字段筛选线索。
      const outcome = await submitLead('business_gift', data.company ?? '', data.contact ?? '', {
        budget: data.budget ?? '',
        quantity: data.quantity ?? '',
        scene: data.scene ?? '',
        timeline: data.timeline ?? '',
        invoice: data.invoice ?? '',
        brief: data.brief ?? '',
        source: 'business-gifts',
      });
      if (outcome.ok) {
        status.dataset.state = 'success';
        status.innerHTML = successHtml(
          '需求已收到。我们将在 2 个工作日内通过您留下的联系方式回复方案与报价。',
          '如需补充材料或说明时间节点，可直接回复确认信息中的联系方式。',
        );
        form.reset();
      } else {
        status.dataset.state = 'error';
        status.innerHTML = successHtml(outcome.message ?? '提交未能完成，请稍后重试。', CONTACT_FALLBACK);
      }
      if (button) button.disabled = false;
    });
  }
</script>

<style>
  /* 首屏 */
  .hero-lead {
    max-width: 640px;
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.9;
    color: var(--ink-soft);
  }
  .hero-conditions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    max-width: 760px;
    margin: 30px 0 0;
    border-top: 1px solid var(--line);
  }
  .hero-conditions > div {
    padding: 16px 20px 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .hero-conditions > div:nth-child(2n) {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .hero-conditions dt {
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .hero-conditions dd {
    margin: 6px 0 0;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 28px;
  }
  .hero-actions .btn {
    margin-top: 0;
  }

  /* 业务线列表 */
  .line-list {
    border-top: 1px solid var(--line);
  }
  .line-item {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 24px;
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--line);
  }
  .line-no {
    font-size: 13px;
    color: var(--muted);
    padding-top: 4px;
  }
  .line-body h3 {
    margin: 0 0 8px;
    font-size: 21px;
  }
  .line-body h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .line-body h3 a:hover {
    color: var(--cinnabar-deep);
  }
  .line-body p {
    margin: 0 0 12px;
    max-width: 620px;
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-soft);
  }
  .line-facts {
    display: block;
    font-size: 13px;
    color: var(--cinnabar-deep);
    letter-spacing: 0.02em;
  }
  .line-more {
    padding-top: 4px;
