---
/**
 * 庆典墨宝礼详情页。
 *
 * 定位：把企业自己的那句话写成书法原作，每幅带唯一编号与藏品证书。
 * 适用：周年纪念、开业题字、里程碑纪念等「需要留存多年」的场合。
 */
import BusinessDetailPage from '../../components/BusinessDetailPage.astro';

const facts = [
  '100 份起订',
  '书法原作，非印刷',
  '每幅唯一编号',
  '附藏品证书',
  '可定制题字内容',
];

const intro = [
  '庆典墨宝礼用于需要长期留存与展示的纪念场合。做法是把贵司自己的那句话 —— 企业理念、周年主题、开业祝辞 —— 写成书法原作，而非套用通用字样。',
  '每幅作品带唯一编号，并附藏品证书，记录作品名称、书写时间与编号信息。编号可与贵司的内部存档对应，便于日后查验与追溯。',
  '相比批量伴手礼，本业务线的重点在「内容独有」而非「数量铺开」。因此我们通常建议先确认题字内容与书写规格，再进入批量环节。',
];

const scenarios = [
  '企业周年纪念（10 周年、20 周年等节点）',
  '开业题字与揭牌纪念',
  '重大合作与战略签约纪念',
  '集团里程碑与表彰',
  '新址落成与空间启幕',
];

const specRows = [
  { label: '起订量', value: '100 份起。若为单件或多件收藏级作品，请按定制创作提交需求，走另一条业务线。' },
  { label: '作品形式', value: '书法原作。规格、形制与装裱方式可在方案阶段确定。' },
  { label: '题字内容', value: '由贵司提供内容（企业理念、周年主题、祝辞等），我们判断书写可行性并给出建议。内容确认后方进入创作。' },
  { label: '编号与证书', value: '每幅作品带唯一编号，附藏品证书，记录作品名称、书写时间与编号。编号可对应贵司内部存档。' },
  { label: '包装', value: '常规含保护性包装。需企业 VI 定制包装的，请在设计稿确认后安排。' },
  { label: '交付周期', value: '方案与报价 2 个工作日内；题字与版式确认 3–5 个工作日；打样 5–7 个工作日；批量创作与包装 20–35 个工作日；配送 3–7 个工作日。' },
  { label: '寄送方式', value: '保价配送。可按名单分地址寄送，或统一交付至贵司指定地点。' },
  { label: '结算与发票', value: '支持对公结算，可开具增值税普通发票或专用发票。具体条款以双方合同为准。' },
  { label: '打样', value: '先出题字样稿，确认书写风格与版式后再进入批量。' },
];

const cases = [
  {
    title: '某集团 · 二十周年纪念',
    clientType: '集团企业 · 周年纪念',
    facts: ['150 份', '书法原作', '唯一编号 + 证书'],
    body: '以集团周年主题句为书写内容，统一形制与装裱。每幅带唯一编号与藏品证书，交付时附编号对照表，便于集团内部存档。',
    image: '/assets/stories/story-niaochong-hengjuan-600.webp',
    alt: '周年纪念书法作品示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
  {
    title: '某文化机构 · 新址启幕题字',
    clientType: '文化机构 · 开业题字',
    facts: ['单件收藏 + 120 份纪念小品', '定制题字', '分地址寄送'],
    body: '主体作品为新址题字，另制备一批纪念小品用于来宾赠礼。主体作品按收藏级处理，纪念小品走批量流程，分批交付。',
    image: '/assets/stories/story-shanmian-biankuang-600.webp',
    alt: '开业题字与纪念小品示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
];

const faqs = [
  {
    q: '题字内容由谁确定？',
    a: '由贵司提供内容方向，我们判断书写可行性与版式方案。内容在确认后方进入创作，避免批量完成后需要返工。',
  },
  {
    q: '每幅作品的编号是怎么编的？',
    a: '按项目统一编号，每幅唯一。编号与作品名称、书写时间一并记入藏品证书。编号规则可与贵司内部存档体系对应。',
  },
  {
    q: '藏品证书是什么？',
    a: '随作品提供的书面凭证，记录作品名称、书写时间与唯一编号。用于贵司内部存档与日后查验。',
  },
  {
    q: '可以做企业 Logo 吗？',
    a: '可以。Logo 的呈现方式（印章、题识、包装印刷等）在方案阶段确定，需以设计稿确认后再进入制作。',
  },
  {
    q: '单件作品也接吗？',
    a: '单件或多件收藏级作品属于定制创作业务，不走本批量流程。可在定制创作页提交意向，我们按该流程处理。',
  },
  {
    q: '交付需要多久？',
    a: '含题字确认、打样与批量创作，常规 30–50 个工作日。周年与开业通常有固定日期，建议在需求表中写明并尽早启动。',
  },
];

const breadcrumbName = '庆典墨宝礼';
---

<BusinessDetailPage
  name={breadcrumbName}
  nameEn="Commemorative Calligraphy"
  tagline="把企业自己的那句话写成书法原作，每幅带唯一编号与藏品证书。"
  facts={facts}
  seoTitle="庆典墨宝礼定制｜企业周年纪念与开业题字书法原作｜小民艺术"
  seoDescription="庆典墨宝礼定制：把企业理念或周年主题写成书法原作，100 份起订，每幅带唯一编号与藏品证书。适用于企业周年、开业题字与里程碑纪念，支持对公结算与分地址寄送。"
  intro={intro}
  scenarios={scenarios}
  specRows={specRows}
  cases={cases}
  faqs={faqs}
/>
