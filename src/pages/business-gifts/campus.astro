---
/**
 * 校园纪念礼详情页。
 *
 * ⚠️ 业主 2026-10-15 明确：「学校也是企业，校庆的人已经参加工作了，懂的流程。」
 *    → 因此本页**不采用任何「校园特调」的柔和语气**，与其余三条业务线保持同一商务口吻：
 *      照常给起订量、规格、周期、开票与寄送条件。校方（校友办 / 基金会 / 校庆办）
 *      的采购流程与企业一致，甚至更规范（多需招标比价与正式发票）。
 */
import BusinessDetailPage from '../../components/BusinessDetailPage.astro';

const facts = [
  '50 份起订',
  '可定制校训与周年主题句',
  '重点作品带唯一编号',
  '可开增值税专票',
  '可直接寄达校友本人',
];

const intro = [
  '校园纪念礼服务于校庆、校友会周年、毕业季等校方主导的纪念活动。交付内容通常分两类：面向广大校友的批量纪念小品，以及用于存档与重点赠礼的收藏级作品。',
  '题写内容以校训、周年主题句或校方指定文本为主。批量纪念小品随附以校方名义手写的贺卡；重点作品带唯一编号与藏品证书，便于校方存档与日后查验。',
  '考虑到校友分布广泛，本业务线支持按校方提供的名单分地址寄送，直接寄达校友本人。名单可提供 Excel 表格，我们按表核对后分批交付。',
  '如校方需走招标、比价或政府采购流程，我们可配合提供所需资质材料与报价单格式。',
];

const scenarios = [
  '校庆纪念（整十周年、重要年份）',
  '校友会成立与周年纪念',
  '毕业季纪念赠礼',
  '校训题写与校园空间布置',
  '基金会答谢与捐赠人致谢',
];

const specRows = [
  { label: '起订量', value: '50 份起。收藏级作品按件计，不走批量流程。' },
  { label: '题写内容', value: '校训、周年主题句或校方指定文本。由校方提供内容，我们确认书写可行性并出样稿。' },
  { label: '产品形式', value: '批量纪念小品（装裱小品、卡笺等）+ 收藏级作品（单件或少量，带编号与证书）。' },
  { label: '贺卡', value: '随附以校方名义手写的贺卡，可选统一祝辞，或按校友称谓分批定制。' },
  { label: '校友名单寄送', value: '支持按校方提供的名单分地址寄送至校友本人，包裹内不含价格单据。名单请提供 Excel 表格。' },
  { label: '交付周期', value: '方案与报价 2 个工作日内；题字与版式确认 3–5 个工作日；打样 5–7 个工作日；批量创作与包装 15–30 个工作日；配送 3–7 个工作日。' },
  { label: '结算与发票', value: '支持对公结算。可开具增值税普通发票或专用发票；校方如需走招标或政府采购流程，我们配合提供所需材料与报价单格式。' },
  { label: '打样', value: '可先看实物样或效果图确认，再进入批量。打样范围、费用与时间在开始前告知。' },
  { label: '资质配合', value: '可配合校方要求提供营业执照、开票信息等材料，用于内部审批或招标流程。' },
];

const cases = [
  {
    title: '某高校 · 建校周年纪念',
    clientType: '高等院校 · 校庆纪念',
    facts: ['300 份', '校训题写 + 卡笺', '校友名单分地址寄送'],
    body: '以校训为书写内容制备批量纪念小品，随附以校方名义手写的贺卡。按校方提供的校友名单分地址寄送，覆盖多个省市。',
    image: '/assets/stories/story-xi-le-huanxi.webp',
    alt: '校庆纪念小品示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
  {
    title: '某校友会 · 成立周年纪念',
    clientType: '校友会 · 周年纪念',
    facts: ['80 份', '重点作品带编号与证书', '含捐赠人致谢卡'],
    body: '校友会周年活动使用，重点作品带唯一编号与藏品证书，用于理事会存档。另备一批致谢卡，随捐赠人名单分批寄出。',
    image: '/assets/stories/story-shou-yuanguang.webp',
    alt: '校友会周年纪念作品示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
];

const faqs = [
  {
    q: '校方走招标或政府采购流程，可以配合吗？',
    a: '可以。我们可提供营业执照、开票信息等所需材料，并按校方要求提供报价单格式。若需现场比价或提交方案文件，请提前告知时间节点。',
  },
  {
    q: '能按校友名单分地址寄送吗？',
    a: '可以。请提供 Excel 格式的名单（收件人、地址、联系方式）。我们按表核对后分批寄送，包裹内不含价格单据。',
  },
  {
    q: '题写内容由谁确定？',
    a: '由校方提供（校训、周年主题句或指定文本），我们确认书写可行性后出样稿，确认再进入批量，避免返工。',
  },
  {
    q: '收藏级作品和批量纪念小品有什么区别？',
    a: '批量纪念小品面向广大校友，规格统一、按批交付；收藏级作品按件制作，带唯一编号与藏品证书，用于校方存档或重点赠礼。两者可同项目并行。',
  },
  {
    q: '发票怎么开？',
    a: '支持增值税普通发票与专用发票。开具专票需提供单位全称、纳税人识别号、地址电话与开户行账号。',
  },
  {
    q: '校庆日期固定，交付来得及吗？',
    a: '含打样与批量创作，常规 25–45 个工作日。校庆有固定日期，建议尽早启动，并在需求表中写明节点。若无法满足会直接答复，不延误校方另行安排。',
  },
];

const breadcrumbName = '校园纪念礼';
---

<BusinessDetailPage
  name={breadcrumbName}
  nameEn="Campus Commemorative Gifts"
  tagline="校庆与校友会纪念的手写纪念礼，可按校友名单分地址寄送。"
  facts={facts}
  seoTitle="校园纪念礼定制｜校庆与校友会纪念礼品定制｜小民艺术"
  seoDescription="校园纪念礼定制：校训与周年主题句写成书法，50 份起订，重点作品带唯一编号与藏品证书。支持按校友名单分地址寄送、增值税专票，可配合校方招标与政府采购流程。"
  intro={intro}
  scenarios={scenarios}
  specRows={specRows}
  cases={cases}
  faqs={faqs}
/>
