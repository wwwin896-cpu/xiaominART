---
/**
 * 空间书法礼详情页。
 *
 * 定位：按空间尺度、光线与气质写字装裱，用于前台、会客区、走廊等固定展示位。
 * 与其余三条业务线的区别：交付物是「挂进空间的固定装置」，不是可携带的礼品。
 */
import BusinessDetailPage from '../../components/BusinessDetailPage.astro';

const facts = [
  '按空间定尺寸',
  '现场尺寸勘测',
  '含装裱与安装建议',
  '可定制内容',
  '可配合空间设计方',
];

const intro = [
  '空间书法礼交付的是固定展示于空间中的书法装置，常见于前台、会客区、会议室与走廊。与礼品类业务的区别在于：尺寸与内容必须依附于具体空间，而非先定产品再找地方挂。',
  '常规流程是先确认空间条件（墙面尺寸、层高、光线方向、周边材质与色调），再据此确定作品形制、尺寸与装裱方式。如贵司已有室内设计方，我们可与其对接尺寸与节点，避免二次返工。',
  '对于需要与建筑或室内风格协调的项目，我们建议在硬装或软装阶段即介入，而不是装饰完成后再行布置。',
];

const scenarios = [
  '企业前台与形象墙',
  '会客室、洽谈区与贵宾室',
  '办公区走廊与公共空间',
  '企业文化展厅',
  '酒店、民宿与商业空间',
];

const specRows = [
  { label: '起订量', value: '按项目承接，无固定份数要求。单一空间或全楼多空间的整体方案均可。' },
  { label: '尺寸确定', value: '以现场实测尺寸为准。贵司可提供空间照片与测绘图，或由我们提出勘测需求。' },
  { label: '作品形式', value: '书法原作，形制可为横幅、竖幅、斗方、条屏或组合式。依空间条件与内容确定。' },
  { label: '装裱与安装', value: '含装裱方案与安装建议。安装方式（挂装、嵌装、框体固定等）依墙体条件确定。' },
  { label: '内容定制', value: '内容可为企业文化语、行业用语或指定文本。由贵司提供方向，我们确认书写可行性。' },
  { label: '与设计方配合', value: '可配合贵司室内设计方或建筑方，就尺寸、材质、色调与进场节点对接。' },
  { label: '交付周期', value: '方案与报价 2–3 个工作日；空间条件确认 3–5 个工作日；样稿确认 5–7 个工作日；创作与装裱 20–40 个工作日。' },
  { label: '交付与安装', value: '含物流与到场安装协调（按项目地点另议）。异地项目需提前确认安装条件与人员安排。' },
  { label: '结算与发票', value: '支持对公结算，可开具增值税普通发票或专用发票。具体条款以双方合同为准。' },
];

const cases = [
  {
    title: '某企业总部 · 前台形象墙',
    clientType: '企业总部 · 前台空间',
    facts: ['宽 4.2m 组合式', '含装裱与安装', '配合室内设计方'],
    body: '依前台形象墙的实际尺度定制组合式作品，与墙面材质及灯光方案协调。由我们与室内设计方对接尺寸与进场节点，安装完成后交付。',
    image: '/assets/stories/story-xiong-zhong-you-shi.webp',
    alt: '前台形象墙书法作品示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
  {
    title: '某酒店 · 会客区与走廊',
    clientType: '酒店 · 公共空间',
    facts: ['6 处点位', '按动线分区定制', '含安装建议'],
    body: '按会客区与走廊的不同动线条件分别确定形制与尺寸，形成统一风格下的分区变化。交付含安装方式建议，便于后期维护与更换。',
    image: '/assets/stories/story-du-xi-xiangkuang.jpg',
    alt: '会客区书法作品示意（临时图片，待替换为项目实拍）',
    isPlaceholder: true,
  },
];

const faqs = [
  {
    q: '尺寸怎么定？需要到现场吗？',
    a: '以现场实测尺寸为准。贵司可提供空间照片与测绘图供初步评估；对尺寸精度要求高的项目，我们建议安排现场勘测。',
  },
  {
    q: '可以和我们请的室内设计师配合吗？',
    a: '可以。我们可与贵司室内设计方或建筑方对接尺寸、材质、色调与进场节点，避免与硬装、软装工序冲突。',
  },
  {
    q: '安装包含在内吗？',
    a: '交付含装裱方案与安装方式建议。是否包含到场安装，依项目地点与条件另议，会在报价阶段明确列出。',
  },
  {
    q: '内容写什么？',
    a: '可以是企业文化语、行业用语或贵司指定的文本。我们确认书写可行性后给出样稿，确认再进入创作。',
  },
  {
    q: '交付需要多久？',
    a: '从方案确认到创作完成，常规 25–45 个工作日。若涉及多空间或多点位，需按点位数量与进场顺序分批安排。',
  },
  {
    q: '空间还没装修完，可以先进场评估吗？',
    a: '可以，且建议如此。在硬装或软装阶段介入，能避免装饰完成后再调整尺寸或安装方式造成的返工。',
  },
];

const breadcrumbName = '空间书法礼';
---

<BusinessDetailPage
  name={breadcrumbName}
  nameEn="Space Calligraphy"
  tagline="按空间尺度、光线与气质定制书法装置，含装裱与安装建议。"
  facts={facts}
  seoTitle="空间书法定制｜企业前台与会客区书法装置定制｜小民艺术"
  seoDescription="空间书法定制：按前台、会客区、走廊等空间实测尺寸定制书法装置，含装裱方案与安装建议，可配合室内设计方对接。支持对公结算，适用企业总部、酒店与商业空间。"
  intro={intro}
  scenarios={scenarios}
  specRows={specRows}
  cases={cases}
  faqs={faqs}
/>
