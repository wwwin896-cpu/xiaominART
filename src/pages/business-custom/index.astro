---
import Layout from '../../layouts/Layout.astro';
import { enterpriseCases, giftDirections } from '../../data/content';
---
<Layout title="企业定制｜Business Custom｜XIAOMINART" description="为企业、品牌活动、文化空间与礼赠场景定制东方艺术表达。">
  <section class="page-head container"><span class="eyebrow">Business Custom / 企业定制</span><h1 class="serif">让一个共同的愿望，<br />拥有自己的视觉语言。</h1><p lang="en">A shared intention, shaped into a visual language.</p><p>面向企业礼赠、文化空间、婚礼与周年、品牌活动等场景。我们先理解项目，再讨论艺术家、媒介、尺度与边界。</p></section>
  <section class="container section business-types">{giftDirections.map((item, i) => <article><span class="mono">0{i + 1}</span><h2 class="serif">{item.title}</h2><p lang="en">{item.en}</p><p>{item.body}</p></article>)}</section>
  <section class="container section enterprise-cases"><div class="section-heading"><span class="eyebrow">Reference cases / 企业案例方向</span><h2 class="serif">从已知场景，讨论下一次创作。</h2><p>以下为概念方向，案例图像与客户故事会在公开整理后持续呈现；不代表已完成项目或可直接复制的方案。</p></div><div class="case-grid">{enterpriseCases.map((item) => <article class="enterprise-case"><div class="case-visual"><span class="serif">{item.title.slice(0, 1)}</span><small>CONCEPT / 参考方向</small></div><span class="eyebrow">{item.scene}</span><h3 class="serif">{item.title}</h3><p lang="en">{item.en}</p><p>{item.summary}</p><blockquote>“{item.testimonial}”</blockquote></article>)}</div></section>
  <section class="container section enterprise-phrase"><span class="eyebrow">Corporate phrase commission / 企业字句定制</span><h2 class="serif">把品牌想说的话，写进一份共同的礼。</h2><p>企业可以从一句品牌主张、周年寄语或团队共同语言开始，讨论书写、器物、礼盒与空间呈现。</p><a class="btn btn-primary" href="/custom/?context=企业字句定制">开启企业字句咨询 →</a></section>
  <section class="container section business-operations"><div><span class="eyebrow">Working terms / 企业合作边界</span><h2 class="serif">先对齐项目，再确认交付。</h2></div><div class="operations-grid"><article><strong>合同与范围</strong><p>项目范围、媒介、节点、交付物与授权边界将在方案确认后形成项目说明或合同。</p></article><article><strong>开票与付款</strong><p>企业开票需求可在表单中备注，具体票种与付款节点待项目沟通确认。</p></article><article><strong>批量项目流程</strong><p>需求简报 → 方向讨论 → 艺术家与媒介确认 → 方案与节点确认 → 创作与交付。</p></article></div></section>
  <section class="container section business-form"><div><span class="eyebrow">Business brief / B 端项目简报</span><h2 class="serif">把项目背景告诉我们。</h2><p>提交信息仅用于初步沟通，不代表报价、排期或项目确认。</p></div><form class="business-inquiry" action="mailto:hello@xiaominart.com" method="post" enctype="text/plain"><label>公司名称 / Company<input name="company" required /></label><label>联系人 / Contact<input name="contact" required /></label><label>预算范围 / Budget range<select name="budget"><option>尚未确定 / To be discussed</option><option>¥3,000–30,000</option><option>¥30,000–50,000</option><option>¥50,000以上</option></select></label><label>项目场景 / Project context<textarea name="context" rows="3" placeholder="企业礼赠、空间、婚礼、品牌活动等" required></textarea></label><label>时间节点 / Timeline<input name="timeline" placeholder="希望开始或交付的时间范围" /></label><button class="btn btn-primary" type="submit">提交 B 端需求 <span>→</span></button><p class="form-note">发送前请检查内容；首版通过默认邮件客户端提交。</p></form></section>
</Layout>
<style>
.page-head{padding:94px 0 72px}.page-head h1{font-size:clamp(52px,7vw,90px);font-weight:500;line-height:1.16;margin:22px 0}.page-head p{max-width:680px;color:var(--ink-soft);font-size:18px}.page-head p[lang=en]{font:24px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.business-types{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.business-types article{min-height:250px;padding:22px 22px 28px 0}.business-types article+article{border-left:1px solid var(--line);padding-left:22px}.business-types h2{font-size:34px;font-weight:500;margin:34px 0 5px}.business-types p{color:var(--ink-soft);font-size:14px}.business-types p[lang=en]{font:17px var(--font-display-en),Georgia,serif;color:var(--ink)}.section-heading{border-top:1px solid var(--line);padding-top:22px}.section-heading h2{font-size:clamp(38px,5vw,62px);font-weight:500;margin:18px 0}.section-heading p{max-width:700px;color:var(--ink-soft)}.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:30px}.enterprise-case{border-top:1px solid var(--line);padding-top:14px}.case-visual{aspect-ratio:1.25;background:var(--paper-deep);display:grid;place-items:center;align-content:center;color:var(--cinnabar);margin-bottom:18px}.case-visual span{font-size:100px}.case-visual small{font:10px var(--font-mono);letter-spacing:.08em;color:var(--ink-soft)}.enterprise-case h3{font-size:28px;font-weight:500;margin:10px 0 2px}.enterprise-case p{color:var(--ink-soft);font-size:14px}.enterprise-case p[lang=en]{font:17px var(--font-display-en),Georgia,serif;color:var(--ink)}blockquote{margin:16px 0 0;border-left:1px solid var(--cinnabar);padding-left:12px;color:var(--meta);font-size:12px}.enterprise-phrase{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.enterprise-phrase h2{font-size:clamp(38px,5vw,62px);font-weight:500;margin:18px 0}.enterprise-phrase p{max-width:650px;color:var(--ink-soft);line-height:1.8}.business-operations{border-top:1px solid var(--line)}.business-operations h2{font-size:clamp(38px,5vw,62px);font-weight:500;margin:18px 0}.operations-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;border-top:1px solid var(--line)}.operations-grid article{padding:18px 18px 0 0}.operations-grid article+article{border-left:1px solid var(--line);padding-left:18px}.operations-grid strong{font:500 22px var(--font-display),Georgia,serif}.operations-grid p{color:var(--ink-soft);font-size:14px}.business-form{display:grid;grid-template-columns:1fr 1fr;gap:90px;border-top:1px solid var(--line)}.business-form h2{font-size:clamp(38px,5vw,64px);font-weight:500;margin:20px 0}.business-form>div>p{color:var(--ink-soft)}.business-inquiry{border-top:1px solid var(--line);padding-top:16px}.business-inquiry label{display:block;color:var(--ink-soft);font-size:13px;margin-bottom:16px}.business-inquiry input,.business-inquiry select,.business-inquiry textarea{display:block;width:100%;margin-top:7px;border:1px solid var(--line);border-radius:0;background:var(--paper-light);color:var(--ink);padding:12px 13px}.business-inquiry button{margin-top:4px}.form-note{color:var(--meta);font-size:11px}@media(max-width:767px){.page-head{padding:58px 0 48px}.page-head h1{font-size:53px}.page-head p[lang=en]{font-size:20px}.business-types{grid-template-columns:1fr}.business-types article,.business-types article+article{min-height:0;padding:21px 0;border-left:0;border-bottom:1px solid var(--line)}.business-types article:last-child{border-bottom:0}.business-types h2{margin:12px 0 4px}.case-grid{grid-template-columns:1fr;gap:34px}.operations-grid{grid-template-columns:1fr}.operations-grid article,.operations-grid article+article{padding:18px 0;border-left:0;border-bottom:1px solid var(--line)}.business-form{grid-template-columns:1fr;gap:28px}.business-inquiry button{width:100%}}
</style>
