---
import Layout from '../../layouts/Layout.astro';
import GiftCard from '../../components/GiftCard.astro';
import { giftProducts } from '../../data/content';
const products = giftProducts;
---
<Layout title="我的心愿单｜小民艺术" description="把喜欢的小民好礼先存在这里，想清楚之后再来咨询——心愿单只保存在你自己的浏览器里。" noindex>
  <section class="container page-head">
    <span class="eyebrow">Wishlist / 心愿单</span>
    <h1 class="serif">先收着，<br />想清楚再送。</h1>
    <p lang="en">Saved quietly, decided slowly.</p>
    <p>心愿单只存在你自己的浏览器里，不会上传、不会同步给任何人。挑好之后，点开任意一件就能咨询包装、时间与适不适合对方。</p>
  </section>

  <section class="container section wishlist-section">
    <p class="wishlist-empty" data-wishlist-empty hidden>心愿单还是空的。到<a href="/gifts/">小民好礼</a>里挑一件，点「加入心愿单」就会出现在这里。</p>
    <div class="gift-grid" data-wishlist-grid>
      {products.map((product) => <div class="wishlist-slot" data-slot={product.slug} hidden><GiftCard product={product} /></div>)}
    </div>
    <div class="wishlist-actions" data-wishlist-actions hidden>
      <a class="btn btn-primary" href="/gift-guide/" data-event="wishlist_to_guide">还拿不定主意？看选礼指南 →</a>
      <button class="btn btn-secondary" type="button" data-wishlist-clear>清空心愿单</button>
    </div>
    <p class="wishlist-hint">页面没有加载出收藏内容时，请确认浏览器没有禁用本地存储；换设备或清理浏览器数据后，心愿单不会自动同步。</p>
  </section>
</Layout>
<style>
  .page-head { padding: 90px 0 58px; }
  .page-head h1 { font-size: clamp(30px, 4vw, 52px); line-height: 1.3; font-weight: 500; margin: 20px 0; }
  .page-head p { max-width: 700px; color: var(--ink-soft); font-size: 18px; }
  .page-head p[lang='en'] { font: 24px var(--font-display-en), Georgia, serif; color: var(--cinnabar-deep); }
  .wishlist-section { border-top: 1px solid var(--line); }
  .wishlist-empty { max-width: 620px; color: var(--ink-soft); font-size: 16px; line-height: 1.9; }
  .wishlist-empty a { color: var(--cinnabar); border-bottom: 1px solid var(--cinnabar); }
  .gift-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px 30px; }
  .wishlist-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 44px; padding-top: 26px; border-top: 1px solid var(--line); }
  .wishlist-hint { margin-top: 22px; color: var(--muted); font-size: 12px; line-height: 1.8; }
  @media (max-width: 900px) { .gift-grid { grid-template-columns: 1fr; gap: 30px; } }
  @media (max-width: 767px) {
    .page-head { padding: 56px 0 42px; }
    .page-head h1 { font-size: 30px; }
    .page-head p { font-size: 16px; }
    .page-head p[lang='en'] { font-size: 20px; }
    .wishlist-actions .btn { width: 100%; }
  }
</style>
<script>
  const key = 'xiaominart-wishlist';
  const read = (): string[] => { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } };
  const grid = document.querySelector<HTMLElement>('[data-wishlist-grid]');
  const empty = document.querySelector<HTMLElement>('[data-wishlist-empty]');
  const actions = document.querySelector<HTMLElement>('[data-wishlist-actions]');
  const slots = Array.from(document.querySelectorAll<HTMLElement>('[data-slot]'));
  const sync = () => {
    const saved = read();
    let visible = 0;
    slots.forEach((slot) => {
      const match = saved.includes(slot.dataset.slot || '');
      slot.hidden = !match;
      if (match) visible += 1;
    });
    if (empty) empty.hidden = visible > 0;
    if (actions) actions.hidden = visible === 0;
    if (grid) grid.hidden = visible === 0;
  };
  sync();
  window.addEventListener('storage', sync);
  window.addEventListener('pageshow', sync);
  document.querySelector<HTMLButtonElement>('[data-wishlist-clear]')?.addEventListener('click', () => {
    localStorage.setItem(key, '[]');
    window.dispatchEvent(new StorageEvent('storage', { key }));
    sync();
  });
</script>
