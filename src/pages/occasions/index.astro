---
import Layout from '../../layouts/Layout.astro';
import { giftOccasions } from '../../data/content';
---
<Layout title="送礼场合｜选礼指南｜小民艺术" description="生日、乔迁、节日、感谢、开业和周年等送礼场合的礼物方向与私享礼遇建议。">
  <section class="container page-head"><span class="eyebrow">Occasions / 送礼场合</span><h1 class="serif">每一个值得表达的时刻，<br />都有合适的礼。</h1><p>场合页是选礼指南的搜索入口，先确认时刻，再进入具体礼物方向。</p><a class="btn btn-primary" href="/gift-guide/">进入选礼指南 →</a></section>
  <section class="container section landing-grid">{giftOccasions.map((item) => <article><span class="eyebrow">{item.en}</span><h2 class="serif"><a href={`/occasions/${item.slug}/`}>{item.title}</a></h2><p>{item.intro}</p><a class="btn btn-link" href={`/occasions/${item.slug}/`}>查看场合建议 →</a></article>)}</section>
</Layout>
<style>
  .page-head { padding: 90px 0 66px; } .page-head h1 { font-size: clamp(48px, 7vw, 86px); line-height: 1.18; font-weight: 500; margin: 20px 0; } .page-head p { max-width: 700px; color: var(--ink-soft); font-size: 18px; } .page-head .btn { margin-top: 18px; } .landing-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); } .landing-grid article { min-height: 250px; padding: 26px 26px 30px 0; border-bottom: 1px solid var(--line); } .landing-grid article:nth-child(even) { padding-left: 26px; border-left: 1px solid var(--line); } .landing-grid h2 { font-size: 34px; font-weight: 500; margin: 16px 0 10px; } .landing-grid p { max-width: 520px; color: var(--ink-soft); font-size: 15px; } @media (max-width: 767px) { .page-head { padding: 56px 0 42px; } .page-head h1 { font-size: 47px; } .page-head p { font-size: 16px; } .landing-grid { grid-template-columns: 1fr; } .landing-grid article, .landing-grid article:nth-child(even) { min-height: 0; padding: 24px 0; border-left: 0; } }
</style>
