---
// 在线后台入口（静态外壳）：https://xiaominart.com/keystatic/
// 客户端组件见 shell-page.js：通过 makePage + virtual:keystatic-config 让浏览器
// 直接 import 配置模块（函数/字段组件不丢失）。dev 下 @keystatic/astro 集成提供
// virtual 模块；生产构建由 astro.config.mjs 的 vite alias 指向 keystatic.config.ts。
import { Keystatic } from './shell-page.js';
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/assets/brand/xiaominart-logo-icon.svg" />
    <title>小民艺术 · 内容后台</title>
  </head>
  <body style="margin:0">
    <Keystatic client:only="react" />
  </body>
</html>
