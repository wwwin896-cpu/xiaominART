---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="联系小民艺术｜Contact｜小民艺术" description="通过邮箱与定制咨询入口联系小民艺术，开始一段人工对接的共创沟通。">
  <section class="container contact-head"><span class="eyebrow">Contact / 联系</span><h1 class="serif">把问题留给我们，<br />从一句话开始。</h1><p>你可以先发一封邮件，也可以直接开启定制咨询。我们会在 1–2 个工作日内回复。</p></section>
  <section class="container contact-grid"><a class="contact-card" href="mailto:hello@xiaominart.com"><span class="eyebrow">Email / 邮箱</span><strong>hello@xiaominart.com</strong><span>打开邮件客户端 →</span></a><div class="contact-card"><span class="eyebrow">Social / 社交</span><strong>小红书 / Instagram</strong><span>官方账号信息将在正式配置后更新。</span></div><div class="contact-card"><span class="eyebrow">WeChat / 微信</span><strong>企业微信</strong><span>如需即时沟通，请在邮件中留下微信号，我们会人工联系。</span></div></section>
</Layout>
<style>.contact-head{padding:96px 0 72px}.contact-head h1{font-size:clamp(52px,7vw,90px);font-weight:500;line-height:1.15;margin:22px 0}.contact-head p{max-width:620px;color:var(--ink-soft);font-size:18px;line-height:1.8}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;border-top:1px solid var(--line);padding-top:24px}.contact-card{display:flex;flex-direction:column;gap:14px;min-height:190px;padding:22px;border:1px solid var(--line);color:var(--ink-soft)}.contact-card strong{font:27px var(--font-display),Georgia,serif;color:var(--ink)}.contact-card span:last-child{margin-top:auto;font-size:12px;color:var(--meta)}@media(max-width:767px){.contact-head{padding:58px 0 48px}.contact-head h1{font-size:53px}.contact-grid{grid-template-columns:1fr}}
</style>
