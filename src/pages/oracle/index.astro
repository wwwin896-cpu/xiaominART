---
import Layout from '../../layouts/Layout.astro';
import { oracleWorks } from '../../data/content';
export const prerender = true;
---
<Layout
  title="甲骨文集 · A4 摆件合集｜乐艺 集福 天干地支 玄鸟 酌酒｜小民艺术"
  description="字游记第二辑「甲骨文集」：乐艺、集福、天干地支、玄鸟、酌酒，五件甲骨文书法 A4 摆件，黑胡桃木框，¥199 含释读说明与礼盒。三千年前的字，摆进今天的日子。"
>
  <section class="container page-head">
    <span class="eyebrow">字游记 · 第二辑</span>
    <h1 class="serif">甲骨文集，<br />把三千年摆上案头。</h1>
    <p>龟甲兽骨上的刻痕，是汉字最早的模样。「甲骨文集」从卜辞与金文里挑出五组有故事的字，亲笔书写、黑胡桃装框——可以是书房里的笨功夫，可以是家门口的老吉语，也可以是一场三千年前的微醺。</p>
    <nav class="collection-switch" aria-label="字游记系列">
      <a href="/zodiac/">第一辑 · 十二生肖</a>
      <span class="is-current" aria-current="page">第二辑 · 甲骨文集</span>
    </nav>
  </section>

  <section class="container section oracle-grid-wrap" aria-label="甲骨文集作品">
    <div class="oracle-grid">
      {oracleWorks.map((w) => (
        <article class="oracle-card" id={w.slug}>
          <figure><img src={w.image} alt={w.alt} loading="lazy" decoding="async" width={1280} height={853} /></figure>
          <div class="oracle-copy">
            <span class="mono oracle-char">{w.glyphs} · {w.en} · {w.orientation}</span>
            <h2 class="serif">{w.name}</h2>
            <p class="oracle-tagline">「{w.tagline}」</p>
            <p class="oracle-price">{w.price}<span>含释读说明与礼盒包装</span></p>
            <p class="oracle-story">{w.story}</p>
            <a class="oracle-link" href={`/custom-commission/?context=${encodeURIComponent('甲骨文集')}&inspiration=${encodeURIComponent(w.name)}`} data-event="gift_advice_click">以此为灵感 →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container section specs" aria-labelledby="oracle-specs-title">
    <div class="specs-lead">
      <span class="eyebrow">系列规格</span>
      <h2 id="oracle-specs-title" class="serif">一只框的讲究，全系列一致。</h2>
    </div>
    <dl class="spec-table">
      <div><dt>外框</dt><dd>A4（约 21 × 29.7 cm），黑胡桃实木框，45° 拼角；天干地支、酌酒为横幅，其余为竖幅</dd></div>
      <div><dt>画芯</dt><dd>手工书写甲骨文，卡纸留白装裱，随附释读说明一页</dd></div>
      <div><dt>价格</dt><dd>¥199 / 件，含释读说明一页与礼盒包装</dd></div>
      <div><dt>题字</dt><dd>主文为甲骨文古字，旁以隶书题名，落款钤印</dd></div>
      <div><dt>陈设</dt><dd>内置桌面支架，案头即摆；亦可挂墙，玄关、书房、茶室皆宜</dd></div>
    </dl>
    <div class="specs-cta">
      <a class="btn btn-primary" href="/custom-commission/?context=甲骨文集&inspiration=甲骨文集" data-event="gift_advice_click">带上你想要的字，与我们聊聊 →</a>
    </div>
  </section>

  <section class="container section tale-note">
    <span class="eyebrow">字游记 · 下一站</span>
    <h2 class="serif">字还在往远处走。</h2>
    <p>第一辑我们跟着十二生肖走过一轮岁月，这一辑在龟甲兽骨里认出了乐艺、集福、玄鸟与酒。字游记会继续往山川风物、人文器物与寻常情感里走——每一个有来处的字，都值得被讲一遍。</p>
  </section>
</Layout>

<style>
  .page-head { padding: 96px 0 48px; max-width: 780px; }
  .page-head h1 { font-size: clamp(46px, 6.4vw, 78px); line-height: 1.14; margin: 20px 0; }
  .page-head > p { color: var(--ink-soft); font-size: 17px; line-height: 1.9; margin: 0; }
  .collection-switch { display: flex; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
  .collection-switch a, .collection-switch .is-current {
    display: inline-block; padding: 7px 16px; border-radius: 999px; font-size: 13px; letter-spacing: .04em;
    border: 1px solid var(--border); color: var(--ink-soft);
  }
  .collection-switch a:hover { color: var(--ink); border-color: var(--ink-soft); }
  .collection-switch .is-current { background: var(--cinnabar); border-color: var(--cinnabar); color: #fff; }
  .oracle-grid-wrap { padding-top: 0; }
  .oracle-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 44px 30px; }
  .oracle-card { display: flex; flex-direction: column; }
  .oracle-card figure { margin: 0; overflow: hidden; aspect-ratio: 4 / 3; background: var(--paper-deep); }
  .oracle-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease, filter .5s ease; }
  .oracle-card:hover img { transform: scale(1.035); filter: brightness(1.05); }
  .oracle-copy { padding: 16px 2px 0; }
  .oracle-char { display: block; color: var(--cinnabar); font-size: 12px; letter-spacing: .14em; margin: 0 0 4px; }
  .oracle-copy h2 { font-size: 21px; font-weight: 500; margin: 0 0 6px; }
  .oracle-tagline { color: var(--cinnabar-deep); font-size: 14px; margin: 0 0 8px; }
  .oracle-price { font-size: 15px; letter-spacing: .02em; margin: 0 0 10px; }
  .oracle-price span { color: var(--ink-soft); font-size: 11.5px; margin-left: 8px; letter-spacing: 0; }
  .oracle-story { color: var(--ink-soft); font-size: 13.5px; line-height: 1.85; margin: 0 0 12px; }
  .oracle-link { color: var(--cinnabar); font-size: 12.5px; white-space: nowrap; }
  .specs { border-top: 1px solid var(--line); padding-top: 56px; }
  .specs-lead h2 { font-size: clamp(30px, 4vw, 44px); margin: 14px 0 26px; }
  .spec-table { display: grid; grid-template-columns: 1fr; max-width: 820px; border-top: 1px solid var(--border); }
  .spec-table > div { display: grid; grid-template-columns: 110px 1fr; border-bottom: 1px solid var(--border); }
  .spec-table dt { padding: 14px 0; font-weight: 500; }
  .spec-table dd { margin: 0; padding: 14px 0; color: var(--ink-soft); }
  .specs-cta { margin-top: 30px; }
  .tale-note { border-top: 1px solid var(--line); max-width: 780px; }
  .tale-note h2 { font-size: clamp(26px, 3.4vw, 38px); margin: 12px 0 14px; }
  .tale-note p { color: var(--ink-soft); line-height: 1.9; margin: 0; }
  @media (max-width: 900px) { .oracle-grid { grid-template-columns: repeat(2, 1fr); gap: 28px 20px; } }
  @media (max-width: 640px) {
    .page-head { padding: 56px 0 40px; }
    .oracle-grid { grid-template-columns: 1fr; gap: 34px; }
    .spec-table > div { grid-template-columns: 88px 1fr; }
  }
</style>
