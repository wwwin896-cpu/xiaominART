---
import Layout from '../../layouts/Layout.astro';
import { giftDirections } from '../../data/content';
---
<Layout title="艺术礼盒｜Art Gift｜XIAOMINART" description="从关系、场景与一句话开始，共同取意一份艺术礼物。"><section class="page-head container"><span class="eyebrow">Art Gift / 艺术礼盒</span><h1 class="serif">礼物不必从货架开始，<br />可以从一段故事开始。</h1><p lang="en">A gift can begin with a story, not a shelf.</p><p>艺术礼盒是定制创作的一种轻量入口。它不预设固定款式，而是围绕一段关系、一场相逢或一份感谢共同确定方向。</p></section><section class="container section gift-grid">{giftDirections.map((gift) => <article><span class="serif">{gift.title}</span><small lang="en">{gift.en}</small><p>{gift.body}</p><a class="btn btn-link" href={`/custom-commission/?scene=gift&context=${encodeURIComponent('艺术礼盒')}&direction=${encodeURIComponent(gift.title)}`}>开启定制咨询 / Begin a consultation →</a></article>)}</section><section class="container section gift-note"><span class="eyebrow">No ready-made objects / 非现货商品</span><h2 class="serif">每份礼盒，都需要先被理解。</h2><p>提交礼赠对象、场景、时间和希望传达的意图，我们再共同确认适合的艺术形式与交付边界。</p><a class="btn btn-primary" href={`/custom-commission/?scene=gift&context=${encodeURIComponent('艺术礼盒')}`}>开启定制咨询 / Begin a consultation →</a></section></Layout>
<style>.page-head{padding:94px 0 72px}.page-head h1{font-size:clamp(52px,7vw,90px);font-weight:500;line-height:1.16;margin:22px 0}.page-head p{max-width:670px;color:var(--ink-soft);font-size:18px}.page-head p[lang=en]{font:24px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.gift-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.gift-grid article{min-height:250px;padding:28px 24px 32px 0}.gift-grid article+article{border-left:1px solid var(--line);padding-left:24px}.gift-grid .serif{display:block;font-size:32px}.gift-grid small{display:block;color:var(--ink-soft);font:17px var(--font-display-en),Georgia,serif;margin-top:5px}.gift-grid p,.gift-note p{color:var(--ink-soft);font-size:14px}.gift-note{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.gift-note h2{font-size:clamp(38px,5vw,64px);font-weight:500;margin:20px 0}.gift-note p{max-width:600px}@media(max-width:767px){.page-head{padding:58px 0 48px}.page-head h1{font-size:53px}.page-head p[lang=en]{font-size:20px}.gift-grid{grid-template-columns:1fr}.gift-grid article,.gift-grid article+article{min-height:0;padding:22px 0;border-left:0;border-bottom:1px solid var(--line)}.gift-grid article:last-child{border-bottom:0}}
</style>
