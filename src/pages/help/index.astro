---
import Layout from '../../layouts/Layout.astro';
import TrustStrip from '../../components/TrustStrip.astro';

// 售后条款（WO-P1-04，2026-10-09 业主定稿，措辞忠实于业主原话，不添加未承诺内容）：
//   1. 每个款式都有专属编号
//   2. 物流原因损坏 → 客户退回，修复后重新发出
//   3. 出厂质量问题（装裱、材质不符合要求）→ 可直接退货
//   4. 其余退货条款与消费品一样，参考书画作品的退货条款
const afterSalesPolicies = [
  { title: '物流损坏 · 修复后重发', body: '作品在运输途中损坏的，你把它退回给我们，修复完成后重新发出。' },
  { title: '出厂质量问题 · 可直接退货', body: '装裱、材质与确认的要求不符，属于出厂质量问题，可以直接退货。' },
  { title: '其余情形 · 参照书画作品通行规则', body: '其他退货情形，与消费品一样，参照书画作品的通行退货条款执行。' },
];
const faqGroups = [
  { title: '选礼', items: [['如何开始选礼？', '可以从小民好礼、选礼指南、场合或对象开始。还不确定时，提交送礼建议即可。'], ['可以直接在小程序下单吗？', '部分礼物已开通小程序下单，页面上有「微信小程序下单」按钮的可以直接购买。暂时只能提交建议的礼物，点「获取送礼建议」留下联系方式，我们会把细节、包装与时间一并讲给你。']] },
  { title: '包装与交付', items: [['可以写手写贺卡吗？', '可以。确认礼物方向时提交贺卡文字，我们会一起确认字数、版式与包装。'], ['多久可以发货？', '页面展示的是当前参考时间，最终以礼物方向、包装方式和确认时间为准；急件请先提交咨询。']] },
  { title: '售后与定制', items: [['礼物可以退换吗？', '物流损坏可退回修复后重发；出厂质量问题（如装裱、材质不符）可直接退货；其余情形参照书画作品的通行退货条款执行。详见本页上方《售后保障与退换须知》。'], ['定制和小民好礼有什么不同？', '小民好礼提供已经整理好的礼物方向；定制会从人物、空间或一句话开始，共同确定创作边界。']] },
  { title: '沟通与联系', items: [['想通过微信沟通怎么办？', '通过「寻墨」留言或邮件留下你的微信号，我们会尽快主动添加你；官方微信也会在页脚展示。'], ['提交表单后会收到什么回复？', '我们会尽快通过你留下的联系方式回复，先确认场景与意图，再讨论方向、预算与交付边界。']] },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((group) => group.items.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  }))),
};
---
<Layout title="帮助中心｜包装、交付与选礼 FAQ｜小民艺术" description="关于小民好礼、选礼、包装、手写贺卡、交付、售后和定制的常见问题。">
  <section class="container help-hero"><span class="eyebrow">Help / 帮助中心</span><h1 class="serif">把礼物的细节，<br />提前说清楚。</h1><p>这里回答选礼、包装、手写贺卡、交付、售后和定制相关问题。未找到答案时，可以直接获取送礼建议。</p><a class="btn btn-primary" href="/custom-commission/?context=送礼建议" data-event="gift_advice_click">获取送礼建议 →</a></section>

  {/* 售后保障（WO-P1-04）。锚点 #after-sales 供页脚与商品页引用。
      条款为业主 2026-10-09 定稿原文，此处不添加任何业主未承诺的时限、运费或范围。 */}
  <section class="container section after-sales" id="after-sales" aria-labelledby="after-sales-title">
    <span class="eyebrow">After-sales / 售后保障</span>
    <h2 id="after-sales-title" class="serif">售后保障与退换须知。</h2>
    <p class="after-sales-lead">每一幅作品都有专属编号——凭编号即可受理售后，作品与订单信息一目了然。遇到问题不必顾虑流程，先联系我们，我们把每一步讲清楚。</p>
    <TrustStrip />
    <div class="policy-list">
      {afterSalesPolicies.map((policy, index) => (
        <div class="policy-item">
          <span class="mono policy-no">0{index + 1}</span>
          <div><h3 class="serif">{policy.title}</h3><p>{policy.body}</p></div>
        </div>
      ))}
    </div>
    <p class="after-sales-tip">收货时建议当场验件；若外包装有明显破损，先拍照留存再拆件，联系我们时一并提供，处理会更快。</p>
    <p class="after-sales-tip">我们如何收集与保护你的个人信息，见<a href="/privacy/">《隐私政策》</a>。</p>
  </section>

  <section class="container section faq-sections">{faqGroups.map((group) => <section><span class="eyebrow">{group.title}</span><div class="faq-list">{group.items.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>)}</section>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
<style>
  .help-hero { padding: 96px 0 70px; } .help-hero h1 { font-size: clamp(50px, 7vw, 88px); font-weight: 500; line-height: 1.18; margin: 20px 0; } .help-hero p { max-width: 700px; color: var(--ink-soft); font-size: 18px; } .help-hero .btn { margin-top: 18px; }
  /* 售后保障（WO-P1-04） */
  .after-sales { border-top: 1px solid var(--line); scroll-margin-top: 92px; }
  .after-sales h2 { font-size: clamp(26px, 3.2vw, 40px); font-weight: 500; margin: 14px 0 12px; }
  .after-sales-lead { max-width: 640px; color: var(--ink-soft); line-height: 1.9; margin: 0 0 22px; }
  .policy-list { border-top: 1px solid var(--line); margin-top: 26px; }
  .policy-item { display: flex; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .policy-no { flex: none; font-size: 15px; color: var(--cinnabar-deep); border-bottom: 1px solid var(--cinnabar); padding-bottom: 5px; height: fit-content; letter-spacing: .18em; }
  .policy-item h3 { font-size: 20px; font-weight: 500; margin: 4px 0 8px; }
  .policy-item p { color: var(--ink-soft); font-size: 15px; line-height: 1.9; margin: 0; max-width: 720px; }
  .after-sales-tip { color: var(--muted); font-size: 12.5px; line-height: 1.8; margin: 18px 0 0; }
  .after-sales-tip a { color: var(--cinnabar); border-bottom: 1px solid var(--cinnabar); }
  .faq-sections { border-top: 1px solid var(--line); } .faq-sections > section { padding: 28px 0 40px; border-bottom: 1px solid var(--line); } .faq-list { max-width: 820px; margin-top: 20px; border-top: 1px solid var(--line); } details { padding: 18px 0; border-bottom: 1px solid var(--line); } summary { cursor: pointer; min-height: 44px; font-weight: 500; } details p { max-width: 680px; color: var(--ink-soft); line-height: 1.8; } @media (max-width: 767px) { .help-hero { padding: 56px 0 46px; } .help-hero h1 { font-size: 50px; } .help-hero p { font-size: 16px; } .policy-item { gap: 16px; padding: 20px 0; } }
</style>
