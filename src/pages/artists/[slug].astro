---
import Layout from '../../layouts/Layout.astro';
import { artists } from '../../data/content';
import { creatorCreed } from '../../data/creator-creed';
export const prerender = true;
export function getStaticPaths(){ return artists.map((artist) => ({ params: { slug: artist.slug }, props: { artist } })); }
const { artist } = Astro.props;
// 书者手记只属于升斗小民（书法方向的见解），面塑方向的主理人不适用。
const creed = artist.slug === 'xiaomin' ? creatorCreed : [];
---
<Layout title={`${artist.name}｜艺术家｜XIAOMINART`} description={`${artist.name} 的创作方向、媒介与定制合作方式。`} breadcrumbs={[{ name: '首页', href: '/' }, { name: '艺术家', href: '/artists/' }, { name: artist.name, href: `/artists/${artist.slug}/` }]}>
  <section class="artist-hero container"><div class="artist-sign"><span class="serif">{artist.name.slice(-1)}</span><small>ARTIST / XIAOMINART</small></div><div><span class="eyebrow">Artist profile / 艺术家详情</span><h1 class="serif">{artist.name}</h1><p lang="en">{artist.en}</p><p>{artist.bio}</p><div class="tag-row">{artist.styles.map((style) => <span class="status">{style}</span>)}{artist.media.map((medium) => <span class="status">{medium}</span>)}</div></div></section>
  <section class="container section profile-copy"><div><span class="eyebrow">Practice / 创作理念</span><h2 class="serif">{artist.philosophy}</h2></div><div><p>艺术家详情页用于理解其视觉语言、媒介倾向与共同创作方式。页面中的图像和案例只作为创作参考，不代表同款可获得。</p><p lang="en">This profile introduces an artistic language, not a catalogue. Any commission begins anew from your context.</p><a class="btn btn-primary" href={`/custom-commission/?artist=${encodeURIComponent(artist.name)}&direction=${encodeURIComponent(artist.discipline)}`}>以此艺术家为方向定制 <span>→</span></a></div></section>
  {creed.length > 0 && (
    <section class="container section artist-creed" aria-labelledby="artist-creed-title">
      <div class="section-heading">
        <span class="eyebrow">In her words / 书者手记</span>
        <h2 id="artist-creed-title" class="serif">她是这么看待书法的。</h2>
        <p>两则原话，不加修饰。一则是她怎么看「把格言挂上墙」，一则是她自己的笔下功夫从哪里来。</p>
      </div>
      <div class="artist-creed-list">
        {creed.map((item) => (
          <article class="artist-creed-card">
            <span class="eyebrow">{item.lead}</span>
            <p class="artist-creed-motto serif">{item.motto}</p>
            <p class="artist-creed-en" lang="en">{item.mottoEn}</p>
            <ul class="artist-creed-points">
              {item.items.map((point) => <li><strong class="serif">{point.title}</strong><span>{point.body}</span></li>)}
            </ul>
            <p class="artist-creed-closing">{item.closing}</p>
          </article>
        ))}
      </div>
    </section>
  )}
  <section class="container section services"><div class="section-heading"><span class="eyebrow">Service entries / 服务入口</span><h2 class="serif">可以从这三件事开始。</h2><p>每个入口都写清了适合谁和下一步点哪里，不必先想清楚全部细节。</p></div><div class="service-grid">{artist.services.map((service) => <article class="service-card"><h3 class="serif">{service.zh}</h3><p lang="en">{service.en}</p><p>{service.body}</p><a class="btn btn-link" href={service.href} data-event="artist_service_entry">{service.zh} · 从这里开始 →</a></article>)}</div></section>
  <section class="container section portfolio"><div class="section-heading"><span class="eyebrow">Selected directions / 代表方向</span><h2 class="serif">代表创作方向</h2><p>方向名称用于说明视觉语言与媒介倾向；可获得的形态以实际定制沟通确认为准，不做同款复刻。</p></div><div class="direction-row">{artist.portfolio.map((title) => <span class="direction">{title}</span>)}</div></section>
  <section class="container section artist-facts"><div><span class="eyebrow">Media & project fit / 擅长媒介与适配项目</span><p>{artist.media.join(' · ')}</p><p>{artist.projectTypes.join(' · ')}</p><p class="pending">{artist.siteNote}</p></div><div><span class="eyebrow">Experience / 经历</span><p>{artist.experience}</p><span class="eyebrow">Reference quote / 参考报价</span><p>{artist.quote}</p></div></section>
</Layout>
<style>.artist-hero{display:grid;grid-template-columns:40% 1fr;gap:80px;align-items:center;padding:96px 0 80px}.artist-sign{aspect-ratio:1;max-width:390px;background:var(--paper-deep);display:grid;place-items:center;align-content:center;color:var(--cinnabar)}.artist-sign span{font-size:150px}.artist-sign small{font:10px var(--font-mono);color:var(--ink-soft);margin-top:14px;letter-spacing:.1em}.artist-hero h1{font-size:clamp(52px,7vw,90px);font-weight:500;margin:20px 0 4px}.artist-hero p{max-width:580px;color:var(--ink-soft);font-size:18px}.artist-hero p[lang=en]{font:24px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.profile-copy{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line)}.profile-copy h2{font-size:clamp(36px,4vw,56px);font-weight:500;line-height:1.3}.profile-copy p{max-width:580px;color:var(--ink-soft)}.profile-copy p[lang=en]{font:21px/1.5 var(--font-display-en),Georgia,serif;color:var(--ink)}.profile-copy .btn{margin-top:18px}.section-heading{border-top:1px solid var(--line);padding-top:22px}.section-heading h2{font-size:clamp(38px,5vw,62px);font-weight:500;margin:18px 0}.section-heading p{max-width:700px;color:var(--ink-soft)}.portfolio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:30px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:26px}.service-card{display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--line);padding:18px 0 0}.service-card h3{font-size:24px;font-weight:400;margin:0}.service-card p{color:var(--ink-soft);font-size:14px;line-height:1.85;margin:0}.service-card p[lang=en]{color:var(--cinnabar-deep);font:15px var(--font-display-en),Georgia,serif}.service-card .btn{margin-top:auto;align-self:flex-start}.direction-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.direction{padding:9px 14px;border:1px solid var(--line);color:var(--ink-soft);font-size:14px}.portfolio-grid article{border-top:1px solid var(--line);padding-top:14px}.portfolio-mark{aspect-ratio:1.2;background:var(--paper-deep);display:grid;place-items:center;align-content:center;color:var(--cinnabar);font-size:100px}.portfolio-mark small{display:block;color:var(--meta);font:11px var(--font-mono);font-size:10px}.portfolio-grid h3{font-size:26px;font-weight:500;margin:12px 0 4px}.portfolio-grid span{font-size:12px;color:var(--meta)}.artist-facts{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line)}.artist-facts p{color:var(--ink-soft);max-width:560px}.artist-facts .pending{color:var(--meta);font-size:12px;border-left:1px solid var(--line);padding-left:12px}
/* 书者手记（仅升斗小民） */
.artist-creed{border-top:1px solid var(--line)}
.artist-creed-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 40px;margin-top:30px}
.artist-creed-card{border-top:1px solid var(--line);padding-top:22px}
.artist-creed-motto{font-size:clamp(19px,2.2vw,26px);font-weight:500;line-height:1.55;margin:16px 0 4px;letter-spacing:.02em}
.artist-creed-en{margin:0 0 20px;color:var(--cinnabar-deep);font:15px/1.6 var(--font-display-en),Georgia,serif}
.artist-creed-points{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.artist-creed-points li{display:grid;gap:6px;padding-bottom:14px;border-bottom:1px solid var(--line-soft)}
.artist-creed-points li:last-child{border-bottom:0;padding-bottom:0}
.artist-creed-points strong{font-size:16px;font-weight:500;line-height:1.6}
.artist-creed-points span{color:var(--ink-soft);font-size:14px;line-height:1.9}
.artist-creed-closing{margin:20px 0 0;padding-left:14px;border-left:2px solid var(--cinnabar);font-size:14px;line-height:1.9}
@media(max-width:900px){.artist-creed-list{grid-template-columns:1fr;gap:30px}}@media(max-width:767px){.artist-hero{grid-template-columns:1fr;gap:34px;padding:58px 0 50px}.artist-sign{max-width:100%;aspect-ratio:1.2}.artist-sign span{font-size:110px}.artist-hero h1{font-size:54px}.profile-copy,.artist-facts{grid-template-columns:1fr;gap:28px}.portfolio-grid,.service-grid{grid-template-columns:1fr;gap:24px}.service-card .btn{align-self:stretch}}
</style>
