---
import Layout from '../../layouts/Layout.astro';
import { artists } from '../../data/content';
export function getStaticPaths(){ return artists.map((artist) => ({ params: { slug: artist.slug }, props: { artist } })); }
const { artist } = Astro.props;
---
<Layout title={`${artist.name}｜艺术家｜XIAOMINART`} description={`${artist.name} 的创作方向、媒介与定制合作方式。`}>
  <section class="artist-hero container"><div class="artist-sign"><span class="serif">{artist.name.slice(-1)}</span><small>ARTIST / XIAOMINART</small></div><div><span class="eyebrow">Artist profile / 艺术家详情</span><h1 class="serif">{artist.name}</h1><p lang="en">{artist.en}</p><p>{artist.bio}</p><div class="tag-row">{artist.styles.map((style) => <span class="status">{style}</span>)}{artist.media.map((medium) => <span class="status">{medium}</span>)}</div></div></section>
  <section class="container section profile-copy"><div><span class="eyebrow">Practice / 创作理念</span><h2 class="serif">{artist.philosophy}</h2></div><div><p>艺术家详情页用于理解其视觉语言、媒介倾向与共同创作方式。页面中的图像和案例只作为创作参考，不代表同款可获得。</p><p lang="en">This profile introduces an artistic language, not a catalogue. Any commission begins anew from your context.</p><a class="btn btn-primary" href={`/custom-commission/?artist=${encodeURIComponent(artist.name)}&direction=${encodeURIComponent(artist.discipline)}`}>以此艺术家为方向定制 <span>→</span></a></div></section>
  <section class="container section portfolio"><div class="section-heading"><span class="eyebrow">Selected directions / 代表方向</span><h2 class="serif">代表创作方向</h2><p>以下名称来自灵感参考库的方向占位，图像与完整作品档案将随公开故事持续呈现。</p></div><div class="portfolio-grid">{artist.portfolio.map((title) => <article><div class="portfolio-mark serif" role="img" aria-label={`${artist.name} ${title} 落地实景图整理中`}>{title.slice(0, 1)}<small>落地实景图整理中</small></div><h3 class="serif">{title}</h3><span>Reference direction / 参考方向</span></article>)}</div></section>
  <section class="container section artist-facts"><div><span class="eyebrow">Media & project fit / 擅长媒介与适配项目</span><p>{artist.media.join(' · ')}</p><p>{artist.projectTypes.join(' · ')}</p><p class="pending">{artist.siteNote}</p></div><div><span class="eyebrow">Experience / 经历</span><p>{artist.experience}</p><span class="eyebrow">Reference quote / 参考报价</span><p>{artist.quote}</p></div></section>
</Layout>
<style>.artist-hero{display:grid;grid-template-columns:40% 1fr;gap:80px;align-items:center;padding:96px 0 80px}.artist-sign{aspect-ratio:1;max-width:390px;background:var(--paper-deep);display:grid;place-items:center;align-content:center;color:var(--cinnabar)}.artist-sign span{font-size:150px}.artist-sign small{font:10px var(--font-mono);color:var(--ink-soft);margin-top:14px;letter-spacing:.1em}.artist-hero h1{font-size:clamp(52px,7vw,90px);font-weight:500;margin:20px 0 4px}.artist-hero p{max-width:580px;color:var(--ink-soft);font-size:18px}.artist-hero p[lang=en]{font:24px var(--font-display-en),Georgia,serif;color:var(--cinnabar-deep)}.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.profile-copy{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line)}.profile-copy h2{font-size:clamp(36px,4vw,56px);font-weight:500;line-height:1.3}.profile-copy p{max-width:580px;color:var(--ink-soft)}.profile-copy p[lang=en]{font:21px/1.5 var(--font-display-en),Georgia,serif;color:var(--ink)}.profile-copy .btn{margin-top:18px}.section-heading{border-top:1px solid var(--line);padding-top:22px}.section-heading h2{font-size:clamp(38px,5vw,62px);font-weight:500;margin:18px 0}.section-heading p{max-width:700px;color:var(--ink-soft)}.portfolio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:30px}.portfolio-grid article{border-top:1px solid var(--line);padding-top:14px}.portfolio-mark{aspect-ratio:1.2;background:var(--paper-deep);display:grid;place-items:center;align-content:center;color:var(--cinnabar);font-size:100px}.portfolio-mark small{display:block;color:var(--meta);font:11px var(--font-mono);font-size:10px}.portfolio-grid h3{font-size:26px;font-weight:500;margin:12px 0 4px}.portfolio-grid span{font-size:12px;color:var(--meta)}.artist-facts{display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid var(--line)}.artist-facts p{color:var(--ink-soft);max-width:560px}.artist-facts .pending{color:var(--meta);font-size:12px;border-left:1px solid var(--line);padding-left:12px}@media(max-width:767px){.artist-hero{grid-template-columns:1fr;gap:34px;padding:58px 0 50px}.artist-sign{max-width:100%;aspect-ratio:1.2}.artist-sign span{font-size:110px}.artist-hero h1{font-size:54px}.profile-copy,.artist-facts{grid-template-columns:1fr;gap:28px}.portfolio-grid{grid-template-columns:1fr;gap:34px}}
</style>
